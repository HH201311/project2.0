<Page x:Class="SUNWODA_SEVB.Views.Pages.HawkEye.CameraConfigurationManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.HawkEye"
      xmlns:core1="clr-namespace:SUNWODA_SEVB.Core.Models.Project.HawkEye;assembly=SUNWODA_SEVB.Core"
      xmlns:core2="clr-namespace:SUNWODA_SEVB.Core.Common.Commands;assembly=SUNWODA_SEVB.Core"
      xmlns:hc="https://handyorg.github.io/handycontrol" 
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="相机配置管理">

    <hc:ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding CompositeItems}" Margin="5,0,0,0">
            <!-- 1. 将布局面板替换为WrapPanel -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid IsItemsHost="True" Columns="{Binding Columns}" Rows="{Binding Rows}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!-- 2. 定义如何显示每个数据项 (DataTemplate) -->
            <ItemsControl.Resources>
                <!--相机模型类绑定-->
                <DataTemplate DataType="{x:Type core1:CameraModel}">
                    <GroupBox Margin="0,0,5,5" Style="{x:Null}">
                        <GroupBox.Header>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} ip:{1}">
                                        <Binding Path="Name"/>
                                        <Binding Path="HostIP"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!--基本信息-->
                            <StackPanel Grid.Row="0" Grid.Column="0" Background="White" Orientation="Vertical">
                                <DockPanel LastChildFill="False" Margin="5">
                                    <TextBlock Text="是否启用:" DockPanel.Dock="Left" Width="80" TextAlignment="Left" VerticalAlignment="Center" FontSize="14PX" FontWeight="Black"/>
                                    <Rectangle Width="10"/>
                                    <CheckBox IsChecked="{Binding Enable}" Content="启用" Margin="0,10,0,10" VerticalContentAlignment="Center" BorderBrush="Blue" FontSize="14PX" FontWeight="Black"/>
                                </DockPanel>
                                <DockPanel LastChildFill="True" Margin="5">
                                    <TextBlock Text="相机名称:" DockPanel.Dock="Left" Width="80" TextAlignment="Left" VerticalAlignment="Center" FontSize="14PX" FontWeight="Black"/>
                                    <Rectangle Width="10"/>
                                    <TextBox Text="{Binding Name}" DockPanel.Dock="Left" BorderBrush="Blue" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="14PX" FontWeight="Black"/>
                                </DockPanel>
                                <DockPanel LastChildFill="True" Margin="5">
                                    <TextBlock Text="相机IP:" DockPanel.Dock="Left" Width="80" TextAlignment="Left" VerticalAlignment="Center" FontSize="14PX" FontWeight="Black"/>
                                    <Rectangle Width="10"/>
                                    <TextBox Text="{Binding HostIP}" DockPanel.Dock="Left" BorderBrush="Blue" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="14PX" FontWeight="Black"/>
                                </DockPanel>
                                <DockPanel LastChildFill="True" Margin="5">
                                    <TextBlock Text="工位名称:" DockPanel.Dock="Left" Width="80" TextAlignment="Left" VerticalAlignment="Center" FontSize="14PX" FontWeight="Black"/>
                                    <Rectangle Width="10"/>
                                    <TextBox Text="{Binding Workstaion}" DockPanel.Dock="Left" BorderBrush="Blue" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" FontSize="14PX" FontWeight="Black"/>
                                </DockPanel>
                            </StackPanel>
                            <!--功能区块-->
                            <StackPanel Grid.Row="0" Grid.Column="1" Background="White" Orientation="Vertical">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="删除" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="0,5,10,20" MinWidth="80" MinHeight="30" VerticalContentAlignment="Center" FontSize="14PX" FontWeight="Black" Foreground="White" Background="#3355FF"/>
                                    <Button Content="保存" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}" Margin="0,5,10,20" MinWidth="80" MinHeight="30" VerticalContentAlignment="Center" FontSize="14PX" FontWeight="Black" Foreground="White" Background="#3355FF"/>
                                </StackPanel>
                            </StackPanel>
                            <!--其他信息-->
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="White" Orientation="Vertical">
                                <DockPanel LastChildFill="False" Margin="5">
                                    <TextBlock Text="通讯协议:" DockPanel.Dock="Left" Width="80" TextAlignment="Left" VerticalAlignment="Center" FontSize="14PX" FontWeight="Black"/>
                                    <Rectangle Width="10"/>
                                    <TextBlock Text="{Binding Protocol}" DockPanel.Dock="Left" FontSize="14PX" FontWeight="Black"/>
                                </DockPanel>
                                <DockPanel LastChildFill="True" Margin="5">
                                    <TextBlock Text="备注:" DockPanel.Dock="Left" Width="80" TextAlignment="Left" VerticalAlignment="Top" FontSize="14PX" FontWeight="Black"/>
                                    <Rectangle Width="10"/>
                                    <TextBox Text="{Binding Remake}" DockPanel.Dock="Left" Height="100" BorderBrush="Blue" TextWrapping="Wrap" AcceptsTab="True" AcceptsReturn="True" VerticalContentAlignment="Top" HorizontalContentAlignment="Left" FontSize="14PX" FontWeight="Black"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </DataTemplate>
                <!--命令绑定按钮-->
                <DataTemplate DataType="{x:Type core2:RelayCommand}">
                    <Button Command="{Binding}" Width="60" Height="50" Background="Transparent" BorderThickness="0">
                        <Image Source="/Assets/images/plus.png" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2"/>
                            </Image.RenderTransform>
                            <Image.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5"/>
                            </Image.RenderTransformOrigin>
                        </Image>
                    </Button>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </hc:ScrollViewer>
</Page>
