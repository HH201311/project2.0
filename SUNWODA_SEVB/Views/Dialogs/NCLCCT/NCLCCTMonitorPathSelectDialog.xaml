<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.NCLCCT.NCLCCTMonitorPathSelectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.NCLCCT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="150"
    Background="White"
    CornerRadius="10"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Button
            Margin="0,0,0,10"
            HorizontalAlignment="Right"
            hc:IconElement.Geometry="{StaticResource CloseGeometry}"
            BorderThickness="0"
            Command="{Binding CloseCommand}">
            <Button.Style>
                <Style BasedOn="{StaticResource ButtonIconCircular}" TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#ff5858" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="Background" Value="#e1e1e1" />
                            <Setter Property="Foreground" Value="Black" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <DockPanel VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    Text="监控路径：" />
                <TextBox
                    VerticalAlignment="Center"
                    IsReadOnly="True"
                    Text="{Binding Result}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Button
                    Command="{Binding AffirmMonitorPathCommand}"
                    Content="确认"
                    Style="{StaticResource ButtonSuccess}" />
                <Button
                    Grid.Column="1"
                    Command="{Binding ChangeMonitorPathCommand}"
                    Content="更改"
                    Style="{StaticResource ButtonWarning}" />
            </Grid>
        </Grid>
    </Grid>
</Border>
