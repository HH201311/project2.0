                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceExportDialogWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="245"
                                    hc:InfoElement.Title="写入超时(ms)"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="等待「请耐心等待.../正在写入图像」进度框消失，默认 60000（1 分钟）">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceExportWriteTimeoutMs" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                            <TextBlock
                                Margin="10,8,10,0"
                                FontWeight="SemiBold"
                                Text="切片图范围 (mm) — 按视角分别设置" />
                            <StackPanel Margin="10,4,10,0" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="160"
                                    Margin="0,0,8,0"
                                    hc:InfoElement.Title="上·开始"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="「上」视图切片范围开始 [mm]">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceRangeTopStartMm" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="160"
                                    Margin="0,0,16,0"
                                    hc:InfoElement.Title="上·结束"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="「上」视图切片范围结束 [mm]">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceRangeTopEndMm" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="160"
                                    Margin="0,0,8,0"
                                    hc:InfoElement.Title="右·开始"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="「右」视图切片范围开始 [mm]">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceRangeRightStartMm" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="160"
                                    hc:InfoElement.Title="右·结束"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="「右」视图切片范围结束 [mm]">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceRangeRightEndMm" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                            <StackPanel Margin="10,4,10,10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="160"
                                    Margin="0,0,8,0"
                                    hc:InfoElement.Title="前·开始"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="「前」视图切片范围开始 [mm]">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceRangeFrontStartMm" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="160"
                                    hc:InfoElement.Title="前·结束"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="「前」视图切片范围结束 [mm]">
                                    <hc:TextBox.Text>
                                        <Binding Path="SliceRangeFrontEndMm" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                        
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Visibility="{Binding IsNavAiAnnotate, Converter={StaticResource BoolToVis}}" Style="{StaticResource CasWhiteCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="AI 图像标注（NJCT 离线 CT）" Style="{StaticResource CasSectionHeaderStyle}" Margin="0"/>
                                <Border Style="{StaticResource CasParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource CasParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="切片导出完成后，取「上」视图中间一张图（数量 N 时取第 N/2 张，如 100→50），调用 NJCT.NJSwdCT 做电芯抓点标注。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="输出位置" />
                                            <LineBreak />
                                            <Run Text="与三视图文件夹同级：{导出根}/{主文件夹}/AI标注/" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• 启用：主流程开关；关闭则跳过本步。" />
                                            <LineBreak />
                                            <Run Text="• 模型路径：ONNX 绝对路径；空则用默认 Dlls\Models\CTOffline\model_500000_900.onnx。" />
                                            <LineBreak />
                                            <Run Text="• CUDA：ModelInit 的 IsRunCuda，默认开启。" />
                                            <LineBreak />
                                            <Run Text="• 打黑高度 BlackHeight：图片下方打黑像素高度，默认 1500。" />
                                            <LineBreak />
                                            <Run Text="• 结果图模式：增强图 / 原图 / 两者（默认增强图）。" />
                                            <LineBreak />
                                            <Run Text="• 导出 JSON/CSV：坐标与尺寸落盘，默认均勾选。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource CasParamHelpIconTextStyle}" />
                            </Border>
                            </StackPanel>

                            <CheckBox
                                Margin="10,4,10,8"
                                Content="启用 AI 图像标注（切片导出后自动执行）"
                                IsChecked="{Binding EnableOfflineCtVisionAnnotation}" />

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Title="模型路径"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="空则使用默认部署路径 Dlls\Models\CTOffline\model_500000_900.onnx">
                                    <hc:TextBox.Text>
                                        <Binding Path="OfflineCtModelPath" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button Width="70" Margin="0,0,8,0" Command="{Binding BrowseOfflineCtModelPathCommand}" Content="浏览" />
                                <Button Width="70" Command="{Binding ResetOfflineCtModelPathCommand}" Content="默认" ToolTip="清空为默认模型路径" />
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,24,0"
                                    VerticalAlignment="Center"
                                    Content="启用 CUDA"
                                    IsChecked="{Binding OfflineCtIsRunCuda}" />
                                <hc:TextBox
                                    Width="180"
                                    hc:InfoElement.Title="打黑高度"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="BlackHeight，图片下方打黑像素高度">
                                    <hc:TextBox.Text>
                                        <Binding Path="OfflineCtBlackHeight" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="结果图模式" />
                                <ComboBox
                                    Width="200"
                                    ItemsSource="{Binding OfflineCtResultImageModeOptions}"
                                    SelectedItem="{Binding OfflineCtResultImageModeDisplay, Mode=TwoWay}" />
                            </StackPanel>

                            <StackPanel Margin="10,4,10,10" Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,24,0"
                                    Content="输出 annotation.json"
                                    IsChecked="{Binding OfflineCtExportJson}" />
                                <CheckBox
                                    Content="输出 annotation.csv"
                                    IsChecked="{Binding OfflineCtExportCsv}" />
                            </StackPanel>

                            <TextBlock
                                Margin="10,0,10,8"
                                TextWrapping="Wrap"
                                Foreground="#666"
                                Text="主流程输入：上视图文件夹中第 N/2 张图。输出：主文件夹下「AI标注」子目录（与前/右/上同级）。" />

                            <TextBlock
                                Margin="10,12,10,0"
                                FontWeight="SemiBold"
                                Text="独立标注（单张图片）" />
                            <TextBlock
                                Margin="10,4,10,0"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource CasMutedTextBrush}"
                                Text="在此选择输入图片后点击「开始标注」。输出文件夹可留空，默认输出到输入图片所在目录。" />
                            <StackPanel Margin="10,10,10,0" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Title="输入图片"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="OfflineCtManualInputImagePath" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button
                                    Width="70"
                                    Command="{Binding BrowseOfflineCtManualInputImageCommand}"
                                    Content="浏览"
                                    IsEnabled="{Binding IsEnableSimulationBtn}" />
                            </StackPanel>
                            <StackPanel Margin="10,8,10,0" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Title="输出文件夹"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="留空则输出到输入图片所在目录">
                                    <hc:TextBox.Text>
                                        <Binding Path="OfflineCtManualOutputFolder" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button
                                    Width="70"
                                    Margin="0,0,8,0"
                                    Command="{Binding BrowseOfflineCtManualOutputFolderCommand}"
                                    Content="浏览"
                                    IsEnabled="{Binding IsEnableSimulationBtn}" />
                                <Button
                                    Width="70"
                                    Command="{Binding ClearOfflineCtManualOutputFolderCommand}"
                                    Content="清空"
                                    IsEnabled="{Binding IsEnableSimulationBtn}"
                                    ToolTip="清空输出文件夹，恢复默认（输入图目录）" />
                            </StackPanel>
                            <StackPanel Margin="10,12,10,12" Orientation="Horizontal">
                                <Button
                                    Style="{StaticResource CasPrimaryButtonStyle}"
                                    MinWidth="180"
                                    Command="{Binding RunOfflineCtManualAnnotationCommand}"
                                    Content="开始标注"
                                    IsEnabled="{Binding IsEnableSimulationBtn}"
                                    ToolTip="使用上方模型/CUDA/打黑高度/结果图模式等参数，对指定输入图执行 AI 标注" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVis}}">

                <Border Visibility="{Binding IsNavStepTest, Converter={StaticResource BoolToVis}}" Style="{StaticResource CasWhiteCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="单步测试" Style="{StaticResource CasSectionHeaderStyle}" Margin="0"/>
                                <Border Style="{StaticResource CasParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource CasParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="警告" />
                                            <LineBreak />
                                            <Run Text="本组按钮仅供测试阶段点击，用于单步验证标定与各阶段自动化是否正常。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="生产阶段请勿点击。" />
                                            <LineBreak />
                                            <Run Text="生产请使用页面底部「开始流程」跑完整批处理；误点单测可能干扰正在运行的 VG 界面。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="按钮说明" />
                                            <LineBreak />
                                            <Run Text="• 测试应用渲染预设：仅验证 LUT 预设下拉选择。" />
                                            <LineBreak />
                                            <Run Text="• 测试直方图灰度调整：需已标定 ROI；截图→换纯绿→峰谷→拖红线。" />
                                            <LineBreak />
                                            <Run Text="• 测试厚板设置(三象限)：验证前/右/上厚板菜单与对话框。" />
                                            <LineBreak />
                                            <Run Text="• 测试简单3-2-1对齐：需标定 3D ROI +「上」ROI + 下拉 + 偏移 Edit。" />
                                            <LineBreak />
                                            <Run Text="• 测试对齐后拖拽：需标定 3D图正视图切换按钮位置与拖拽箭头。" />
                                            <LineBreak />
                                            <Run Text="• 测试切片导出(三视图)：验证前/右/上堆栈导出。" />
                                            <LineBreak />
                                            <Run Text="• 测试 AI 图像标注：选手动图或按规则取「上」视图中间图调用 NJCT。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource CasParamHelpIconTextStyle}" />
                            </Border>
                            </StackPanel>
                            <Border
                                Margin="10,10,10,0"
                                Padding="12,10"
                                Background="#14C0392B"
                                BorderBrush="#66C0392B"
                                BorderThickness="1"
                                CornerRadius="10">
                                <TextBlock
                                    Foreground="#C0392B"
                                    FontWeight="SemiBold"
                                    Text="仅测试阶段使用，生产阶段请勿点击。误点可能干扰正在运行的 VG。"
                                    TextWrapping="Wrap" />
                            </Border>
                            <UniformGrid Margin="10,14,0,4" Columns="2">
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestRenderingPresetCommand}"
                                    Content="1  测试应用渲染预设"
                                    IsEnabled="{Binding IsEnableSimulationBtn}" />
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestHistogramGrayScaleCommand}"
                                    Content="2  测试直方图灰度调整"
                                    IsEnabled="{Binding IsEnableSimulationBtn}"
                                    ToolTip="需已标定 ROI：截图→目标色换纯绿→峰谷→拖红线" />
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestThickPlateCommand}"
                                    Content="3  测试厚板设置(三象限)"
                                    IsEnabled="{Binding IsEnableSimulationBtn}" />
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestSimple321AlignmentCommand}"
                                    Content="4  测试简单3-2-1对齐"
                                    IsEnabled="{Binding IsEnableSimulationBtn}"
                                    ToolTip="需已标定 3D ROI +「上」ROI + 简单对齐下拉 + 三点后偏移Edit" />
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestPostAlignCaptureDragCommand}"
                                    Content="5  测试对齐后拖拽"
                                    IsEnabled="{Binding IsEnableSimulationBtn}"
                                    ToolTip="需已标定 3D图正视图切换按钮位置与拖拽箭头；VG 已打开且处于可对齐后视图操作的状态" />
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestSliceExportCommand}"
                                    Content="6  测试切片导出(三视图)"
                                    IsEnabled="{Binding IsEnableSimulationBtn}" />
                                <Button
                                    Style="{StaticResource CasStepTestButtonStyle}"
                                    Command="{Binding TestOfflineCtVisionAnnotationCommand}"
                                    Content="7  测试 AI 图像标注"
                                    IsEnabled="{Binding IsEnableSimulationBtn}"
                                    ToolTip="选手动图，或按切片导出目录取「上」视图中间图后调用 NJCT" />
                            </UniformGrid>

                            <TextBlock
                                Margin="10,18,10,0"
                                FontWeight="SemiBold"
                                Text="上位机窗体大小（仅本项目）" />
                            <TextBlock
                                Margin="10,4,10,0"
                                Foreground="{StaticResource CasMutedTextBrush}"
                                TextWrapping="Wrap"
                                Text="默认全屏。可在此设置窗口宽高，或「保存当前窗体大小」以便下次进入 CT 自动化切片时自动沿用。离开本项目后恢复默认全屏。" />
                            <TextBlock
                                Margin="10,8,10,0"
                                FontFamily="Consolas"
                                FontWeight="SemiBold"
                                Text="{Binding MainWindowSizeDisplayText}"
                                TextWrapping="Wrap" />
                            <StackPanel Margin="10,10,10,0" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="140"
                                    Margin="0,0,8,0"
                                    hc:InfoElement.Title="宽度"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="MainWindowWidth" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="140"
                                    Margin="0,0,8,0"
                                    hc:InfoElement.Title="高度"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="MainWindowHeight" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="120"
                                    Margin="0,0,8,0"
                                    hc:InfoElement.Title="Left"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="MainWindowLeft" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="120"
                                    hc:InfoElement.Title="Top"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="MainWindowTop" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                            <StackPanel Margin="10,10,10,12" Orientation="Horizontal">
                                <CheckBox
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    Content="下次启动沿用"
                                    IsChecked="{Binding MainWindowRememberSize}"
                                    ToolTip="勾选后，下次进入本项目自动应用上方尺寸" />
                                <Button
                                    Style="{StaticResource CasSecondaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    Command="{Binding ApplyMainWindowSizeCommand}"
                                    Content="应用窗体大小"
                                    ToolTip="按上方宽高/位置立即调整主窗（不改全屏默认）" />
                                <Button
                                    Style="{StaticResource CasPrimaryButtonStyle}"
                                    Margin="0,0,8,0"
                                    MinWidth="0"
                                    Command="{Binding SaveCurrentMainWindowSizeCommand}"
                                    Content="保存当前窗体大小"
                                    ToolTip="读取当前主窗实际尺寸并保存，下次进入本项目自动沿用" />
                                <Button
                                    Style="{StaticResource CasSecondaryButtonStyle}"
                                    Command="{Binding RestoreDefaultMainWindowSizeCommand}"
                                    Content="恢复默认全屏"
                                    ToolTip="关闭沿用并立即最大化主窗" />
                            </StackPanel>
                        
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                </Grid>
                </Grid>

                <!-- 流程异常/超时：人工干预醒目面板（覆盖右侧内容区） -->
                <Border Grid.Row="0" Grid.RowSpan="4"
                        Panel.ZIndex="200"
                        Background="#E6B71C1C"
                        Visibility="{Binding IsManualInterventionVisible, Converter={StaticResource BoolToVis}}">
                    <Border Margin="24"
                            Padding="28"
                            Background="#FF1A1A1A"
                            BorderBrush="#FFFF5252"
                            BorderThickness="3"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MinWidth="520"
                            MaxWidth="860">
                        <StackPanel>
                            <TextBlock Text="需要人工处理"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#FFFF5252"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="自动化已暂停。请检查 VG / 现场状态，处理完成后点击下方按钮继续下一文件。"
                                       FontSize="16"
                                       Foreground="#FFFFE082"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>
                            <TextBlock FontSize="15"
                                       Foreground="White"
                                       Margin="0,0,0,6"
                                       Text="{Binding ManualInterventionFileName, StringFormat=失败文件：{0}}"/>
                            <TextBlock FontSize="14"
                                       Foreground="#FFFFCDD2"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"
                                       Text="{Binding ManualInterventionReason}"/>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFAB40"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"
                                       Text="{Binding ManualInterventionCountdownText}"/>
                            <Button Content="处理完成"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Height="52"
                                    MinWidth="220"
                                    HorizontalAlignment="Center"
                                    Background="#FF43A047"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ConfirmManualInterventionCommand}"
                                    ToolTip="确认已完成人工处理：归档失败文件并继续下一文件"/>
                        </StackPanel>
                    </Border>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CasBottomBarStyle}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CasPrimaryButtonStyle}"
                                Content="{Binding PrimaryActionButtonText}"
                                Command="{Binding RunSimulationCommand}"
                                IsEnabled="{Binding IsEnableSimulationBtn}"
                                Margin="12,0,0,0"
                                ToolTip="生产/批量入口：按 CT 体素文件夹排队执行完整自动化流程"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CasSecondaryButtonStyle}"
                                Content="清除日志"
                                Command="{Binding ClearImportLogCommand}"
                                VerticalAlignment="Center"/>
                        <!-- 临时采图：视觉学习 PlanB 兜底用，采完可删 -->
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource CasSecondaryButtonStyle}"
                                Content="截取3D标定图"
                                Command="{Binding CaptureVision3dSampleCommand}"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                ToolTip="临时：最小化本软件后，按已标定 3D ROI 截图，保存到网络目录「…\图片\3D」"/>
                        <Button DockPanel.Dock="Left"
                                Style="{StaticResource CasSecondaryButtonStyle}"
