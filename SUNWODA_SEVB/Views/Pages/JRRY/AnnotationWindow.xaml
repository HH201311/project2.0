<Window
    x:Class="SUNWODA_SEVB.Views.Pages.JRRY.AnnotationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="尺寸标注"
    Width="1200"
    Height="800"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    WindowStyle="ToolWindow">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  操作按钮  -->
        <Border
            Grid.Row="0"
            Padding="10"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#4CAF50"
                    Command="{Binding StartAnnotationCommand}"
                    Content="开始标注"
                    FontSize="15"
                    Foreground="White" />
                <Button
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#2196F3"
                    Command="{Binding EndAnnotationCommand}"
                    Content="结束标注"
                    FontSize="15"
                    Foreground="White" />
                <Button
                    Width="100"
                    Height="35"
                    Margin="0,0,10,0"
                    Background="#FF9800"
                    Command="{Binding ClearAnnotationCommand}"
                    Content="清除绘制"
                    FontSize="15"
                    Foreground="White" />
                <Button
                    Width="100"
                    Height="35"
                    Background="#F44336"
                    Command="{Binding CloseCommand}"
                    Content="关闭"
                    FontSize="15"
                    Foreground="White" />
            </StackPanel>
        </Border>

        <!--  图像 + 标注层  -->
        <Border
            Grid.Row="1"
            Margin="0,10,0,10"
            Background="Black"
            BorderBrush="#DDDDDD"
            BorderThickness="1">
            <Grid x:Name="ImageGrid">
                <Image
                    x:Name="AnnotationImageCtrl"
                    Source="{Binding AnnotationImage}"
                    Stretch="Uniform" />
                <Canvas
                    x:Name="AnnotationCanvas"
                    Width="{Binding ElementName=AnnotationImageCtrl, Path=ActualWidth}"
                    Height="{Binding ElementName=AnnotationImageCtrl, Path=ActualHeight}"
                    Background="Transparent"
                    ClipToBounds="True"
                    Cursor="{Binding AnnotationCursor, Mode=OneWay}"
                    IsHitTestVisible="{Binding IsDrawingMode}"
                    MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown" />
            </Grid>
        </Border>

        <!--  结果显示：已完成线段列表  -->
        <Border
            Grid.Row="2"
            Padding="10"
            Background="White"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            CornerRadius="6">

            <ScrollViewer MaxHeight="80" VerticalScrollBarVisibility="Auto">

                <ItemsControl ItemsSource="{Binding CompletedSegments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontSize="12" Foreground="#333">
                                <Run Text="线段长度: " />
                                <Run Text="{Binding Length, Mode=OneWay, StringFormat=F2}" />
                                <Run Text=" mm" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>

        </Border>

    </Grid>
</Window>