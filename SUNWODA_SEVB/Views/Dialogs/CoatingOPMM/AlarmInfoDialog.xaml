<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CoatingOPMM.AlarmInfoDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.CoatingOPMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="800"
    Background="White"
    CornerRadius="20"
    mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Grid DockPanel.Dock="Right">
                <hc:CircleProgressBar
                    Width="40"
                    Height="40"
                    Margin="0,0,0,10"
                    d:Value="100"
                    ArcThickness="2"
                    Background="Transparent"
                    ShowText="False"
                    Style="{StaticResource ProgressBarSuccessCircle}"
                    Value="{Binding RemainTime}" />
                <Button
                    Width="35"
                    Height="35"
                    Margin="0,0,0,10"
                    hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                    BorderThickness="0"
                    Command="{Binding CloseCommand}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource ButtonIconCircular}" TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#ff5858" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="False">
                                    <Setter Property="Background" Value="#e1e1e1" />
                                    <Setter Property="Foreground" Value="Black" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            <TextBlock
                VerticalAlignment="Center"
                d:Text="严重告警"
                FontSize="{Binding MainFontSize}"
                FontWeight="Bold"
                Foreground="{Binding AlarmLevelColor}"
                Text="{Binding AlarmLevel}" />
        </DockPanel>

        <StackPanel Grid.Row="1">
            <TextBlock
                Margin="0,0,0,30"
                d:Text="L1-A面-膜区1"
                FontSize="{Binding MainFontSize}"
                FontWeight="Bold"
                Text="{Binding AlarmZone}" />
            <TextBlock
                Margin="0,0,0,30"
                d:Text="报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息"
                FontSize="{Binding MainFontSize}"
                Text="{Binding AlarmInfo}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Border>
