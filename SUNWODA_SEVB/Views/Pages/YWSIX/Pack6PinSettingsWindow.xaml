<Window
    x:Class="SUNWODA_SEVB.Views.Pages.YWSIX.Pack6PinSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="参数设置"
    Width="560"
    Height="360"
    MinWidth="480"
    MinHeight="300"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="#FFF5F8FC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="15"
            FontWeight="SemiBold"
            Text="连接器 PIN 歪斜阈值"
            ToolTip="后续其它工艺参数也可放本窗；需侧边栏管理员；运行中可改" />

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="长PIN角度差≤" />
            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4,12,4" Text="{Binding PinLongAngleMax, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,6" VerticalAlignment="Center" Text="长PIN列差≤" />
            <TextBox Grid.Row="0" Grid.Column="3" Margin="0,4,0,4" Text="{Binding PinLongColDiffMax, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="长PIN行差≥" />
            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4,12,4" Text="{Binding PinLongRowDiffMin, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Margin="0,6" VerticalAlignment="Center" Text="长PIN行差≤" />
            <TextBox Grid.Row="1" Grid.Column="3" Margin="0,4,0,4" Text="{Binding PinLongRowDiffMax, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="短PIN行差≤" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4,12,4" Text="{Binding PinShortRowDiffMax, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Margin="0,6" VerticalAlignment="Center" Text="短PIN列差≥" />
            <TextBox Grid.Row="2" Grid.Column="3" Margin="0,4,0,4" Text="{Binding PinShortColDiffMin, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="短PIN列差≤" />
            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4,12,4" Text="{Binding PinShortColDiffMax, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <StackPanel
            Grid.Row="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="100"
                Margin="0,0,8,0"
                Click="OnSaveClick"
                Content="保存"
                FontWeight="SemiBold" />
            <Button
                Width="100"
                Click="OnCloseClick"
                Content="关闭"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
