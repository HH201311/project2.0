<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:core="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.Core;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pjconvert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    Title="CCTBSettingsPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <pjconvert:StringToBooleanConverter x:Key="StringToBooleanConverter" />
            <pjconvert:UMToEnableConverter x:Key="UMToEnableConverter" />
            <pjconvert:UMToReadOnlyConverter x:Key="UMToReadOnlyConverter" />
            <pjconvert:UMToVisibilityConverter x:Key="UMToVisibilityConverter" />
            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Column="0"
            Background="#0DFFFFFF"
            BorderThickness="0"
            CornerRadius="10">
            <StackPanel Orientation="Vertical">
                <RadioButton
                    d:IsChecked="True"
                    Command="{Binding ClosedLoopSettingCommand}"
                    Content="闭环设置"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_ClosedLoopSettingPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}"
                    Visibility="{Binding Source={x:Static core:GlobalContextModel.Instance}, Path=UserRole, Converter={StaticResource UMToVisibilityConverter}, ConverterParameter='RM003'}" />
                <RadioButton
                    d:IsChecked="False"
                    Command="{Binding FunctionSettingCommand}"
                    Content="功能设置"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_FunctionSettingPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}"
                    Visibility="{Binding Source={x:Static core:GlobalContextModel.Instance}, Path=UserRole, Converter={StaticResource UMToVisibilityConverter}, ConverterParameter='RM004,RM005'}" />
                <RadioButton
                    d:IsChecked="False"
                    Command="{Binding AlarmSettingCommand}"
                    Content="报警设置"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_AlarmSettingPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}"
                    Visibility="{Binding Source={x:Static core:GlobalContextModel.Instance}, Path=UserRole, Converter={StaticResource UMToVisibilityConverter}, ConverterParameter='RM006'}" />
                <RadioButton
                    d:IsChecked="False"
                    Command="{Binding CommunicationSettingCommand}"
                    Content="通讯设置"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_CommunicationSettingPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}"
                    Visibility="{Binding Source={x:Static core:GlobalContextModel.Instance}, Path=UserRole, Converter={StaticResource UMToVisibilityConverter}, ConverterParameter='RM007'}" />
                <RadioButton
                    d:IsChecked="False"
                    Command="{Binding PermissionSettingCommand}"
                    Content="权限设置"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_PermissionSettingPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}"
                    Visibility="{Binding Source={x:Static core:GlobalContextModel.Instance}, Path=UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}" />
            </StackPanel>
        </Border>

        <Frame
            Grid.Column="1"
            Margin="20,0,0,0"
            BorderThickness="0"
            Content="{Binding NavigationPage}" />
    </Grid>
</Page>
