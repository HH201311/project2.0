<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JRRY.JRRedundancyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CheckComboBox="clr-namespace:SUNWODA_SEVB.Tool.Helper;assembly=SUNWODA_SEVB.Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JRRY"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CTOL;assembly=SUNWODA_SEVB.Component"
    Title="JRRedundancyPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <!--  主Grid：3行结构（标题行、内容行、版权行）  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.Resources>
            <!--  1. 标题头样式  -->
            <Style x:Key="CellHeader" TargetType="DataGridColumnHeader">
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="LightGray" />
                <Setter Property="BorderBrush" Value="#E5E7EB" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Foreground" Value="#374151" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="5,8" />
            </Style>

            <!--  2. 常规单元格内容样式  -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  ★ 显式行样式（奇偶行、悬停）  -->
            <Style x:Key="ResultGridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="White" />
                <!--  奇数行  -->
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <!--  偶数行背景  -->
                    <Trigger Property="AlternationIndex" Value="1">
                        <Setter Property="Background" Value="#F9FAFB" />
                    </Trigger>
                    <!--  鼠标悬停  -->
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#E3F2FD" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  4. 单元格样式（消除默认选中边框，防干扰）  -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4,2" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                        <Setter Property="Background" Value="#FF82BBD9" />
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style
                x:Key="ResultCellText"
                BasedOn="{StaticResource CellText}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="Green" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DetectionResult}" Value="NG">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DetectionResult}" Value="算法异常">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DetectionResult}" Value="超时">
                        <Setter Property="Foreground" Value="Red" />
                    </DataTrigger>
                    <!--  ★ 选中行触发器，放在最后，优先级最高  -->
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Value="True">
                        <Setter Property="Foreground" Value="White" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </Grid.Resources>

        <!--  顶部标题行  -->
        <Grid Grid.Row="0" Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Margin="10,0"
                    Source="pack://application:,,,/Assets/images/logo1.png" />
                <!--  项目名称文本  -->
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="极耳冗余 AI视觉检测系统V1.0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>

            <!--  检测结果图片显示区  -->
            <Border
                Grid.Column="0"
                BorderBrush="LightGray"
                BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="50,10,0,5"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="检测结果" />

                    <!--  主内容区  -->
                    <Border
                        Grid.Row="1"
                        Background="Black"
                        BorderBrush="LightGray"
                        BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <!--  条码 + 结果  -->
                                <RowDefinition Height="Auto" />
                                <!--  图像  -->
                                <RowDefinition Height="Auto" />
                                <!--  标准 + 检测值  -->
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!--  顶部状态栏：条码 & 检测结果  -->
                            <Border Grid.Row="0" Padding="50,10">
                                <UniformGrid Columns="2">

                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">

                                        <TextBlock
                                            Margin="0,10,5,10"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="Orange"
                                            Text="电芯SN码: " />

                                        <TextBlock
                                            Margin="5,10,60,10"
                                            d:Text="SN123456789"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="Orange"
                                            Text="{Binding CurrentBarcode}" />

                                    </StackPanel>

                                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">

                                        <TextBlock
                                            Margin="60,10,5,10"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="Orange"
                                            Text="检测结果: " />

                                        <TextBlock
                                            Margin="5,10,0,10"
                                            d:Text="OK"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{Binding CurrentDetectionResult}">

                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CurrentDetectionResult}" Value="NG">
                                                            <Setter Property="Foreground" Value="Red" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding CurrentDetectionResult}" Value="OK">
                                                            <Setter Property="Foreground" Value="Green" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>

                                        </TextBlock>

                                    </StackPanel>

                                </UniformGrid>
                            </Border>

                            <!--  图像显示  -->
                            <uc:ImageShowControl
                                Grid.Row="1"
                                MinHeight="406"
                                Margin="5,0"
                                d:Source="D:\Users\2207130097\Desktop\20260723-175413.png"
                                Source="{Binding ResultImage}" />

                            <!--  标准 & 检测值区域  -->
                            <Grid Grid.Row="2" Margin="15,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  第1列：标准（来自 ParametersThresholdRows）  -->
                                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,0">

                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="Orange"
                                            Text="检测标准" />

                                        <ItemsControl d:ItemsSource="{d:SampleData ItemCount=10}" ItemsSource="{Binding ParametersThresholdRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="0,2"
                                                        FontSize="12"
                                                        Foreground="Orange">
                                                        <Run Text="{Binding ParameterName, StringFormat='{}{0}: '}" />
                                                        <Run Text="[" />
                                                        <Run Text="{Binding LowerLimit, StringFormat=F2}" />
                                                        <Run Text=", " />
                                                        <Run Text="{Binding UpperLimit, StringFormat=F2}" />
                                                        <Run Text="]" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </ScrollViewer>

                                <!--  第2列：间距检测结果（动态集合）  -->
                                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="10,0">

                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="14"
                                            FontWeight="Bold"
                                            Foreground="Orange"
                                            Text="间距检测结果" />

                                        <ItemsControl d:ItemsSource="{d:SampleData ItemCount=7}" ItemsSource="{Binding GapResults}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock
                                                        Margin="0,2"
                                                        FontSize="12"
                                                        Foreground="{Binding ValueColor}">
                                                        <Run Foreground="Orange" Text="{Binding Name, StringFormat='{}{0}: '}" />
                                                        <Run Foreground="{Binding ValueColor}" Text="{Binding Value, StringFormat=F2}" />
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </ScrollViewer>

                                <!--  第3列：开叉检测结果（左右分列，也可以动态）  -->
                                <Grid Grid.Column="2" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.ColumnSpan="2"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="Orange"
                                        Text="开叉检测结果" />

                                    <!--  左侧开叉  -->
                                    <ScrollViewer
                                        Grid.Column="0"
                                        Margin="0,25,0,0"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel>

                                            <TextBlock
                                                Margin="0,0,0,10"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="Orange"
                                                Text="左侧" />

                                            <ItemsControl d:ItemsSource="{d:SampleData ItemCount=7}" ItemsSource="{Binding LeftForkResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Margin="0,2"
                                                            FontSize="12"
                                                            Foreground="{Binding ValueColor}">
                                                            <Run Foreground="Orange" Text="{Binding Name, StringFormat='{}{0}: '}" />
                                                            <Run Foreground="{Binding ValueColor}" Text="{Binding Value, StringFormat=F2}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </ScrollViewer>

                                    <!--  右侧开叉  -->
                                    <ScrollViewer
                                        Grid.Column="1"
                                        Margin="0,25,0,0"
                                        VerticalScrollBarVisibility="Auto">
                                        <StackPanel>

                                            <TextBlock
                                                Margin="0,0,0,10"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Foreground="Orange"
                                                Text="右侧" />

                                            <ItemsControl d:ItemsSource="{d:SampleData ItemCount=7}" ItemsSource="{Binding RightForkResults}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            Margin="0,2"
                                                            FontSize="12"
                                                            Foreground="{Binding ValueColor}">
                                                            <Run Foreground="Orange" Text="{Binding Name, StringFormat='{}{0}: '}" />
                                                            <Run Foreground="{Binding ValueColor}" Text="{Binding Value, StringFormat=F2}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </ScrollViewer>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>
            </Border>

            <!--  状态信息统计区  -->
            <Border
                Grid.Column="1"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1">

                <Grid>
                    <Grid.RowDefinitions>
                        <!--  标题  -->
                        <RowDefinition Height="Auto" />
                        <!--  上部：当前统计+饼图  -->
                        <RowDefinition Height="Auto" />
                        <!--  中部：缺陷列表 (自适应撑开)  -->
                        <RowDefinition Height="*" />
                        <!--  下部：历史统计  -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  1. 顶部标题  -->
                    <TextBlock
                        Grid.Row="0"
                        Margin="0,10,0,10"
                        HorizontalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Text="状态信息" />

                    <!--  2. 上部区域：当前统计表格 + 饼图  -->
                    <Grid
                        x:Name="StatusInfo"
                        Grid.Row="1"
                        Margin="5,0,5,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Width="120"
                            Height="150"
                            Background="White"
                            BorderBrush="LightGray"
                            BorderThickness="1">
                            <Grid Background="LightGray">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1.2*" />
                                </Grid.ColumnDefinitions>

                                <!--  模板样式  -->
                                <Grid.Resources>
                                    <Style x:Key="CellBorder" TargetType="Border">
                                        <Setter Property="Background" Value="White" />
                                        <Setter Property="Margin" Value="1" />
                                    </Style>
                                    <Style x:Key="CellText" TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="FontFamily" Value="Microsoft YaHei" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </Style>
                                </Grid.Resources>

                                <!--  第1行  -->
                                <Border
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        Foreground="#666666"
                                        Style="{StaticResource CellText}"
                                        Text="总计" />
                                </Border>

                                <Border
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        d:Text="100"
                                        Foreground="Black"
                                        Style="{StaticResource CellText}"
                                        Text="{Binding TotalCount}" />
                                </Border>

                                <!--  第2行  -->
                                <Border
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        Foreground="#4ade80"
                                        Style="{StaticResource CellText}"
                                        Text="OK" />
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        d:Text="99"
                                        Foreground="#4ade80"
                                        Style="{StaticResource CellText}"
                                        Text="{Binding OkCount}" />
                                </Border>

                                <!--  第3行  -->
                                <Border
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        Foreground="#ef4444"
                                        Style="{StaticResource CellText}"
                                        Text="NG" />
                                </Border>

                                <Border
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        d:Text="1"
                                        Foreground="#ef4444"
                                        Style="{StaticResource CellText}"
                                        Text="{Binding NgCount}" />
                                </Border>

                                <!--  第4行  -->
                                <Border
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        Foreground="#666666"
                                        Style="{StaticResource CellText}"
                                        Text="良率" />
                                </Border>

                                <Border
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Style="{StaticResource CellBorder}">
                                    <TextBlock
                                        d:Text="99.00%"
                                        Foreground="Black"
                                        Style="{StaticResource CellText}"
                                        Text="{Binding YieldRate, StringFormat={}{0:P2}}" />
                                </Border>

                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="Transparent">

                            <uc:PiePlotViewer
                                Labels="{Binding DetectionSattisticalLabel}"
                                LabelsColor="{Binding DetectionStatisticalLabelColor}"
                                Values="{Binding DetectionSattisticalData}" />

                        </Border>

                    </Grid>

                    <!--  3. 中部区域：缺陷列表  -->
                    <Grid Grid.Row="2">

                        <!--  圆角卡片容器  -->
                        <Border
                            Margin="0,0,0,5"
                            Padding="0,8,0,0"
                            Background="White"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="8">

                            <DataGrid
                                Height="Auto"
                                d:ItemsSource="{d:SampleData ItemCount=7}"
                                AlternationCount="2"
                                AutoGenerateColumns="False"
                                Background="Transparent"
                                BorderThickness="0"
                                CanUserAddRows="False"
                                CanUserReorderColumns="False"
                                CanUserSortColumns="False"
                                ColumnHeaderStyle="{StaticResource CellHeader}"
                                GridLinesVisibility="None"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                ItemsSource="{Binding DefectDataList}"
                                RowStyle="{StaticResource ResultGridRowStyle}"
                                SelectionMode="Single"
                                SelectionUnit="FullRow">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="1.5*"
                                        Binding="{Binding DefectType}"
                                        ElementStyle="{StaticResource CellText}"
                                        Header="缺陷类型" />
                                    <DataGridTextColumn
                                        Width="0.8*"
                                        Binding="{Binding Count}"
                                        ElementStyle="{StaticResource CellText}"
                                        Header="数量" />
                                    <DataGridTextColumn
                                        Width="1*"
                                        Binding="{Binding Ratio, StringFormat={}{0:P2}}"
                                        ElementStyle="{StaticResource CellText}"
                                        Header="占比" />
                                </DataGrid.Columns>
                            </DataGrid>

                        </Border>

                    </Grid>

                    <!--  4. 底部区域：历史统计面板  -->
                    <Border
                        Grid.Row="3"
                        BorderBrush="LightGray"
                        BorderThickness="0.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <Button
                                    Width="300"
                                    Margin="5"
                                    Padding="15,5"
                                    HorizontalAlignment="Center"
                                    Background="OrangeRed"
                                    Command="{Binding ClearDetectionInfoCommand}"
                                    FontWeight="Bold"
                                    Foreground="Black"
                                    IsEnabled="{Binding CanEdit}">

                                    <!--  将 Content 替换为 StackPanel，实现 图标+文字 组合  -->
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                        <!--  信号+垃圾桶 矢量图标  -->
                                        <Viewbox
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Stretch="Uniform">
                                            <Canvas Width="100" Height="100">
                                                <!--  1. 顶部信号线（圆角端点）  -->
                                                <Path
                                                    Data="M 26,24 L 16,14 M 50,18 L 50,8 M 74,24 L 84,14"
                                                    Stroke="Black"
                                                    StrokeEndLineCap="Round"
                                                    StrokeStartLineCap="Round"
                                                    StrokeThickness="6" />
                                                <!--  2. 外部圆环  -->
                                                <Ellipse
                                                    Canvas.Left="14"
                                                    Canvas.Top="16"
                                                    Width="72"
                                                    Height="72"
                                                    Fill="OrangeRed"
                                                    Stroke="Black"
                                                    StrokeThickness="5" />
                                                <!--  3. 垃圾桶提手  -->
                                                <Rectangle
                                                    Canvas.Left="44"
                                                    Canvas.Top="24"
                                                    Width="12"
                                                    Height="6"
                                                    Fill="White"
                                                    Stroke="Black"
                                                    StrokeThickness="4" />
                                                <!--  4. 垃圾桶盖子  -->
                                                <Rectangle
                                                    Canvas.Left="32"
                                                    Canvas.Top="30"
                                                    Width="36"
                                                    Height="8"
                                                    Fill="White"
                                                    Stroke="Black"
                                                    StrokeThickness="4" />
                                                <!--  5. 垃圾桶桶身  -->
                                                <Path
                                                    Data="M 31,38 L 69,38 L 67,70 L 33,70 Z"
                                                    Fill="OrangeRed"
                                                    Stroke="Black"
                                                    StrokeThickness="4" />
                                                <!--  6. 桶内 3 条竖向垃圾条纹（平角端点）  -->
                                                <Path
                                                    Data="M 43,46 L 43,64 M 50,46 L 50,64 M 57,46 L 57,64"
                                                    Stroke="Black"
                                                    StrokeEndLineCap="Flat"
                                                    StrokeStartLineCap="Flat"
                                                    StrokeThickness="4" />
                                            </Canvas>
                                        </Viewbox>

                                        <!--  按钮文字  -->
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="Black"
                                            Text="统 计 清 零" />

                                    </StackPanel>

                                </Button>

                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <TextBlock
                                    Margin="5"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="清零时间" />
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    d:Text="12:00:00"
                                    FontWeight="SemiBold"
                                    Text="{Binding ClearTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />

                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="历史总检测数" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="100"
                                        FontWeight="SemiBold"
                                        Text="{Binding TotalDetectionNum}" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="历史OK数" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="95"
                                        FontWeight="SemiBold"
                                        Text="{Binding OKDetectionNum}" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.Column="0"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <StackPanel VerticalAlignment="Center">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="NG数" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="5"
                                        FontWeight="SemiBold"
                                        Text="{Binding NGDetectionNum}" />

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.Column="1"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="SemiBold"
                                        Text="一次优率" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="95%"
                                        FontWeight="SemiBold"
                                        Text="{Binding OKRate, StringFormat={}{0:F1}%}" />

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <!--  功能项区  -->
            <Border
                Grid.Column="2"
                BorderBrush="LightGray"
                BorderThickness="1">
                <TabControl>

                    <!--  第一页：数据监测页  -->
                    <TabItem
                        d:IsSelected="True"
                        FontSize="20"
                        Header="监测数据">

                        <Grid>

                            <!--  圆角卡片容器  -->
                            <Border
                                Margin="0,0,0,5"
                                Padding="0,8,0,0"
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8">

                                <DataGrid
                                    Height="Auto"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    d:ItemsSource="{d:SampleData ItemCount=17}"
                                    AlternationCount="2"
                                    AutoGenerateColumns="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CanUserAddRows="False"
                                    CanUserResizeColumns="True"
                                    CanUserSortColumns="False"
                                    ColumnHeaderStyle="{StaticResource CellHeader}"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding TestResultList}"
                                    RowHeaderWidth="0"
                                    RowStyle="{StaticResource ResultGridRowStyle}"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1.6*"
                                            MinWidth="100"
                                            Binding="{Binding Barcode}"
                                            ElementStyle="{StaticResource CellText}"
                                            Header="条码" />

                                        <DataGridTextColumn
                                            Width="1.5*"
                                            MinWidth="80"
                                            Binding="{Binding DefectType}"
                                            ElementStyle="{StaticResource CellText}"
                                            Header="缺陷类型" />

                                        <DataGridTextColumn
                                            Width="0.8*"
                                            MinWidth="80"
                                            Binding="{Binding DetectionResult}"
                                            ElementStyle="{StaticResource ResultCellText}"
                                            Header="检测结果" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!--  第二页：数据检索页  -->
                    <TabItem FontSize="20" Header="数据检索">

                        <DockPanel Margin="5,10">
                            <hc:DateTimePicker
                                Margin="0,5"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                hc:InfoElement.Placeholder="请输入开始时间"
                                hc:InfoElement.Title="开始时间："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                SelectedDateTime="{Binding StartDate}"
                                Style="{StaticResource DateTimePickerPlus}" />

                            <hc:DateTimePicker
                                Margin="0,5"
                                hc:InfoElement.Placeholder="请输入结束时间"
                                hc:InfoElement.Title="结束时间："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                SelectedDateTime="{Binding EndDate}"
                                Style="{StaticResource DateTimePickerPlus}" />

                            <hc:CheckComboBox
                                Margin="0,5"
                                CheckComboBox:CheckComboBoxHelper.SelectedItems="{Binding DefectSelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                hc:InfoElement.Placeholder="请选择类型"
                                hc:InfoElement.Title="类型筛选："
                                DisplayMemberPath="DefectType"
                                DockPanel.Dock="Top"
                                FontSize="15"
                                ItemsSource="{Binding DefectDataList}"
                                SelectedValuePath="DefectType"
                                ShowSelectAllButton="True"
                                Style="{StaticResource CheckComboBoxExtend}" />

                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,5"
                                Background="#5DADE2"
                                BorderThickness="0"
                                Command="{Binding QueryCommand}"
                                Content="查询"
                                DockPanel.Dock="Top"
                                Foreground="White" />

                            <hc:TextBox
                                Margin="0,5"
                                hc:InfoElement.Placeholder="这是筛选后检索出来的总数量"
                                hc:InfoElement.Title="总数量："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                IsReadOnly="True"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding TotalCount, Mode=OneWay}" />

                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,5"
                                Background="#5DADE2"
                                BorderThickness="0"
                                Command="{Binding ExportCommand}"
                                Content="导出文件"
                                DockPanel.Dock="Top"
                                Foreground="White" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  数据表格  -->
                                <DataGrid
                                    x:Name="cxDetection"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    d:ItemsSource="{d:SampleData ItemCount=7}"
                                    AlternationCount="2"
                                    AutoGenerateColumns="False"
                                    Background="Transparent"
                                    CanUserAddRows="False"
                                    CanUserSortColumns="False"
                                    ColumnHeaderStyle="{StaticResource CellHeader}"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding ShowResults}"
                                    RowHeaderWidth="0"
                                    RowStyle="{StaticResource ResultGridRowStyle}"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow">

                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1.1*"
                                            MinWidth="125"
                                            Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            ElementStyle="{StaticResource CellText}"
                                            Header="时间" />

                                        <DataGridTextColumn
                                            Width="1*"
                                            MinWidth="125"
                                            Binding="{Binding Barcode}"
                                            ElementStyle="{StaticResource CellText}"
                                            Header="电芯条码" />

                                        <DataGridTextColumn
                                            Width="1*"
                                            MinWidth="80"
                                            Binding="{Binding DefectType}"
                                            ElementStyle="{StaticResource CellText}"
                                            Header="缺陷类型" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!--  底部：分页控件  -->
                                <hc:Pagination
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    IsJumpEnabled="True"
                                    MaxPageCount="{Binding MaxPageCount}"
                                    PageIndex="{Binding PageIndex}">

                                    <hc:Interaction.Triggers>
                                        <hc:EventTrigger EventName="PageUpdated">
                                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                                        </hc:EventTrigger>
                                    </hc:Interaction.Triggers>

                                </hc:Pagination>
                            </Grid>

                        </DockPanel>

                    </TabItem>

                    <!--  第三页：参数设置页  -->
                    <TabItem FontSize="20" Header="参数设置">

                        <Grid Margin="0,10">
                            <Grid.RowDefinitions>
                                <!--  第1行：监控图片路径  -->
                                <RowDefinition Height="Auto" />
                                <!--  第2行：参数规格设置  -->
                                <RowDefinition Height="*" />
                                <!--  第3行：操作按钮  -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  监控路径 + 运行按钮  -->
                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  第一行：状态指示 + 启停按钮  -->
                                    <DockPanel
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        LastChildFill="False">

                                        <TextBlock
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Left"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="#1A1A2E"
                                            Text="路径" />

                                        <!--  启停按钮  -->
                                        <ToggleButton
                                            Width="52"
                                            Height="30"
                                            Padding="0"
                                            hc:VisualElement.HighlightBrush="#2ECC71"
                                            Command="{Binding ToggleCommand}"
                                            DockPanel.Dock="Right"
                                            Style="{StaticResource ToggleButtonSwitch.Small}" />

                                        <!--  状态指示器  -->
                                        <StackPanel
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center"
                                            DockPanel.Dock="Right"
                                            Orientation="Horizontal">
                                            <Ellipse
                                                Width="9"
                                                Height="9"
                                                Margin="0,0,5,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="#95A5A6" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                <Setter Property="Fill" Value="#2ECC71" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock
                                                VerticalAlignment="Center"
                                                d:Text="未运行"
                                                FontSize="12"
                                                Foreground="#666666"
                                                Text="{Binding StatusText}" />
                                        </StackPanel>
                                    </DockPanel>

                                    <!--  第二行：监听路径  -->
                                    <Grid Grid.Row="1" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#888"
                                            Text="监听路径" />

                                        <TextBox
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            FontSize="15"
                                            IsEnabled="{Binding CanEdit}"
                                            Text="{Binding RemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <Button
                                            Grid.Column="2"
                                            Width="52"
                                            Height="28"
                                            Background="#5DADE2"
                                            BorderThickness="0"
                                            Command="{Binding BrowseRemotePathCommand}"
                                            Content="浏览"
                                            IsEnabled="{Binding CanEdit}" />
                                    </Grid>

                                    <!--  第三行：输出路径  -->
                                    <Grid Grid.Row="2" Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <!--<ColumnDefinition Width="60" />-->
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#888"
                                            Text="输出路径" />

                                        <TextBox
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            FontSize="15"
                                            IsEnabled="False"
                                            Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                        <!--<Button
                                            Grid.Column="2"
                                            Width="52"
                                            Height="28"
                                            Background="#5DADE2"
                                            BorderThickness="0"
                                            Command="{Binding BrowseOutputDirectoryCommand}"
                                            Content="浏览"
                                            IsEnabled="False" />-->
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--  参数规格  -->
                            <Border
                                Grid.Row="1"
                                Margin="0,0,0,5"
                                Padding="0,5,0,0"
                                Background="White"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1"
                                CornerRadius="8">

                                <DataGrid
                                    IsEnabled="{Binding CanEdit}"
                                    x:Name="DgParameters"
                                    d:ItemsSource="{d:SampleData ItemCount=7}"
                                    hc:DataGridAttach.ShowRowNumber="False"
                                    hc:DataGridAttach.ShowSelectAllButton="False"
                                    AlternatingRowBackground="#F9FAFB"
                                    AlternationCount="2"
                                    AutoGenerateColumns="False"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    CanUserReorderColumns="False"
                                    CanUserSortColumns="False"
                                    ColumnHeaderStyle="{StaticResource CellHeader}"
                                    FontSize="13"
                                    GridLinesVisibility="None"
                                    HeadersVisibility="Column"
                                    ItemsSource="{Binding ParametersThresholdRows}"
                                    RowHeaderWidth="0"
                                    RowStyle="{StaticResource ResultGridRowStyle}"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow">

                                    <DataGrid.Columns>
                                        <!--  第1列：参数标准  -->
                                        <DataGridTemplateColumn Width="1.8*" Header="参数标准">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource CellText}" Text="{Binding ParameterName}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        Text="{Binding ParameterName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>


                                        <!--  第2列：上限  -->
                                        <DataGridTemplateColumn Width="1.1*" Header="上限">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource CellText}" Text="{Binding UpperLimit, StringFormat=F2}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox
                                                        Padding="5,2"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        Text="{Binding UpperLimit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>

                                        <!--  第3列：下限  -->
                                        <DataGridTemplateColumn Width="1.1*" Header="下限">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Style="{StaticResource CellText}" Text="{Binding LowerLimit, StringFormat=F2}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <TextBox
                                                        Padding="5,2"
                                                        HorizontalContentAlignment="Center"
                                                        VerticalContentAlignment="Center"
                                                        BorderBrush="#E5E7EB"
                                                        BorderThickness="1"
                                                        Text="{Binding LowerLimit, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Border>

                            <hc:UniformSpacingPanel
                                x:Name="saveAndresetBtnPanel"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Button
                                    Height="35"
                                    Margin="10"
                                    Background="#2196F3"
                                    BorderThickness="0"
                                    Command="{Binding AddParameterCommand}"
                                    Content="增加参数"
                                    FontSize="16"
                                    Foreground="White"
                                    IsEnabled="{Binding CanEdit}" />

                                <Button
                                    Height="35"
                                    Margin="10"
                                    Background="#FF9800"
                                    BorderThickness="0"
                                    Command="{Binding DeleteParameterCommand}"
                                    CommandParameter="{Binding ElementName=DgParameters, Path=SelectedItem}"
                                    Content="删除选中"
                                    FontSize="16"
                                    Foreground="White"
                                    IsEnabled="{Binding CanEdit}" />

                                <Button
                                    x:Name="saveParameterBtn"
                                    Height="35"
                                    Margin="10"
                                    Background="#4CAF50"
                                    BorderThickness="0"
                                    Command="{Binding SaveSettingsCommand}"
                                    Content="保存设置"
                                    FontSize="16"
                                    Foreground="White"
                                    IsEnabled="{Binding CanEdit}" />

                            </hc:UniformSpacingPanel>

                        </Grid>

                    </TabItem>

                    <!--  第四页：尺寸标注页  -->
                    <TabItem FontSize="20" Header="尺寸标注">

                        <!--  外部容器，限制最小高度防止排版挤压  -->
                        <Grid MinHeight="450" Margin="0,10">
                            <Grid.RowDefinitions>
                                <!--  第1行：配置路径  -->
                                <RowDefinition Height="Auto" />
                                <!--  第2行：操作按钮  -->
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  ============ 第1行：路径配置 ============  -->
                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="6">

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  标题  -->
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,10"
                                        FontSize="15"
                                        FontWeight="Bold"
                                        Foreground="#1A1A2E"
                                        Text="路径" />

                                    <!--  路径1：标注图片路径  -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#666"
                                            Text="标注图片路径" />

                                        <TextBox
                                            Grid.Column="1"
                                            Margin="10,0,6,0"
                                            Padding="4"
                                            VerticalContentAlignment="Center"
                                            FontSize="14"
                                            IsEnabled="{Binding CanEdit}"
                                            Text="{Binding AnnotationImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                    </Grid>

                                </Grid>
                            </Border>

                            <!--  ============ 第2行：操作按钮 ============  -->
                            <Border
                                Grid.Row="1"
                                Margin="0,0,0,12"
                                Padding="12"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="6">

                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        Width="100"
                                        Height="35"
                                        Margin="0,0,10,0"
                                        Background="#4CAF50"
                                        BorderThickness="0"
                                        Command="{Binding StartAnnotationCommand}"
                                        Content="开始标注"
                                        FontSize="15"
                                        Foreground="White"
                                        IsEnabled="{Binding CanEdit}" />
                                    <Button
                                        Width="100"
                                        Height="35"
                                        Margin="0,0,10,0"
                                        Background="#5DADE2"
                                        BorderThickness="0"
                                        Command="{Binding LoadImageCommand}"
                                        Content="加载图片"
                                        FontSize="15"
                                        Foreground="White"
                                        IsEnabled="{Binding CanEdit}" />
                                </StackPanel>

                            </Border>

                        </Grid>

                    </TabItem>

                </TabControl>

            </Border>

        </Grid>

        <!--  底部版权信息  -->
        <Border
            Grid.Row="2"
            BorderBrush="LightGray"
            BorderThickness="1">
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                FontSize="15"
                Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />
        </Border>

    </Grid>

</Page>
