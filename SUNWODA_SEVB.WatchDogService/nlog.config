<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="true"
      internalLogLevel="Debug"
      internalLogFile="${basedir}/logs/nlog-internal.log">

	<!-- 定义变量 -->
	<variable name="logDirectory" value="${basedir}/../logs"/>
	<variable name="standardLayout" value="${longdate} | ${level:uppercase=true:padding=5} | ${logger}.${callsite:className=false:methodName=true:fileName=true:includeSourcePath=false} | ${message} ${exception:format=tostring}" />
	<variable name="specialLayout" value="${longdate} | ${level:uppercase=true:padding=5} | ${logger}.${callsite:className=false:methodName=true:fileName=true:includeSourcePath=false} | ${message} | ${exception:format=tostring} | ${stacktrace}" />
	<variable name="simpleLayout" value="${longdate} | ${level:uppercase=true:padding=5} | ${logger} | ${message} ${exception:format=tostring}" />

	<!-- 从appsettings.json读取连接字符串 -->
	<variable name="dbConnection" value="${configsetting:item=ConnectionStrings.DefaultConnection}" />

	<!-- 注册自定义目标 -->
	<extensions>
		<add assembly="SUNWODA_SEVB.Logging" />
	</extensions>

	<!-- 定义目标 -->
	<targets>
		<!-- 普通文件目标 - 同步写入 -->
		<target xsi:type="File"
				name="logfile"
				fileName="${logDirectory}/${shortdate}/${date:format=yyyy-MM-dd-HH}.txt"
				layout="${standardLayout}"
				encoding="utf-8"
				createDirs="true"
				keepFileOpen="true"
				autoFlush="true"
				openFileCacheTimeout="30">
		</target>

		<!-- 控制台输出（用于调试） -->
		<target xsi:type="Console"
				name="console"
				layout="${simpleLayout}" />

		<!-- 调试输出窗口 -->
		<target xsi:type="Debugger"
				name="debugger"
				layout="${simpleLayout}" />

		<!-- 定义实际的特殊日志文件目标 - 同步写入 -->
		<target xsi:type="File"
				name="actualSpecialFile"
				fileName="${logDirectory}/${shortdate}/special-${date:format=yyyy-MM-dd}.txt"
				layout="${specialLayout}"
				encoding="utf-8"
				createDirs="true"
				keepFileOpen="true"
				autoFlush="true"
				openFileCacheTimeout="30">
		</target>

		<!-- 特殊日志过滤器 - 修复条件表达式 -->
		<target xsi:type="FilteringWrapper"
				name="specialfile"
				condition="contains('${event-properties:item=LogToSpecialFile}', 'true')">
			<target-ref name="actualSpecialFile" />
		</target>

		<!-- 数据库目标的过滤包装器 - 只有 IsToDatabase=true 的日志才写入 -->
		<target xsi:type="FilteringWrapper"
				name="database_app_filtered"
				condition="'${event-properties:item=IsToDatabase}' == 'True'">
			<target xsi:type="DatabaseLog"
					name="database_app"
					connectionString="${dbConnection}"
					logType="AppLog" />
		</target>

		<!-- 异步包装数据库目标 -->
		<target xsi:type="AsyncWrapper"
				name="database_app_async"
				queueLimit="5000"
				timeToSleepBetweenBatches="50"
				batchSize="100"
				overflowAction="Discard">
			<target-ref name="database_app_filtered" />
		</target>

		<!-- 数据库日志目标 - MES接口日志 -->
		<target xsi:type="AsyncWrapper"
				name="database_mes_async"
				queueLimit="5000"
				timeToSleepBetweenBatches="50"
				batchSize="100"
				overflowAction="Discard">
			<target xsi:type="DatabaseLog"
					name="database_mes"
					connectionString="${dbConnection}"
					logType="MesInterfaceLog" />
		</target>

		<!-- 数据库日志目标 - Web接口日志 -->
		<target xsi:type="AsyncWrapper"
				name="database_web_async"
				queueLimit="5000"
				timeToSleepBetweenBatches="50"
				batchSize="100"
				overflowAction="Discard">
			<target xsi:type="DatabaseLog"
					name="database_web"
					connectionString="${dbConnection}"
					logType="WebInterfaceLog" />
		</target>
	</targets>

	<!-- 定义规则 -->
	<rules>
		<!-- 调试输出（开发环境） -->
		<logger name="*" minlevel="Debug" writeTo="console,debugger" />

		<!-- 所有日志写入普通日志文件 -->
		<logger name="*" minlevel="Trace" writeTo="logfile" />

		<!-- 特殊日志 -->
		<logger name="*" minlevel="Trace" writeTo="specialfile" />

		<!-- 应用日志写入数据库（排除MES和Web日志，且只有 IsToDatabase=true 的才写入） -->
		<logger name="*" minlevel="Info" writeTo="database_app_async">
			<filters defaultAction="Log">
				<when condition="starts-with('${logger}','MesInterface')" action="Ignore" />
				<when condition="starts-with('${logger}','WebInterface')" action="Ignore" />
				<when condition="starts-with('${logger}','Microsoft')" action="Ignore" />
				<when condition="starts-with('${logger}','System')" action="Ignore" />
			</filters>
		</logger>

		<!-- MES接口日志写入数据库 -->
		<logger name="MesInterface.*" minlevel="Info" writeTo="database_mes_async" final="true" />

		<!-- Web接口日志写入数据库 -->
		<logger name="WebInterface.*" minlevel="Info" writeTo="database_web_async" final="true" />
	</rules>
</nlog>