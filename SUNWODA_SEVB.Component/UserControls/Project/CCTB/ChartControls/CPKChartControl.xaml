<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls.CPKChartControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBChartControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  图表标签文本样式  -->
            <Style x:Key="ChartLabelContentControlStyle" TargetType="ContentControl">
                <Setter Property="Margin" Value="10,0,10,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Line
                                    Grid.Column="0"
                                    Margin="10,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stroke="{TemplateBinding Foreground}"
                                    StrokeThickness="1"
                                    X1="0"
                                    X2="10"
                                    Y1="0"
                                    Y2="0" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  CPK虚线样式  -->
            <Style x:Key="SubLineStyle" TargetType="Line">
                <Setter Property="Stroke" Value="#FF29CC7A" />
                <Setter Property="StrokeDashArray" Value="5,5" />
            </Style>

            <!--  CPK折线样式  -->
            <Style x:Key="LinePathStyle" TargetType="Path">
                <Setter Property="StrokeThickness" Value="3" />
            </Style>

            <!--  CPK点样式  -->
            <Style x:Key="PointsEllipseStyle" TargetType="Ellipse">
                <Setter Property="Width" Value="5" />
                <Setter Property="Height" Value="5" />
                <Setter Property="Margin" Value="-2.5,-2.5,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Fill" Value="#FF121212" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Opacity" Value="1" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="0,-20,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <ContentControl
                Content="闭环"
                Foreground="#FF29CC7A"
                Style="{StaticResource ChartLabelContentControlStyle}" />
            <ContentControl
                Content="人工"
                Foreground="#CCFFFFFF"
                Style="{StaticResource ChartLabelContentControlStyle}" />
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" MinHeight="20" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="30" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  X轴渲染器  -->
            <local:AxisRenderer
                x:Name="XAxisPainter"
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,10,0,0"
                AxisLabel="趟号"
                AxisType="X"
                Opacity="0.5" />
            <!--  Y轴渲染器  -->
            <local:AxisRenderer
                x:Name="YAxisPainter"
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,10,0"
                AxisLabel="CPK"
                AxisType="Y"
                Opacity="0.5" />

            <!--  图表区域  -->
            <Grid Grid.Row="0" Grid.Column="1">
                <!--  XY坐标轴线  -->
                <Border
                    BorderBrush="#CCFFFFFF"
                    BorderThickness="1,0,0,1"
                    Opacity="0.5" />
                <!--  绘图区域  -->
                <Grid
                    x:Name="ChartGrid"
                    ClipToBounds="True"
                    SizeChanged="ChartGrid_SizeChanged" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
