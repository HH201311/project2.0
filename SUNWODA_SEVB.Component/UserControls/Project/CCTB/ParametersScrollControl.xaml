<UserControl x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ParametersScrollControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
             xmlns:uccharts="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls"
             xmlns:modelcctb="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ChartToolTipStyle" TargetType="ToolTip">
                <Setter Property="Width" Value="500"/>
                <Setter Property="Height" Value="220"/>
                <Setter Property="Margin" Value="0,0,20,0"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Placement" Value="Left"/>
                <Setter Property="HorizontalOffset" Value="0"/>
                <Setter Property="VerticalOffset" Value="-100"/>
                <Setter Property="Background" Value="#FF121212"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Grid Margin="{TemplateBinding Margin}" Background="Transparent">
                                <!--边框&背景虚化效果-->
                                <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <Border Opacity="1" Background="#1AFFFFFF">
                                        <Border.Effect>
                                            <BlurEffect Radius="50" KernelType="Gaussian" RenderingBias="Quality"/>
                                        </Border.Effect>
                                    </Border>
                                </Border>
                                <!--箭头&箭头的虚化背景效果-->
                                <Grid Width="20" Height="20" Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-18,0">
                                    <Path Data="M 0,0 L 20,10 L 0,20" Fill="{TemplateBinding Background}" Stroke="#1AFFFFFF" StrokeThickness="1">
                                        <Path.Effect>
                                            <BlurEffect Radius="5" KernelType="Gaussian" RenderingBias="Quality"/>
                                        </Path.Effect>
                                    </Path>
                                </Grid>
                                <!--内容-->
                                <ContentPresenter Margin="10,20,20,10"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--键值对样式-->
            <Style x:Key="ParameterPairContentControlStyle" TargetType="ContentControl">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.2*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding PName}" d:Text="ParamName"
                                           Margin="0,0,0,0" Foreground="#99FFFFFF" FontSize="{TemplateBinding FontSize}" FontWeight="Medium"
                                           FontFamily="{TemplateBinding FontFamily}" TextAlignment="Left"
                                           HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource ChartToolTipStyle}">
                                            <uccharts:MicroChartControl Title="{Binding PName}" ItemSource="{Binding PValues}"/>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding PValue}" d:Text="0.00"
                                           Margin="0,0,0,0" Foreground="#CCFFFFFF" FontSize="{TemplateBinding FontSize}" FontWeight="Bold"
                                           FontFamily="{TemplateBinding FontFamily}" TextAlignment="Left"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--ScrollViewer垂直滚动条滑块样式-->
            <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
                <Setter Property="Background" Value="#61FFFFFF"/>
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Thumb}">
                            <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--ScrollViewer垂直滚动条样式-->
            <Style x:Key="ModernScrollBar" TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <Setter Property="Width" Value="6"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="GridRoot" Width="{TemplateBinding Width}" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="true" Focusable="false">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ModernScrollThumb}"/>
                                    </Track.Thumb>
                                    <!-- 隐藏上下箭头按钮 (Increase/DecreaseRepeatButton) -->
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="false"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="false"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ScrollViewer样式 -->
            <Style x:Key="ModernScrollViewer" TargetType="{x:Type ScrollViewer}">
                <Setter Property="Margin" Value="10,25,10,25"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                            <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" 
                                                    CanContentScroll="{TemplateBinding CanContentScroll}" 
                                                    Grid.Column="0" Grid.Row="0" Margin="{TemplateBinding Padding}" 
                                                    Grid.RowSpan="2" Grid.ColumnSpan="2"/>
                                <!-- 垂直滚动条 -->
                                <ScrollBar x:Name="PART_VerticalScrollBar" 
                                       Style="{StaticResource ModernScrollBar}" 
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" 
                                       Grid.Column="1" Grid.Row="0" 
                                       ViewportSize="{TemplateBinding ViewportHeight}" 
                                       Maximum="{TemplateBinding ScrollableHeight}" 
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <GroupBox x:Name="PPairsGroupBox" Margin="0,0,0,0" Style="{StaticResource SimpleGroupBoxStyle}">
            <ScrollViewer Style="{StaticResource ModernScrollViewer}" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PPairsItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Margin="50,0,30,20" Content="{Binding}" Style="{StaticResource ParameterPairContentControlStyle}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
