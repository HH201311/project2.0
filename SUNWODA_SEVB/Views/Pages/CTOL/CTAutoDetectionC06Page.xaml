<Page x:Class="SUNWODA_SEVB.Views.Pages.CTOL.CTAutoDetectionC06Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:cc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:hc="https://handyorg.github.io/handycontrol"
      xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CTOL"
      xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d" 
      Title="CTAutoDetectionC06Page"
      d:DesignHeight="1080"
      d:DesignWidth="1920"
      FontSize="15">

    <!-- 主Grid：3行结构（标题行、内容行、版权行） -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部标题行 -->
        <Grid Grid.Row="0" Background="LightGray" Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <!-- logo图片 -->
                <Image Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/SEVB-logo1.png" MaxWidth="80" MaxHeight="90"/>
                <!-- 项目名称文本 -->
                <TextBlock Text="在线CT AI检测系统V2.0" 
                          FontSize="35" FontWeight="Bold" 
                          Foreground="Black" VerticalAlignment="Center" MinWidth="400"/>
            </StackPanel>
        </Grid>

        <!-- 第二行：分为三列 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1*"/>
                <!-- 左列：标题 -->
                <ColumnDefinition Width="1.6*"/>
                <!-- 右列：信息统计和参数设置 -->
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 工位1：第1行第1列 -->
                    <Border Grid.Row="0" Grid.Column="0"
                                Background="Black" 
                                BorderBrush="#E0E0E0" 
                                BorderThickness="1" 
                                Margin="0">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 工位1标题 -->
                            <TextBlock Grid.Row="0"
                               Text="LAB" 
                               HorizontalAlignment="Center"
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               Margin="0"/>

                            <!-- 工位1图像 -->
                            <Image Grid.Row="1"
                                   x:Name="ImgStationLAB" 
                                   Stretch="Uniform" 
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="0"
                                   Source="{Binding CurrentResultImageLAB}"
                                   RenderTransformOrigin="0.5,0.5">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform 
                                        ScaleX="{Binding RealTimeImageScaleXLAB}" 
                                        ScaleY="{Binding RealTimeImageScaleYLAB}"/>
                                        <TranslateTransform 
                                        X="{Binding RealTimeImageTranslateXLAB}" 
                                        Y="{Binding RealTimeImageTranslateYLAB}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!-- 滚轮缩放命令 -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction 
                                    Command="{Binding ZoomRealTimeImageCommandLAB}" 
                                    PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标按下（开始拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction 
                                    Command="{Binding ImageMouseDownCommandLAB}" 
                                    PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!--鼠标移动（拖动中）命令 -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction 
                                    Command="{Binding ImageMouseMoveCommandLAB}" 
                                    PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!--鼠标松开（结束拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandLAB}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标离开控件（强制结束拖动） -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction 
                                    Command="{Binding ImageMouseUpCommandLAB}" 
                                    PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!-- 图片上双击还原 -->
                                <Image.InputBindings>
                                    <MouseBinding 
                                    MouseAction="LeftDoubleClick" 
                                    Command="{Binding ResetRealTimeImageZoomCommandLAB}"/>
                                    <!-- 删掉多余参数 -->
                                </Image.InputBindings>
                                <!-- 右键菜单（保留原有逻辑） -->
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandLAB}"/>
                                        <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandLAB}"/>
                                        <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandLAB}"/>
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <!-- 空白区域右键菜单（父Grid响应，与图片菜单一致） -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandLAB}"/>
                                    <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandLAB}"/>
                                    <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandLAB}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- 父Grid的双击事件绑定到重置命令 -->
                            <Grid.InputBindings>
                                <MouseBinding 
                        MouseAction="LeftDoubleClick" 
                        Command="{Binding ResetRealTimeImageZoomCommandLAB}"/>
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1"
                            Background="Black" 
                            BorderBrush="#E0E0E0" 
                            BorderThickness="1" 
                            Margin="5,0,0,0">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 工位1标题 -->
                            <TextBlock Grid.Row="0"
                                       Text="LCD" 
                                       HorizontalAlignment="Center"
                                       FontSize="14" 
                                       FontWeight="SemiBold" 
                                       Foreground="White" 
                                       Margin="0"/>

                            <!-- 工位1图像 -->
                            <Image Grid.Row="1"
                                   x:Name="ImgStation2" 
                                        Stretch="Uniform" 
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                    HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                    Margin="0"
                                    Source="{Binding CurrentResultImageLCD}"
                                    
                                    RenderTransformOrigin="0.5,0.5">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform 
                                        ScaleX="{Binding RealTimeImageScaleXLCD}" 
                                        ScaleY="{Binding RealTimeImageScaleYLCD}"/>
                                        <TranslateTransform 
                                        X="{Binding RealTimeImageTranslateXLCD}" 
                                        Y="{Binding RealTimeImageTranslateYLCD}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!-- 滚轮缩放命令 -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ZoomRealTimeImageCommandLCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标按下（开始拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseDownCommandLCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!--鼠标移动（拖动中）命令 -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseMoveCommandLCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标松开（结束拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandLCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标离开控件（强制结束拖动） -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandLCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!--图片上双击还原 -->
                                <Image.InputBindings>
                                    <MouseBinding 
                                        MouseAction="LeftDoubleClick" 
                                        Command="{Binding ResetRealTimeImageZoomCommandLCD}"/>
                                    <!-- 删掉多余参数 -->
                                </Image.InputBindings>
                                <!-- 右键菜单 -->
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandLCD}"/>
                                        <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandLCD}"/>
                                        <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandLCD}"/>
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <!-- 空白区域右键菜单-->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandLCD}"/>
                                    <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandLCD}"/>
                                    <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandLCD}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- 关键新增：父Grid的双击事件绑定到重置命令 -->
                            <Grid.InputBindings>
                                <MouseBinding 
                                    MouseAction="LeftDoubleClick" 
                                    Command="{Binding ResetRealTimeImageZoomCommandLCD}"/>
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0"
                        Background="Black" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        Margin="0,5,0,0">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- 工位1标题 -->
                                <RowDefinition Height="*"/>
                                <!-- 工位1图像 -->
                            </Grid.RowDefinitions>

                            <!-- 工位1标题 -->
                            <TextBlock Grid.Row="0"
                                   Text="RAB" 
                                   HorizontalAlignment="Center"
                                   FontSize="14" 
                                   FontWeight="SemiBold" 
                                   Foreground="White" 
                                   Margin="0"/>
                            <!-- 工位1图像 -->
                            <Image Grid.Row="1"
                                   x:Name="ImgStation3" 
                                   Stretch="Uniform" 
                                   Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="0"
                                   Source="{Binding CurrentResultImageRAB}"
                                   RenderTransformOrigin="0.5,0.5">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform 
                                    ScaleX="{Binding RealTimeImageScaleXRAB}" 
                                    ScaleY="{Binding RealTimeImageScaleYRAB}"/>
                                        <TranslateTransform 
                                        X="{Binding RealTimeImageTranslateXRAB}" 
                                        Y="{Binding RealTimeImageTranslateYRAB}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!-- 滚轮缩放命令 -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ZoomRealTimeImageCommandRAB}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!--鼠标按下（开始拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseDownCommandRAB}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标移动（拖动中）命令 -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseMoveCommandRAB}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标松开（结束拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandRAB}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标离开控件（强制结束拖动） -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandRAB}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!-- 图片上双击还原（保留，无参数冲突） -->
                                <Image.InputBindings>
                                    <MouseBinding 
                                        MouseAction="LeftDoubleClick" 
                                        Command="{Binding ResetRealTimeImageZoomCommandRAB}"/>
                                </Image.InputBindings>
                                <!-- 右键菜单 -->
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandRAB}"/>
                                        <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandRAB}"/>
                                        <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandRAB}"/>
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <!-- 空白区域右键菜单 -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandRAB}"/>
                                    <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandRAB}"/>
                                    <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandRAB}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- 关键新增：父Grid的双击事件绑定到重置命令 -->
                            <Grid.InputBindings>
                                <MouseBinding 
                                    MouseAction="LeftDoubleClick" 
                                    Command="{Binding ResetRealTimeImageZoomCommandRAB}"/>
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1"
                        Background="Black" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        Margin="5,5,0,0">
                        <Grid ClipToBounds="True" Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <!-- 工位1标题 -->
                                <RowDefinition Height="*"/>
                                <!-- 工位1图像 -->
                            </Grid.RowDefinitions>

                            <!-- 工位1标题 -->
                            <TextBlock Grid.Row="0"
                               Text="RCD"
                               HorizontalAlignment="Center"
                               FontSize="14" 
                               FontWeight="SemiBold" 
                               Foreground="White" 
                               Margin="0"/>

                            <!-- 工位1图像 -->
                            <Image Grid.Row="1"
                                   x:Name="ImgStation4" 
                                        Stretch="Uniform" 
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                    HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                    Margin="0"
                                    Source="{Binding CurrentResultImageRCD}"
                                    RenderTransformOrigin="0.5,0.5">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform 
                                        ScaleX="{Binding RealTimeImageScaleXRCD}" 
                                        ScaleY="{Binding RealTimeImageScaleYRCD}"/>
                                        <TranslateTransform 
                                        X="{Binding RealTimeImageTranslateXRCD}" 
                                        Y="{Binding RealTimeImageTranslateYRCD}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!-- 滚轮缩放命令 -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ZoomRealTimeImageCommandRCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标按下（开始拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseDownCommandRCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!-- 鼠标移动（拖动中）命令 -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseMoveCommandRCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!--鼠标松开（结束拖动）命令 -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandRCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                    <!--鼠标离开控件（强制结束拖动） -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommandRCD}" 
                                        PassEventArgsToCommand="True"/>
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!-- 图片上双击还原 -->
                                <Image.InputBindings>
                                    <MouseBinding 
                                    MouseAction="LeftDoubleClick" 
                                    Command="{Binding ResetRealTimeImageZoomCommandRCD}"/>
                                </Image.InputBindings>
                                <!-- 右键菜单 -->
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandRCD}"/>
                                        <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandRCD}"/>
                                        <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandRCD}"/>
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <!-- 4. 空白区域右键菜单（父Grid响应，与图片菜单一致） -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommandRCD}"/>
                                    <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommandRCD}"/>
                                    <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommandRCD}"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!--父Grid的双击事件绑定到重置命令 -->
                            <Grid.InputBindings>
                                <MouseBinding 
                                    MouseAction="LeftDoubleClick" 
                                    Command="{Binding ResetRealTimeImageZoomCommandRCD}"/>
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Margin="0" Background="White">
                <Grid>
                    <!-- 状态信息栏：垂直布局-->
                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="0">
                        <StackPanel Margin="0" Height="Auto" Orientation="Vertical">
                            <!-- 标题 -->
                            <TextBlock Text="状态信息" FontWeight="Bold" FontSize="20" Margin="0,0,0,5"/>

                            <!--上方：饼图区域-->
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,15">
                                <oxy:PlotView
                                    Model="{Binding PieModel}"
                                    Height="250"
                                    Width="300"
                                    IsHitTestVisible="False"/>

                                <!-- 饼图图例 -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                                    <!-- OK图例 -->
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="78"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Fill="#2F80ED" Margin="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="OK" Margin="0,0" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding OKRate}" Margin="0,0" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="53"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Fill="#FF6384" Margin="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="OH不良" Margin="0,0" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ratio_OHBL}" Margin="0,0" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="53"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Fill="#36A2EB" Margin="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="正极少片" Margin="0,0" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ratio_ZJSP}" Margin="0,0" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="101"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Fill="#43A047" Margin="2" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="正极中间间隙不良" Margin="2,0" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ratio_ZJZJJXBL}" Margin="2,0" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">
                                    <!-- OK图例 -->
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="53"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Fill="#FFCE56" Margin="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="正极多片" Margin="0,0" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ratio_ZJDP}" Margin="0,0" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="101"/>
                                            <ColumnDefinition Width="60"/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Width="10" Height="10" Fill="#FF5722" Margin="0" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="正极边缘间隙不良" Margin="0,0" FontSize="12" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Ratio_ZJBYJXBL}" Margin="0,0" FontSize="12" Grid.Column="2" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,0" HorizontalAlignment="Left">

                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="53"/>
