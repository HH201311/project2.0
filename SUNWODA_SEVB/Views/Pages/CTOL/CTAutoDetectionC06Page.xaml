<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CTOL.CTAutoDetectionC06Page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:cc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CTOL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="CTAutoDetectionC06Page"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    FontSize="15"
    mc:Ignorable="d">

    <!--  主Grid：3行结构（标题行、内容行、版权行）  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部标题行  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,0"
            Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.png" />
                <!--  项目名称文本  -->
                <TextBlock
                    MinWidth="400"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="在线CT AI检测系统V2.0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0"
                        Background="Black"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="LAB" />

                            <Image
                                x:Name="ImgStationLAB"
                                Grid.Row="1"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{Binding CurrentResultImageLAB}"
                                Stretch="Uniform">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding RealTimeImageScaleXLAB}" ScaleY="{Binding RealTimeImageScaleYLAB}" />
                                        <TranslateTransform X="{Binding RealTimeImageTranslateXLAB}" Y="{Binding RealTimeImageTranslateYLAB}" />
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!--  滚轮缩放命令  -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommandLAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标按下（开始拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommandLAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标移动（拖动中）命令  -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommandLAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标松开（结束拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandLAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标离开控件（强制结束拖动）  -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandLAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!--  图片上双击还原  -->
                                <Image.InputBindings>
                                    <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandLAB}" MouseAction="LeftDoubleClick" />
                                </Image.InputBindings>
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ZoomInRealTimeCommandLAB}" Header="放大" />
                                        <MenuItem Command="{Binding ZoomOutRealTimeCommandLAB}" Header="缩小" />
                                        <MenuItem Command="{Binding ResetRealTimeImageZoomCommandLAB}" Header="适应窗口" />
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ZoomInRealTimeCommandLAB}" Header="放大" />
                                    <MenuItem Command="{Binding ZoomOutRealTimeCommandLAB}" Header="缩小" />
                                    <MenuItem Command="{Binding ResetRealTimeImageZoomCommandLAB}" Header="适应窗口" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.InputBindings>
                                <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandLAB}" MouseAction="LeftDoubleClick" />
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Background="Black"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="LCD" />

                            <Image
                                x:Name="ImgStation2"
                                Grid.Row="1"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{Binding CurrentResultImageLCD}"
                                Stretch="Uniform">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding RealTimeImageScaleXLCD}" ScaleY="{Binding RealTimeImageScaleYLCD}" />
                                        <TranslateTransform X="{Binding RealTimeImageTranslateXLCD}" Y="{Binding RealTimeImageTranslateYLCD}" />
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!--  滚轮缩放命令  -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommandLCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标按下（开始拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommandLCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标移动（拖动中）命令  -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommandLCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标松开（结束拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandLCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标离开控件（强制结束拖动）  -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandLCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!--  图片上双击还原  -->
                                <Image.InputBindings>
                                    <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandLCD}" MouseAction="LeftDoubleClick" />
                                    <!--  删掉多余参数  -->
                                </Image.InputBindings>
                                <!--  右键菜单  -->
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ZoomInRealTimeCommandLCD}" Header="放大" />
                                        <MenuItem Command="{Binding ZoomOutRealTimeCommandLCD}" Header="缩小" />
                                        <MenuItem Command="{Binding ResetRealTimeImageZoomCommandLCD}" Header="适应窗口" />
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <!--  空白区域右键菜单  -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ZoomInRealTimeCommandLCD}" Header="放大" />
                                    <MenuItem Command="{Binding ZoomOutRealTimeCommandLCD}" Header="缩小" />
                                    <MenuItem Command="{Binding ResetRealTimeImageZoomCommandLCD}" Header="适应窗口" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.InputBindings>
                                <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandLCD}" MouseAction="LeftDoubleClick" />
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,5,0,0"
                        Background="Black"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="RAB" />
                            <Image
                                x:Name="ImgStation3"
                                Grid.Row="1"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{Binding CurrentResultImageRAB}"
                                Stretch="Uniform">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding RealTimeImageScaleXRAB}" ScaleY="{Binding RealTimeImageScaleYRAB}" />
                                        <TranslateTransform X="{Binding RealTimeImageTranslateXRAB}" Y="{Binding RealTimeImageTranslateYRAB}" />
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!--  滚轮缩放命令  -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommandRAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标按下（开始拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommandRAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标移动（拖动中）命令  -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommandRAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标松开（结束拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandRAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标离开控件（强制结束拖动）  -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandRAB}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <!--  图片上双击还原（保留，无参数冲突）  -->
                                <Image.InputBindings>
                                    <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandRAB}" MouseAction="LeftDoubleClick" />
                                </Image.InputBindings>
                                <!--  右键菜单  -->
                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ZoomInRealTimeCommandRAB}" Header="放大" />
                                        <MenuItem Command="{Binding ZoomOutRealTimeCommandRAB}" Header="缩小" />
                                        <MenuItem Command="{Binding ResetRealTimeImageZoomCommandRAB}" Header="适应窗口" />
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <!--  空白区域右键菜单  -->
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ZoomInRealTimeCommandRAB}" Header="放大" />
                                    <MenuItem Command="{Binding ZoomOutRealTimeCommandRAB}" Header="缩小" />
                                    <MenuItem Command="{Binding ResetRealTimeImageZoomCommandRAB}" Header="适应窗口" />
                                </ContextMenu>
                            </Grid.ContextMenu>

                            <Grid.InputBindings>
                                <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandRAB}" MouseAction="LeftDoubleClick" />
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5,5,0,0"
                        Background="Black"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1">
                        <Grid Background="Transparent" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="RCD" />

                            <Image
                                x:Name="ImgStation4"
                                Grid.Row="1"
                                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                                Margin="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                RenderTransformOrigin="0.5,0.5"
                                Source="{Binding CurrentResultImageRCD}"
                                Stretch="Uniform">

                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding RealTimeImageScaleXRCD}" ScaleY="{Binding RealTimeImageScaleYRCD}" />
                                        <TranslateTransform X="{Binding RealTimeImageTranslateXRCD}" Y="{Binding RealTimeImageTranslateYRCD}" />
                                    </TransformGroup>
                                </Image.RenderTransform>

                                <behaviors:Interaction.Triggers>
                                    <!--  滚轮缩放命令  -->
                                    <behaviors:EventTrigger EventName="MouseWheel">
                                        <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommandRCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标按下（开始拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommandRCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标移动（拖动中）命令  -->
                                    <behaviors:EventTrigger EventName="MouseMove">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommandRCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标松开（结束拖动）命令  -->
                                    <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandRCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                    <!--  鼠标离开控件（强制结束拖动）  -->
                                    <behaviors:EventTrigger EventName="MouseLeave">
                                        <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommandRCD}" PassEventArgsToCommand="True" />
                                    </behaviors:EventTrigger>
                                </behaviors:Interaction.Triggers>
                                <Image.InputBindings>
                                    <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandRCD}" MouseAction="LeftDoubleClick" />
                                </Image.InputBindings>

                                <Image.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ZoomInRealTimeCommandRCD}" Header="放大" />
                                        <MenuItem Command="{Binding ZoomOutRealTimeCommandRCD}" Header="缩小" />
                                        <MenuItem Command="{Binding ResetRealTimeImageZoomCommandRCD}" Header="适应窗口" />
                                    </ContextMenu>
                                </Image.ContextMenu>
                            </Image>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ZoomInRealTimeCommandRCD}" Header="放大" />
                                    <MenuItem Command="{Binding ZoomOutRealTimeCommandRCD}" Header="缩小" />
                                    <MenuItem Command="{Binding ResetRealTimeImageZoomCommandRCD}" Header="适应窗口" />
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.InputBindings>
                                <MouseBinding Command="{Binding ResetRealTimeImageZoomCommandRCD}" MouseAction="LeftDoubleClick" />
                            </Grid.InputBindings>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border
                Grid.Column="1"
                Margin="0"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <Border
                        Margin="0"
                        BorderBrush="LightGray"
                        BorderThickness="1">
                        <StackPanel
                            Height="Auto"
                            Margin="0"
                            Orientation="Vertical">
                            <TextBlock
                                Margin="0,0,0,5"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="状态信息" />
                            <StackPanel Margin="0,0,0,15" HorizontalAlignment="Center">
                                <oxy:PlotView
                                    Width="300"
                                    Height="250"
                                    IsHitTestVisible="False"
                                    Model="{Binding PieModel}" />

                                <!--  饼图图例  -->
                                <StackPanel
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <!--  OK图例  -->
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="25" />
                                            <ColumnDefinition Width="78" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Fill="#2F80ED" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="OK" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding OKRate}" />
                                    </Grid>
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="53" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Fill="#FF6384" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="OH不良" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Ratio_OHBL}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="53" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Fill="#36A2EB" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="正极少片" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Ratio_ZJSP}" />
                                    </Grid>
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="101" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="2"
                                            VerticalAlignment="Center"
                                            Fill="#43A047" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="2,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="正极中间间隙不良" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="2,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Ratio_ZJZJJXBL}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                                    <!--  OK图例  -->
                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="53" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Fill="#FFCE56" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="正极多片" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Ratio_ZJDP}" />
                                    </Grid>

                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="101" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="0"
                                            VerticalAlignment="Center"
                                            Fill="#FF5722" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="正极边缘间隙不良" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{Binding Ratio_ZJBYJXBL}" />
                                    </Grid>
                                </StackPanel>
                                <StackPanel
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal">

                                    <Grid Margin="2" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="53" />
                                            <ColumnDefinition Width="50" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Grid.Column="0"
                                            Width="10"
                                            Height="10"
                                            Margin="2"
                                            VerticalAlignment="Center"
                                            Fill="#4BC0C0" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="负极多片" />
                                        <TextBlock
