<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring.TBDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccharts="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls;assembly=SUNWODA_SEVB.Component"
    xmlns:ucdatagrids="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.DataGridControls;assembly=SUNWODA_SEVB.Component"
    Title="TBDataPage"
    d:DesignHeight="860"
    d:DesignWidth="1780"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="280*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="260*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="280*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  机头A-面密度实时数据  -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="机头A-面密度实时数据"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBDataChartControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamA}"
                ItemSource="{Binding TBDatasA}"
                ParamOptionSelectedCommand="{Binding ParamOptionSelectedACommand}"
                ParamOptions="{Binding ParamOptionsA}"
                YMax="{Binding TBDataAMax}"
                YMin="{Binding TBDataAMin}" />
        </GroupBox>
        <!--  机头B-面密度实时数据  -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="2"
            Header="机头B-面密度实时数据"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBDataChartControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamB}"
                ItemSource="{Binding TBDatasB}"
                ParamOptionSelectedCommand="{Binding ParamOptionSelectedBCommand}"
                ParamOptions="{Binding ParamOptionsB}"
                YMax="{Binding TBDataBMax}"
                YMin="{Binding TBDataBMin}" />
        </GroupBox>
        <!--  机头A-面密度实时数据列表  -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="0"
            Header="机头A-面密度实时数据列表"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <ucdatagrids:TBDataGridControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamA1}"
                ItemsSource="{Binding TBDataHistoryA}" />
        </GroupBox>
        <!--  机头B-面密度实时数据列表  -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="2"
            Header="机头B-面密度实时数据列表"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <ucdatagrids:TBDataGridControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamB1}"
                ItemsSource="{Binding TBDataHistoryB}" />
        </GroupBox>
        <!--  机头A-T块实时位置  -->
        <GroupBox
            Grid.Row="4"
            Grid.Column="0"
            Header="机头A-T块实时位置"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBlockChartControl
                Margin="20,10,10,20"
                ItemSource="{Binding TBlockDatasA}"
                YMax="{Binding TBlockAMax}"
                YMin="{Binding TBlockAMin}" />
        </GroupBox>
        <!--  机头B-T块实时位置  -->
        <GroupBox
            Grid.Row="4"
            Grid.Column="2"
            Header="机头B-T块实时位置"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBlockChartControl
                Margin="20,10,10,20"
                ItemSource="{Binding TBlockDatasB}"
                YMax="{Binding TBlockBMax}"
                YMin="{Binding TBlockBMin}" />
        </GroupBox>
    </Grid>
</Page>
