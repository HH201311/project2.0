<Page x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring.SummaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring"
      mc:Ignorable="d" 
      d:DesignHeight="860" d:DesignWidth="1800"
      Title="SummaryPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="13*"/>
            <RowDefinition Height="30*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*"/>
                <ColumnDefinition Width="31*"/>
                <ColumnDefinition Width="20*"/>
                <ColumnDefinition Width="20*"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Margin="0,0,0,0" Header="拉线信息" Style="{StaticResource SimpleGroupBoxStyle}"/>
            <GroupBox Grid.Column="1" Margin="20,0,0,0" Header="生产信息" Style="{StaticResource SimpleGroupBoxStyle}"/>
            <GroupBox Grid.Column="2" Margin="20,0,0,0" Header="关键控制" Style="{StaticResource SimpleGroupBoxStyle}"/>
            <GroupBox Grid.Column="3" Margin="20,0,0,0" Header="设备监控" Style="{StaticResource SimpleGroupBoxStyle}"/>
        </Grid>
        <UniformGrid Grid.Row="1" Rows="2" Columns="2">
            <GroupBox Header="机头A-BY卷CPK" Margin="0,20,0,0" Style="{StaticResource SimpleGroupBoxStyle}"/>
            <GroupBox Header="机头B-BY卷CPK" Margin="20,20,0,0" Style="{StaticResource SimpleGroupBoxStyle}"/>
            <GroupBox Header="机头A-单趟CPK" Margin="0,20,0,0" Style="{StaticResource SimpleGroupBoxStyle}"/>
            <GroupBox Header="机头B-单趟CPK" Margin="20,20,0,0" Style="{StaticResource SimpleGroupBoxStyle}"/>
        </UniformGrid>
    </Grid>
</Page>
