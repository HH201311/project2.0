<Page x:Class="SUNWODA_SEVB.Views.Pages.STC.P230ConnectorInstallerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.STC"
      xmlns:conver="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
      xmlns:userControl="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1200"
      Title="螺丝拧紧工序监控">
    <Page.Resources>
        <!-- 布尔值取反转换器 -->
        <conver:BooleanInverterConverter x:Key="BooleanInverterConverter"/>
        <conver:ImagePathToSourceConverter x:Key="ImagePathConverter"/>
        <!-- 按钮基础样式 -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 启动按钮样式 -->
        <Style x:Key="StartButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 停止按钮样式 -->
        <Style x:Key="StopButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Background" Value="#F44336"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- 普通按钮样式 -->
        <Style x:Key="NormalButtonStyle" TargetType="Button" BasedOn="{StaticResource ControlButtonStyle}">
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Page.Resources>



    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧:螺丝位置显示区域 -->
        <Border Grid.Column="0" Background="White" Margin="10" CornerRadius="8" 
                BorderBrush="#CCCCCC" BorderThickness="2">
            <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="Gray" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <!-- 标题 -->
                <TextBlock Grid.Row="0" Text="螺丝拧紧位置图" FontSize="18" FontWeight="Bold" 
                          HorizontalAlignment="Center" Margin="0,10,0,10" Foreground="#333"/>

                <!-- 工序选择 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="当前工序:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <ComboBox Name="ProcessComboBox" Width="200" Height="30"
                             ItemsSource="{Binding Processes}"
                             SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                             DisplayMemberPath="ProcessName"/>
                </StackPanel>

                <!-- 螺丝位置图 (使用Grid代替Canvas以支持背景图片) -->
                <Grid Grid.Row="2" Name="ScrewPositionContainer" Margin="20">
                    <!-- 背景图片 -->
                    <Image Name="ProcessBackgroundImage" 
                           Source="{Binding SelectedProcess.ImagePath, Converter={StaticResource ImagePathConverter}}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    <!-- 螺丝位置标记层 -->
                    <Canvas Name="ScrewPositionCanvas" Background="Transparent">
                        <!-- 动态生成的螺丝位置标记将通过代码添加 -->
                    </Canvas>
                </Grid>

                <!-- 状态说明 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                    <Ellipse Width="15" Height="15" Fill="Green" Margin="5,0"/>
                    <TextBlock Text="拧紧完成" VerticalAlignment="Center" Margin="5,0,20,0"/>
                    <Ellipse Width="15" Height="15" Fill="Red" Margin="5,0"/>
                    <TextBlock Text="待拧紧/异常" VerticalAlignment="Center" Margin="5,0,20,0"/>
                    <Ellipse Width="15" Height="15" Fill="Gray" Margin="5,0"/>
                    <TextBlock Text="未启用" VerticalAlignment="Center" Margin="5,0"/>
                </StackPanel>
                <!-- 日志显示区域 -->
                <Border Grid.Row="4" Background="Transparent" CornerRadius="5" Margin="0,10,0,0" Padding="8" BorderBrush="#666" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="LightGray"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Info">
                                                        <Setter Property="Foreground" Value="Gray"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                        <Setter Property="Foreground" Value="Orange"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- 右侧:拧紧曲线显示区域 -->
        <Grid Grid.Column="1" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="5" Margin="0,0,0,5" Padding="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Gray" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧信息区 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="拧紧曲线监控" FontSize="18" FontWeight="Bold" 
                                  VerticalAlignment="Center" Foreground="#333" Margin="0,0,15,0"/>

                        <!-- 服务状态指示器 -->
                        <Border CornerRadius="10" Padding="8,4" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E0E0E0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Background" Value="#4CAF50"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="已停止"/>
                                            <Setter Property="Foreground" Value="#666"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Text" Value="运行中"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Pack包信息 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                            <TextBlock Text="Pack包:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                            <TextBlock Text="{Binding CurrentPackCode, TargetNullValue='-', FallbackValue='-'}" 
                                      FontWeight="Bold" VerticalAlignment="Center" Foreground="#FF6B00"/>
                        </StackPanel>

                        <!-- 螺丝标签 -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="当前螺丝:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#666"/>
                            <TextBlock Text="{Binding SelectedScrewLabel, TargetNullValue='-', FallbackValue='-'}" 
                                      FontWeight="Bold" VerticalAlignment="Center" Foreground="#2196F3"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧按钮区 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <!-- 启动按钮 -->
                        <Button Content="启动服务" 
                               Style="{StaticResource StartButtonStyle}"
                               Command="{Binding StartServerCommand}"
                               IsEnabled="{Binding IsServerRunning, Converter={StaticResource BooleanInverterConverter}}"/>

                        <!-- 停止按钮 -->
                        <Button Content="停止服务" 
                               Style="{StaticResource StopButtonStyle}"
                               Command="{Binding StopServerCommand}"
                               IsEnabled="{Binding IsServerRunning}"/>

                        <!-- 分隔线 -->
                        <Border Width="1" Background="#DDD" Margin="10,5"/>

                        <!-- 清空曲线按钮 -->
                        <Button Content="清空曲线" 
                               Style="{StaticResource NormalButtonStyle}"
                               Command="{Binding ClearChartsCommand}"
                               IsEnabled="{Binding IsServerRunning, Converter={StaticResource BooleanInverterConverter}}"
                               ToolTip="仅在服务停止时可用"/>

                        <!-- 模拟测试按钮 -->
                        <Button Content="模拟测试" 
                               Style="{StaticResource NormalButtonStyle}"
                               Command="{Binding SimulateCommand}"
                               IsEnabled="{Binding IsServerRunning, Converter={StaticResource BooleanInverterConverter}}"
                               ToolTip="仅在服务停止时可用"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- OK拧紧曲线 -->
            <Border Grid.Row="1" Background="White" CornerRadius="5" Margin="0,2.5" 
                   BorderBrush="#4CAF50" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Gray" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#4CAF50" CornerRadius="3,3,0,0">
                        <StackPanel Orientation="Horizontal" Margin="10,5">
                            <TextBlock Text="合格拧紧曲线 (OK)" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OkPlotDataSeries.Count, StringFormat=' - 共 {0} 条曲线'}" 
                                      FontSize="12" Foreground="#E8F5E9" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <userControl:ScottPlotControl Grid.Row="1" 
                                                  Margin="5"                                                
                                                  DataSeriesCollection="{Binding OkPlotDataSeries}"
                                                  XAxisLabel="数量 (个)"
                                                  YAxisLabel="扭矩 (N·m)"
                                                  ShowGrid="True"
                                                  ShowLegend="True"
                                                  PlotType="Line"/>
                </Grid>
            </Border>

            <!-- NG拧紧曲线 -->
            <Border Grid.Row="2" Background="White" CornerRadius="5" Margin="0,2.5" 
                   BorderBrush="#F44336" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Color="Gray" Opacity="0.3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F44336" CornerRadius="3,3,0,0">
                        <StackPanel Orientation="Horizontal" Margin="10,5">
                            <TextBlock Text="异常拧紧曲线 (NG)" FontSize="14" FontWeight="Bold" 
                                      Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding NgPlotDataSeries.Count, StringFormat=' - 共 {0} 条曲线'}" 
                                      FontSize="12" Foreground="#FFEBEE" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <userControl:ScottPlotControl Grid.Row="1" 
                                                  Margin="5"
                                                  DataSeriesCollection="{Binding NgPlotDataSeries}"
                                                  XAxisLabel="数量 (个)"
                                                  YAxisLabel="扭矩 (N·m)"
                                                  ShowGrid="True"
                                                  ShowLegend="True"
                                                  PlotType="Line"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
