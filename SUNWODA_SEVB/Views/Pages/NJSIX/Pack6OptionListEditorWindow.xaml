<Window
    x:Class="SUNWODA_SEVB.Views.Pages.NJSIX.Pack6OptionListEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="编辑选项"
    Width="420"
    Height="420"
    MinWidth="360"
    MinHeight="320"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="#FFF5F8FC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Margin="0,0,0,8"
            FontSize="13"
            Foreground="#FF555555"
            Text="增删本段下拉可选值（保存设置后写入数据库）。" />

        <ListBox
            x:Name="ItemList"
            Grid.Row="1"
            Margin="0,0,0,8"
            FontSize="14" />

        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="NewItemBox"
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalContentAlignment="Center"
                FontSize="14" />
            <Button
                Grid.Column="1"
                Width="72"
                Margin="0,0,8,0"
                Click="OnAddClick"
                Content="添加" />
            <Button
                Grid.Column="2"
                Width="72"
                Click="OnDeleteClick"
                Content="删除" />
        </Grid>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="90"
                Margin="0,0,8,0"
                Click="OnOkClick"
                Content="确定"
                FontWeight="SemiBold"
                IsDefault="True" />
            <Button
                Width="90"
                Click="OnCancelClick"
                Content="取消"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
