<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CTAutoSlicer.ScreenArrowCalibrationOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="拖拽箭头标定"
    AllowsTransparency="True"
    Background="#66000000"
    Cursor="Cross"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Canvas x:Name="RootCanvas">
        <TextBlock
            x:Name="HintTextBlock"
            Margin="24"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="White"
            IsHitTestVisible="False"
            Text="在起点按住左键拖到终点松开，箭头表示拖拽方向与距离；Esc / 右键取消" />

        <Border
            x:Name="CoordPanel"
            Padding="10,6"
            Background="#F01E1E1E"
            BorderBrush="#FFFFC107"
            BorderThickness="1"
            CornerRadius="4"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="CoordText"
                FontFamily="Consolas"
                FontSize="13"
                FontWeight="Bold"
                Foreground="White"
                Text="起点 → 终点" />
        </Border>

        <!-- 拖拽箭头：线段 + 箭头多边形 -->
        <Line
            x:Name="ArrowShaft"
            Stroke="#FFFFC107"
            StrokeThickness="3"
            Visibility="Collapsed"
            IsHitTestVisible="False" />
        <Polygon
            x:Name="ArrowHead"
            Fill="#FFFFC107"
            Stroke="#FFFF9800"
            StrokeThickness="1"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <!-- 起点圆点 -->
        <Ellipse
            x:Name="StartDot"
            Width="10"
            Height="10"
            Fill="#FF4CAF50"
            Stroke="White"
            StrokeThickness="1"
            Visibility="Collapsed"
            IsHitTestVisible="False" />
    </Canvas>
</Window>
