<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls.DateRangePicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="30"
    d:DesignWidth="200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries />

            <convert:TodayBackgroundConverter x:Key="TodayBackgroundConverter" />

            <!--  展示的文本样式  -->
            <Style x:Key="DisplayTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="hc:InfoElement.Placeholder" Value="全部操作时间" />
            </Style>

            <!--  月份按钮样式定义  -->
            <Style x:Key="CalendarButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  日期的文本样式  -->
            <Style x:Key="DateTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#606266" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  星期的文本样式  -->
            <Style x:Key="WeekTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#606266" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  日期的文本样式  -->
            <Style x:Key="DayLabelStyle" TargetType="Label">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="#FFF5F7FA" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="16" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Label">
                            <Grid>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{Binding (hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                    Cursor="Hand" />
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TimeComboStyle" TargetType="ComboBox">
                <Setter Property="Width" Value="55" />
                <Setter Property="Height" Value="28" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--  输入框区域  -->
        <Border
            Background="#0DFFFFFF"
            BorderBrush="#0DFFFFFF"
            BorderThickness="1"
            CornerRadius="5"
            MouseLeftButtonDown="OnInputClick">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="DisplayTB"
                    Grid.Column="0"
                    Margin="10,0"
                    d:Text="全部操作时间"
                    Style="{StaticResource DisplayTextBlockStyle}" />

                <!--  日历图标  -->
                <Canvas
                    Grid.Column="1"
                    Width="14"
                    Height="14"
                    Margin="0,0,10,0">
                    <Ellipse
                        Width="14"
                        Height="14"
                        Stroke="#2AFFFFFF"
                        StrokeThickness="1" />
                    <Path
                        Data="M7,3 7,7 11,7"
                        Stroke="#2AFFFFFF"
                        StrokeThickness="1" />
                </Canvas>
            </Grid>
        </Border>

        <!--  弹出面板  -->
        <Popup
            AllowsTransparency="True"
            HorizontalOffset="0"
            IsOpen="{Binding IsOpen, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Placement="Bottom"
            PopupAnimation="Fade"
            StaysOpen="False"
            VerticalOffset="5">
            <Border
                Margin="5"
                Background="#FFFFFF"
                BorderBrush="#E4E7ED"
                BorderThickness="1"
                CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="10"
                        Opacity="0.1"
                        ShadowDepth="0" />
                </Border.Effect>

                <StackPanel>
                    <!--  双日历面板  -->
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Padding="15"
                            BorderBrush="#EBEEF5"
                            BorderThickness="0,0,1,0">
                            <StackPanel>
                                <!--  月份标题  -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding PrevMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="leftDate"
                                        Content="◀"
                                        Style="{StaticResource CalendarButtonStyle}" />
                                    <TextBlock
                                        x:Name="LeftMonthTitle"
                                        Grid.Column="1"
                                        Style="{StaticResource DateTextBlockStyle}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding NextMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="leftDate"
                                        Content="▶"
                                        Style="{StaticResource CalendarButtonStyle}" />
                                </Grid>

                                <!--  星期标题  -->
                                <UniformGrid Margin="0,0,0,5" Columns="7">
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="一" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="二" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="三" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="四" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="五" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="六" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="日" />
                                </UniformGrid>

                                <!--  日期网格  -->
                                <ItemsControl ItemsSource="{Binding LeftDays, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Label
                                                x:Name="CellLabel"
                                                Content="{Binding Date.Day}"
                                                MouseLeftButtonDown="OnDayClick"
                                                Style="{StaticResource DayLabelStyle}" />
                                            <DataTemplate.Triggers>
                                                <!--  非当月：置灰  -->
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="#C0C4CC" />
                                                    <Setter TargetName="CellLabel" Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                                <!--  今天：蓝色加粗  -->
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="#1890FF" />
                                                    <Setter TargetName="CellLabel" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <!--  范围中间：浅蓝背景，蓝字  -->
                                                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#E6F7FF" />
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="0" />
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="#1890FF" />
                                                </DataTrigger>
                                                <!--  范围开始：左侧圆角  -->
                                                <DataTrigger Binding="{Binding IsRangeStart}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#1890FF" />
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="16,0,0,16" />
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="White" />
                                                    <Setter TargetName="CellLabel" Property="FontWeight" Value="Medium" />
                                                </DataTrigger>
                                                <!--  范围结束：右侧圆角  -->
                                                <DataTrigger Binding="{Binding IsRangeEnd}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#1890FF" />
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="0,16,16,0" />
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="White" />
                                                    <Setter TargetName="CellLabel" Property="FontWeight" Value="Medium" />
                                                </DataTrigger>
                                                <!--  单日选中（开始结束同一天）：全圆角  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRangeStart}" Value="True" />
                                                        <Condition Binding="{Binding IsRangeEnd}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="16" />
                                                </MultiDataTrigger>
                                                <!--  悬停效果（仅在非选中/非范围内时生效）  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRangeStart}" Value="False" />
                                                        <Condition Binding="{Binding IsRangeEnd}" Value="False" />
                                                        <Condition Binding="{Binding IsInRange}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#F5F7FA" />
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  右侧面板  -->
                        <Border Padding="15">
                            <StackPanel>
                                <!--  月份标题  -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        Grid.Column="0"
                                        Command="{Binding PrevMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="rightDate"
                                        Content="◀"
                                        Style="{StaticResource CalendarButtonStyle}" />
                                    <TextBlock
                                        x:Name="RightMonthTitle"
                                        Grid.Column="1"
                                        Style="{StaticResource DateTextBlockStyle}" />
                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding NextMonthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="rightDate"
                                        Content="▶"
                                        Style="{StaticResource CalendarButtonStyle}" />
                                </Grid>

                                <!--  星期标题  -->
                                <UniformGrid Margin="0,0,0,5" Columns="7">
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="一" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="二" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="三" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="四" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="五" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="六" />
                                    <TextBlock Style="{StaticResource WeekTextBlockStyle}" Text="日" />
                                </UniformGrid>

                                <!--  日期网格  -->
                                <ItemsControl ItemsSource="{Binding RightDays, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Label
                                                x:Name="CellLabel"
                                                Content="{Binding Date.Day}"
                                                MouseLeftButtonDown="OnDayClick"
                                                Style="{StaticResource DayLabelStyle}" />
                                            <DataTemplate.Triggers>
                                                <!--  非当月：置灰  -->
                                                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="#C0C4CC" />
                                                    <Setter TargetName="CellLabel" Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                                <!--  今天：蓝色加粗  -->
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="#1890FF" />
                                                    <Setter TargetName="CellLabel" Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <!--  范围中间：浅蓝背景，蓝字  -->
                                                <DataTrigger Binding="{Binding IsInRange}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#E6F7FF" />
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="0" />
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="#1890FF" />
                                                </DataTrigger>
                                                <!--  范围开始：左侧圆角  -->
                                                <DataTrigger Binding="{Binding IsRangeStart}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#1890FF" />
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="16,0,0,16" />
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="White" />
                                                    <Setter TargetName="CellLabel" Property="FontWeight" Value="Medium" />
                                                </DataTrigger>
                                                <!--  范围结束：右侧圆角  -->
                                                <DataTrigger Binding="{Binding IsRangeEnd}" Value="True">
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#1890FF" />
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="0,16,16,0" />
                                                    <Setter TargetName="CellLabel" Property="Foreground" Value="White" />
                                                    <Setter TargetName="CellLabel" Property="FontWeight" Value="Medium" />
                                                </DataTrigger>
                                                <!--  单日选中（开始结束同一天）：全圆角  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRangeStart}" Value="True" />
                                                        <Condition Binding="{Binding IsRangeEnd}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellLabel" Property="hc:BorderElement.CornerRadius" Value="16" />
                                                </MultiDataTrigger>
                                                <!--  悬停效果（仅在非选中/非范围内时生效）  -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsRangeStart}" Value="False" />
                                                        <Condition Binding="{Binding IsRangeEnd}" Value="False" />
                                                        <Condition Binding="{Binding IsInRange}" Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="CellLabel" Property="Background" Value="#F5F7FA" />
                                                </MultiDataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  时间选择区域  -->
                    <Border
                        Padding="15,10"
                        BorderBrush="#EBEEF5"
                        BorderThickness="0,1,0,0"
                        Visibility="{Binding ShowTime, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Boolean2VisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="#606266"
                                Text="开始时间:" />
                            <ComboBox
                                x:Name="StartHourCB"
                                ItemsSource="{Binding Hours, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectionChanged="OnTimeClick"
                                Style="{StaticResource TimeComboStyle}" />
                            <TextBlock
                                Margin="3,0"
                                VerticalAlignment="Center"
                                Foreground="#606266"
                                Text=":" />
                            <ComboBox
                                x:Name="StartMinuteCB"
                                ItemsSource="{Binding Minutes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectionChanged="OnTimeClick"
                                Style="{StaticResource TimeComboStyle}" />

                            <TextBlock
                                Margin="20,0,8,0"
                                VerticalAlignment="Center"
                                Foreground="#606266"
                                Text="截止时间:" />
                            <ComboBox
                                x:Name="EndHourCB"
                                ItemsSource="{Binding Hours, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectionChanged="OnTimeClick"
                                Style="{StaticResource TimeComboStyle}" />
                            <TextBlock
                                Margin="3,0"
                                VerticalAlignment="Center"
                                Foreground="#606266"
                                Text=":" />
                            <ComboBox
                                x:Name="EndMinuteCB"
                                ItemsSource="{Binding Minutes, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectionChanged="OnTimeClick"
                                Style="{StaticResource TimeComboStyle}" />
                        </StackPanel>
                    </Border>

                    <!--  底部按钮  -->
                    <Border
                        Padding="15,10"
                        BorderBrush="#EBEEF5"
                        BorderThickness="0,1,0,0">
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <Button
                                Margin="0,0,10,0"
                                Padding="15,6"
                                Background="Transparent"
                                BorderBrush="#DCDFE6"
                                BorderThickness="1"
                                Command="{Binding ClearCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="清空"
                                Cursor="Hand"
                                Foreground="#606266" />
                            <Button
                                Padding="15,6"
                                Background="#1890FF"
                                BorderThickness="0"
                                Command="{Binding ConfirmCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="确定"
                                Cursor="Hand"
                                Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
