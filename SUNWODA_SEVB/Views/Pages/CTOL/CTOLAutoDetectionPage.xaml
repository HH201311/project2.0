<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CTOL.CTOLAutoDetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CTOL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CTOL;assembly=SUNWODA_SEVB.Component"
    Title="CTOLAutoDetectionPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <!--  主Grid：3行结构（标题行、内容行、版权行）  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部标题行  -->
        <Grid Grid.Row="0" Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.ico" />
                <!--  项目名称文本  -->
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="在线CT AI检测系统V2.0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="1" Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Margin="0,0,2,2" Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="LAB" />
                        <uc:ImageShowControl Grid.Row="1" Source="{Binding CurrentResultImageLAB}" />
                    </Grid>

                    <Grid
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="2,0,0,2"
                        Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="LCD" />
                        <uc:ImageShowControl Grid.Row="1" Source="{Binding CurrentResultImageLCD}" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,2,2,0"
                        Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="RAB" />
                        <uc:ImageShowControl Grid.Row="1" Source="{Binding CurrentResultImageRAB}" />
                    </Grid>

                    <Grid
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="2,2,0,0"
                        Background="Black">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="RCD" />
                        <uc:ImageShowControl Grid.Row="1" Source="{Binding CurrentResultImageRCD}" />
                    </Grid>
                </Grid>
            </Grid>

            <Border
                x:Name="StatusInfo"
                Grid.Column="1"
                Margin="0"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                SizeChanged="StatusInfo_SizeChanged">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <DockPanel>
                        <TextBlock
                            Margin="0,10,0,5"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Top"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="状态信息" />
                        <uc:PiePlotViewer
                            Height="{Binding ElementName=StatusInfo, Path=ActualWidth}"
                            DockPanel.Dock="Top"
                            Labels="{Binding DetectionSattisticalLabel}"
                            Values="{Binding DetectionSattisticalData}" />



                        <StackPanel Margin="10,10,0,10" DockPanel.Dock="Bottom">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="总检测数" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding TotalDetectionNum}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#FF9800"
                                    Text="NG" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding NGDetectionNum}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#2F80ED"
                                    Text="OK" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding OKDetectionNum}" />
                            </Grid>

                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="一次优率" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding OKRate, StringFormat={}{0:P2}}" />
                            </Grid>

                            <hc:UniformSpacingPanel
                                x:Name="uniformSpacingPanel"
                                Width="{Binding ElementName=StatusInfo, Path=Width}"
                                HorizontalAlignment="Center">
                                <Button
                                    x:Name="clearListBtn"
                                    Height="35"
                                    Background="#F5B041"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ClearListCommand}"
                                    Content="清空列表"
                                    FontSize="16"
                                    Foreground="Black" />
                                <Button
                                    x:Name="clearStatisticsBtn"
                                    Height="35"
                                    Background="#F5B041"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ClearStatisticsCommand}"
                                    Content="统计清零"
                                    FontSize="16"
                                    Foreground="Black" />
                            </hc:UniformSpacingPanel>
                        </StackPanel>

                        <ListView
                            x:Name="defectListView"
                            Background="Transparent"
                            FontSize="12"
                            FontWeight="Bold"
                            ItemsSource="{Binding DefectDataList}"
                            Style="{StaticResource ListView.Small}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="FontWeight" Value="Normal" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        x:Name="colType"
                                        DisplayMemberBinding="{Binding DefectType}"
                                        Header="缺陷类型" />
                                    <GridViewColumn
                                        x:Name="colCount"
                                        DisplayMemberBinding="{Binding Count}"
                                        Header="数量" />
                                    <GridViewColumn
                                        x:Name="colRatio"
                                        DisplayMemberBinding="{Binding Ratio, StringFormat={}{0:P2}}"
                                        Header="占比" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="2"
                BorderBrush="LightGray"
                BorderThickness="1">
                <TabControl>
                    <!--  第一页：数据页  -->
                    <TabItem FontSize="25" Header="统计数据">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  检测结果表格  -->
                            <DataGrid
                                x:Name="DgDetection"
                                Height="Auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutoGenerateColumns="False"
                                Background="#FFF5F5F5"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                ItemsSource="{Binding DetectionDataList}"
                                RowHeaderWidth="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Background" Value="#FFF5F5F5" />
                                        <Setter Property="FontSize" Value="20" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="1.6*"
                                        MinWidth="100"
                                        Binding="{Binding CellBarcode}"
                                        Header="条码">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Width="1.2*"
                                        MinWidth="80"
                                        Binding="{Binding NgDetails}"
                                        Header="缺陷类型">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        MinWidth="80"
                                        Binding="{Binding DetectionResult}"
                                        Header="检测结果">
                                        <!--  结果文字颜色：OK绿色，NG红色  -->
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="FontSize" Value="15" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="NG">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

