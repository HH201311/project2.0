<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.ClosedLoopSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cctbmodels="[cctbmodels ]clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:sc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls;assembly=SUNWODA_SEVB.Component"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Title="ClosedLoopSettingPage"
    d:DesignHeight="940"
    d:DesignWidth="1610"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  文本样式  -->
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="{x:Type hc:TextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="260" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="180" />
            </Style>

            <!--  下拉框样式  -->
            <Style BasedOn="{StaticResource HCParamComboBoxStyle}" TargetType="{x:Type hc:ComboBox}">
                <Setter Property="Width" Value="260" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="120" />
            </Style>

            <!--  键值对容器样式  -->
            <Style BasedOn="{StaticResource ParamPairContentControlStyle}" TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="Width" Value="260" />
                <Setter Property="PairKeyWidth" Value="120" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!--  开关样式  -->
            <Style
                x:Key="PVSimpleToggleButtonStyle"
                BasedOn="{StaticResource ParamValueSimpleToggleButtonStyle}"
                TargetType="{x:Type uccc:SimpleToggleButton}">
                <Setter Property="Width" Value="50" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="CheckedText" Value="是" />
                <Setter Property="UnCheckedText" Value="否" />
            </Style>

            <Style BasedOn="{StaticResource ModernHorizontalScrollBar}" TargetType="ScrollBar" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270*" />
            <RowDefinition Height="270*" />
            <RowDefinition Height="360*" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,20"
            Header="A面"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid
                Margin="20,20,0,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Rows="1">
                <sc:AlgorithmSettingControl
                    Margin="0,0,20,0"
                    AlgorithmEnableChangedCommand="{Binding AlgorithmEnableChangedCommand}"
                    AlgorithmName="{Binding AlgorithmModel_MDA.AlgorithmName, Mode=TwoWay}"
                    AlgorithmVerifyCommand="{Binding AlgorithmVerifyCommand}"
                    ClosedLoopType="{x:Static enums:EClosedLoopType.MD}"
                    IsAlgorithmEnabled="{Binding AlgorithmModel_MDA.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="{x:Static enums:ESideType.A}" />
                <sc:AlgorithmSettingControl
                    Margin="0,0,20,0"
                    AlgorithmEnableChangedCommand="{Binding AlgorithmEnableChangedCommand}"
                    AlgorithmName="{Binding AlgorithmModel_TDA.AlgorithmName, Mode=TwoWay}"
                    AlgorithmVerifyCommand="{Binding AlgorithmVerifyCommand}"
                    ClosedLoopType="{x:Static enums:EClosedLoopType.TD}"
                    IsAlgorithmEnabled="{Binding AlgorithmModel_TDA.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="{x:Static enums:ESideType.A}" />
                <sc:AlgorithmSettingControl
                    Margin="0,0,20,0"
                    AlgorithmEnableChangedCommand="{Binding AlgorithmEnableChangedCommand}"
                    AlgorithmName="{Binding AlgorithmModel_MDTDA.AlgorithmName, Mode=TwoWay}"
                    AlgorithmVerifyCommand="{Binding AlgorithmVerifyCommand}"
                    ClosedLoopType="{x:Static enums:EClosedLoopType.MDTD}"
                    IsAlgorithmEnabled="{Binding AlgorithmModel_MDTDA.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="{x:Static enums:ESideType.A}" />
            </UniformGrid>
        </GroupBox>
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,20"
            Header="B面"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid
                Margin="20,20,0,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Rows="1">
                <sc:AlgorithmSettingControl
                    Margin="0,0,20,0"
                    AlgorithmEnableChangedCommand="{Binding AlgorithmEnableChangedCommand}"
                    AlgorithmName="{Binding AlgorithmModel_MDB.AlgorithmName, Mode=TwoWay}"
                    AlgorithmVerifyCommand="{Binding AlgorithmVerifyCommand}"
                    ClosedLoopType="{x:Static enums:EClosedLoopType.MD}"
                    IsAlgorithmEnabled="{Binding AlgorithmModel_MDB.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="{x:Static enums:ESideType.B}" />
                <sc:AlgorithmSettingControl
                    Margin="0,0,20,0"
                    AlgorithmEnableChangedCommand="{Binding AlgorithmEnableChangedCommand}"
                    AlgorithmName="{Binding AlgorithmModel_TDB.AlgorithmName, Mode=TwoWay}"
                    AlgorithmVerifyCommand="{Binding AlgorithmVerifyCommand}"
                    ClosedLoopType="{x:Static enums:EClosedLoopType.TD}"
                    IsAlgorithmEnabled="{Binding AlgorithmModel_TDB.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="{x:Static enums:ESideType.B}" />
                <sc:AlgorithmSettingControl
                    Margin="0,0,20,0"
                    AlgorithmEnableChangedCommand="{Binding AlgorithmEnableChangedCommand}"
                    AlgorithmName="{Binding AlgorithmModel_MDTDB.AlgorithmName, Mode=TwoWay}"
                    AlgorithmVerifyCommand="{Binding AlgorithmVerifyCommand}"
                    ClosedLoopType="{x:Static enums:EClosedLoopType.MDTD}"
                    IsAlgorithmEnabled="{Binding AlgorithmModel_MDTDB.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="{x:Static enums:ESideType.B}" />
            </UniformGrid>
        </GroupBox>
        <Grid Grid.Row="2" Margin="0">
            <GroupBox Header="通用设置" Style="{StaticResource SimpleGroupBoxStyle}">
                <ScrollViewer
                    Margin="20,20,0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,0" Orientation="Horizontal">
                        <GroupBox Header="数据处理设置" Style="{StaticResource ParamGroupBoxStyle}">
                            <StackPanel Margin="20,0,20,20">
                                <hc:ComboBox
                                    Width="260"
                                    d:SelectedIndex="0"
                                    hc:InfoElement.Title="闭环数据源"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding WeightDataTypeSource}"
                                    SelectedValue="{Binding GeneralSettingsModel.WeightDataType, Mode=TwoWay}"
                                    SelectedValuePath="ItemValue" />
                                <hc:ComboBox
                                    Width="260"
                                    d:SelectedIndex="0"
                                    hc:InfoElement.Title="膜区处理"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding EMembraneZoneTypeSource}"
                                    SelectedValue="{Binding GeneralSettingsModel.MembraneZoneType, Mode=TwoWay}"
                                    SelectedValuePath="ItemValue" />
                                <hc:TextBox
                                    Width="260"
                                    hc:InfoElement.Placeholder="请输入"
                                    hc:InfoElement.Title="刀距滞后变化值（mm）"
                                    Text="{Binding GeneralSettingsModel.Lag_DearanceConditiont, Mode=TwoWay}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="PLC设定泵速读取配置" Style="{StaticResource ParamGroupBoxStyle}">
                            <StackPanel Margin="20,0,20,20">
                                <hc:TextBox
                                    Width="260"
                                    hc:InfoElement.Placeholder="请输入"
                                    hc:InfoElement.Title="小数位/精度"
                                    Text="{Binding GeneralSettingsModel.SetB_Digits, Mode=TwoWay}" />
                                <uccc:PairContentControl PairKeyText="四舍五入">
                                    <uccc:SimpleToggleButton
                                        d:IsChecked="False"
                                        IsChecked="{Binding GeneralSettingsModel.SetB_IsRound, Mode=TwoWay}"
                                        Style="{StaticResource PVSimpleToggleButtonStyle}" />
                                </uccc:PairContentControl>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="数据判异/数采设置" Style="{StaticResource ParamGroupBoxStyle}">
                            <StackPanel Margin="20,0,20,20">
                                <hc:TextBox
                                    Width="260"
                                    hc:InfoElement.Placeholder="请输入"
                                    hc:InfoElement.Title="走带速度（m/min）"
                                    Text="{Binding GeneralSettingsModel.VelocityCondition, Mode=TwoWay}" />
                                <hc:TextBox
                                    Width="260"
                                    hc:InfoElement.Placeholder="请输入"
                                    hc:InfoElement.Title="面密度目标值（±/mg）"
                                    Text="{Binding GeneralSettingsModel.TargetOffset, Mode=TwoWay}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="设备参数配置" Style="{StaticResource ParamGroupBoxStyle}">
                            <StackPanel Margin="20,0,20,20">
                                <hc:TextBox
                                    Width="260"
                                    hc:InfoElement.Placeholder="请输入"
                                    hc:InfoElement.Title="AB面走带间隔距离（m）"
                                    Text="{Binding GeneralSettingsModel.DistanceBetweenAB, Mode=TwoWay}" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="膜区配置" Style="{StaticResource ParamGroupBoxStyle}">
                            <Grid Margin="20,0,20,20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <hc:ComboBox
                                    Width="260"
                                    d:SelectedIndex="0"
                                    hc:InfoElement.Title="闭环数据源"
                                    DisplayMemberPath="DisplayName"
                                    ItemsSource="{Binding PartitionedTypeSource}"
                                    SelectedValue="{Binding GeneralSettingsModel.PartitionedType, Mode=TwoWay}"
                                    SelectedValuePath="ItemValue">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="SelectionChanged">
                                            <i:InvokeCommandAction Command="{Binding PartitionedSelectionChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </hc:ComboBox>
                                <ScrollViewer
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalScrollBarVisibility="Hidden">
                                    <ItemsControl ItemsSource="{Binding PartitionedModels, Mode=TwoWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <UniformGrid Margin="0,10,0,0" Rows="4">
                                                    <TextBlock
                                                        d:Text="膜区一"
                                                        Foreground="#CCFFFFFF"
                                                        Style="{StaticResource ParamNameTextBlockStyle}"
                                                        Text="{Binding PartitionedName, Mode=TwoWay}" />
                                                    <hc:TextBox
                                                        Width="260"
                                                        Margin="0,5,0,0"
                                                        hc:InfoElement.Title="起始位置"
                                                        hc:InfoElement.TitleWidth="160"
                                                        Opacity="0.6"
                                                        Text="{Binding StartIndex, Mode=TwoWay}" />
                                                    <hc:TextBox
                                                        Width="260"
                                                        Margin="0,5,0,0"
                                                        hc:InfoElement.Title="终止位置"
                                                        hc:InfoElement.TitleWidth="160"
                                                        Opacity="0.6"
                                                        Text="{Binding EndIndex, Mode=TwoWay}" />
                                                    <hc:TextBox
                                                        Width="260"
                                                        Margin="0,5,0,0"
                                                        hc:InfoElement.Title="分区个数"
                                                        hc:InfoElement.TitleWidth="160"
                                                        Opacity="0.6"
                                                        Text="{Binding PartitionedCount, Mode=TwoWay}" />
                                                </UniformGrid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
            <Button
                Margin="0,20,20,0"
                VerticalAlignment="Top"
                Command="{Binding ParamSaveCommand}"
                Content="保存"
                Style="{StaticResource ParamOKButtonStyle}" />
        </Grid>
    </Grid>
</Page>
