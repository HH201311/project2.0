<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CTAutoSlicer.ScreenColorPickerOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="屏幕取色"
    AllowsTransparency="True"
    Background="#01000000"
    Cursor="Cross"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Canvas x:Name="RootCanvas">
        <TextBlock
            Margin="24"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="White"
            IsHitTestVisible="False"
            Text="取色中：移动鼠标查看 9×9 放大格；左键确认，右键/Esc 取消" />

        <Border
            x:Name="PreviewPanel"
            Padding="8"
            Background="#F01E1E1E"
            BorderBrush="#FF00E5FF"
            BorderThickness="1"
            CornerRadius="6"
            IsHitTestVisible="False">
            <StackPanel>
                <Image
                    x:Name="MagnifierImage"
                    Width="126"
                    Height="126"
                    SnapsToDevicePixels="True"
                    Stretch="None" />
                <Border
                    x:Name="ColorSwatch"
                    Height="22"
                    Margin="0,8,0,4"
                    Background="Gray"
                    BorderBrush="White"
                    BorderThickness="1"
                    CornerRadius="3" />
                <TextBlock
                    x:Name="HexText"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="#000000" />
                <TextBlock
                    x:Name="RgbText"
                    Margin="0,2,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="#FFCCCCCC"
                    Text="RGB(0,0,0)" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
