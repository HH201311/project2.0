<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:hcData="clr-namespace:HandyControl.Data;assembly=HandyControl"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity;assembly=HandyControl">



    <Style x:Key="GrowlColsedButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="14" />
        <Setter Property="MinHeight" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
        <Setter Property="Content" Value="&#xe669;" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        Margin="{TemplateBinding Margin}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}">
                        <Border x:Name="border">
                            <ContentPresenter
                                Margin="5"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrowlConfirmButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Background" Value="#FF29CC7A" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Content" Value="确认" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Opacity="0.87" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrowlCancleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Content" Value="取消" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="#CCFFFFFF"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Opacity="0.8" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IndustrialGrowlStyle" TargetType="hc:Growl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinHeight" Value="120" />
        <Setter Property="Width" Value="400" />
        <Setter Property="MaxWidth" Value="400" />
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="8" />
        <Setter Property="Background" Value="#FF121212" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:Growl">
                    <Grid Name="PART_GridMain" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform X="{TemplateBinding MaxWidth}" />
                            </TransformGroup>
                        </Grid.RenderTransform>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!--  边框和背景  -->
                        <Border
                            Grid.Row="0"
                            Grid.RowSpan="3"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{Binding Path=(hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="0" Background="#1AFFFFFF">
                                <Border.Effect>
                                    <BlurEffect
                                        KernelType="Gaussian"
                                        Radius="50"
                                        RenderingBias="Performance" />
                                </Border.Effect>
                            </Border>
                        </Border>

                        <!--  图标&标题&关闭按钮  -->
                        <DockPanel
                            Grid.Row="0"
                            Margin="20,18"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            LastChildFill="False">
                            <Path
                                x:Name="PART_Icon"
                                Width="30"
                                Height="24"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Data="{TemplateBinding Icon}"
                                DockPanel.Dock="Left"
                                Fill="{TemplateBinding IconBrush}"
                                FlowDirection="LeftToRight"
                                Stretch="Uniform" />
                            <TextBlock
                                x:Name="PART_Title"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Left"
                                FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                                FontSize="20"
                                Foreground="{TemplateBinding Foreground}"
                                Opacity="0.8"
                                TextAlignment="Left" />
                            <!--  隐藏自带的按钮(因为名称绑定，没有的话会报错)  -->
                            <Button
                                Name="PART_ButtonClose"
                                Width="0"
                                Height="0"
                                Background="Transparent"
                                BorderThickness="0" />
                            <Button
                                Command="interactivity:ControlCommands.Close"
                                DockPanel.Dock="Right"
                                Style="{StaticResource GrowlColsedButtonStyle}" />
                        </DockPanel>

                        <!--  内容(消息&时间)  -->
                        <StackPanel
                            Grid.Row="1"
                            Margin="60,0,20,18"
                            VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Left"
                                FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
                                FontSize="14"
                                Foreground="{TemplateBinding Foreground}"
                                LineHeight="18"
                                Opacity="0.5"
                                Style="{StaticResource TextBlockDefault}"
                                Text="{TemplateBinding Message}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Left"
                                FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
                                FontSize="14"
                                Foreground="{TemplateBinding Foreground}"
                                Opacity="0.5"
                                Style="{StaticResource TextBlockDefault}"
                                Text="{Binding Time, RelativeSource={RelativeSource AncestorType=hc:Growl}, StringFormat=yyyy/MM/dd HH:mm:ss fff}"
                                Visibility="{Binding ShowDateTime, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Boolean2VisibilityConverter}}" />
                        </StackPanel>

                        <!--  下面的按钮  -->
                        <StackPanel
                            Name="PART_PanelMore"
                            Grid.Row="2"
                            Margin="0,0,20,20"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <Button Command="interactivity:ControlCommands.Confirm" Style="{StaticResource GrowlConfirmButtonStyle}" />
                            <Button Command="interactivity:ControlCommands.Cancel" Style="{StaticResource GrowlCancleButtonStyle}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Type" Value="{x:Static hcData:InfoType.Success}">
                            <Setter TargetName="PART_Title" Property="Text" Value="成功信息" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static hcData:InfoType.Info}">
                            <Setter TargetName="PART_Title" Property="Text" Value="信息提示" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static hcData:InfoType.Warning}">
                            <Setter TargetName="PART_Title" Property="Text" Value="普通提示" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static hcData:InfoType.Error}">
                            <Setter TargetName="PART_Title" Property="Text" Value="重要报警" />
                            <Setter TargetName="PART_PanelMore" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_PanelMore" Property="IsEnabled" Value="True" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static hcData:InfoType.Fatal}">
                            <Setter TargetName="PART_Title" Property="Text" Value="致命报警" />
                            <Setter TargetName="PART_Icon" Property="Fill" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static hcData:InfoType.Ask}">
                            <Setter TargetName="PART_Title" Property="Text" Value="询问信息" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>