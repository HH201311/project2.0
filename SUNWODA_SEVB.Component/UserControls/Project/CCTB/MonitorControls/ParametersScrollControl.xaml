<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ParametersScrollControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelcctb="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    xmlns:uccharts="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ChartToolTipStyle" TargetType="ToolTip">
                <Setter Property="Width" Value="500" />
                <Setter Property="Height" Value="220" />
                <Setter Property="Margin" Value="0,0,20,0" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="HasDropShadow" Value="True" />
                <Setter Property="Placement" Value="Left" />
                <Setter Property="HorizontalOffset" Value="0" />
                <Setter Property="VerticalOffset" Value="-100" />
                <Setter Property="Background" Value="#FF121212" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Grid Margin="{TemplateBinding Margin}" Background="Transparent">
                                <!--  边框&背景虚化效果  -->
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#1AFFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Border Background="#1AFFFFFF" Opacity="1">
                                        <Border.Effect>
                                            <BlurEffect
                                                KernelType="Gaussian"
                                                Radius="50"
                                                RenderingBias="Quality" />
                                        </Border.Effect>
                                    </Border>
                                </Border>
                                <!--  箭头&箭头的虚化背景效果  -->
                                <Grid
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,-18,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent">
                                    <Path
                                        Data="M 0,0 L 20,10 L 0,20"
                                        Fill="{TemplateBinding Background}"
                                        Stroke="#1AFFFFFF"
                                        StrokeThickness="1">
                                        <Path.Effect>
                                            <BlurEffect
                                                KernelType="Gaussian"
                                                Radius="5"
                                                RenderingBias="Quality" />
                                        </Path.Effect>
                                    </Path>
                                </Grid>
                                <!--  内容  -->
                                <ContentPresenter Margin="10,20,20,10" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <GroupBox
        d:Header="参数列表"
        Header="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
        Style="{StaticResource SimpleGroupBoxStyle}">
        <ScrollViewer Style="{StaticResource ModernScrollViewer}" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding ParameterSource, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <uccc:PairContentControl
                            Margin="10,0,10,10"
                            Content="{Binding PValue}"
                            PairKeyText="{Binding PName}"
                            PairKeyWidth="160"
                            Style="{StaticResource ParamPairContentControlStyle}">
                            <uccc:PairContentControl.ToolTip>
                                <ToolTip Style="{StaticResource ChartToolTipStyle}">
                                    <uccharts:MicroChartControl Title="{Binding PName}" ItemSource="{Binding PValues}" />
                                </ToolTip>
                            </uccc:PairContentControl.ToolTip>
                        </uccc:PairContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </GroupBox>
</UserControl>
