<Page
    x:Class="SUNWODA_SEVB.Views.Pages.Demo.MESTestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Tool.Converter;assembly=SUNWODA_SEVB.Tool"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:demo="clr-namespace:SUNWODA_SEVB.ViewModels.Pages.Demo"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.Demo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MESTestPage"
    d:DesignHeight="550"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  引用转换器  -->
        <converter:BoolToColorConverter x:Key="BoolToColorConverter" />
        <converter:InverseBoolConverter x:Key="InverseBoolConverter" />

        <!--  按钮样式  -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#007ACC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#005A9E" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#666666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#007ACC" />
            <Setter Property="BorderBrush" Value="#007ACC" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F8FF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCCCCC" />
                                <Setter Property="Foreground" Value="#CCCCCC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Border
            Margin="10"
            Background="White"
            BorderBrush="LightGray"
            BorderThickness="1"
            CornerRadius="5">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,15"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333333"
                    Text="MES 数据上传测试" />

                <!--  MES状态  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,15"
                    Padding="12"
                    Background="#F5F5F5"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,8"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#555555"
                            Text="MES服务状态:" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Grid.Column="0"
                                Width="14"
                                Height="14"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Fill="{Binding IsMesEnabled, Converter={StaticResource BoolToColorConverter}}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Text="{Binding UploadStatus}" />

                            <Button
                                Grid.Column="2"
                                Padding="10,5"
                                Command="{Binding CheckMesStatusCommand}"
                                Content="🔄 刷新状态"
                                Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  输入区域  -->
                <Border
                    Grid.Row="2"
                    Margin="0,0,0,15"
                    Padding="12"
                    Background="#FAFAFA"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#555555"
                            Text="产品序列号:" />
                        <TextBox
                            Padding="8"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            FontSize="12"
                            IsEnabled="{Binding IsUploading, Converter={StaticResource InverseBoolConverter}}"
                            Text="{Binding ProductSn, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TextBox">
                                                <Border
                                                    x:Name="border"
                                                    Background="White"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="3">
                                                    <ScrollViewer x:Name="PART_ContentHost" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsFocused" Value="True">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="#007ACC" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <TextBlock
                            Margin="0,12,0,5"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="#555555"
                            Text="测试结果:" />
                        <ComboBox
                            Padding="8"
                            BorderBrush="#CCCCCC"
                            FontSize="12"
                            IsEnabled="{Binding IsUploading, Converter={StaticResource InverseBoolConverter}}"
                            SelectedValue="{Binding TestResult}">
                            <ComboBoxItem Content="✓ 合格 (PASS)" Tag="1" />
                            <ComboBoxItem Content="✗ 不合格 (FAIL)" Tag="0" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!--  操作按钮  -->
                <StackPanel Grid.Row="3" Margin="0,0,0,15">
                    <TextBlock
                        Margin="0,0,0,8"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#555555"
                        Text="数据上传操作:" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Height="25"
                            Padding="12,10"
                            Command="{Binding UploadOfflineDataCommand}"
                            Content="📤 上传离线数据"
                            IsEnabled="{Binding IsMesEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Height="25"
                            Padding="12,10"
                            Command="{Binding UploadMarkingDataCommand}"
                            Content="📋 上传Marking数据"
                            IsEnabled="{Binding IsMesEnabled}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>

                    <!--  附加操作按钮  -->
                    <UniformGrid
                        Margin="0,10,0,0"
                        Columns="3"
                        Rows="1">
                        <Button
                            Height="20"
                            Margin="0,0,5,0"
                            Padding="8,6"
                            Command="{Binding ClearLogsCommand}"
                            Content="🗑️ 清空日志"
                            FontSize="11"
                            Style="{StaticResource SecondaryButtonStyle}" />

                        <Button
                            Margin="5,0,5,0"
                            Padding="8,6"
                            Command="{Binding ExportLogsCommand}"
                            Content="💾 导出日志"
                            FontSize="11"
                            Style="{StaticResource SecondaryButtonStyle}" />

                        <Button
                            Margin="5,0,0,0"
                            Padding="8,6"
                            Command="{Binding TestConnectionCommand}"
                            Content="🔌 测试连接"
                            FontSize="11"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </UniformGrid>
                </StackPanel>

                <!--  日志区域  -->
                <GroupBox
                    Grid.Row="4"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                    <GroupBox.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#555555"
                                Text="📝 日志信息" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#999999"
                                Text="{Binding UploadLogs.Count, StringFormat='({0} 条记录)'}" />
                        </StackPanel>
                    </GroupBox.Header>
                    <Border
                        Background="#FAFAFA"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        CornerRadius="3">
                        <ListBox
                            Margin="5"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding UploadLogs}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,2"
                                        Padding="5,3"
                                        Background="White"
                                        BorderBrush="#E0E0E0"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="2">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            Foreground="#333333"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </GroupBox>
            </Grid>
        </Border>
    </Grid>
</Page>
