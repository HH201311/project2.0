<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JRCW.JRCWClosedLoopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.JRCW;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JRCW"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxyWpf="http://oxyplot.org/wpf"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JRCW;assembly=SUNWODA_SEVB.Component"
    Title="JRCWClosedLoopPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JRCW/JRCWCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1048*" />
                <ColumnDefinition Width="752*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Column="0"
                Header="实时监控参数分析"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <!--  图表  -->
                    <oxyWpf:PlotView
                        Grid.Column="0"
                        Background="WhiteSmoke"
                        IsMouseWheelEnabled="False"
                        Model="{Binding LineSeriersModel}"
                        Visibility="Visible" />
                    <!--  PLC地址数据  -->
                    <Border
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Stretch"
                        Background="WhiteSmoke">
                        <ListBox
                            x:Name="plcAddressListView"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource CustomItemContainerStyleStyle}"
                            ItemsSource="{Binding PLCAddressModels}"
                            SelectionMode="Multiple">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItems, ElementName=plcAddressListView}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </ListBox>
                    </Border>
                </Grid>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Margin="20,0,0,0"
                Header="设备信息"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <uc:ProductionInfoControl Margin="0,20,0,0" ItemSource="{Binding ProductionInfoModel}" />
            </GroupBox>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="日志" />
                <Button
                    Command="{Binding BusinessParamCommand}"
                    CommandParameter="{Binding BusinessType}"
                    Content="参数配置"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SimpleButtonStyle}" />
            </DockPanel>

            <DataGrid
                x:Name="LogDataGrid"
                Grid.Row="1"
                Margin="0,20,0,0"
                AlternatingRowBackground="#F8F9FA"
                AutoGenerateColumns="False"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="True"
                FontFamily="Consolas"
                FontSize="12"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding AppLogs}"
                RowHeight="36"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VerticalGridLinesBrush="#E0E0E0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F8F9FA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#1976D2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#1976D2" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Background" Value="#FFF8F8F8" />
                        <Setter Property="BorderBrush" Value="#FFE0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="#FF333333" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Grid>
                                        <Border
                                            x:Name="headerBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="0">
                                            <ContentPresenter
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <Path
                                            x:Name="sortArrow"
                                            Width="10"
                                            Height="6"
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M 0,0 L 5,5 L 10,0 Z"
                                            Fill="#FF007ACC"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFE6F2FF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFCCE5FF" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="sortArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="sortArrow" Property="Data" Value="M 0,5 L 5,0 L 10,5 Z" />
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFE1F0FF" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="sortArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFE1F0FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#F5F5F5" />
                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                        <Setter Property="Width" Value="12" />
                        <Setter Property="Height" Value="12" />
                    </Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding LogTime}"
                        CanUserSort="True"
                        Header="时间">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Foreground" Value="#2C3E50" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip>
                                            <TextBlock
                                                Padding="4"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Text="{Binding LogTime}" />
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="400"
                        Binding="{Binding Message}"
                        CanUserSort="True"
                        Header="日志内容">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Foreground" Value="#2C3E50" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip MaxWidth="600">
                                            <TextBlock
                                                Padding="4"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn
                        Width="90"
                        CanUserSort="True"
                        Header="等级">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#E8F4FD"
                                    BorderBrush="#3498DB"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="#2980B9"
                                        Text="{Binding LogLevel}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Page>
