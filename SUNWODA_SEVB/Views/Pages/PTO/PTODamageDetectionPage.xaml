                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>
                    </TabItem>

                    <TabItem Header="报表设置" FontSize="25">

                        <!-- UserID 输入区域 -->
                        <StackPanel Margin="10,0,10,0">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40"/>
                                    <RowDefinition Height="40"/>
                                </Grid.RowDefinitions>

                                <TextBlock 
                                    Grid.Row="0" Grid.Column="0" 
                                    Text="报表内最大电芯数量：" 
                                    VerticalAlignment="Center" 
                                    FontWeight="Bold"
                                    FontSize="22"
                                    Margin="0,0,10,0"/>

                                <!-- 带上下箭头的输入框 -->
                                <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox 
                                        Grid.Column="0"
                                        Text="{Binding MaxImagesPerReport, Mode=TwoWay }"
                                        IsEnabled="{Binding IsInAnyDetection}"
                                        VerticalAlignment="Center"
                                        Height="30"
                                        FontSize="20"
                                        TextAlignment="Center"
                                        Margin="0,0,0,0"/>

                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Stretch">
                                        <!-- 上箭头按钮 -->
                                        <Button 
                                            Content="▲" 
                                            Height="15" 
                                            FontSize="8"
                                            Padding="0,-2,0,0"
                                            Command="{Binding IncrementMaxImagesCommand}" 
                                            IsEnabled="{Binding IsInAnyDetection}"    
                                            Background="LightGray"
                                            BorderThickness="0,1,1,0.5"/>

                                        <!-- 下箭头按钮 -->
                                        <Button 
                                            Content="▼" 
                                            Height="15" 
                                            FontSize="8"
                                            Padding="0,-2,0,0"
                                            Command="{Binding DecrementMaxImagesCommand}"
                                            IsEnabled="{Binding IsInAnyDetection}"
                                            Background="LightGray"
                                            BorderThickness="0,0.5,1,1"/>
                                    </StackPanel>
                                </Grid>

                                <Button 
                                    Grid.Row="0" Grid.Column="2" 
                                    Content="保存" 
                                    Height="30" 
                                    Margin="10,5,0,5" 
                                    Background="#5DADE2"
                                    Command="{Binding SaveMaxImagesCommand}" IsEnabled="{Binding IsInAnyDetection}"/>

                                <TextBlock 
                                    Grid.Row="1" Grid.Column="0" 
                                    Text="生成报表最大间隔时间：" 
                                    FontSize="22"
                                    VerticalAlignment="Center" 
                                    FontWeight="Bold"
                                    Margin="0,0,10,0"/>

                                <!-- 带上下箭头的输入框 -->
                                <Grid Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox 
                                        Grid.Column="0"
                                        Text="{Binding ReportTimeoutMinutes, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"
                                        VerticalAlignment="Center"
                                        Height="30"
                                        FontSize="20"
                                        TextAlignment="Center"
                                        Margin="0,0,0,0"/>

                                    <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Stretch">
                                        <!-- 上箭头按钮 -->
                                        <Button 
                                            Content="▲" 
                                            Height="15" 
                                            FontSize="8"
                                            Padding="0,-2,0,0"
                                            Command="{Binding IncrementTimeoutCommand}" IsEnabled="{Binding IsInAnyDetection}"
                                            Background="LightGray"
                                            BorderThickness="0,1,1,0.5"/>

                                        <!-- 下箭头按钮 -->
                                        <Button 
                                            Content="▼" 
                                            Height="15" 
                                            FontSize="8"
                                            Padding="0,-2,0,0"
                                            Command="{Binding DecrementTimeoutCommand}" IsEnabled="{Binding IsInAnyDetection}"
                                            Background="LightGray"
                                            BorderThickness="0,0.5,1,1"/>
                                    </StackPanel>
                                </Grid>

                                <Button 
                                    Grid.Row="1" Grid.Column="2" 
                                    Content="保存" 
                                    Height="30" 
                                    Margin="10,5,0,5" 
                                    Background="#5DADE2"
                                    Command="{Binding SaveTimeoutCommand}" IsEnabled="{Binding IsInAnyDetection}"/>
                            </Grid>
                            <TextBlock Text="添加推送用户 ID" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox 
                                    Width="200"
                                    Height="32"
                                    FontSize="16"
                                    Text="{Binding NewUserId, UpdateSourceTrigger=PropertyChanged}"
                                    MaxLength="10"
                                    Margin="0,0,10,0"
                                    ToolTip="仅允许输入10位数字"/>

                                <Button 
                                    Content="保存"
                                    Width="100"
                                    Height="32"
                                    FontSize="16"
                                    Command="{Binding SaveUserIdCommand}"
                                    IsEnabled="{Binding CanSaveUserId}"
                                    Background="#5DADE2"
                                    Foreground="White"
                                    BorderThickness="0"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding SavedUserIds}" Margin="0,15,0,0" Width="160" HorizontalAlignment="Left">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border 
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            Height="Auto"
                                            Padding="0"
                                            Margin="0,0,0,10"
                                            CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Text="{Binding}" FontSize="18" VerticalAlignment="Center"/>

                                                <Button 
                                                    Content="×"
                                                    Grid.Column="1"
                                                    Command="{Binding DataContext.DeleteUserIdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="Red"
                                                    BorderThickness="0"
                                                    Width="25"
                                                    Height="25"
                                                    ToolTip="删除该用户ID"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- 底部版权栏 -->
        <Grid Grid.Row="2" Margin="0,0,0,0" Background="LightGray">
            <TextBlock Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" 
                           HorizontalAlignment="Right" Margin="5" FontSize="15"/>

        </Grid>
        <Grid 
    Grid.RowSpan="3" 
    Visibility="{Binding IsDrawFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">

            <Grid.Background>
                <SolidColorBrush Color="#33000000" Opacity="0.8"/>
            </Grid.Background>

            <mah:Flyout 
                    x:Name="DrawRoiFlyout"
                    DataContext="{StaticResource DamageDetectionVM}"
                    IsOpen="True"
                    Position="Left"
                    Width="950" 
                    Height="650"
                    AnimateOpacity="True"
                    CloseButtonVisibility="Collapsed"
                    Background="White"
                    BorderThickness="0">

                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <StackPanel 
                        Grid.Row="0" 
                        Orientation="Horizontal" 
                        Margin="25,20,25,15" 
                        VerticalAlignment="Center">

                        <TextBlock FontSize="22" FontWeight="Bold" Foreground="#2C3E50"
           Text="{Binding DrawTitle}"/>
                    </StackPanel>

                    <Border 
                        Grid.Row="0" 
                        Margin="25,60,25,0" 
                        Height="1" 
                        Background="#E5E7EB"/>

                    <Grid Grid.Row="1" Margin="25,10,25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>

                        <Border 
                            Grid.Column="0" 
                            CornerRadius="8" 
                            BorderThickness="1" 
                            BorderBrush="#E5E7EB"
                            Margin="0,0,15,0">

                            <Grid>
                                <StackPanel 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock 
                                        Text="图片加载中..." 
                                        FontSize="16" 
                                        Foreground="#94A3B8"/>
                                </StackPanel>

                                <InkCanvas 
                                    x:Name="NegativeRoiInkCanvas" 
                                    Margin="10"
                                    Cursor="Arrow"
                                    Loaded="NegativeRoiInkCanvas_Loaded">

                                    <InkCanvas.DefaultDrawingAttributes>
                                        <DrawingAttributes 
                                        Color="#E74C3C" 
                                        Width="4" 
                                        Height="4" 
                                        FitToCurve="True"/>

                                    </InkCanvas.DefaultDrawingAttributes>
                                    <InkCanvas.Background>
                                        <ImageBrush 
                                        ImageSource="{Binding CurrentRoiImageSource}" 
                                        Stretch="Uniform"
                                        Opacity="0.95"/>
                                    </InkCanvas.Background>
                                </InkCanvas>
                            </Grid>
                        </Border>

                        <Border 
                                Grid.Column="1" 
                                CornerRadius="8" 
                                Background="#F8FAFC" 
                                Padding="20"
                                BorderThickness="1"
                                BorderBrush="#E5E7EB">

                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <TextBlock 
                                        Text="绘制说明" 
                                        FontSize="16" 
                                        FontWeight="SemiBold" 
                                        Foreground="#2C3E50"/>
                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">

                                        <TextBlock 
                                            Text="1.鼠标在左侧图片绘制封闭区域" 
                                            FontSize="14" 
                                            Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">

                                        <TextBlock 
                                            Text="2.区域内负极缺陷将被系统过滤" 
                                            FontSize="14" 
                                            Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">

                                        <TextBlock 
                                            Text="3.绘制错误可点击「删除绘制」重绘" 
                                            FontSize="14" 
                                            Foreground="#475569"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">

                                        <TextBlock 
                                            Text="4.完成后点击「保存区域」生效" 
                                            FontSize="14" 
                                            Foreground="#475569"/>  
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                                        <TextBlock 
                                            Text="5.点击「取消」放弃当前绘制" 
                                            FontSize="14" 
                                            Foreground="#475569"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border 
                            Grid.Row="2" 
                            Margin="25,0,25,25" 
                            CornerRadius="8" 
                            Background="#F8FAFC"
                            BorderThickness="1"
                            BorderBrush="#E5E7EB">
                        <StackPanel 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center"
                            Margin="0,15,0,15">

                            <Button 
                                Content="删除绘制" 
                                Command="{Binding DeleteNegativeRoiCommand}" 
                                IsEnabled="{Binding IsInAnyDetection}" 
                                Background="OrangeRed"
                                Width="130" 
                                Height="42" 
                                Margin="0,0,15,0"/>

                            <Button 
                                Content="保存区域" 
                                Command="{Binding SaveNegativeRoiCommand}" 
                                IsEnabled="{Binding IsInAnyDetection}" 
                                Background="GreenYellow"
                                Width="130" 
                                Height="42" 
                                Margin="0,0,15,0" />

                            <Button 
                                Content="取消" 
                                Background="AliceBlue"
                                Command="{Binding CancelDrawRoiCommand}" 
                                Width="130" 
                                Height="42"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </mah:Flyout>
        </Grid>
    </Grid>
</Page>
