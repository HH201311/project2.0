<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls.DeviceStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB.FormEnums;assembly=SUNWODA_SEVB.Core"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="deviceStatusControl"
    Width="60"
    Height="60"
    d:DesignHeight="60"
    d:DesignWidth="60"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style x:Key="DeviceNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>
            <Style x:Key="DeviceStatusTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>
            <Style x:Key="AcceptDeviceCountTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1AFFFFFF" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已连接}">
                            <Setter Property="Background" Value="#FF29CC7A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                            <Setter Property="Background" Value="#FF29CC7A" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未连接}">
                            <Setter Property="Background" Value="DarkRed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未开启}">
                            <Setter Property="Background" Value="DarkRed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <UniformGrid Margin="6" Rows="2">
            <TextBlock d:Text="涂布机" Text="{Binding DeviceName, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource DeviceNameTextBlockStyle}" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#CCFFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未启用}">
                                <Setter Property="Foreground" Value="#99FFFFFF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock d:Text="设备状态" Text="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource DeviceStatusTextBlockStyle}" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#CCFFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未启用}">
                                <Setter Property="Foreground" Value="#99FFFFFF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </UniformGrid>
        <Grid
            Width="25"
            Height="25"
            Margin="0,-5,-10,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Ellipse Fill="Green" />
            <TextBlock
                x:Name="AcceptDeviceCountTextBlock"
                d:Text="9+"
                Style="{StaticResource AcceptDeviceCountTextBlockStyle}"
                Text="0" />
        </Grid>
    </Grid>
</UserControl>
