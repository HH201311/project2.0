<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JRCW.JRCWClosedLoopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JRCW"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxyWpf="http://oxyplot.org/wpf"
    Title="JRCWClosedLoopPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="SimpleGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{StaticResource CCTB.AlimamaShuHeiTi}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style x:Key="ParamGroupBoxStyle" TargetType="GroupBox">
            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5,10" />
            <Setter Property="BorderBrush" Value="#D5DFE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid SnapsToDevicePixels="true">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="4"
                                BorderBrush="Black"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                                <Border
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                    <Border
                                        BorderBrush="White"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2" />
                                </Border>
                            </Border>
                            <Border
                                x:Name="Header"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Padding="3,1,3,0"
                                HorizontalAlignment="Left"
                                Background="White">
                                <ContentPresenter
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <ContentPresenter
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="{TemplateBinding Padding}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ParamNameTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>

        <Style x:Key="ParamValueTextBoxStyle" TargetType="TextBox">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" MinHeight="320" />
            <RowDefinition Height="3*" MinHeight="100" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1048*" />
                <ColumnDefinition Width="752*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Column="0"
                Header="实时监控参数分析"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <!--  图表  -->
                    <oxyWpf:PlotView
                        Grid.Column="0"
                        Background="WhiteSmoke"
                        IsMouseWheelEnabled="False"
                        Model="{Binding LineSeriersModel}"
                        Visibility="Visible" />
                    <!--  PLC地址数据  -->
                    <Border
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Stretch"
                        Background="WhiteSmoke">
                        <ListBox
                            x:Name="plcAddressListView"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding PLCAddressModels}"
                            SelectionMode="Multiple">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItems, ElementName=plcAddressListView}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Border
                                                        Name="SelectBorder"
                                                        Margin="1"
                                                        Padding="2"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="0">
                                                        <Grid x:Name="DockPanel1">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition />
                                                            </Grid.RowDefinitions>
                                                            <DockPanel VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Name="SelectText"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="12"
                                                                    Foreground="#666666"
                                                                    Text="{Binding PName}" />
                                                                <TextBlock
                                                                    Margin="0,0,20,0"
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="12"
                                                                    Foreground="#3355FF"
                                                                    Text="{Binding PValue}">
                                                                    <TextBlock.ToolTip>
                                                                        <TextBlock
                                                                            MaxWidth="500"
                                                                            Text="{Binding PValue}"
                                                                            TextWrapping="NoWrap" />
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="DockPanel1" Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAEDFF" />
                                                    </Trigger>
                                                    <!--  选中  -->
                                                    <Trigger Property="Selector.IsSelected" Value="true">
                                                        <Setter Property="Background" Value="#EAEDFF" />
                                                        <Setter TargetName="SelectBorder" Property="BorderBrush" Value="Transparent" />
                                                        <Setter TargetName="SelectText" Property="Foreground" Value="#3355FF" />
                                                    </Trigger>
                                                    <!--  多条件触发器  -->
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <!--  是否已被选中，含多选情况  -->
                                                            <Condition Property="Selector.IsSelected" Value="True" />
                                                            <!--  是否是当前选中项，多选时为焦点所在项  -->
                                                            <Condition Property="Selector.IsFocused" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter TargetName="SelectBorder" Property="BorderBrush" Value="#14AAE6" />
                                                        <Setter TargetName="SelectText" Property="Foreground" Value="#14AAE6" />
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </Grid>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Margin="20,0,0,0"
                Header="设备信息"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,20,0,0"
                    Background="WhiteSmoke"
                    CornerRadius="20">
                    <ItemsControl d:ItemsSource="{d:SampleData ItemCount=7}" ItemsSource="{Binding ProductInfoModel}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="5" CornerRadius="5">
                                    <StackPanel Margin="2,0" VerticalAlignment="Center">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                Margin="0,0,10,20"
                                                FontSize="14"
                                                Foreground="#666666"
                                                Text="{Binding PName}"
                                                TextAlignment="Right" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Text="{Binding PValue}"
                                                TextAlignment="Left">
                                                <TextBlock.ToolTip>
                                                    <TextBlock
                                                        MaxWidth="500"
                                                        Text="{Binding PValue}"
                                                        TextWrapping="NoWrap" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </GroupBox>
        </Grid>

        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,20"
            Header="闭环配置参数(可在“设置”界面修改参数)"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid Margin="0,20,0,0" Rows="1">
                <GroupBox Header="数据处理设置" Style="{StaticResource ParamGroupBoxStyle}">
                    <StackPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t1" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.T1, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t2" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.T2, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t3" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.T3, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="参数设置" Style="{StaticResource ParamGroupBoxStyle}">
                    <StackPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t4" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.T4, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="单次调节量上限" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.U_Limit, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="调节系数K值" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.K, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="调节设置" Style="{StaticResource ParamGroupBoxStyle}">
                    <StackPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="变径调节精度" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.J_d, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="压花调节阈值" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.P_Switch, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="压花调节系数p_t" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.P_t, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="压花调节精度" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.P_j_d, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="极耳层数" Style="{StaticResource ParamGroupBoxStyle}">
                    <StackPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="正极层数" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.Nb, Mode=TwoWay}" />
                        </DockPanel>
                        <DockPanel Margin="1,5">
                            <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="负极层数" />
                            <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding JRCWParamSettingModel.Na, Mode=TwoWay}" />
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
            </UniformGrid>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Header="日志"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <ScrollViewer
                Margin="0,20,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ParamName}" />
                                <TextBlock Grid.Column="1" Text="{Binding ParamValue}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</Page>
