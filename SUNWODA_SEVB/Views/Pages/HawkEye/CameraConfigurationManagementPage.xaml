<Page
    x:Class="SUNWODA_SEVB.Views.Pages.HawkEye.CameraConfigurationManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ImageViewer="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    xmlns:core1="clr-namespace:SUNWODA_SEVB.Core.Models.Project.HawkEye;assembly=SUNWODA_SEVB.Core"
    xmlns:core2="clr-namespace:SUNWODA_SEVB.Core.Common.Commands;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.HawkEye"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="相机配置管理"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <hc:ScrollViewer
        Grid.Row="1"
        Margin="10"
        VerticalScrollBarVisibility="Auto">
        <ItemsControl Margin="5,0,0,0" ItemsSource="{Binding CompositeItems}">
            <!--  1. 将布局面板替换为WrapPanel  -->
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="{Binding Columns}"
                        IsItemsHost="True"
                        Rows="{Binding Rows}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <!--  2. 定义如何显示每个数据项 (DataTemplate)  -->
            <ItemsControl.Resources>
                <!--  相机模型类绑定  -->
                <DataTemplate DataType="{x:Type core1:CameraModel}">
                    <GroupBox Margin="0,0,5,5" Style="{x:Null}">
                        <GroupBox.Header>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Foreground="#3355FF">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0}   ip:{1}">
                                            <Binding Path="Name" />
                                            <Binding Path="HostIP" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock MaxWidth="480" TextWrapping="Wrap">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}标定文件: {0}">
                                            <Binding Path="CalibrationFilePath" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--  基本信息  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="White"
                                Orientation="Vertical">
                                <DockPanel Margin="5" LastChildFill="False">
                                    <TextBlock
                                        Width="80"
                                        Margin="0,5,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="配置启用:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <CheckBox
                                        Margin="0,5,0,0"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        Content="启用"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsChecked="{Binding Enable}" />
                                </DockPanel>
                                <DockPanel Margin="5,0" LastChildFill="False">
                                    <TextBlock
                                        Width="80"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="去除畸变:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <CheckBox
                                        Margin="0,5,0,5"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        Content="启用"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsChecked="{Binding RemoveDistortion}"
                                        IsEnabled="{Binding IsEnable}" />
                                </DockPanel>
                                <DockPanel Margin="5,0" LastChildFill="False">
                                    <TextBlock
                                        Width="80"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="实时画面:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <CheckBox
                                        Margin="0,5,0,5"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        Content="启用"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsChecked="{Binding RealTimeDisplay}"
                                        IsEnabled="{Binding IsEnable}" />
                                </DockPanel>
                                <DockPanel Margin="5,0" LastChildFill="False">
                                    <TextBlock
                                        Width="80"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="视频保存:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <CheckBox
                                        Margin="0,5,0,5"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        Content="启用"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsChecked="{Binding VideoSaving}"
                                        IsEnabled="{Binding IsEnable}" />
                                </DockPanel>
                                <DockPanel Margin="5" LastChildFill="True">
                                    <TextBlock
                                        Width="80"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="相机名称:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <TextBox
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsEnabled="{Binding IsEnable}"
                                        Text="{Binding Name}" />
                                </DockPanel>
                                <DockPanel Margin="5" LastChildFill="True">
                                    <TextBlock
                                        Width="80"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="相机IP:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <TextBox
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsEnabled="{Binding IsEnable}"
                                        Text="{Binding HostIP}" />
                                </DockPanel>
                                <DockPanel Margin="5" LastChildFill="True">
                                    <TextBlock
                                        Width="80"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="工位名称:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <TextBox
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="Blue"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsEnabled="{Binding IsEnable}"
                                        Text="{Binding WorkStation}" />
                                </DockPanel>
                            </StackPanel>
                            <!--  其他信息  -->
                            <StackPanel
                                Grid.Row="0"
                                Grid.Column="1"
                                Background="White"
                                Orientation="Vertical">
                                <DockPanel Margin="5" LastChildFill="False">
                                    <TextBlock
                                        Width="65"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="分辨率:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <TextBox
                                        Width="100"
                                        BorderBrush="Blue"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsEnabled="{Binding IsEnable}"
                                        Text="{Binding Resolution}" />
                                    <TextBlock
                                        Width="50"
                                        Margin="5,5,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="FPS"
                                        TextAlignment="Left" />
                                </DockPanel>
                                <DockPanel Margin="5,0" LastChildFill="False">
                                    <TextBlock
                                        Width="65"
                                        Margin="0,5,0,0"
                                        VerticalAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="通讯协议:"
                                        TextAlignment="Left" />
                                    <Rectangle Width="5" />
                                    <ComboBox
                                        Width="100"
                                        Margin="0,5,0,0"
                                        VerticalContentAlignment="Center"
                                        DockPanel.Dock="Left"
                                        FontSize="14"
                                        FontWeight="Black"
                                        IsEnabled="{Binding IsEnable}"
                                        ItemsSource="{Binding ProtocolList}"
                                        SelectedItem="{Binding Protocol}" />
                                </DockPanel>
                                <StackPanel Margin="5">
                                    <TextBlock
                                        Width="80"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Text="备注:"
                                        TextAlignment="Left" />
                                    <Rectangle Height="5" />
                                    <TextBox
                                        Height="121"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Top"
                                        AcceptsReturn="True"
                                        AcceptsTab="True"
                                        BorderBrush="Blue"
                                        DockPanel.Dock="Left"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        IsEnabled="{Binding IsEnable}"
                                        Text="{Binding Remake}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                            <!--  功能区块  -->
                            <StackPanel
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Background="White"
                                Orientation="Vertical">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button
                                        MinWidth="80"
                                        MinHeight="30"
                                        Margin="0,5,10,10"
                                        VerticalContentAlignment="Center"
                                        Background="#3355FF"
                                        Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="删除"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Foreground="White"
                                        IsEnabled="{Binding IsEnable}" />
                                    <Button
                                        MinWidth="80"
                                        MinHeight="30"
                                        Margin="0,5,10,10"
                                        VerticalContentAlignment="Center"
                                        Background="#3355FF"
                                        Command="{Binding DataContext.LoadCalibrationConfigCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="加载标定文件"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Foreground="White" />
                                    <Button
                                        MinWidth="80"
                                        MinHeight="30"
                                        Margin="0,5,10,10"
                                        VerticalContentAlignment="Center"
                                        Background="#3355FF"
                                        Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                        CommandParameter="{Binding}"
                                        Content="保存并执行"
                                        FontSize="14PX"
                                        FontWeight="Black"
                                        Foreground="White" />
                                </StackPanel>
                                <!--  实时图像显示区  -->
                                <Border
                                    Height="275"
                                    Margin="5"
                                    BorderBrush="#3355FF"
                                    BorderThickness="1">

                                    <ScrollViewer
                                        PreviewMouseLeftButtonDown="OnMouseDown"
                                        PreviewMouseLeftButtonUp="OnMouseUp"
                                        PreviewMouseMove="OnMouseMove"
                                        PreviewMouseWheel="OnMouseWheel">
                                        <Image
                                            RenderTransformOrigin="0.5,0.5"
                                            Source="{Binding ImageSources}"
                                            Stretch="Uniform">
                                            <Image.RenderTransform>
                                                <TransformGroup />
                                            </Image.RenderTransform>
                                        </Image>
                                    </ScrollViewer>

                                </Border>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </DataTemplate>
                <!--  命令绑定按钮  -->
                <DataTemplate DataType="{x:Type core2:RelayCommand}">
                    <Button
                        Width="60"
                        Height="50"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding}">
                        <Image Source="/Assets/images/plus.png" Stretch="UniformToFill">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="2" ScaleY="2" />
                            </Image.RenderTransform>
                            <Image.RenderTransformOrigin>
                                <Point X="0.5" Y="0.5" />
                            </Image.RenderTransformOrigin>
                        </Image>
                    </Button>
                </DataTemplate>
            </ItemsControl.Resources>
        </ItemsControl>
    </hc:ScrollViewer>
</Page>
