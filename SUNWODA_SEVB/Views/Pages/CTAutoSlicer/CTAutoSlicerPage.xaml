                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource CasParamHelpIconTextStyle}" />
                            </Border>
                            </StackPanel>
                            <Border Style="{StaticResource CasFormSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CasFormSectionTitleStyle}" Text="阶段单测按钮" />
                                    <TextBlock Style="{StaticResource CasFormSectionDescStyle}" Text="逐阶段验证标定与各阶段自动化是否正常；生产请使用页面底部「开始流程」。" />
                                    <Border
                                        Margin="0,0,0,12"
                                        Padding="12,10"
                                        Background="#14C0392B"
                                        BorderBrush="#66C0392B"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                        <TextBlock
                                            Foreground="#C0392B"
                                            FontWeight="SemiBold"
                                            Text="仅测试阶段使用，生产阶段请勿点击。误点可能干扰正在运行的 VG。"
                                            TextWrapping="Wrap" />
                                    </Border>
                                    <UniformGrid Columns="2">
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestRenderingPresetCommand}"
                                            Content="1  测试应用渲染预设"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestHistogramGrayScaleCommand}"
                                            Content="2  测试直方图灰度调整"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            ToolTip="需已标定 ROI + LUT 关键段两点：截图→峰谷→拖红线→中点对齐红线"
                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestThickPlateCommand}"
                                            Content="3  测试厚板设置(三象限)"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestSimple321AlignmentCommand}"
                                            Content="4  测试简单3-2-1对齐"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            ToolTip="需已标定 3D ROI +「上」ROI + 简单对齐下拉 + 三点后偏移Edit"
                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding OpenVision3dPointsStepDebugCommand}"
                                            Content="4b 本地3D找点分步调试"
                                            ToolTip="不跑 VG：对 vision_3d 截图逐步执行 Vision3dSectionPointsDetector，查看每步中间图定位失败点"
                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestPostAlignCaptureDragCommand}"
                                            Content="5  测试对齐后拖拽"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            ToolTip="需已标定 3D图正视图切换按钮位置与拖拽箭头；VG 已打开且处于可对齐后视图操作的状态"
                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestSliceExportCommand}"
                                            Content="6  测试切片导出+交接"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
