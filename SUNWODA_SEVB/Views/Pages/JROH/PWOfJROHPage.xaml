<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JROH.PWOfJROHPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:jrohuc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JROH;assembly=SUNWODA_SEVB.Component"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JROH"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="PWOfJROHPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JROH/JROHCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style BasedOn="{StaticResource SimpleGroupBoxStyle}" TargetType="GroupBox" />
            <Style BasedOn="{StaticResource SimpleDataGridStyle}" TargetType="DataGrid" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--  正极宽度值图表  -->
        <jrohuc:PoleWidthPlot
            Title="正极宽度曲线"
            Grid.Column="0"
            LineSeriesCollection="{Binding SeriesOfPos}"
            LowerLine="{Binding LowerOfPos}"
            ShowGrid="True"
            ShowLegend="True"
            UpperLine="{Binding UpperOfPos}"
            YAxisLabel="宽度 (mm)" />
        <jrohuc:PoleWidthPlot
            Title="负极宽度曲线"
            Grid.Column="1"
            LineSeriesCollection="{Binding SeriesOfNeg}"
            LowerLine="{Binding LowerOfNeg}"
            ShowGrid="True"
            ShowLegend="True"
            UpperLine="{Binding UpperOfNeg}"
            YAxisLabel="宽度 (mm)" />
        <Grid
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                LastChildFill="False">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="调机日志" />
                <Button
                    Command="{Binding BusinessParamCommand}"
                    Content="参数配置"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SimpleButtonStyle}"
                    Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}" />
            </DockPanel>
            <!--  调机记录  -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding AdjustmentRecordsView}" />
        </Grid>
    </Grid>
</Page>
