<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.JRCW.MessageBoxDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.JRCW"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="Auto"
    Height="Auto"
    MinWidth="800"
    MinHeight="450"
    d:Height="450"
    d:Width="800"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  标题样式  -->
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  倒计时信息  -->
            <Style x:Key="CountdownTimeTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#5AFFFFFF" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>

            <!--  信息  -->
            <Style x:Key="MessageTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="10,20" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  关闭按钮  -->
            <Style x:Key="ClosedButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  功能按钮  -->
            <Style
                x:Key="ConfirmButtonStyle"
                BasedOn="{StaticResource GrowlConfirmButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="#FF3DCC84" />
                <Setter Property="Content" Value="确认" />
                <Setter Property="Command" Value="{Binding ConfirmCommand}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style
                x:Key="CancleButtonStyle"
                BasedOn="{StaticResource GrowlCancleButtonStyle}"
                TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Content" Value="取消" />
                <Setter Property="Command" Value="{Binding CancleCommand}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20,0,20,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock
                d:Text="警告"
                DockPanel.Dock="Left"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{Binding Caption}" />
            <TextBlock
                Margin="10,0,0,0"
                d:Text="(窗口将在 5 秒后关闭)"
                DockPanel.Dock="Left"
                Style="{StaticResource CountdownTimeTextBlockStyle}"
                Text="{Binding RemainTime, StringFormat='(窗口将在 {0} 秒后关闭)'}"
                Visibility="{Binding CountdownTimeVisibility}" />
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource ClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <TextBlock
            Grid.Row="1"
            d:Text="报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息报警信息"
            Style="{StaticResource MessageTextBlockStyle}"
            Text="{Binding MessageText}" />

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button Style="{StaticResource ConfirmButtonStyle}" />
            <Button Style="{StaticResource CancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

