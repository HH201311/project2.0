<Window
    x:Class="SUNWODA_SEVB.Views.Pages.ZZSIX.Pack6MissingShotAlarmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="缺张报警"
    Width="720"
    Height="480"
    MinWidth="560"
    MinHeight="360"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ShowInTaskbar="True"
    Background="#FFFFF8E7"
    ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="16,12"
            Background="#FFF39C12"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="#FF3D2E00"
                    Text="缺张报警" />
                <TextBlock
                    x:Name="ProductText"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#FF5D4E00"
                    Text="产品：" />
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="1"
            Margin="0,16,0,8"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="#FF7D6608"
            Text="缺少以下相机张序：" />

        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#FFF39C12"
            BorderThickness="2"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox
                    x:Name="DetailBox"
                    Margin="8"
                    AcceptsReturn="True"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FF7D6608"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>

        <Button
            Grid.Row="3"
            Height="52"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch"
            Background="#FFF39C12"
            Click="OnConfirmClick"
            Content="确定"
            FontSize="20"
            FontWeight="Bold"
            Foreground="#FF3D2E00" />
    </Grid>
</Window>
