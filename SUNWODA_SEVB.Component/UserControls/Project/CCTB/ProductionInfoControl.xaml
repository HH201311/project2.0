<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ProductionInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelcctb="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  表头样式  -->
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  键值对样式  -->
            <Style x:Key="ParameterPairContentControlStyle" TargetType="ContentControl">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="Medium"
                                    Foreground="#99FFFFFF"
                                    Text="{Binding Path=Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                    TextAlignment="Left" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,0,0"
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="Bold"
                                    Foreground="#CCFFFFFF"
                                    Text="{Binding Path=Content, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                                    TextAlignment="Left" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <GroupBox
            x:Name="PPairsGroupBox"
            Margin="0,0,0,0"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <ContentControl x:Name="ProductionInfoContentControl" Margin="60,20,60,20">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="1.5*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="1.5*" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="5*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Grid.Row="0"
                                Grid.Column="0"
                                Content="{Binding CellModel}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="生产型号" />
                            <ContentControl
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="{Binding FilmRollNumber}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="膜卷号" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource HeaderTextBlockStyle}"
                                Text="面密度净重规格" />
                            <ContentControl
                                Grid.Row="2"
                                Grid.Column="0"
                                Content="{Binding NetWeightSpecificationDisplay_A}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="单面" />
                            <ContentControl
                                Grid.Row="2"
                                Grid.Column="1"
                                Content="{Binding NetWeightSpecificationDisplay_B}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="双面" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource HeaderTextBlockStyle}"
                                Text="尺寸规格" />
                            <ContentControl
                                Grid.Row="4"
                                Grid.Column="0"
                                Content="{Binding CCDSpecificationDisplay_MembraneZone}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="膜区" />
                            <ContentControl
                                Grid.Row="4"
                                Grid.Column="1"
                                Content="{Binding CCDSpecificationDisplay_BatteryTab}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="极耳" />
                            <ContentControl
                                Grid.Row="5"
                                Grid.Column="0"
                                Content="{Binding CCDSpecificationDisplay_Ceramic}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="陶瓷" />
                            <ContentControl
                                Grid.Row="5"
                                Grid.Column="1"
                                Content="{Binding CCDSpecificationLimitDisplay_Mismatch}"
                                Style="{StaticResource ParameterPairContentControlStyle}"
                                Tag="A/B错位" />
                        </Grid>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </GroupBox>
    </Grid>
</UserControl>
