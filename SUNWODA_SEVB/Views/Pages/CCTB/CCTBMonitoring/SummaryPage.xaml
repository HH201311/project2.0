<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring.SummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.Core;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccctb="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccharts="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls;assembly=SUNWODA_SEVB.Component"
    Title="SummaryPage"
    d:DesignHeight="860"
    d:DesignWidth="1800"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="13*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="30*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="67*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="35*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="35*" />
            </Grid.ColumnDefinitions>
            <uccctb:LineInfoControl Grid.Column="0" ParameterSource="{Binding LineInfo}" />
            <uccctb:ProductionInfoControl Grid.Column="2" ParameterSource="{Binding Source={x:Static core:GlobalContextModel.Instance}, Path=ProductionInfo}" />
            <uccctb:ParametersScrollControl
                Grid.Column="4"
                Header="关键控制"
                ParameterSource="{Binding KeyControlParameters}" />
            <uccctb:ParametersScrollControl
                Grid.Column="6"
                Header="设备监控"
                ParameterSource="{Binding MonitoringParameters}" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="20" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Row="0"
                Grid.Column="0"
                Header="机头A-BY卷CPK"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <uccharts:CPKByRollChartControl
                    Margin="20,10,10,20"
                    ItemsSource="{Binding CPKByRollModelsA}"
                    YMax="{Binding CPKMaxA}"
                    YMin="{Binding CPKMinA}" />
            </GroupBox>
            <GroupBox
                Grid.Row="0"
                Grid.Column="2"
                Header="机头B-BY卷CPK"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <uccharts:CPKByRollChartControl
                    Margin="20,10,10,20"
                    ItemsSource="{Binding CPKByRollModelsB}"
                    YMax="{Binding CPKMaxB}"
                    YMin="{Binding CPKMinB}" />
            </GroupBox>
            <GroupBox
                Grid.Row="2"
                Grid.Column="0"
                Header="机头A-单趟CPK"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <uccharts:CPKChartControl
                    Margin="20,10,10,20"
                    ItemsSource="{Binding CPKModelsA}"
                    YMax="{Binding CPKByRollMaxA}"
                    YMin="{Binding CPKByRollMinA}" />
            </GroupBox>
            <GroupBox
                Grid.Row="2"
                Grid.Column="2"
                Header="机头B-单趟CPK"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <uccharts:CPKChartControl
                    Margin="20,10,10,20"
                    ItemsSource="{Binding CPKModelsB}"
                    YMax="{Binding CPKByRollMaxB}"
                    YMin="{Binding CPKByRollMinB}" />
            </GroupBox>
        </Grid>
    </Grid>
</Page>
