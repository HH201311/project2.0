<UserControl x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls.CCDDataChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:ucdgconvers="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.DataGridControls.TBDataGridConverters"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="150" d:DesignWidth="1780">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml"/>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBChartControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--转换器-->
            <ucdgconvers:ContentToTextConverter x:Key="ContentToTextConverter"/>

            <!--自定义标题的文本样式-->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="#99FFFFFF"/>
            </Style>

            <!--自定义共用的文本样式-->
            <Style x:Key="BMValueTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="#99FFFFFF"/>
            </Style>

            <!--自定义值标题的文本样式-->
            <Style x:Key="ValueHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="#DEFFFFFF"/>
            </Style>

            <!--自定义值的文本样式-->
            <Style x:Key="ValueTextBlockStyle" TargetType="TextBlock">
                <Setter Property="TextAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="#DEFFFFFF"/>
            </Style>

            <Style x:Key="SubLineStyle" TargetType="Line">
                <Setter Property="Stroke" Value="#0DFFFFFF"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </Style>

            <Style x:Key="BarGraphPathStyle" TargetType="Path">
                <Setter Property="Fill" Value="#0DFFFFFF"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition />
            <RowDefinition Height="20"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="基材宽度：" HorizontalAlignment="Center" Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock d:Text="883.85" x:Name="BaseMaterialValueTB" HorizontalAlignment="Center" Style="{StaticResource BMValueTextBlockStyle}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="(n) 错位数据" Style="{StaticResource TitleTextBlockStyle}"/>
                <Rectangle Width="20"/>
                <TextBlock Text="n 宽度数据" Foreground="#FF3DCC84" Style="{StaticResource TitleTextBlockStyle}"/>
            </StackPanel>
        </Grid>

        <!--A面数据-->
        <Grid Grid.Row="2" VerticalAlignment="Bottom" Margin="0,0,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderA" Grid.Column="0" d:Text="A干" Style="{StaticResource ValueHeaderTextBlockStyle}"/>
            <Grid x:Name="DataGridA" Grid.Column="1" Margin="0,0,30,0" HorizontalAlignment="Stretch"/>
        </Grid>

        <!--膜区示意图-->
        <Grid x:Name="ChartGrid" Grid.Row="3" SizeChanged="ChartGrid_SizeChanged"/>

        <!--B面数据-->
        <Grid Grid.Row="4" VerticalAlignment="Top" Margin="0,7,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HeaderB" Grid.Column="0" d:Text="B干" Style="{StaticResource ValueHeaderTextBlockStyle}"/>
            <Grid x:Name="DataGridB" Grid.Column="1" Margin="0,0,30,0" HorizontalAlignment="Stretch"/>
        </Grid>
    </Grid>
</UserControl>
