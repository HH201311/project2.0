<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 页面底色默认 RGB(247,228,229)；外层卡片默认 RGB(247,237,238)；可在「偏好→设置颜色」覆盖 -->
    <SolidColorBrush x:Key="CasBgBrush" Color="#F7E4E5" />
    <SolidColorBrush x:Key="CasOuterCardBrush" Color="#F7EDEE" />
    <SolidColorBrush x:Key="CasSurfaceBrush" Color="#EFEBF7" />
    <SolidColorBrush x:Key="CasAccentBrush" Color="#D9D0EF" />
    <SolidColorBrush x:Key="CasNavSelectedBrush" Color="#A89AD4" />
    <SolidColorBrush x:Key="CasPrimaryBrush" Color="#8E82C4" />
    <SolidColorBrush x:Key="CasPrimaryTextBrush" Color="#5E567A" />
    <SolidColorBrush x:Key="CasWhiteBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CasMutedTextBrush" Color="#8A839E" />
    <SolidColorBrush x:Key="CasBorderBrush" Color="#E3DDF0" />
    <SolidColorBrush x:Key="CasComboPopupBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CasComboHoverBrush" Color="#EFEBF7" />

    <!-- 兼容旧资源键名（原暖色键 → 浅紫映射） -->
    <SolidColorBrush x:Key="CasPeachBrush" Color="#EFEBF7" />
    <SolidColorBrush x:Key="CasApricotBrush" Color="#EFEBF7" />
    <SolidColorBrush x:Key="CasCoralBrush" Color="#A89AD4" />
    <SolidColorBrush x:Key="CasTerracottaBrush" Color="#8E82C4" />
    <SolidColorBrush x:Key="CasSidebarIconBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CasHeroGradient" Color="#EFEBF7" />

    <Style x:Key="CasPageRootStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CasBgBrush}" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="TextElement.FontSize" Value="15" />
    </Style>

    <Style x:Key="CasSidebarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CasPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Width" Value="186" />
        <Setter Property="Padding" Value="10,14" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.1"
                    ShadowDepth="2"
                    Color="#8E82C4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasNavButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasNavLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CasWhiteCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CasOuterCardBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="BorderBrush" Value="{DynamicResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Direction="270"
                    Opacity="0.08"
                    ShadowDepth="2"
                    Color="#8E82C4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 偏好页等长文字区域：禁用阴影，避免 DropShadow 位图缓存导致文字发糊/挤扁 -->
    <Style
        x:Key="CasWhiteCardFlatStyle"
        BasedOn="{StaticResource CasWhiteCardStyle}"
        TargetType="Border">
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>

    <!-- 偏好页色位选择按钮：用 ContentPresenter 显示内容，避免模板内文字被裁切 -->
    <Style x:Key="CasThemeSlotButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="52" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#222222" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#C8C8C8" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#888888" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasHeroCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CasSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BorderBrush" Value="{DynamicResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="12"
                    Direction="270"
                    Opacity="0.08"
                    ShadowDepth="2"
                    Color="#8E82C4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasSummaryCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CasWhiteBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="MinHeight" Value="96" />
        <Setter Property="BorderBrush" Value="{StaticResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="10"
                    Direction="270"
                    Opacity="0.06"
                    ShadowDepth="1"
                    Color="#8E82C4" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
    </Style>

    <Style x:Key="CasSectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="CasMutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CasMutedTextBrush}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="CasPillBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CasSurfaceBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderBrush" Value="{DynamicResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="CasPrimaryButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{DynamicResource CasPrimaryBrush}"
                        CornerRadius="14"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasSecondaryButtonStyle" TargetType="Button">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{DynamicResource CasSurfaceBrush}"
                        BorderBrush="{DynamicResource CasBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CasAccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 生产/调试模式切换：分段胶囊 -->
    <Style x:Key="CasModeSegmentButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="64" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="14,4" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CasMutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="10"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 单步测试按钮：加大尺寸，便于现场点选 -->
    <Style
        x:Key="CasStepTestButtonStyle"
        BasedOn="{StaticResource CasSecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="280" />
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Padding" Value="22,14" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style
        x:Key="CasIconButtonStyle"
        BasedOn="{StaticResource CasSecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="CasParamHelpIconBorderStyle" TargetType="Border">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource CasPrimaryBrush}" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
    </Style>

    <Style x:Key="CasParamHelpIconTextStyle" TargetType="TextBlock">
        <Setter Property="Text" Value="?" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="CasParamHelpToolTipTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="22" />
    </Style>

    <Style x:Key="CasBottomBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CasWhiteBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="BorderBrush" Value="{StaticResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="10"
                    Direction="90"
                    Opacity="0.06"
                    ShadowDepth="1"
                    Color="#8E82C4" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 表单分组：对标 VS Code / JetBrains 设置页「一组一事」卡片 -->
    <Style x:Key="CasFormSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CasSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- 大卡片内的子分组：浅底小圆角，形成「大框套小框」 -->
    <Style x:Key="CasFormSubSectionStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CasWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <Style x:Key="CasFormSectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="CasFormSectionDescStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource CasMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <Style x:Key="CasFormRowStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="CasFormLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="CasFormHintStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource CasMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="LineHeight" Value="18" />
    </Style>

    <Style x:Key="CasInfoCalloutStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CasWhiteBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="CasFormCheckItemStyle" TargetType="CheckBox">
        <Setter Property="Margin" Value="0,0,16,10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style
        x:Key="CasFormActionButtonStyle"
        BasedOn="{StaticResource CasSecondaryButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 下拉框：圆角、浅黄底、自定义箭头与弹出列表（替代系统默认丑陋样式） -->
    <Style x:Key="CasComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CasComboHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CasAccentBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CasComboBoxStyle" TargetType="ComboBox">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="160" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource CasPrimaryTextBrush}" />
        <Setter Property="Background" Value="{StaticResource CasComboPopupBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource CasBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource CasComboBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Grid.Column="0"
                                    Margin="12,0,8,0"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    IsHitTestVisible="False"
                                    RecognizesAccessKey="True"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                                <Path
                                    x:Name="Arrow"
                                    Grid.Column="1"
                                    Width="10"
                                    Height="6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,0 L10,0 L5,6 Z"
                                    Fill="{StaticResource CasPrimaryTextBrush}" />
                            </Grid>
                        </Border>

                        <ToggleButton
                            x:Name="ToggleButton"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" />
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Popup
                            x:Name="Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Fade">
                            <Border
                                x:Name="DropDownBorder"
                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Margin="0,4,0,0"
                                Background="{StaticResource CasComboPopupBrush}"
                                BorderBrush="{StaticResource CasBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="12"
                                        Direction="270"
                                        Opacity="0.12"
                                        ShadowDepth="3"
                                        Color="#5E567A" />
                                </Border.Effect>
                                <ScrollViewer CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CasPrimaryBrush}" />
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CasSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource CasPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
