                                            Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestOfflineCtVisionAnnotationCommand}"
                                            Content="测试 AI 图像标注"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            ToolTip="选手动图，或从交接目录/切片目录取图后调用 NJCT"
                                            Visibility="{Binding IsAiPipelineMode, Converter={StaticResource BoolToVis}}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CasFormSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CasFormSectionTitleStyle}" Text="CTAutoCutImg DLL 离线测试（不跑 VG）" />
                                    <TextBlock
                                        Style="{StaticResource CasFormSectionDescStyle}"
                                        TextWrapping="Wrap"
                                        Text="仅调用视觉 DLL 找点并落盘标注图，不打开 VG、不执行 3-2-1 点击流程。选择文件夹后对该目录下全部图片批量跑通：GetSectionReferencePoints（3D侧视图）标四点（上盖三点+原点）；GetObjectTopBottomPoints（2D侧视图）标起点[0]、终点[1]。" />

                                    <Grid Style="{StaticResource CasFormRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CasFormLabelStyle}" Text="3D侧视图" ToolTip="GetSectionReferencePoints 输入文件夹，通常为 3D ROI 截图目录" />
                                        <hc:TextBox Grid.Column="1" HorizontalAlignment="Stretch" ToolTip="3D侧视图测试图文件夹（目录内全部图片批量测）">
                                            <hc:TextBox.Text>
                                                <Binding Path="CutImgDllTestSectionFolder" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <Button
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource CasSecondaryButtonStyle}"
                                            Content="浏览…"
                                            Command="{Binding BrowseCutImgDllTestSectionFolderCommand}" />
                                    </Grid>

                                    <Grid Style="{StaticResource CasFormRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CasFormLabelStyle}" Text="2D侧视图" ToolTip="GetObjectTopBottomPoints 输入文件夹，通常为「上」视图截图目录" />
                                        <hc:TextBox Grid.Column="1" HorizontalAlignment="Stretch" ToolTip="2D侧视图测试图文件夹（目录内全部图片批量测）">
                                            <hc:TextBox.Text>
                                                <Binding Path="CutImgDllTestVectorFolder" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <Button
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource CasSecondaryButtonStyle}"
                                            Content="浏览…"
                                            Command="{Binding BrowseCutImgDllTestVectorFolderCommand}" />
                                    </Grid>

                                    <Grid Style="{StaticResource CasFormRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CasFormLabelStyle}" Text="标注输出目录" ToolTip="默认 C:\AutoSlice\cutpicture\CutImgDllTest" />
                                        <hc:TextBox Grid.Column="1" HorizontalAlignment="Stretch" ToolTip="标注结果 PNG 输出目录">
                                            <hc:TextBox.Text>
                                                <Binding Path="CutImgDllTestOutputDir" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <Button
                                            Grid.Column="2"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource CasSecondaryButtonStyle}"
                                            Content="浏览…"
                                            Command="{Binding BrowseCutImgDllTestOutputDirCommand}" />
                                    </Grid>

                                    <UniformGrid Columns="2" Margin="0,8,0,0">
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestCutImgGetSectionReferencePointsCommand}"
                                            Content="测 GetSectionReferencePoints"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            ToolTip="对 3D侧视图文件夹内全部图片调用 DLL 标上盖三点+原点，输出 *_section_*.png" />
                                        <Button
                                            Style="{StaticResource CasStepTestButtonStyle}"
                                            Command="{Binding TestCutImgGetObjectTopBottomPointsCommand}"
                                            Content="测 GetObjectTopBottomPoints"
                                            IsEnabled="{Binding IsEnableSimulationBtn}"
                                            ToolTip="对 2D侧视图文件夹内全部图片调用 DLL 标起点[0]+终点[1]，输出 *_topbottom_*.png" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CasFormSectionStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CasFormSectionTitleStyle}" Text="标定采图（调试）" />
                                    <TextBlock
                                        Style="{StaticResource CasFormSectionDescStyle}"
                                        TextWrapping="Wrap"
                                        Text="最小化本软件后按已标定 ROI 截图。需先在「视觉对齐」页完成 3D / 上视图区域标定。" />
                                    <Grid Style="{StaticResource CasFormRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CasFormLabelStyle}" Text="3D标定图存放路径" ToolTip="截取3D标定图保存目录；默认 C:\AutoSlice\cutpicture\3D" />
                                        <hc:TextBox Grid.Column="1" HorizontalAlignment="Stretch" ToolTip="截取3D标定图保存目录；默认 C:\AutoSlice\cutpicture\3D">
                                            <hc:TextBox.Text>
                                                <Binding Path="VisionLearn3dSampleDir" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button
                                                Style="{StaticResource CasFormActionButtonStyle}"
                                                Command="{Binding BrowseVisionLearn3dSampleDirCommand}"
                                                Content="浏览" />
                                            <Button
                                                Style="{StaticResource CasFormActionButtonStyle}"
                                                MinWidth="140"
                                                Command="{Binding CaptureVision3dSampleCommand}"
                                                Content="截取3D标定图"
                                                ToolTip="最小化本软件后，按已标定 3D ROI 截图并保存到左侧路径" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource CasFormRowStyle}" Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CasFormLabelStyle}" Text="上视图标定图存放路径" ToolTip="截取上视图标定图保存目录；默认 C:\AutoSlice\cutpicture\上视图" />
                                        <hc:TextBox Grid.Column="1" HorizontalAlignment="Stretch" ToolTip="截取上视图标定图保存目录；默认 C:\AutoSlice\cutpicture\上视图">
                                            <hc:TextBox.Text>
                                                <Binding Path="VisionLearnTopViewSampleDir" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <Button
                                                Style="{StaticResource CasFormActionButtonStyle}"
                                                Command="{Binding BrowseVisionLearnTopViewSampleDirCommand}"
                                                Content="浏览" />
                                            <Button
                                                Style="{StaticResource CasFormActionButtonStyle}"
                                                MinWidth="140"
                                                Command="{Binding CaptureVisionTopViewSampleCommand}"
                                                Content="截取上视图标定图"
                                                ToolTip="最小化本软件后，按已标定「上」视图 ROI 截图并保存到左侧路径" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CasFormSectionStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CasFormSectionTitleStyle}" Text="上位机窗体大小（仅本项目）" />
                                    <TextBlock
                                        Style="{StaticResource CasFormSectionDescStyle}"
                                        TextWrapping="Wrap"
                                        Text="默认全屏。可在此设置窗口宽高，或「保存当前窗体大小」以便下次进入 CT 自动化切片时自动沿用。离开本项目后恢复默认全屏。" />
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontFamily="Consolas"
                                        FontWeight="SemiBold"
                                        Text="{Binding MainWindowSizeDisplayText}"
                                        TextWrapping="Wrap" />
                                    <UniformGrid Columns="4" Margin="0,0,0,12">
                                        <hc:TextBox
                                            Margin="0,0,8,0"
                                            hc:InfoElement.Title="宽度"
                                            hc:InfoElement.TitlePlacement="Top">
                                            <hc:TextBox.Text>
                                                <Binding Path="MainWindowWidth" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <hc:RegexRule Type="PInt" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            Margin="0,0,8,0"
                                            hc:InfoElement.Title="高度"
                                            hc:InfoElement.TitlePlacement="Top">
                                            <hc:TextBox.Text>
                                                <Binding Path="MainWindowHeight" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <hc:RegexRule Type="PInt" />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            Margin="0,0,8,0"
                                            hc:InfoElement.Title="Left"
                                            hc:InfoElement.TitlePlacement="Top">
                                            <hc:TextBox.Text>
                                                <Binding Path="MainWindowLeft" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <hc:TextBox
                                            hc:InfoElement.Title="Top"
                                            hc:InfoElement.TitlePlacement="Top">
                                            <hc:TextBox.Text>
                                                <Binding Path="MainWindowTop" UpdateSourceTrigger="PropertyChanged" />
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                    </UniformGrid>
                                    <CheckBox
                                        Style="{StaticResource CasFormCheckItemStyle}"
                                        Content="下次启动沿用"
                                        IsChecked="{Binding MainWindowRememberSize}"
                                        ToolTip="勾选后，下次进入本项目自动应用上方尺寸" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button
                                            Style="{StaticResource CasFormActionButtonStyle}"
                                            Margin="0,0,8,8"
                                            Command="{Binding ApplyMainWindowSizeCommand}"
                                            Content="应用窗体大小"
                                            ToolTip="按上方宽高/位置立即调整主窗（不改全屏默认）" />
                                        <Button
                                            Style="{StaticResource CasPrimaryButtonStyle}"
                                            Margin="0,0,8,8"
                                            MinWidth="0"
                                            Command="{Binding SaveCurrentMainWindowSizeCommand}"
                                            Content="保存当前窗体大小"
                                            ToolTip="读取当前主窗实际尺寸并保存，下次进入本项目自动沿用" />
                                        <Button
                                            Style="{StaticResource CasFormActionButtonStyle}"
                                            Margin="0,0,0,8"
                                            Command="{Binding RestoreDefaultMainWindowSizeCommand}"
                                            Content="恢复默认全屏"
                                            ToolTip="关闭沿用并立即最大化主窗" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                </Grid>

                <!-- 偏好设置：子菜单 + 颜色页（与其它导航页同属 Grid.Row=2） -->
                <Border Visibility="{Binding IsNavPreferences, Converter={StaticResource BoolToVis}}"
                        Style="{StaticResource CasWhiteCardFlatStyle}"
                        TextOptions.TextFormattingMode="Ideal"
                        TextOptions.TextRenderingMode="Auto"
                        ClipToBounds="False"
                        UseLayoutRounding="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="156" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Margin="0,0,14,0" Padding="10" VerticalAlignment="Top"
                                Background="{DynamicResource CasSurfaceBrush}"
                                BorderBrush="{DynamicResource CasBorderBrush}"
                                BorderThickness="1" CornerRadius="12"
                                ClipToBounds="False">
                            <StackPanel>
                                <TextBlock Margin="8,4,8,12" FontWeight="SemiBold" FontSize="15"
                                           Foreground="#333333" Text="偏好" />
                                <Button Command="{Binding SelectPrefSubCommand}" CommandParameter="0"
                                        MinHeight="44" Padding="12,10">
                                    <Button.Style>
                                        <Style BasedOn="{StaticResource CasSecondaryButtonStyle}" TargetType="Button">
                                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                                            <Setter Property="Margin" Value="0,0,0,6" />
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="44" />
                                            <Setter Property="Padding" Value="12,10" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPrefSubColors}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource CasAccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <iconPacks:PackIconMaterial Width="16" Height="16" Margin="0,0,8,0"
                                                                    VerticalAlignment="Center" Foreground="#333333" Kind="Palette" />
                                        <TextBlock VerticalAlignment="Center" Foreground="#333333"
                                                   FontSize="14" Padding="0,2"
                                                   Text="设置颜色" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Column="1" Padding="0,0,6,0"
                                      Visibility="{Binding IsPrefSubColors, Converter={StaticResource BoolToVis}}"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False"
                                      ClipToBounds="False">
                            <StackPanel>
                                <TextBlock FontSize="17" FontWeight="SemiBold" Foreground="#333333"
                                           Margin="0,0,0,6" Padding="0,2" Text="设置颜色" />
                                <TextBlock FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                           Margin="0,0,0,12" Padding="0,2"
                                           Text="圆盘内拖动取色；下方两条分别调饱和度与亮度。点「保存主题」后下次启动沿用。内置 4 套预设不可删除。" />

                                <Border Style="{StaticResource CasFormSectionStyle}" Margin="0,0,0,12" Effect="{x:Null}" ClipToBounds="False">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#333333"
                                                   Margin="0,0,0,8" Padding="0,2" Text="配色方案" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Style="{StaticResource CasFormActionButtonStyle}" Margin="0,0,8,0"
                                                    Command="{Binding RevertThemeColorsCommand}" Content="还原已保存"
                                                    ToolTip="丢弃当前预览，恢复为上次保存的配色" />
                                            <Button Style="{StaticResource CasPrimaryButtonStyle}" MinWidth="96" MinHeight="36"
                                                    Padding="12,6" FontSize="14" Margin="0"
                                                    Command="{Binding SaveThemeColorsCommand}" Content="保存主题"
                                                    ToolTip="将当前预览色写入项目配置，下次启动生效" />
                                        </WrapPanel>
                                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" FontSize="12" Padding="0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#666666" />
                                                    <Setter Property="Text" Value="状态：已与保存一致" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasUnsavedThemeChanges}" Value="True">
                                                            <Setter Property="Text" Value="状态：有未保存预览（离开偏好页将还原）" />
                                                            <Setter Property="Foreground" Value="#C62828" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <hc:TextBox Width="180" Margin="0,0,8,0"
                                                        hc:InfoElement.Placeholder="新预设名称"
                                                        Text="{Binding NewThemePresetName, UpdateSourceTrigger=PropertyChanged}" />
                                            <Button Style="{StaticResource CasFormActionButtonStyle}" Margin="0"
                                                    Command="{Binding SaveAsThemePresetCommand}" Content="存为新预设"
                                                    ToolTip="把当前四处颜色另存为可删除的自定义预设" />
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding ThemeColorPresets}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="12,10" MinHeight="44"
                                                            Background="#FFFFFF" BorderBrush="#C8C8C8" BorderThickness="1"
                                                            CornerRadius="10" ClipToBounds="False"
                                                            SnapsToDevicePixels="True" UseLayoutRounding="True">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                    VerticalContentAlignment="Center"
                                                                    Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                                    Padding="0" MinHeight="28"
                                                                    Command="{Binding DataContext.ApplyThemePresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding Id}">
                                                                <Button.Template>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                                    </ControlTemplate>
                                                                </Button.Template>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                                                                        <Border Width="16" Height="28" CornerRadius="4,0,0,4" Background="{Binding SidebarBrush}" />
                                                                        <Border Width="16" Height="28" Background="{Binding PageBgBrush}" />
                                                                        <Border Width="16" Height="28" Background="{Binding OuterCardBrush}" />
                                                                        <Border Width="16" Height="28" CornerRadius="0,4,4,0" BorderBrush="#C8C8C8" BorderThickness="1" Background="{Binding InnerCardBrush}" />
                                                                    </StackPanel>
                                                                    <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#222222"
                                                                               Text="{Binding TitleLine}" TextWrapping="Wrap"
                                                                               Padding="0,2" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Padding="10,6" Style="{StaticResource CasFormActionButtonStyle}"
                                                                    Content="删除"
                                                                    Command="{Binding DataContext.DeleteThemePresetCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                                    CommandParameter="{Binding Id}"
                                                                    Visibility="{Binding CanDelete, Converter={StaticResource BoolToVis}}"
                                                                    ToolTip="删除此自定义预设（内置预设不可删）" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="2" Margin="0,0,0,12">
                                    <Button Margin="0,0,8,8"
                                            Command="{Binding SelectThemeColorSlotCommand}" CommandParameter="0">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasThemeSlotButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeSlotPageBg}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CasPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" BorderBrush="#C8C8C8" BorderThickness="1"
                                                    Background="{Binding ThemePageBgBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#222222" Padding="0,2"
                                                       Text="{Binding ThemePageBgColor, StringFormat=页面底色  {0}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,0,8"
                                            Command="{Binding SelectThemeColorSlotCommand}" CommandParameter="1">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasThemeSlotButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeSlotOuterCard}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CasPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" BorderBrush="#C8C8C8" BorderThickness="1"
                                                    Background="{Binding ThemeOuterCardBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#222222" Padding="0,2"
                                                       Text="{Binding ThemeOuterCardColor, StringFormat=最外层卡片  {0}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0,0,8,0"
                                            Command="{Binding SelectThemeColorSlotCommand}" CommandParameter="2">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasThemeSlotButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeSlotInnerCard}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CasPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" BorderBrush="#C8C8C8" BorderThickness="1"
                                                    Background="{Binding ThemeInnerCardBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#222222" Padding="0,2"
                                                       Text="{Binding ThemeInnerCardColor, StringFormat=内部分组卡片  {0}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Margin="0"
                                            Command="{Binding SelectThemeColorSlotCommand}" CommandParameter="3">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasThemeSlotButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsThemeSlotSidebar}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CasPrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="32" Height="32" CornerRadius="8" BorderBrush="#C8C8C8" BorderThickness="1"
                                                    Background="{Binding ThemeSidebarBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#222222" Padding="0,2"
                                                       Text="{Binding ThemeSidebarColor, StringFormat=左侧菜单栏  {0}}" />
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>

                                <Border Style="{StaticResource CasFormSectionStyle}" Margin="0" Effect="{x:Null}" ClipToBounds="False">
                                    <StackPanel>
                                        <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#333333"
                                                   Margin="0,0,0,8" Padding="0,2" TextWrapping="Wrap"
                                                   Text="{Binding ThemeEditSlotTitle, StringFormat=正在编辑：{0}}" />
                                        <Button Style="{StaticResource CasFormActionButtonStyle}" Margin="0,0,0,12"
                                                HorizontalAlignment="Left" Command="{Binding ResetThemeColorsCommand}"
                                                Content="预览默认工控蓝灰"
                                                ToolTip="仅预览内置推荐方案，需再点「保存主题」才会落盘" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <local:ColorWheelPicker SelectedColor="{Binding ThemeEditColor, Mode=TwoWay}" />
                                                <TextBlock Margin="0,10,0,0" FontSize="12" Foreground="#666666"
                                                           TextWrapping="Wrap" Padding="0,2"
                                                           Text="上条：饱和度（白→纯色）　下条：亮度（黑→白）" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                                <Border Width="72" Height="72" HorizontalAlignment="Left" CornerRadius="10"
                                                        BorderBrush="#C8C8C8" BorderThickness="1"
                                                        Background="{Binding ThemeEditPreviewBrush}" />
                                                <TextBlock FontWeight="SemiBold" Margin="0,10,0,6" Foreground="#222222"
                                                           Padding="0,2" Text="{Binding ThemeEditRgbText}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#333333" Text="HEX" />
                                                    <hc:TextBox Width="120">
                                                        <hc:TextBox.Text>
                                                            <Binding Path="ThemeEditHex" UpdateSourceTrigger="LostFocus" />
                                                        </hc:TextBox.Text>
                                                    </hc:TextBox>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                </Grid>

                <!-- 流程异常/超时：人工干预醒目面板（覆盖右侧内容区） -->
                <Border Grid.Row="0" Grid.RowSpan="4"
                        Panel.ZIndex="200"
                        Background="#E6B71C1C"
                        Visibility="{Binding IsManualInterventionVisible, Converter={StaticResource BoolToVis}}">
                    <Border Margin="24"
                            Padding="28"
                            Background="#FF1A1A1A"
                            BorderBrush="#FFFF5252"
                            BorderThickness="3"
                            CornerRadius="10"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            MinWidth="520"
                            MaxWidth="860">
                        <StackPanel>
                            <TextBlock Text="需要人工处理"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#FFFF5252"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>
                            <TextBlock Text="自动化已暂停。请检查 VG / 现场状态，确认后点击下方按钮将该文件放入异常文件夹并跳过，继续下一文件。"
                                       FontSize="16"
                                       Foreground="#FFFFE082"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,18"/>
                            <TextBlock FontSize="15"
                                       Foreground="White"
                                       Margin="0,0,0,6"
                                       Text="{Binding ManualInterventionFileName, StringFormat=失败文件：{0}}"/>
                            <TextBlock FontSize="14"
                                       Foreground="#FFFFCDD2"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,14"
                                       Text="{Binding ManualInterventionReason}"/>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="#FFFFAB40"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"
                                       Text="{Binding ManualInterventionCountdownText}"/>
                            <Button Content="放入异常文件夹并跳过"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Height="52"
                                    MinWidth="280"
                                    HorizontalAlignment="Center"
                                    Background="#FF43A047"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ConfirmManualInterventionCommand}"
                                    ToolTip="将该失败文件放入异常文件夹并跳过，继续下一文件"/>
                        </StackPanel>
                    </Border>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource CasBottomBarStyle}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CasPrimaryButtonStyle}"
                                Content="{Binding PrimaryActionButtonText}"
                                Command="{Binding RunSimulationCommand}"
                                IsEnabled="{Binding IsEnableSimulationBtn}"
                                Margin="12,0,0,0"
                                ToolTip="{Binding PrimaryActionToolTip}"/>
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource CasSecondaryButtonStyle}"
                                Content="清除日志"
                                Command="{Binding ClearImportLogCommand}"
                                VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                   Style="{StaticResource CasMutedTextStyle}"
                                   Text="{Binding MessageShower}"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
