<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.AlarmSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alarm="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.AlarmModels;assembly=SUNWODA_SEVB.Core"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Title="AlarmSettingPage"
    d:DesignHeight="940"
    d:DesignWidth="1610"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:ContentToStringConverter x:Key="ContentToStringConverter" />
            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />

            <Style x:Key="ParamComboBoxItemConetntControlStyle" TargetType="ContentControl">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid>
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Opacity="0.1" />
                                <ContentPresenter
                                    Margin="20,5"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Content" Value="一般">
                        <Setter Property="Background" Value="#FF3DCC84" />
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </Trigger>
                    <Trigger Property="Content" Value="中等">
                        <Setter Property="Background" Value="#FFCC9629" />
                        <Setter Property="Foreground" Value="#FFCC9629" />
                    </Trigger>
                    <Trigger Property="Content" Value="严重">
                        <Setter Property="Background" Value="#FFCC5252" />
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ParamComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Grid>
                                <Border
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="5" />
                                <ContentControl
                                    Margin="5,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{Binding DisplayName}"
                                    Style="{StaticResource ParamComboBoxItemConetntControlStyle}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ParamComboBoxItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!--  整体背景框  -->
                                <Border
                                    x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" />

                                <!--  内容展示区域  -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Margin="20,0,34,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                    <ContentPresenter.ContentTemplate>
                                        <ItemContainerTemplate>
                                            <ContentControl Content="{Binding DisplayName}" Style="{StaticResource ParamComboBoxItemConetntControlStyle}" />
                                        </ItemContainerTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>

                                <!--  下拉按钮区域：自定义形状和颜色  -->
                                <ToggleButton
                                    x:Name="DropDownToggle"
                                    Margin="10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ClickMode="Press"
                                    Focusable="false"
                                    IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid
                                                Width="14"
                                                Height="14"
                                                Background="Transparent">
                                                <Path
                                                    x:Name="SimpleArrow"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M0,0 L4,4 L8,0"
                                                    Stroke="#61FFFFFF"
                                                    StrokeThickness="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SimpleArrow" Property="Stroke" Value="#CCFFFFFF" />
                                                    <Setter TargetName="SimpleArrow" Property="StrokeThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!--  下拉弹出框  -->
                                <Popup
                                    x:Name="PART_Popup"
                                    Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    Placement="Bottom"
                                    PopupAnimation="Slide"
                                    VerticalOffset="10">
                                    <Border
                                        x:Name="PopupBorder"
                                        Background="#FF2B2B2B"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="True">
                                        <ScrollViewer
                                            Margin="15,10,10,5"
                                            Background="{TemplateBinding Background}"
                                            SnapsToDevicePixels="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!--  选中项的字体颜色随背景对比调整  -->
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <DockPanel
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                LastChildFill="False">
                <Label
                    Margin="20,0"
                    Content="报警设置"
                    DockPanel.Dock="Left"
                    Style="{StaticResource ParamTitleLabelStyle}" />

                <Button
                    Margin="0,0,20,0"
                    Command="{Binding ParamSaveCommand}"
                    Content="保存"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ParamOKButtonStyle}" />
            </DockPanel>
        </Border>
        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <Border
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0.5,0.5,0,0"
                CornerRadius="0">
                <DataGrid
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    AutoGenerateColumns="False"
                    Background="Transparent"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0"
                    CanUserAddRows="False"
                    CanUserResizeColumns="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding AlarmConfigs, Mode=TwoWay}"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="20,0" />
                            <Setter Property="Height" Value="50" />
                            <Setter Property="Background" Value="#0DFFFFFF" />
                            <Setter Property="BorderThickness" Value="0,0,0.5,0.5" />
                            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="#CCFFFFFF" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                            <Setter Property="FontSize" Value="16" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="50" />
                            <Setter Property="BorderThickness" Value="0,0,0,0.5" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="#99FFFFFF" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A3DCC84" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="40" />
                            <Setter Property="BorderThickness" Value="0,0,0.5,0" />
                            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="#99FFFFFF" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="True" />
                                        <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#FF1F1F1F" />
                                    <Setter Property="BorderBrush" Value="#FF3DCC84" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="#1AFFFFFF" />
                                </MultiTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" Header="报警信息">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        Margin="5,0"
                                        Background="Transparent"
                                        Foreground="#99FFFFFF"
                                        IsReadOnly="True"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" Header="报警参数设置">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ContentControl>
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <TextBox
                                                                Margin="10,0"
                                                                Background="Transparent"
                                                                Foreground="#99FFFFFF"
                                                                IsReadOnly="True"
                                                                Style="{StaticResource ParamValueTextBoxStyle}"
                                                                Text="/" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Code}" Value="{x:Static alarm:AlarmDefaultConfig.A001}">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="20,0" Orientation="Horizontal">
                                                                        <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="异常值: " />
                                                                        <uccc:AffixedTextBox
                                                                            HorizontalContentAlignment="Left"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="Transparent"
                                                                            Foreground="#99FFFFFF"
                                                                            Prefix="&gt;"
                                                                            Style="{StaticResource ParamValueAffixedTextBoxStyle}"
                                                                            Suffix="mg"
                                                                            Text="{Binding DataContext.AlarmConfigParam.WeightDataLimit, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Code}" Value="{x:Static alarm:AlarmDefaultConfig.A002}">
                                                        <Setter Property="ContentTemplate">
                                                            <Setter.Value>
                                                                <DataTemplate>
                                                                    <StackPanel Margin="20,0" Orientation="Horizontal">
                                                                        <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="限定极差值: " />
                                                                        <uccc:AffixedTextBox
                                                                            HorizontalContentAlignment="Left"
                                                                            VerticalContentAlignment="Center"
                                                                            Background="Transparent"
                                                                            Foreground="#99FFFFFF"
                                                                            Style="{StaticResource ParamValueAffixedTextBoxStyle}"
                                                                            Suffix="mg"
                                                                            Text="{Binding DataContext.AlarmConfigParam.RangeLimit, RelativeSource={RelativeSource AncestorType=Page}, Mode=TwoWay}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" Header="报警等级">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Background="Transparent"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding DataContext.AlarmLevelSource, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding Level, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamComboBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="*" Header="是否启用">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <uccc:SimpleToggleButton
                                        Margin="15,0"
                                        HorizontalAlignment="Left"
                                        d:IsChecked="True"
                                        IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</Page>
