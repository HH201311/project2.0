<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CTAutoSlicer.HistogramRoiCalibrationOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="直方图 ROI 标定"
    AllowsTransparency="True"
    Background="Transparent"
    Cursor="Cross"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Grid x:Name="RootGrid">
        <!-- 四块遮罩 + 中间透明选区，在 Code-behind 中更新 -->
        <Canvas x:Name="MaskCanvas" Background="Transparent">
            <Rectangle
                x:Name="MaskTop"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Width="0"
                Height="0" />
            <Rectangle
                x:Name="MaskBottom"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Width="0"
                Height="0" />
            <Rectangle
                x:Name="MaskLeft"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Width="0"
                Height="0" />
            <Rectangle
                x:Name="MaskRight"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Width="0"
                Height="0" />
            <Rectangle
                x:Name="SelectionRect"
                Stroke="#FF00E5FF"
                StrokeThickness="2"
                Fill="#2200E5FF"
                Visibility="Collapsed" />
            <Border
                x:Name="ActionBar"
                Padding="8,6"
                Background="#EE1E1E1E"
                CornerRadius="6"
                Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Foreground="White"
                        FontSize="13"
                        Text="确认框选直方图区域" />
                    <Button
                        x:Name="ConfirmButton"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Background="#FF2E7D32"
                        BorderThickness="0"
                        Click="ConfirmButton_OnClick"
                        Cursor="Hand"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Content="✓"
                        ToolTip="提交标定" />
                    <Button
                        x:Name="CancelSelectionButton"
                        Width="36"
                        Height="36"
                        Background="#FFC62828"
                        BorderThickness="0"
                        Click="CancelSelectionButton_OnClick"
                        Cursor="Hand"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="White"
                        Content="✕"
                        ToolTip="重新框选" />
                </StackPanel>
            </Border>
        </Canvas>

        <TextBlock
            Margin="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="White"
            IsHitTestVisible="False"
            Text="拖拽框选直方图区域；框下方 ✓ 提交 / ✕ 重选；Esc 取消标定" />
    </Grid>
</Window>
