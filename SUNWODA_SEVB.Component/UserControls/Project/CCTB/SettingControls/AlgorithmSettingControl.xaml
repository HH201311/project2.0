<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.AlgorithmSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:core="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.Core;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pjconvert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    d:DesignHeight="190"
    d:DesignWidth="510"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <pjconvert:ContentToStringConverter x:Key="ContentToStringConverter" />
            <pjconvert:StringToBooleanConverter x:Key="StringToBooleanConverter" />
            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <!--  标题文本样式  -->
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!--  算法名称输入框样式  -->
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="hc:TextBox">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Padding" Value="5" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="hc:InfoElement.Placeholder" Value="请输入算法名称" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="0" />
                <Setter Property="CaretBrush" Value="#FFFFFF" />
                <Setter Property="ToolTip" Value="双击进行编辑" />
                <Style.Triggers>
                    <Trigger Property="IsReadOnly" Value="False">
                        <Setter Property="Background" Value="#FF2D2D30" />
                        <Setter Property="BorderBrush" Value="#FF3DCC84" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
                        <Setter Property="ToolTip" Value="Esc退出编辑&#x0a;Enter保存验证" />
                        <Setter Property="hc:InfoElement.Placeholder" Value="请输入算法名称" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  算法开关按钮样式  -->
            <Style x:Key="AlgorithmEnableToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FF3DCC84" />
                <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
                <Setter Property="Content" Value="启用" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                CornerRadius="{Binding (hc:BorderElement.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="关闭算法" />
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                    <Setter Property="Foreground" Value="#99FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Opacity" Value="0.8" />
                                    <Setter Property="Background" Value="#2DFFFFFF" />
                                    <Setter Property="BorderBrush" Value="#2DFFFFFF" />
                                    <Setter Property="Foreground" Value="#2DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#0DFFFFFF" CornerRadius="10">
        <Grid>
            <Grid
                Width="50"
                Height="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                IsEnabled="{Binding IsAlgorithmEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <Border Background="#0DFFFFFF" CornerRadius="0,10,0,50" />
                <Path
                    Margin="17,11,8,21"
                    Data="M25,2.11s-4,1.3-8.666,6.493a50.363,50.363,0,0,0-7,9.254A23.154,23.154,0,0,0,0,9.578L3.5,6.331a18.832,18.832,0,0,1,5.334,6.006A36.406,36.406,0,0,1,25,0Z"
                    Fill="#FF3DCC84" />
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    d:Text="xx算法"
                    Style="{StaticResource HeaderTextBlockStyle}"
                    Text="{Binding ClosedLoopType, StringFormat='{}{0}算法', RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <UniformGrid
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    Columns="1">
                    <hc:TextBox
                        MinWidth="200"
                        d:Text="DY_ASDASDASDASDASD"
                        IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        KeyDown="AlgorithmTB_KeyDown"
                        LostFocus="AlgorithmTB_LostFocus"
                        MouseDoubleClick="AlgorithmNameTB_MouseDoubleClick"
                        Text="{Binding AlgorithmName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}">
                        <hc:TextBox.Style>
                            <Style BasedOn="{StaticResource {x:Type hc:TextBox}}" TargetType="hc:TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClosedLoopType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="MD">
                                        <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
                                        <Setter Property="hc:InfoElement.Necessary" Value="False" />
                                        <Setter Property="hc:InfoElement.Title" Value="专家PID算法:" />
                                        <Setter Property="MinWidth" Value="300" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:TextBox.Style>
                    </hc:TextBox>

                    <hc:TextBox
                        MinWidth="200"
                        d:Text="DY_ASDASDASDASDASD"
                        IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        KeyDown="AlgorithmTB1_KeyDown"
                        LostFocus="AlgorithmTB1_LostFocus"
                        MouseDoubleClick="AlgorithmNameTB1_MouseDoubleClick"
                        Text="{Binding AlgorithmName1, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        Visibility="{Binding ClosedLoopType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='MD'}">
                        <hc:TextBox.Style>
                            <Style BasedOn="{StaticResource {x:Type hc:TextBox}}" TargetType="hc:TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClosedLoopType, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="MD">
                                        <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
                                        <Setter Property="hc:InfoElement.Necessary" Value="False" />
                                        <Setter Property="hc:InfoElement.Title" Value="流量算法:" />
                                        <Setter Property="MinWidth" Value="300" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:TextBox.Style>
                    </hc:TextBox>
                </UniformGrid>

                <StackPanel
                    Grid.Row="2"
                    Margin="0,5,0,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ParamSettingClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource ParamFunctionButtonStyle}" TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Rectangle Width="20" />
                    <ToggleButton
                        Command="{Binding AlgorithmEnableChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsChecked="{Binding IsAlgorithmEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource AlgorithmEnableToggleButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
