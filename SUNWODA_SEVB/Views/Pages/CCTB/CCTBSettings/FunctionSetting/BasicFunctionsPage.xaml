<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.FunctionSetting.BasicFunctionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fsc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.FunctionSettingControls;assembly=SUNWODA_SEVB.Component"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FunctionSettingPage"
    d:DesignHeight="940"
    d:DesignWidth="1440"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  按钮区  -->
        <Border
            Grid.Row="0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <DockPanel VerticalAlignment="Stretch" LastChildFill="False">
                <RadioButton
                    x:Name="WeightMeasureRB"
                    d:IsChecked="True"
                    Command="{Binding ControlPageNavigateCommand}"
                    CommandParameter="测重仪"
                    Content="测重仪"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='WMFunctionControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="CoatingMachineRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    CommandParameter="涂布机"
                    Content="涂布机"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='CMFunctionControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="DieHeadRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    CommandParameter="模头"
                    Content="模头"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='DHFunctionControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="CCDRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    CommandParameter="CCD"
                    Content="CCD"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='CCDFunctionControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="ClosedLoopRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    CommandParameter="闭环"
                    Content="闭环"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='CLFunctionControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
            </DockPanel>
        </Border>

        <!--  内容区  -->
        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <ContentControl Grid.Row="0" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=WeightMeasureRB}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <fsc:WMFunctionControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding FunctionModel, Mode=TwoWay}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CoatingMachineRB}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <fsc:CMFunctionControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding FunctionModel, Mode=TwoWay}"
                                                PLCGatherConfigCommand="{Binding PLCGatherConfigCommand}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=DieHeadRB}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <fsc:DHFunctionControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding FunctionModel, Mode=TwoWay}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=CCDRB}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <fsc:CCDFunctionControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding FunctionModel, Mode=TwoWay}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ClosedLoopRB}" Value="True">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <fsc:CLFunctionControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                FTPUploadCommand="{Binding FTPUpLoadCommand}"
                                                FTPUploadDate="{Binding FTPUpLoadData, Mode=TwoWay}"
                                                ItemSource="{Binding FunctionModel, Mode=TwoWay}"
                                                PLCGatherConfigCommand="{Binding PLCGatherConfigCommand}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Page>
