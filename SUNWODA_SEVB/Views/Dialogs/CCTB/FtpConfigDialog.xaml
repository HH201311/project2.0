<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.FtpConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Width="Auto"
    Height="Auto"
    MinWidth="400"
    MaxWidth="800"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBHCControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  标题样式  -->
            <Style x:Key="ConfigHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  文本样式  -->
            <Style
                x:Key="InquireTextBoxStyle"
                BasedOn="{StaticResource HCTitleValueTextBox}"
                TargetType="{x:Type hc:TextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="150" />
                <Setter Property="Margin" Value="0,2,20,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="0" />
            </Style>

            <Style BasedOn="{StaticResource ExpanderBaseStyle}" TargetType="Expander">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!--  键值对容器样式  -->
            <Style BasedOn="{StaticResource ParamPairContentControlStyle}" TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="Width" Value="260" />
                <Setter Property="PairKeyWidth" Value="110" />
                <Setter Property="Margin" Value="0,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!--  开关样式  -->
            <Style
                x:Key="PVSimpleToggleButtonStyle"
                BasedOn="{StaticResource ParamValueSimpleToggleButtonStyle}"
                TargetType="{x:Type uccc:SimpleToggleButton}">
                <Setter Property="Width" Value="50" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="CheckedText" Value="是" />
                <Setter Property="UnCheckedText" Value="否" />
            </Style>

            <Style BasedOn="{StaticResource ParamCheckBoxStyle}" TargetType="CheckBox">
                <Setter Property="Margin" Value="0,6,0,0" />
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ItemTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>

            <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Height" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border Padding="8,0" Background="{TemplateBinding Background}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <!--  仅保留鼠标悬停效果，让交互有反馈  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E8F0FE" />
                                </Trigger>
                                <!--  选中：背景透明，彻底无高亮  -->
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20,0,20,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel VerticalAlignment="Center" LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource ConfigHeaderTextBlockStyle}"
                Text="FTP配置" />
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource IconClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <Border
            Grid.Row="1"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <StackPanel Margin="20,20,20,20">
                <TextBox
                    Height="40"
                    Margin="0,0,0,20"
                    hc:InfoElement.Placeholder="eg: ftp://10.215.114.36/"
                    hc:InfoElement.Title="FTP路径"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="110"
                    Background="#1AFFFFFF"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                    FontSize="14"
                    Foreground="#99FFFFFF"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding ItemSource.FtpPath}" />
                <TextBox
                    Height="40"
                    Margin="0,0,0,20"
                    hc:InfoElement.Placeholder="请输入用户账号"
                    hc:InfoElement.Title="用户账号"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="110"
                    Background="#1AFFFFFF"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                    FontSize="14"
                    Foreground="#99FFFFFF"
                    Style="{StaticResource TextBoxExtend}"
                    Text="{Binding ItemSource.UserName}" />

                <hc:PasswordBox
                    Height="40"
                    Margin="0,0,0,20"
                    hc:InfoElement.Necessary="True"
                    hc:InfoElement.Placeholder="请输入用户密码"
                    hc:InfoElement.Symbol="*"
                    hc:InfoElement.Title="用户密码"
                    hc:InfoElement.TitlePlacement="Left"
                    hc:InfoElement.TitleWidth="110"
                    Background="#0DFFFFFF"
                    BorderThickness="0"
                    CaretBrush="#FFFFFFFF"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                    FontSize="14"
                    Foreground="#99FFFFFF"
                    IsSafeEnabled="False"
                    PasswordChar="*"
                    ShowEyeButton="True"
                    Style="{StaticResource HCPasswordBoxStyle}"
                    UnsafePassword="{Binding ItemSource.Password, UpdateSourceTrigger=PropertyChanged}" />

                <uccc:PairContentControl PairKeyText="是否启用SSL">
                    <uccc:SimpleToggleButton
                        d:IsChecked="True"
                        IsChecked="{Binding ItemSource.IsUseSSL, Mode=TwoWay}"
                        Style="{StaticResource PVSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
            </StackPanel>
        </Border>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button
                Margin="10,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="确认"
                Style="{StaticResource ParamOKButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding CancleCommand}"
                Content="取消"
                Style="{StaticResource ParamCancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

