<Page x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.ClosedLoopSettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
      xmlns:cctbmodels ="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
      xmlns:uccctb="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
      mc:Ignorable="d" 
      d:DesignHeight="940" d:DesignWidth="1610"
      Title="ClosedLoopSettingPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ParamSaveButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="#FF3DCC84"/>
                <Setter Property="Content" Value="保存"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border CornerRadius="5" BorderThickness="0" Background="{TemplateBinding Background}"/>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#99FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Left"/>
            </Style>

            <Style x:Key="ParamUnitTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#99FFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Left"/>
            </Style>

            <Style x:Key="ParamValueTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="TextAlignment" Value="Left"/>
                <Setter Property="IsReadOnly" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border BorderThickness="0" Background="#0DFFFFFF" CornerRadius="5">
                                <Grid Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" Text="{TemplateBinding Tag}" Style="{StaticResource ParamUnitTextBlockStyle}"/>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamValueToggleButton" TargetType="ToggleButton">
                <Setter Property="Background" Value="#0DFFFFFF"/>
                <Setter Property="Width" Value="50"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="Foreground" Value="#99FFFFFF"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border CornerRadius="10" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                <Grid Margin="5,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                    <TextBlock x:Name="StatusTB" Margin="0,0,14,0" Text="否" Opacity="{TemplateBinding Opacity}" 
                                               FontFamily="{TemplateBinding FontFamily}" Foreground="{TemplateBinding Foreground}"
                                               FontWeight="{TemplateBinding FontWeight}" FontSize="{TemplateBinding FontSize}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                                    <Ellipse x:Name="StatusE" Width="14" Height="14" Fill="#CCFFFFFF" HorizontalAlignment="Right" Opacity="0.87"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- 悬停状态 (可选，稍微变亮) -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.9"/>
                                </Trigger>

                                <!-- 选中状态 (IsChecked = True) -->
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="StatusTB" Property="Text" Value="是"/>
                                    <Setter TargetName="StatusTB" Property="Margin" Value="14,0,0,0"/>
                                    <Setter Property="Opacity" Value="1"/>
                                    <Setter TargetName="StatusE" Property="HorizontalAlignment" Value="Left"/>
                                    <Setter Property="Background" Value="#FF29CC7A"/>
                                    <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                </Trigger>
                                <!-- 未选中状态 (IsChecked = False) -->
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="StatusTB" Property="Text" Value="否"/>
                                    <Setter TargetName="StatusTB" Property="Margin" Value="0,0,14,0"/>
                                    <Setter Property="Opacity" Value="0.8"/>
                                    <Setter TargetName="StatusE" Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                    <Setter Property="Foreground" Value="#99FFFFFF"/>
                                </Trigger>

                                <!-- 禁用状态 -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamValueComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#0DFFFFFF"/>
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="4"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- 整体背景框 -->
                                <Border x:Name="Border"
                                    CornerRadius="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>

                                <!-- 内容展示区域 -->
                                <ContentPresenter x:Name="ContentSite"
                                                  Margin="10,0,34,0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                <!-- 下拉按钮区域：自定义形状和颜色 -->
                                <ToggleButton x:Name="DropDownToggle"
                                              HorizontalAlignment="Right" 
                                              VerticalAlignment="Center" 
                                              Margin="10,0"
                                              Focusable="false"
                                              IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid Width="14" Height="14" Background="Transparent">
                                                <Path x:Name="SimpleArrow" Data="M0,0 L4,4 L8,0" StrokeThickness="1" Stroke="#61FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SimpleArrow" Property="Stroke" Value="#CCFFFFFF"/>
                                                    <Setter TargetName="SimpleArrow" Property="StrokeThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 下拉弹出框 -->
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border x:Name="PopupBorder"
                                            CornerRadius="5"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            SnapsToDevicePixels="True">
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!-- 选中项的字体颜色随背景对比调整 -->
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270*"/>
            <RowDefinition Height="270*"/>
            <RowDefinition Height="360*"/>
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="A面" Margin="0,0,0,20" Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid Rows="1" Margin="20,20,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <uccctb:ArithmeticSettingControl Header="MD算法" SideType="A" ClosedLoopType="MD" Margin="0,0,20,0" 
                                                 ArithmeticName="{Binding ArithmeticModel_MDA.ArithmeticName,Mode=TwoWay}" IsArithmeticEnabled="{Binding ArithmeticModel_MDA.IsEnable,Mode=TwoWay}" 
                                                 ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                                                 ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}" ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"/>
                <uccctb:ArithmeticSettingControl Header="TD算法" SideType="A" ClosedLoopType="TD" Margin="0,0,20,0" 
                                                 ArithmeticName="{Binding ArithmeticModel_TDA.ArithmeticName,Mode=TwoWay}" IsArithmeticEnabled="{Binding ArithmeticModel_TDA.IsEnable,Mode=TwoWay}" 
                                                 ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                                                 ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}" ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"/>
                <uccctb:ArithmeticSettingControl Header="MDTD算法" SideType="A" ClosedLoopType="MDTD" Margin="0,0,20,0" 
                                                 ArithmeticName="{Binding ArithmeticModel_MDTDA.ArithmeticName,Mode=TwoWay}" IsArithmeticEnabled="{Binding ArithmeticModel_MDTDA.IsEnable,Mode=TwoWay}" 
                                                 ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                                                 ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}" ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"/>

            </UniformGrid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="B面" Margin="0,0,0,20" Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid Rows="1" Margin="20,20,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <uccctb:ArithmeticSettingControl Header="MD算法" SideType="B" ClosedLoopType="MD" Margin="0,0,20,0" 
                                                 ArithmeticName="{Binding ArithmeticModel_MDB.ArithmeticName,Mode=TwoWay}" IsArithmeticEnabled="{Binding ArithmeticModel_MDB.IsEnable,Mode=TwoWay}" 
                                                 ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                                                 ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}" ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"/>
                <uccctb:ArithmeticSettingControl Header="TD算法" SideType="B" ClosedLoopType="TD" Margin="0,0,20,0" 
                                                 ArithmeticName="{Binding ArithmeticModel_TDB.ArithmeticName,Mode=TwoWay}" IsArithmeticEnabled="{Binding ArithmeticModel_TDB.IsEnable,Mode=TwoWay}" 
                                                 ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                                                 ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}" ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"/>
                <uccctb:ArithmeticSettingControl Header="MDTD算法" SideType="B" ClosedLoopType="MDTD" Margin="0,0,20,0" 
                                                 ArithmeticName="{Binding ArithmeticModel_MDTDB.ArithmeticName,Mode=TwoWay}" IsArithmeticEnabled="{Binding ArithmeticModel_MDTDB.IsEnable,Mode=TwoWay}" 
                                                 ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                                                 ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}" ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"/>
            </UniformGrid>
        </GroupBox>
        <Grid Grid.Row="2" Margin="0">
            <GroupBox Header="通用设置" Style="{StaticResource SimpleGroupBoxStyle}">
                <UniformGrid Rows="1" Margin="20,20,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <GroupBox Header="数据处理设置" Margin="0,0,20,0" Style="{StaticResource SimpleGroupBoxStyle1}">
                        <StackPanel Margin="20,0,20,20" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="闭环数据源" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding WeightDataTypeSource}" SelectedValue="{Binding GeneralSettingsModel.WeightDataType}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="ItemValue" Style="{StaticResource ParamValueComboBoxStyle}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="膜区处理" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <ComboBox ItemsSource="{Binding EMembraneZoneTypeSource}" SelectedValue="{Binding GeneralSettingsModel.MembraneZoneType}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="ItemValue" Style="{StaticResource ParamValueComboBoxStyle}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="刀距滞后变化值" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <TextBox d:Text="1" Text="{Binding asd}" Tag="(mm)" Style="{StaticResource ParamValueTextBoxStyle}"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="PLC设定泵速读取配置" Margin="0,0,20,0" Style="{StaticResource SimpleGroupBoxStyle1}">
                        <StackPanel Margin="20,0,20,20" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="小数位/精度" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <TextBox d:Text="2" Text="{Binding asd}" Style="{StaticResource ParamValueTextBoxStyle}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="四舍五入" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <ToggleButton d:IsChecked="False" IsChecked="{Binding asd}" Style="{StaticResource ParamValueToggleButton}"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="数据判异/数采设置" Margin="0,0,20,0" Style="{StaticResource SimpleGroupBoxStyle1}">
                        <StackPanel Margin="20,0,20,20" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="走带速度" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <TextBox d:Text="20" Text="{Binding asd}" Tag="(m/min)" Style="{StaticResource ParamValueTextBoxStyle}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="面密度目标值" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <TextBox d:Text="±20" Text="{Binding asd,StringFormat={}±{0}}" Tag="(mg)" Style="{StaticResource ParamValueTextBoxStyle}"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="设备参数配置" Margin="0,0,20,0" Style="{StaticResource SimpleGroupBoxStyle1}">
                        <StackPanel Margin="20,0,20,20" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                <TextBlock Text="AB面走带间隔距离" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                <TextBox d:Text="85" Text="{Binding asd}" Tag="(m)" Style="{StaticResource ParamValueTextBoxStyle}"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="膜区配置" Margin="0,0,20,0" Style="{StaticResource SimpleGroupBoxStyle1}">
                        <StackPanel Margin="20,0,20,20" Orientation="Vertical" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <UniformGrid Columns="1" MinHeight="30" Margin="0,20,0,0">
                                <ComboBox ItemsSource="{Binding PartitionedTypeSource}" SelectedValue="{Binding GeneralSettingsModel.PartitionedType}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="ItemValue" Style="{StaticResource ParamValueComboBoxStyle}"/>
                            </UniformGrid>
                            <ScrollViewer Margin="0,20,0,0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding asd}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Margin="0,20,0,0"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.Resources>
                                        <DataTemplate DataType="{x:Type cctbmodels:PartitionedModel}">
                                            <UniformGrid Rows="3" Columns="1">
                                                <TextBlock d:Text="膜区一" Text="{Binding PartitionedName}" Foreground="#CCFFFFFF" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                                <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                                    <TextBlock Text="起止位置" Opacity="0.6" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" d:Text="1" Text="{Binding StartIndex}" Tag="(m)" Style="{StaticResource ParamValueTextBoxStyle}"/>
                                                        <Rectangle Grid.Column="1" Height="1" Width="20" Margin="6,0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="2" d:Text="1" Text="{Binding EndIndex}" Tag="(m)" Style="{StaticResource ParamValueTextBoxStyle}"/>
                                                    </Grid>
                                                </UniformGrid>
                                                <UniformGrid Columns="2" MinHeight="30" Margin="0,20,0,0">
                                                    <TextBlock Text="分区个数" Opacity="0.6" Style="{StaticResource ParamNameTextBlockStyle}"/>
                                                    <TextBox d:Text="1" Text="{Binding PartitionedCount}" Style="{StaticResource ParamValueTextBoxStyle}"/>
                                                </UniformGrid>
                                            </UniformGrid>
                                        </DataTemplate>
                                    </ItemsControl.Resources>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </GroupBox>
                </UniformGrid>
            </GroupBox>
            <Button Margin="0,20,20,0" Command="{Binding ParamSaveCommand}" Style="{StaticResource ParamSaveButtonStyle}"/>
        </Grid>
    </Grid>
</Page>
