<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CoatingOPMM.CoatingOPMMPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CoatingOPMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CoatingOPMMPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Frame Content="{Binding Line1Page}" NavigationUIVisibility="Hidden" />
        <Frame
            Grid.Row="1"
            Content="{Binding Line2Page}"
            NavigationUIVisibility="Hidden" />
    </Grid>
</Page>
