<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.JRCW.ParamControls.YWParamControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.JRCW;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JRCW.ParamControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <convert:UserRoleToVisibilityConverter x:Key="UserRoleToVisibilityConverter" />

            <Style x:Key="ParamGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Margin" Value="5" />
                <Setter Property="Padding" Value="5,10" />
                <Setter Property="BorderBrush" Value="#D5DFE5" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Grid SnapsToDevicePixels="true">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="6" />
                                </Grid.RowDefinitions>
                                <Border
                                    Grid.Row="1"
                                    Grid.RowSpan="3"
                                    Grid.ColumnSpan="4"
                                    BorderBrush="Black"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Border
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3">
                                        <Border
                                            BorderBrush="White"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="2" />
                                    </Border>
                                </Border>
                                <Border
                                    x:Name="Header"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Grid.Column="2"
                                    Padding="3,1,3,0"
                                    HorizontalAlignment="Left"
                                    Background="White">
                                    <ContentPresenter
                                        ContentSource="Header"
                                        RecognizesAccessKey="True"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </Border>
                                <ContentPresenter
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>

            <Style x:Key="ParamValueTextBoxStyle" TargetType="TextBox">
                <Setter Property="BorderThickness" Value="0,0,0,0" />
                <Setter Property="MinWidth" Value="80" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UniformGrid Background="WhiteSmoke" Rows="1">
        <GroupBox
            Header="数据处理设置"
            Style="{StaticResource ParamGroupBoxStyle}"
            Visibility="{Binding UserRole, Converter={StaticResource UserRoleToVisibilityConverter}, ConverterParameter=6}">
            <StackPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t1" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.T1, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t2" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.T2, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t3" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.T3, Mode=TwoWay}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="参数设置" Style="{StaticResource ParamGroupBoxStyle}">
            <StackPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环阈值t4" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.T4, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="单次调节量上限" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.U_Limit, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="调节系数K值" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.K, Mode=TwoWay}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox
            Header="调节设置"
            Style="{StaticResource ParamGroupBoxStyle}"
            Visibility="{Binding UserRole, Converter={StaticResource UserRoleToVisibilityConverter}, ConverterParameter=6}">
            <StackPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="变径调节精度" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.J_d, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="压花调节阈值" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.P_Switch, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="压花调节系数p_t" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.P_t, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="压花调节精度" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.P_j_d, Mode=TwoWay}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="极耳层数" Style="{StaticResource ParamGroupBoxStyle}">
            <StackPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="正极层数" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.Nb, Mode=TwoWay}" />
                </DockPanel>
                <DockPanel Margin="1,5">
                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="负极层数" />
                    <TextBox Style="{StaticResource ParamValueTextBoxStyle}" Text="{Binding ParamSettingModel.Na, Mode=TwoWay}" />
                </DockPanel>
            </StackPanel>
        </GroupBox>
    </UniformGrid>
</UserControl>
