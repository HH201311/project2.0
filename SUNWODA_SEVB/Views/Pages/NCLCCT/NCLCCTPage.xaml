<Page
    x:Class="SUNWODA_SEVB.Views.Pages.NCLCCT.NCLCCTPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:coreConverter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.NCLCCT"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CTOL;assembly=SUNWODA_SEVB.Component"
    Title="NCLCCTPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    FontSize="15"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <coreConverter:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Menu
                x:Name="menuBar"
                Background="Transparent"
                BorderBrush="LightGray"
                BorderThickness="1">
            <MenuItem Header="开始" IsEnabled="{Binding IsEnableContinuousDetection}">
                <CheckBox
                    Command="{Binding MonitorPathSelectCommand}"
                    Content="连续检测"
                    IsChecked="{Binding IsContinuousDetection}"
                    IsEnabled="{Binding IsEnableContinuousDetection}"
                    Style="{StaticResource ToggleButtonSwitch.Small}"
                    ToolTip="{Binding MonitorPathsDisplay, UpdateSourceTrigger=PropertyChanged}" />
            </MenuItem>
            <MenuItem Header="参数设置">
                <MenuItem Header="导入">
                    <MenuItem Header="单张导入">
                        <MenuItem
                            Command="{Binding FileSelectCommand}"
                            Header="文件选择"
                            IsEnabled="{Binding IsEnableFileSelect}" />
                    </MenuItem>
                    <MenuItem Header="按文件夹导入">
                        <MenuItem
                            Command="{Binding DirSelectCommand}"
                            Header="文件夹选择"
                            IsEnabled="{Binding IsEnableFileSelect}" />
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="导出">
                    <MenuItem
                        Command="{Binding ExportPathSelectCommand}"
                        Header="路径选择"
                        IsEnabled="{Binding IsEnableSetGapLimit}"
                        ToolTip="{Binding ExportPath, UpdateSourceTrigger=PropertyChanged}" />
                </MenuItem>
                <MenuItem Header="保存" Visibility="Collapsed">
                    <CheckBox Content="AI增强结果" IsChecked="{Binding IsSaveAIEnhanceResult}" />
                </MenuItem>
                <MenuItem Header="Gap标准">
                    <DockPanel IsEnabled="{Binding IsEnableSetGapLimit}">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="像素精度 (mm/px) ×" />
                        <hc:NumericUpDown
                            Margin="10,0"
                            DecimalPlaces="4"
                            Value="{Binding HuaweiPxToMmScale}" />
                    </DockPanel>
                    <Separator />
                    <DockPanel IsEnabled="{Binding IsEnableSetGapLimit}">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="管控 Gap1~3 ≤ (mm)" />
                        <hc:NumericUpDown
                            Margin="10,0"
                            DecimalPlaces="3"
                            Value="{Binding HuaweiNorm3UpperMm}" />
                    </DockPanel>
                    <DockPanel IsEnabled="{Binding IsEnableSetGapLimit}">
                        <hc:NumericUpDown
                            Margin="10,0"
                            DecimalPlaces="3"
                            Value="{Binding HuaweiNorm2LowerMm}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="≤ 管控 Gap4~6 ≤ (mm)" />
                        <hc:NumericUpDown
                            Margin="10,0"
                            DecimalPlaces="3"
                            Value="{Binding HuaweiNorm2MeanUpperMm}" />
                    </DockPanel>
                    <DockPanel IsEnabled="{Binding IsEnableSetGapLimit}">
                        <TextBlock
                            VerticalAlignment="Center"
                            DockPanel.Dock="Left"
                            Text="管控 Gap10 ≤ (mm)" />
                        <hc:NumericUpDown
                            Margin="10,0"
                            DecimalPlaces="3"
                            Value="{Binding HuaweiNorm1UpperMm}" />
                    </DockPanel>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="检测类型" ItemsSource="{Binding DetectionItems}">
                <MenuItem.ItemsPanel>
                    <ItemsPanelTemplate>
                        <hc:SimpleStackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </MenuItem.ItemsPanel>

                <MenuItem.ItemTemplate>
                    <DataTemplate>
                        <RadioButton
                            HorizontalAlignment="Left"
                            Content="{Binding Name}"
                            GroupName="detections"
                            IsChecked="{Binding IsChecked}"
                            IsEnabled="{Binding IsEnabled}" />
                    </DataTemplate>
                </MenuItem.ItemTemplate>
            </MenuItem>
            </Menu>
            <TextBlock
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="15"
                FontWeight="SemiBold"
                Foreground="#1565C0"
                IsHitTestVisible="False"
                Text="{Binding FolderImportProgressText}"
                Visibility="{Binding IsFolderImportProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition MinWidth="300" MaxWidth="550" />
            </Grid.ColumnDefinitions>

            <Border BorderBrush="LightGray" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="1" Margin="5">
                        <TextBlock
                            Margin="0,0,0,5"
                            DockPanel.Dock="Top"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="检测结果图" />
                        <uc:ImageShowControl Background="Black" Source="{Binding LastProcessedImage}" />
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Width="2" HorizontalAlignment="Right" />

            <Border
                Grid.Column="1"
                BorderBrush="LightGray"
                BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border BorderBrush="LightGray" BorderThickness="0.5">
                        <uc:PiePlotViewer
                            Labels="{Binding DetectionSattisticalLabel}"
                            LabelsColor="{Binding DetectionStatisticalLabelColor}"
                            Values="{Binding DetectionSattisticalData}" />
                    </Border>

                    <Border
                        Grid.Row="1"
                        BorderBrush="LightGray"
                        BorderThickness="0.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="4*" />
                            </Grid.RowDefinitions>

                            <Border
                                Grid.ColumnSpan="2"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="状态信息" />
                            </Border>


                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="总检测数" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="100"
                                        FontWeight="Bold"
                                        Text="{Binding TotalDetectionNum}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="OK数" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="95"
                                        FontWeight="Bold"
                                        Text="{Binding OKDetectionNum}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="NG数" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="5"
                                        FontWeight="Bold"
                                        Text="{Binding NGDetectionNum}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="一次优率" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        d:Text="95%"
                                        FontWeight="Bold"
                                        Text="{Binding OKRate, StringFormat={}{0:F1}%}" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                BorderBrush="LightGray"
                                BorderThickness="0.5">
                                <DockPanel Margin="10">
                                    <Button
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Center"
                                        Background="OrangeRed"
                                        BorderThickness="0"
                                        Command="{Binding ClearDetectionInfoCommand}"
                                        Content="统计清零"
                                        DockPanel.Dock="Top"
                                        FontWeight="Bold"
                                        Foreground="Black">
                                        <hc:IconElement.Geometry>
                                            <PathGeometry>M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19M8,9H16V19H8V9M15.5,4L14.5,3H9.5L8.5,4H5V6H19V4H15.5Z</PathGeometry>
                                        </hc:IconElement.Geometry>
                                    </Button>
                                    <ScrollViewer HorizontalScrollBarVisibility="Visible">
                                        <ListView ItemsSource="{Binding DetectionInfoList}">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.View>
                                                <GridView>
                                                    <GridViewColumn Width="160" DisplayMemberBinding="{Binding ClearTime, StringFormat='yyyy-MM-dd HH:mm:ss'}">
                                                        <GridViewColumnHeader
                                                            HorizontalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Content="清零时间"
                                                            FontSize="12"
                                                            FontWeight="Bold" />
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding DetectionTotalNum}">
                                                        <GridViewColumnHeader
                                                            HorizontalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Content="总检测数"
                                                            FontSize="12"
                                                            FontWeight="Bold" />
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding DetectionOKNum}">
                                                        <GridViewColumnHeader
                                                            HorizontalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Content="OK数"
                                                            FontSize="12"
                                                            FontWeight="Bold" />
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding DetectionNGNum}">
                                                        <GridViewColumnHeader
                                                            HorizontalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Content="NG数"
                                                            FontSize="12"
                                                            FontWeight="Bold" />
                                                    </GridViewColumn>
                                                    <GridViewColumn Width="80" DisplayMemberBinding="{Binding DetectionOKRate, StringFormat={}{0:F1}%}">
                                                        <GridViewColumnHeader
                                                            HorizontalAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Content="一次优率"
                                                            FontSize="12"
                                                            FontWeight="Bold" />
                                                    </GridViewColumn>
                                                </GridView>
                                            </ListView.View>
                                        </ListView>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            BorderBrush="LightGray"
            BorderThickness="1">
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />
        </Border>

        <Grid
            Grid.RowSpan="3"
            Visibility="{Binding IsInitCompleted, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Border Background="#CC2B2B2B" />
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="640">
                <TextBlock
                    Margin="20,0,20,16"
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="White"
                    Text="{Binding DownloadStatusText}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <ProgressBar
                    Width="480"
                    Height="22"
                    Maximum="100"
                    Minimum="0"
                    IsIndeterminate="{Binding IsDownloadProgressIndeterminate}"
                    Value="{Binding DownloadProgress}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
