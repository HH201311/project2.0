<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CTAutoSlicer.RoiPreviewOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="ROI 范围预览"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Grid>
        <Canvas x:Name="MaskCanvas" Background="Transparent">
            <Rectangle
                x:Name="MaskTop"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Height="0"
                Width="0" />
            <Rectangle
                x:Name="MaskBottom"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Height="0"
                Width="0" />
            <Rectangle
                x:Name="MaskLeft"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Height="0"
                Width="0" />
            <Rectangle
                x:Name="MaskRight"
                Canvas.Left="0"
                Canvas.Top="0"
                Fill="#99000000"
                Height="0"
                Width="0" />
            <Rectangle
                x:Name="SelectionRect"
                Fill="#3300E5FF"
                Stroke="#FF00E5FF"
                StrokeThickness="3" />
            <Border
                x:Name="LabelBorder"
                Padding="10,6"
                Background="#EE1E1E1E"
                CornerRadius="4"
                IsHitTestVisible="False">
                <TextBlock
                    x:Name="LabelText"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="ROI 预览" />
            </Border>
        </Canvas>

        <TextBlock
            Margin="24"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="White"
            IsHitTestVisible="False"
            Text="当前为已标定 ROI 范围预览；Esc 或取消勾选关闭" />
    </Grid>
</Window>
