<Page
    x:Class="SUNWODA_SEVB.Views.Pages.PCD.PersonCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cov="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.PCD"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="PersonCheckPage"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Page.Resources>
        <cov:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <cov:BooleanToBrushConverter
            x:Key="BooleanToBrushConverter"
            FalseBrush="Red"
            TrueBrush="Green" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Button
                Width="100"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding StartMonitoringCommand}"
                Content="开始监控"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />
            <Button
                Width="100"
                Height="30"
                Command="{Binding StopMonitoringCommand}"
                Content="停止监控"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />

            <Separator
                Margin="10,0"
                Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

            <!--  顶部相机状态  -->
            <Ellipse
                Width="10"
                Height="10"
                Margin="5,0,2,0"
                Fill="{Binding Cam1StatusColor}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{Binding Cam1StatusColor}"
                Text="{Binding Cam1Status, StringFormat='顶部: {0}'}" />

            <!--  左部相机状态  -->
            <Ellipse
                Width="10"
                Height="10"
                Margin="15,0,2,0"
                Fill="{Binding Cam2StatusColor}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{Binding Cam2StatusColor}"
                Text="{Binding Cam2Status, StringFormat='左部: {0}'}" />

            <!--  右部相机状态  -->
            <Ellipse
                Width="10"
                Height="10"
                Margin="15,0,2,0"
                Fill="{Binding Cam3StatusColor}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{Binding Cam3StatusColor}"
                Text="{Binding Cam3Status, StringFormat='右部: {0}'}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="275" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    BorderBrush="Gray"
                    FontWeight="ExtraBold"
                    Header="实时监控 (Live)">
                    <UniformGrid Columns="3" Rows="1">
                        <Grid Margin="2">
                            <Grid Background="LightGray">
                                <Image Source="{Binding LiveDisplayImage1}" Stretch="Uniform" />
                            </Grid>
                            <Border
                                Margin="5"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="DarkGray">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Green"
                                    Text="顶部监控 (实时)" />
                            </Border>
                        </Grid>
                        <Grid Margin="2">
                            <Grid Background="LightGray">
                                <Image Source="{Binding LiveDisplayImage2}" Stretch="Uniform" />
                            </Grid>
                            <Border
                                Margin="5"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="DarkGray">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Green"
                                    Text="左部监控 (实时)" />
                            </Border>
                        </Grid>
                        <Grid Margin="2">
                            <Grid Background="LightGray">
                                <Image Source="{Binding LiveDisplayImage3}" Stretch="Uniform" />
                            </Grid>
                            <Border
                                Margin="5"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="DarkGray">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Green"
                                    Text="右部监控 (实时)" />
                            </Border>
                        </Grid>
                    </UniformGrid>
                </GroupBox>

                <GroupBox
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    FontWeight="ExtraBold"
                    Header="智能预警 (Warnings)">
                    <UniformGrid Columns="3" Rows="1">
                        <Grid Margin="2" Background="LightGray">
                            <Image Source="{Binding AnomalyDisplayImage1}" Stretch="Uniform" />
                            <Border
                                Margin="5"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="DarkGray">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Red"
                                    Text="顶部监控 (异常)" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding AnomalyInfo1}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Yellow" />
                                        <Setter Property="FontSize" Value="18" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="#A0000000" />
                                        <!--  半透明黑色背景底色  -->
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <!--  当没有异常信息时，自动隐藏整个文本块（连同黑底）  -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="2" Background="LightGray">
                            <Image Source="{Binding AnomalyDisplayImage2}" Stretch="Uniform" />
                            <Border
                                Margin="5"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="DarkGray">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Red"
                                    Text="左部监控 (异常)" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding AnomalyInfo2}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Yellow" />
                                        <Setter Property="FontSize" Value="18" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="#A0000000" />
                                        <!--  半透明黑色背景底色  -->
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <!--  当没有异常信息时，自动隐藏整个文本块（连同黑底）  -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <Grid Margin="2" Background="LightGray">
                            <Image Source="{Binding AnomalyDisplayImage3}" Stretch="Uniform" />
                            <Border
                                Margin="5"
                                Padding="5,2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Background="DarkGray">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="Red"
                                    Text="右部监控 (异常)" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Text="{Binding AnomalyInfo3}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Yellow" />
                                        <Setter Property="FontSize" Value="18" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Setter Property="Background" Value="#A0000000" />
                                        <!--  半透明黑色背景底色  -->
                                        <Setter Property="Padding" Value="10,5" />
                                        <Setter Property="Visibility" Value="Visible" />
                                        <!--  当没有异常信息时，自动隐藏整个文本块（连同黑底）  -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </UniformGrid>
                </GroupBox>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  数据统计部分  -->
                <GroupBox
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Header="参数配置">
                    <StackPanel Margin="10">
                        <!--  FPS  -->
                        <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                            <TextBlock
                                Margin="1,0,15,0"
                                VerticalAlignment="Center"
                                FontWeight="Bold"
                                Foreground="DarkGray"
                                Text="检测帧率(FPS):" />
                            <hc:NumericUpDown
                                Width="80"
                                Height="30"
                                Increment="1"
                                Maximum="60"
                                Minimum="1"
                                Value="{Binding FramesPerSecond, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Separator Margin="0,1" />

                        <!--  顶部相机检测区域配置  -->
                        <TextBlock
                            Margin="0,5,0,10"
                            FontWeight="Bold"
                            Foreground="DarkGray"
                            Text="顶部相机检测区域 (Specified Zone)" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  点1 (左上)  -->
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="点1 (左上) X:" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="5"
                                Maximum="3840"
                                Minimum="0"
                                Value="{Binding ZonePoint1X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="Y:" />
                            <hc:NumericUpDown
                                Grid.Row="0"
                                Grid.Column="3"
                                Margin="5"
                                Maximum="2160"
                                Minimum="0"
                                Value="{Binding ZonePoint1Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  点2 (右上)  -->
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="点2 (右上) X:" />
                            <hc:NumericUpDown
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="5"
                                Maximum="3840"
                                Minimum="0"
                                Value="{Binding ZonePoint2X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="Y:" />
                            <hc:NumericUpDown
                                Grid.Row="1"
                                Grid.Column="3"
                                Margin="5"
                                Maximum="2160"
                                Minimum="0"
                                Value="{Binding ZonePoint2Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  点3 (右下)  -->
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="点3 (右下) X:" />
                            <hc:NumericUpDown
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="5"
                                Maximum="3840"
                                Minimum="0"
                                Value="{Binding ZonePoint3X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="Y:" />
                            <hc:NumericUpDown
                                Grid.Row="2"
                                Grid.Column="3"
                                Margin="5"
                                Maximum="2160"
                                Minimum="0"
                                Value="{Binding ZonePoint3Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!--  点4 (左下)  -->
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="0"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="点4 (左下) X:" />
                            <hc:NumericUpDown
                                Grid.Row="3"
                                Grid.Column="1"
                                Margin="5"
                                Maximum="3840"
                                Minimum="0"
                                Value="{Binding ZonePoint4X, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Grid.Row="3"
                                Grid.Column="2"
                                Margin="5"
                                VerticalAlignment="Center"
                                Text="Y:" />
                            <hc:NumericUpDown
                                Grid.Row="3"
                                Grid.Column="3"
                                Margin="5"
                                Maximum="2160"
                                Minimum="0"
                                Value="{Binding ZonePoint4Y, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <Button
                            Width="120"
                            Height="30"
                            Margin="0,10,0,0"
                            Command="{Binding SaveZoneCommand}"
                            Content="保存检测区域"
                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox
                    Grid.Row="1"
                    Margin="0,5,0,0"
                    Header="报警与事件日志">
                    <ListBox
                        ItemsSource="{Binding AlarmLogs}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        VirtualizingStackPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="0,2"
                                    FontSize="11"
                                    Foreground="{Binding LogColor}"
                                    Text="{Binding Message}"
                                    TextWrapping="Wrap" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </Grid>
        </Grid>

        <StatusBar Grid.Row="2" Background="#FFF0F0F0">
            <StatusBarItem>
                <TextBlock Foreground="Gray" Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="Gray" Text="{Binding CurrentTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>
