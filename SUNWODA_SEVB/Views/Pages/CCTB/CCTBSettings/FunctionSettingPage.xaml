<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.FunctionSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="FunctionSettingPage"
    d:DesignHeight="940"
    d:DesignWidth="1610"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Border
            Grid.Column="0"
            Background="#0DFFFFFF"
            BorderThickness="0"
            CornerRadius="10">
            <StackPanel Orientation="Vertical">
                <RadioButton
                    d:IsChecked="True"
                    Command="{Binding BasicFunctionsCommand}"
                    Content="基础功能"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_BasicFunctionsPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}" />
                <RadioButton
                    d:IsChecked="False"
                    Command="{Binding SpecialFunctionsCommand}"
                    Content="特殊功能"
                    IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_SpecialFunctionsPage'}"
                    Style="{StaticResource SubNavigationRadioButtonStyle}" />
            </StackPanel>
        </Border>

        <Frame
            Grid.Column="1"
            Margin="20,0,0,0"
            BorderThickness="0"
            Content="{Binding NavigationPage}" />
    </Grid>
</Page>
