<hc:Window
    x:Class="SUNWODA_SEVB.Views.Windows.Common.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Windows.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="单机数字化平台"
    Width="800"
    Height="450"
    WindowState="Maximized"
    mc:Ignorable="d">
    <!--  添加资源和转换器  -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converter:BooleanToRLAngleConverter x:Key="BooleanToRLAngleConverter" />

        <!--  垂直半圆形按钮样式（右侧）  -->
        <Style x:Key="SemiCircleRightButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Path
                                x:Name="ButtonPath"
                                Fill="{TemplateBinding Background}"
                                Stroke="{TemplateBinding BorderBrush}"
                                StrokeThickness="0">
                                <Path.Data>
                                    <PathGeometry>
                                        <PathFigure StartPoint="0,0">
                                            <ArcSegment
                                                IsLargeArc="True"
                                                Point="0,40"
                                                Size="20,20"
                                                SweepDirection="Clockwise" />
                                            <LineSegment Point="0,0" />
                                        </PathFigure>
                                    </PathGeometry>
                                </Path.Data>
                            </Path>

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill">
                                    <Setter.Value>
                                        <SolidColorBrush Opacity="0.8" Color="#FF2C3E50" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonPath" Property="Fill">
                                    <Setter.Value>
                                        <SolidColorBrush Color="#FF1A252F" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="#FF1A252F" />
            <Setter Property="BorderBrush" Value="#FF2C3E50" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="NavigationColumnDefinition"
                Width="Auto"
                MaxWidth="500" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>



        <!--  左侧导航栏  -->
        <Grid
            x:Name="NavigationBar"
            Grid.Column="0"
            Background="#FF2C3E50"
            Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>


            <!--  Logo区域  -->

            <Border
                Grid.Row="0"
                Height="60"
                Background="#FF1A252F">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Foreground="White"
                    Text="单机数字化平台" />
            </Border>

            <!--  菜单列表  -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl d:ItemsSource="{d:SampleData}" ItemsSource="{Binding MenuItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                GroupName="NavButtons"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding DataContext.IsNavigating, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border
                                                        x:Name="border"
                                                        Padding="10,8"
                                                        Background="Transparent"
                                                        BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FF34495E" />
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#FF3498DB" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.5" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter Property="FontSize" Value="14" />
                                    </Style>
                                </RadioButton.Style>
                                <StackPanel Margin="10,2" Orientation="Horizontal">
                                    <TextBlock Margin="0,0,10,0" Text="{Binding Icon}" />
                                    <TextBlock Text="{Binding DisplayName}" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  底部功能按钮  -->
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <RadioButton
                    Command="{Binding SettingsCommand}"
                    GroupName="NavButtons"
                    IsEnabled="{Binding IsNavigating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="border"
                                            Padding="20,10"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF34495E" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF3498DB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </RadioButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Margin="0,0,10,0" Text="⚙️" />-->
                        <iconPacks:PackIconMaterial Margin="0,0,10,0" Kind="Cog" />
                        <TextBlock Text="设置" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    Command="{Binding UserCommand}"
                    GroupName="NavButtons"
                    IsEnabled="{Binding IsNavigating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border
                                            x:Name="border"
                                            Padding="20,10"
                                            Background="Transparent"
                                            BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF34495E" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#FF3498DB" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontSize" Value="14" />
                        </Style>
                    </RadioButton.Style>
                    <StackPanel Orientation="Horizontal">
                        <!--<TextBlock Margin="0,0,10,0" Text="👤" />-->
                        <iconPacks:PackIconMaterial Margin="0,0,10,0" Kind="Account" />
                        <TextBlock Text="用户" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>

        <GridSplitter
            Width="4"
            HorizontalAlignment="Right"
            Background="Transparent"
            IsEnabled="{Binding IsNavigationExpanded}"
            Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!--  右侧内容区  -->
        <Grid Grid.Column="1" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  顶部状态栏  -->
            <Border
                Grid.Row="0"
                Height="40"
                Background="#FFF8F9FA"
                BorderBrush="#FFE0E0E0"
                BorderThickness="0,0,0,1"
                Visibility="Visible">
                <Grid>
                    <TextBlock
                        Grid.Column="0"
                        Margin="20,0"
                        VerticalAlignment="Center"
                        Text="{Binding LoadingMessage}" />
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Frame x:Name="NavigationFrame" NavigationUIVisibility="Hidden">
                    <Frame.Resources>
                        <!--  添加淡入淡出动画  -->
                        <Style TargetType="Frame">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Frame">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter x:Name="PART_FrameCP">
                                                <ContentPresenter.RenderTransform>
                                                    <TranslateTransform />
                                                </ContentPresenter.RenderTransform>
                                            </ContentPresenter>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Frame.Resources>
                </Frame>
            </Grid>
        </Grid>

        <Button
            Margin="-20,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Command="{Binding ToggleNavigationStateCommand}"
            CommandParameter="{Binding ElementName=NavigationColumnDefinition}"
            Style="{StaticResource SemiCircleRightButtonStyle}">
            <iconPacks:PackIconFontAwesome
                Width="8"
                Margin="-6"
                Foreground="White"
                Kind="{Binding IsNavigationExpanded, Converter={StaticResource BooleanToRLAngleConverter}}" />
        </Button>
    </Grid>
</hc:Window>