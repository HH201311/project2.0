<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CoatingOPMM.CoatingSingleLinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:SUNWODA_SEVB.Component.CustomControls;assembly=SUNWODA_SEVB.Component"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CoatingOPMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="CoatingSingleLinePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontSize="{Binding MainFontSize}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="3*" />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>


        <Border d:Background="#e9faf1" Background="{Binding StatusBarBrush}">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,2,0"
                    VerticalAlignment="Center"
                    d:Text="L1"
                    FontSize="{Binding LineTitleFontSize}"
                    FontWeight="Bold"
                    Text="{Binding Title}" />
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="{Binding LineTitleFontSize}"
                    Text="涂布机" />
                <TextBlock
                    VerticalAlignment="Center"
                    d:Foreground="#29cc7a"
                    d:Text="正常"
                    FontSize="{Binding LineTitleFontSize}"
                    Foreground="{Binding StatusInfoBrush}"
                    Text="{Binding StatusInfo}" />
            </StackPanel>
        </Border>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Frame Content="{Binding FaceAPage}" NavigationUIVisibility="Hidden" />
            <Frame
                Grid.Column="1"
                Content="{Binding FaceBPage}"
                NavigationUIVisibility="Hidden" />
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border>
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="A面干膜数据" />
                    </StackPanel>

                    <uc:DataCellTableControl Columns="{Binding FaceADryDataTableColumns}" Rows="{Binding FaceADryDataTableRows}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="1">
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="B面湿膜数据" />
                    </StackPanel>

                    <uc:DataCellTableControl Columns="{Binding FaceBWetDataTableColumns}" Rows="{Binding FaceBWetDataTableRows}" />
                    <!--<uc:DataTableControl Columns="{Binding FaceBWetDataTableColumns}" Rows="{Binding FaceBWetDataTableRows}" />-->
                </DockPanel>
            </Border>

            <Border Grid.Column="2">
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="B面干膜数据" />
                    </StackPanel>

                    <uc:DataCellTableControl Columns="{Binding FaceBDryDataTableColumns}" Rows="{Binding FaceBDryDataTableRows}" />
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="6.5*" />
                <ColumnDefinition Width="1.5*" />
            </Grid.ColumnDefinitions>

            <Border>
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="设备信息" />
                    </StackPanel>

                    <cc:UniformWrapItemsControl
                        Margin="0,10"
                        d:ItemsSource="{d:SampleData ItemCount=6}"
                        AutoWrapReferenceWidth="{Binding RelativeSource={RelativeSource AncestorType=DockPanel}, Path=ActualWidth}"
                        Columns="2"
                        HorizontalSpacing="5"
                        ItemsSource="{Binding DeviceInfos}"
                        VerticalSpacing="{Binding ParameterVerticalSpacing}">
                        <cc:UniformWrapItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,3,0" Text="{Binding PName}" />
                                    <TextBlock FontWeight="Bold" Text="{Binding PValue}" />
                                </StackPanel>
                            </DataTemplate>
                        </cc:UniformWrapItemsControl.ItemTemplate>
                    </cc:UniformWrapItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="1">
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="A干-B湿错位数据" />
                    </StackPanel>

                    <uc:DataCellTableControl Columns="{Binding FaceADryAndBWetDataTableColumns}" Rows="{Binding FaceADryAndBWetDataTableRows}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2">
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="A干-B干错位数据" />
                    </StackPanel>

                    <uc:DataCellTableControl Columns="{Binding FaceADryAndBDryDataTableColumns}" Rows="{Binding FaceADryAndBDryDataTableRows}" />
                </DockPanel>
            </Border>

            <Border Grid.Column="3">
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="通讯参数" />
                    </StackPanel>

                    <cc:UniformWrapItemsControl
                        Margin="0,10"
                        d:ItemsSource="{d:SampleData ItemCount=24}"
                        AutoWrapReferenceWidth="{Binding RelativeSource={RelativeSource AncestorType=DockPanel}, Path=ActualWidth}"
                        Columns="8"
                        HorizontalSpacing="5"
                        ItemsSource="{Binding GeneralParameterInfos}"
                        VerticalSpacing="{Binding ParameterVerticalSpacing}">
                        <cc:UniformWrapItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,3,0" Text="{Binding PName}" />
                                    <TextBlock FontWeight="Bold" Text="{Binding PValue}" />
                                </StackPanel>
                            </DataTemplate>
                        </cc:UniformWrapItemsControl.ItemTemplate>
                    </cc:UniformWrapItemsControl>
                </DockPanel>
            </Border>

            <Border Grid.Column="4">
                <DockPanel>
                    <StackPanel
                        Margin="0,5"
                        DockPanel.Dock="Top"
                        Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock
                            FontSize="{Binding LittleTitleFontSize}"
                            FontWeight="Bold"
                            Text="实时告警栏" />
                    </StackPanel>

                    <uc:AlarmBarControl ItemsSource="{Binding Alarms}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
