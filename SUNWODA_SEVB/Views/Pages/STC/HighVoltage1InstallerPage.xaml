<Page
    x:Class="SUNWODA_SEVB.Views.Pages.STC.HighVoltage1InstallerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conver="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.STC"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControl="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="强电连接与复拧1 - 螺丝曲线"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Page.Resources>
        <conver:BooleanInverterConverter x:Key="BooleanInverterConverter" />
        <conver:ScrewStatusToColorConverter x:Key="ScrewStatusToColorConverter" />
        <conver:ImagePathToSourceConverter x:Key="ImagePathConverter" />

        <!--  按钮基础样式  -->
        <Style x:Key="ControlButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="StartButtonStyle"
            BasedOn="{StaticResource ControlButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#4CAF50" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style
            x:Key="StopButtonStyle"
            BasedOn="{StaticResource ControlButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#F44336" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style
            x:Key="NormalButtonStyle"
            BasedOn="{StaticResource ControlButtonStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="#2196F3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
    </Page.Resources>

    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <!--  ============ 左侧：示意图 + 螺丝曲线列表 ============  -->
        <Border
            Grid.Column="0"
            Margin="10"
            Background="White"
            BorderBrush="#CCCCCC"
            BorderThickness="2"
            CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="5"
                    Opacity="0.5"
                    ShadowDepth="2"
                    Color="Gray" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  标题  -->
                <StackPanel
                    Grid.Row="0"
                    Margin="0,10,0,5"
                    HorizontalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="强电1（Pack 5）" />
                    <TextBlock
                        Margin="0,3,0,0"
                        FontSize="12"
                        Foreground="#888"
                        Text="{Binding CurrentPackCode, TargetNullValue='等待Pack包...', StringFormat='Pack包: {0}'}"
                        TextAlignment="Center" />
                    <StackPanel
                        Margin="0,3,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#666"
                            Text="判定: " />
                        <Border
                            Margin="3,0"
                            Padding="6,1"
                            CornerRadius="3">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#F5F5F5" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OverallResultText}" Value="OK">
                                            <Setter Property="Background" Value="#C8E6C9" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding OverallResultText}" Value="NG">
                                            <Setter Property="Background" Value="#FFCDD2" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Text="{Binding OverallResultText, TargetNullValue='-'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#999" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding OverallResultText}" Value="OK">
                                                <Setter Property="Foreground" Value="#2E7D32" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding OverallResultText}" Value="NG">
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  示意图（序号集成在图中，仅作空间参考，不可点）  -->
                <Image
                    Grid.Row="1"
                    MaxHeight="280"
                    Margin="8,5"
                    HorizontalAlignment="Center"
                    d:Source="/Assets/images/强电1示意图.png"
                    Source="{Binding DiagramImagePath, Converter={StaticResource ImagePathConverter}}"
                    Stretch="Uniform" />

                <!--  图例  -->
                <Border
                    Grid.Row="2"
                    Margin="10,2,10,5"
                    Padding="8,4"
                    Background="#F5F5F5"
                    CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Padding="6,2"
                            Background="#E3F2FD"
                            CornerRadius="3">
                            <TextBlock
                                FontSize="11"
                                Foreground="#1565C0"
                                Text="拧紧" />
                        </Border>
                        <Border
                            Margin="0,0,10,0"
                            Padding="6,2"
                            Background="#FFF3E0"
                            CornerRadius="3">
                            <TextBlock
                                FontSize="11"
                                Foreground="#E65100"
                                Text="复拧" />
                        </Border>
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,3,0"
                            Fill="#4CAF50" />
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Text="OK" />
                        <Ellipse
                            Width="10"
                            Height="10"
                            Margin="0,0,3,0"
                            Fill="#F44336" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Text="NG" />
                    </StackPanel>
                </Border>

                <!--  螺丝曲线列表（一条 = 一次拧紧/复拧，点击取该条曲线）  -->
                <ScrollViewer
                    Grid.Row="3"
                    Margin="8,5"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ScrewRecords}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Margin="0,1"
                                    Cursor="Hand"
                                    ToolTip="{Binding TooltipText}">
                                    <Grid.InputBindings>
                                        <MouseBinding
                                            Command="{Binding DataContext.SelectRecordCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            MouseAction="LeftClick" />
                                    </Grid.InputBindings>
                                    <Border
                                        Padding="6,4"
                                        BorderBrush="#EEE"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#E3F2FD" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!--  编号  -->
                                            <TextBlock
                                                Grid.Column="0"
                                                Width="36"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                Foreground="#333"
                                                Text="{Binding ScrewNumber, StringFormat='#{0}'}"
                                                TextAlignment="Center" />

                                            <!--  拧紧/复拧  -->
                                            <Border
                                                Grid.Column="1"
                                                Margin="3,0"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                CornerRadius="3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F5F5F5" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TypeLabel}" Value="拧紧">
                                                                <Setter Property="Background" Value="#E3F2FD" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TypeLabel}" Value="复拧">
                                                                <Setter Property="Background" Value="#FFF3E0" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock
                                                    MinWidth="28"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Text="{Binding TypeLabel}"
                                                    TextAlignment="Center" />
                                            </Border>

                                            <!--  扭矩/角度  -->
                                            <StackPanel
                                                Grid.Column="2"
                                                Margin="5,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#666"
                                                    Text="{Binding TorqueValue, StringFormat='扭矩 {0:F2} N·m', TargetNullValue='扭矩 -'}" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="#666"
                                                    Text="{Binding AngleValue, StringFormat='角度 {0:F1}°', TargetNullValue='角度 -'}" />
                                            </StackPanel>

                                            <!--  OK/NG  -->
                                            <Ellipse
                                                Grid.Column="3"
                                                Width="12"
                                                Height="12"
                                                Margin="3,0"
                                                VerticalAlignment="Center"
                                                Fill="{Binding Status, Converter={StaticResource ScrewStatusToColorConverter}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!--  底部按钮  -->
                <Border
                    Grid.Row="4"
                    Margin="10,5"
                    Padding="8"
                    Background="#FAFAFA"
                    CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                        <Button
                            Command="{Binding ResetAllStatusCommand}"
                            Content="重置状态"
                            Style="{StaticResource NormalButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  ============ 右侧：曲线区 ============  -->
        <Grid Grid.Column="1" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>

            <!--  控制栏  -->
            <Border
                Grid.Row="0"
                Margin="0,0,0,5"
                Padding="10"
                Background="White"
                CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="3"
                        Opacity="0.3"
                        ShadowDepth="1"
                        Color="Gray" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  行0：标题 + 启动/停止/清空  -->
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#333"
                        Text="螺丝曲线监控" />
                    <StackPanel
                        Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding StartServerCommand}"
                            Content="启动"
                            IsEnabled="{Binding CanStart}"
                            Style="{StaticResource StartButtonStyle}" />
                        <Button
                            Command="{Binding StopServerCommand}"
                            Content="停止"
                            IsEnabled="{Binding IsServerRunning}"
                            Style="{StaticResource StopButtonStyle}" />
                        <Button
                            Command="{Binding ClearChartsCommand}"
                            Content="清空曲线"
                            IsEnabled="{Binding IsServerRunning, Converter={StaticResource BooleanInverterConverter}}"
                            Style="{StaticResource NormalButtonStyle}" />
                        <!--  离线导入：仅服务停止时可用  -->
                        <Button
                            Margin="1,5"
                            Command="{Binding LoadLocalCsvCommand}"
                            Content="离线导入"
                            Style="{StaticResource NormalButtonStyle}"
                            ToolTip="从本地CSV导入按包号保存的历史曲线（仅服务停止时可用）" />

                        <!--  运行中禁用提示  -->
                        <!--<TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="#F44336"
                            Text="⚠ 服务运行中，导入已禁用"
                            Visibility="{Binding IsServerRunning, Converter={StaticResource BooleanToVisibilityConverter}}" />-->
                    </StackPanel>

                    <!--  行1：运行状态 + 当前标签 (左) | 手动输入 (右)  -->
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,6,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#666"
                            Text="{Binding ChannelDisplayText, TargetNullValue='强电1-未知通道', FallbackValue='强电1-未知通道'}" />
                        <Border
                            Width="1"
                            Height="16"
                            Margin="10,0"
                            Background="#DDD" />
                        <!--  服务运行状态  -->
                        <Border
                            Margin="0,0,10,0"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            CornerRadius="10">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#E0E0E0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                            <Setter Property="Background" Value="#4CAF50" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="0,0,5,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Gray" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Fill" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock VerticalAlignment="Center" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="已停止" />
                                            <Setter Property="Foreground" Value="#666" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsServerRunning}" Value="True">
                                                    <Setter Property="Text" Value="运行中" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border
                            Width="1"
                            Height="16"
                            Margin="0,0,10,0"
                            Background="#DDD" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#666"
                            Text="当前: " />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#2196F3"
                            Text="{Binding SelectedScrewLabel, TargetNullValue='-', FallbackValue='-'}" />
                    </StackPanel>
                    <StackPanel
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,6,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="#666"
                            Text="螺丝编号:" />
                        <TextBox
                            Width="90"
                            Height="26"
                            Margin="5,0"
                            Padding="5,3"
                            VerticalContentAlignment="Center"
                            Text="{Binding ManualScrewInput, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                        <Button
                            Command="{Binding FetchCurveManualCommand}"
                            Content="获取曲线"
                            Style="{StaticResource NormalButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  选中条目曲线  -->
            <Border
                Grid.Row="1"
                Margin="0,2.5"
                Background="White"
                BorderBrush="#2196F3"
                BorderThickness="2"
                CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="3"
                        Opacity="0.3"
                        ShadowDepth="1"
                        Color="Gray" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Background="#2196F3"
                        CornerRadius="3,3,0,0">
                        <StackPanel Margin="10,5" Orientation="Horizontal">
                            <TextBlock
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="螺丝曲线" />
                            <TextBlock
                                Margin="10,0,0,0"
                                FontSize="12"
                                Foreground="#E3F2FD"
                                Text="{Binding SelectedScrewLabel, TargetNullValue='点击列表或输入编号获取曲线', FallbackValue='点击列表或输入编号获取曲线'}" />
                        </StackPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <userControl:ScottPlotControl
                            Margin="5"
                            DataSeriesCollection="{Binding SelectedPlotSeries}"
                            PlotType="Line"
                            ShowGrid="True"
                            ShowLegend="True"
                            XAxisLabel="数量 (个)"
                            YAxisLabel="扭矩 (N·m)" />
                        <!--  空态占位：无曲线时提示，加载后自动隐藏  -->
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="13"
                            Foreground="#B0BEC5"
                            IsHitTestVisible="False"
                            Text="点击左侧列表行或输入编号获取曲线">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCurves}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </Border>

            <!--  操作日志  -->
            <Border
                Grid.Row="2"
                Margin="0,2.5"
                Background="White"
                BorderBrush="#90A4AE"
                BorderThickness="1"
                CornerRadius="5">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="3"
                        Opacity="0.3"
                        ShadowDepth="1"
                        Color="Gray" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Background="#607D8B"
                        CornerRadius="3,3,0,0">
                        <TextBlock
                            Margin="10,4"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="操作日志" />
                    </Border>
                    <ScrollViewer
                        Grid.Row="1"
                        Background="#FAFAFA"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Logs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="6,1"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Text="{Binding DisplayText}"
                                        TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#555" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warn">
                                                        <Setter Property="Foreground" Value="#FF9800" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Foreground" Value="#F44336" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
