<Page
    x:Class="SUNWODA_SEVB.Views.Pages.PCD.PersonCheckPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:cov="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.PCD"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    Title="PersonCheckPage"
    d:DesignHeight="720"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Page.Resources>
        <cov:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <cov:BooleanToBrushConverter x:Key="BooleanToBrushConverter" TrueBrush="Green" FalseBrush="Red" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,10"
            Orientation="Horizontal">
            <Button
                Width="100"
                Height="30"
                Margin="0,0,10,0"
                Command="{Binding StartMonitoringCommand}"
                Content="开始监控"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />
            <Button
                Width="100"
                Height="30"
                Command="{Binding StopMonitoringCommand}"
                Content="停止监控"
                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" />

            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                FontWeight="Bold"
                Foreground="DarkGray"
                Text="当前系统状态: " />
            <TextBlock
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                Foreground="{Binding IsProcessing, Converter={StaticResource BooleanToBrushConverter}}"
                Text="{Binding StatusMessage}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox
                Grid.Column="0"
                Margin="0,0,5,0"
                Header="实时监控阵列 (Live)">
                <UniformGrid Columns="2" Rows="2">

                    <Grid Margin="2">
                        <Grid Background="Black">
                            <vlc:VideoView
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MediaPlayer="{Binding LiveMediaPlayer1}" />
                        </Grid>
                        <Border
                            Margin="5"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A0000000">
                            <TextBlock
                                FontSize="12"
                                Foreground="LightGreen"
                                Text="CAM 1 (实时)" />
                        </Border>
                    </Grid>

                    <Grid Margin="2">
                        <Grid Background="Black">
                            <vlc:VideoView
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MediaPlayer="{Binding LiveMediaPlayer2}" />
                        </Grid>
                        <Border
                            Margin="5"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A0000000">
                            <TextBlock
                                FontSize="12"
                                Foreground="LightGreen"
                                Text="CAM 2 (实时)" />
                        </Border>
                    </Grid>

                    <Grid Margin="2">
                        <Grid Background="Black">
                            <vlc:VideoView
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MediaPlayer="{Binding LiveMediaPlayer3}" />
                        </Grid>
                        <Border
                            Margin="5"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A0000000">
                            <TextBlock
                                FontSize="12"
                                Foreground="LightGreen"
                                Text="CAM 3 (实时)" />
                        </Border>
                    </Grid>

                    <Grid Margin="2">
                        <GroupBox Header="报警与事件日志">
                            <ListBox ItemsSource="{Binding AlarmLogs}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0,2"
                                            FontSize="11"
                                            Foreground="#AA0000"
                                            Text="{Binding}"
                                            TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>
                    </Grid>

                </UniformGrid>
            </GroupBox>

            <GroupBox
                Grid.Column="1"
                Margin="5,0,0,0"
                BorderBrush="#CC0000"
                BorderThickness="1"
                Header="异常录像回放 (Playback)">
                <UniformGrid Columns="2" Rows="2">

                    <Grid Margin="2" Background="#1A1A1A">
                        <vlc:VideoView
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            MediaPlayer="{Binding AnomalyMediaPlayer1}" />
                        <Border
                            Margin="5"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A0CC0000">
                            <TextBlock
                                FontSize="12"
                                Foreground="White"
                                Text="CAM 1 (异常回放)" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#444"
                            Text="等待触发..."
                            Visibility="{Binding HasAnomaly1, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}" />
                    </Grid>

                    <Grid Margin="2" Background="#1A1A1A">
                        <vlc:VideoView
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            MediaPlayer="{Binding AnomalyMediaPlayer2}" />
                        <Border
                            Margin="5"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A0CC0000">
                            <TextBlock
                                FontSize="12"
                                Foreground="White"
                                Text="CAM 2 (异常回放)" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#444"
                            Text="等待触发..."
                            Visibility="{Binding HasAnomaly2, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}" />
                    </Grid>

                    <Grid Margin="2" Background="#1A1A1A">
                        <vlc:VideoView
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            MediaPlayer="{Binding AnomalyMediaPlayer3}" />
                        <Border
                            Margin="5"
                            Padding="5,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="#A0CC0000">
                            <TextBlock
                                FontSize="12"
                                Foreground="White"
                                Text="CAM 3 (异常回放)" />
                        </Border>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="#444"
                            Text="等待触发..."
                            Visibility="{Binding HasAnomaly3, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}" />
                    </Grid>

                    <Grid Margin="2">
                        <GroupBox Header="人员合规检测统计">
                            <StackPanel Margin="10">
                                <TextBlock Margin="0,0,0,8" FontSize="14" Foreground="#333" Text="{Binding TotalCheckCount, StringFormat=今日总检测人次: {0}}" />
                                <TextBlock Margin="0,0,0,8" FontSize="14" Foreground="#333" Text="{Binding ViolationCount, StringFormat=今日违规次数: {0}}" />
                                <Separator Margin="0,10" />
                                <TextBlock FontWeight="Bold" Foreground="#CC0000" Text="最新违规提示:" />
                                <TextBlock Margin="0,5,0,0" Foreground="#555" TextWrapping="Wrap" Text="{Binding LatestViolationHint}" />
                            </StackPanel>
                        </GroupBox>
                    </Grid>

                </UniformGrid>
            </GroupBox>
        </Grid>

        <StatusBar Grid.Row="2" Background="#FFF0F0F0">
            <StatusBarItem>
                <TextBlock Foreground="Gray" Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="Gray" Text="{Binding CurrentTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Page>