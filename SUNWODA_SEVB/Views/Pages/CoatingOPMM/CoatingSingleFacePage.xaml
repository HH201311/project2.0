<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CoatingOPMM.CoatingSingleFacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:SUNWODA_SEVB.Component.CustomControls;assembly=SUNWODA_SEVB.Component"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CoatingOPMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="CoatingSingleFacePage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    FontSize="6"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="5*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="9*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock d:Text="A面干膜-分区数据" Text="{Binding Title, StringFormat={}{0}面干膜-分区数据}" />
                    </StackPanel>

                    <uc:CoatingZoneDataPlotViewer x:Name="DemoPlot" FilmData="{Binding FilmData}" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Border
                            Margin="0,0,5,0"
                            Background="Green"
                            BorderBrush="Green"
                            BorderThickness="1" />
                        <TextBlock d:Text="A面干膜-毫米数据" Text="{Binding Title, StringFormat={}{0}面干膜-毫米数据}" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="毫米数据" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Column="1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border
                        Margin="0,0,5,0"
                        Background="Green"
                        BorderBrush="Green"
                        BorderThickness="1" />
                    <TextBlock d:Text="A面-规格信息" Text="{Binding Title, StringFormat={}{0}面-规格信息}" />
                </StackPanel>

                <cc:EqualSpacingItemsControl
                    Margin="10,40"
                    d:ItemsSource="{d:SampleData ItemCount=4}"
                    ItemsSource="{Binding SpecificationInfos}"
                    Orientation="Vertical">
                    <cc:EqualSpacingItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel
                                Margin="0,0,0,10"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{Binding PName}" />
                                <TextBlock FontWeight="Bold" Text="{Binding PValue}" />
                            </StackPanel>
                        </DataTemplate>
                    </cc:EqualSpacingItemsControl.ItemTemplate>
                </cc:EqualSpacingItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Column="2">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border
                        Margin="0,0,5,0"
                        Background="Green"
                        BorderBrush="Green"
                        BorderThickness="1" />
                    <TextBlock d:Text="A面-设备监控" Text="{Binding Title, StringFormat={}{0}面-设备监控}" />
                </StackPanel>

                <cc:UniformWrapItemsControl
                    Margin="10,20"
                    d:ItemsSource="{d:SampleData ItemCount=9}"
                    AutoWrapReferenceWidth="{Binding RelativeSource={RelativeSource AncestorType=DockPanel}, Path=ActualWidth}"
                    Columns="2"
                    HorizontalSpacing="10"
                    ItemsSource="{Binding DeviceMonitorInfos}"
                    VerticalSpacing="20">
                    <cc:UniformWrapItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Margin="0,0,5,0" Text="{Binding PName}" />
                                <TextBlock FontWeight="Bold" Text="{Binding PValue}" />
                            </StackPanel>
                        </DataTemplate>
                    </cc:UniformWrapItemsControl.ItemTemplate>
                </cc:UniformWrapItemsControl>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="3">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border
                        Margin="0,0,5,0"
                        Background="Green"
                        BorderBrush="Green"
                        BorderThickness="1" />
                    <TextBlock d:Text="A面-CCD" Text="{Binding Title, StringFormat={}{0}面-CCD}" />
                </StackPanel>

                <uc:CoatingZoneDisplayControl RawSegments="{Binding RawSegments}" />
            </DockPanel>

        </Border>
    </Grid>
</Page>
