<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CTAutoSlicer.ScreenTwoPointPickerOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="屏幕两点标定"
    AllowsTransparency="True"
    Background="#66000000"
    Cursor="Cross"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <Canvas x:Name="RootCanvas">
        <TextBlock
            x:Name="HintTextBlock"
            Margin="24"
            FontSize="15"
            FontWeight="SemiBold"
            Foreground="White"
            IsHitTestVisible="False"
            Text="左键依次点击两个目标点；右键 / Esc 取消" />

        <Border
            x:Name="CoordPanel"
            Padding="10,6"
            Background="#F01E1E1E"
            BorderBrush="#FF00E5FF"
            BorderThickness="1"
            CornerRadius="4"
            IsHitTestVisible="False">
            <TextBlock
                x:Name="CoordText"
                FontFamily="Consolas"
                FontSize="14"
                FontWeight="Bold"
                Foreground="White"
                Text="(0, 0)" />
        </Border>

        <!-- 已确认的第 1 点标记 -->
        <Ellipse
            x:Name="Point1Marker"
            Width="14"
            Height="14"
            Stroke="#FFFF4444"
            StrokeThickness="2"
            Fill="#66FF4444"
            Visibility="Collapsed"
            IsHitTestVisible="False" />

        <!-- 十字准星 -->
        <Line
            x:Name="CrossH"
            Stroke="#FFFF4444"
            StrokeThickness="1"
            IsHitTestVisible="False" />
        <Line
            x:Name="CrossV"
            Stroke="#FFFF4444"
            StrokeThickness="1"
            IsHitTestVisible="False" />
    </Canvas>
</Window>
