<Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CTAutoSlicer.Vision3dPointsStepDebugWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="本地 3D 找点算法 · 分步调试"
    Width="1280"
    Height="840"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Background="#FF1E1E1E"
    Closed="Window_Closed">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border
            Grid.Row="0"
            Padding="10"
            Background="#FF252526"
            CornerRadius="6"
            Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock
                        Text="截图"
                        Foreground="#FFCCCCCC"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0" />
                    <TextBox
                        Width="560"
                        Height="28"
                        VerticalContentAlignment="Center"
                        Text="{Binding ImagePath, UpdateSourceTrigger=PropertyChanged}"
                        Background="#FF2D2D30"
                        Foreground="White"
                        BorderBrush="#FF3F3F46" />
                    <Button
                        Margin="8,0,0,0"
                        Padding="12,4"
                        Content="浏览…"
                        Command="{Binding BrowseImageCommand}"
                        Background="#FF3E3E42"
                        Foreground="White"
                        BorderBrush="#FF555555" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock
                        Text="{Binding StepProgress}"
                        Foreground="#FF9CDCFE"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0"
                        FontWeight="SemiBold" />
                    <Button
                        Margin="0,0,8,0"
                        Padding="14,6"
                        Content="开始/重置"
                        Command="{Binding ResetCommand}"
                        Background="#FF0E639C"
                        Foreground="White"
                        BorderThickness="0" />
                    <Button
                        Padding="18,6"
                        Content="◀ 上一步"
                        Command="{Binding StepPrevCommand}"
                        Background="#FF3E7BFF"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0" />
                    <Button
                        Padding="18,6"
                        Content="灰度范围…"
                        Command="{Binding OpenMidGrayRangeTunerCommand}"
                        Background="#FF3E3E42"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Margin="8,0,8,0" />
                    <Button
                        Padding="18,6"
                        Content="下一步 ▶"
                        Command="{Binding StepNextCommand}"
                        Background="#FF4CAF50"
                        Foreground="White"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 图像 -->
        <Border
            Grid.Row="1"
            Background="#FF111111"
            CornerRadius="6"
            BorderBrush="#FF3F3F46"
            BorderThickness="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image
                    Source="{Binding PreviewImage}"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="8" />
            </ScrollViewer>
        </Border>

        <!-- 说明 -->
        <Border
            Grid.Row="2"
            Margin="0,10,0,0"
            Padding="12"
            Background="#FF252526"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    Text="{Binding StepTitle}"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="{Binding StatusBrush}"
                    Margin="0,0,0,6" />
                <TextBlock
                    Text="{Binding StepDetail}"
                    Foreground="#FFDDDDDD"
                    TextWrapping="Wrap"
                    LineHeight="22" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="#FF888888"
                    FontSize="12"
                    Text="提示：用失败现场的 vision_3d_*.png；逐步观察白区/四边形是否合理。橙=该步未通过但仍可回退；红=终结失败。" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
