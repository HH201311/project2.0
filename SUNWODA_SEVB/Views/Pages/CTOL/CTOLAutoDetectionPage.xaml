<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CTOL.CTOLAutoDetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CTOL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CTOL;assembly=SUNWODA_SEVB.Component"
    xmlns:vm="clr-namespace:SUNWODA_SEVB.ViewModels.Pages.CTOL"
    Title="CTOLAutoDetectionPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    mc:Ignorable="d">

    <!--  主Grid：3行结构（标题行、内容行、版权行）  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部标题行  -->
        <Grid Grid.Row="0" Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.ico" />
                <!--  项目名称文本  -->
                <TextBlock
                    Margin="10,0"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="在线CT AI检测系统V2.0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <ItemsControl ItemsSource="{Binding Monitors}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2" Background="Black">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Id}" />

                            <uc:ImageShowControl Grid.Row="1" Source="{Binding LastProcessedImage}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border
                x:Name="StatusInfo"
                Grid.Column="1"
                Margin="0"
                Background="White"
                BorderBrush="LightGray"
                BorderThickness="1"
                SizeChanged="StatusInfo_SizeChanged">
                <ScrollViewer HorizontalScrollBarVisibility="Auto">
                    <DockPanel>
                        <TextBlock
                            Margin="0,10,0,5"
                            HorizontalAlignment="Center"
                            DockPanel.Dock="Top"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="状态信息" />
                        <uc:PiePlotViewer
                            Height="{Binding ElementName=StatusInfo, Path=ActualWidth}"
                            DockPanel.Dock="Top"
                            Labels="{Binding DetectionSattisticalLabel}"
                            LabelsColor="{Binding DetectionStatisticalLabelColor}"
                            Values="{Binding DetectionSattisticalData}" />



                        <StackPanel Margin="10,10,0,10" DockPanel.Dock="Bottom">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Text="总检测数" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="15"
                                    Text="{Binding TotalDetectionNum}" />
                            </Grid>

                            <hc:UniformSpacingPanel x:Name="uniformSpacingPanel" HorizontalAlignment="Center">
                                <Button
                                    x:Name="clearListBtn"
                                    Height="35"
                                    Background="#F5B041"
                                    BorderBrush="Gray"
                                    BorderThickness="0"
                                    Command="{Binding ClearListCommand}"
                                    Content="清空监测"
                                    FontSize="16"
                                    Foreground="Black"
                                    IsEnabled="{Binding AreAllMonitorsStopped}" />
                                <Button
                                    x:Name="clearStatisticsBtn"
                                    Height="35"
                                    Background="#F5B041"
                                    BorderBrush="Gray"
                                    BorderThickness="0"
                                    Command="{Binding ClearStatisticsCommand}"
                                    Content="统计清零"
                                    FontSize="16"
                                    Foreground="Black"
                                    IsEnabled="{Binding AreAllMonitorsStopped}" />
                            </hc:UniformSpacingPanel>
                        </StackPanel>

                        <ListView
                            x:Name="defectListView"
                            Background="Transparent"
                            FontSize="12"
                            FontWeight="Bold"
                            ItemsSource="{Binding DefectDataList}"
                            Style="{StaticResource ListView.Small}">

                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ListViewItemBaseStyle.Small}" TargetType="ListViewItem">
                                    <Setter Property="FontWeight" Value="Normal" />
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        x:Name="colType"
                                        DisplayMemberBinding="{Binding DefectType}"
                                        Header="缺陷类型" />
                                    <GridViewColumn
                                        x:Name="colCount"
                                        DisplayMemberBinding="{Binding Count}"
                                        Header="数量" />
                                    <GridViewColumn
                                        x:Name="colRatio"
                                        DisplayMemberBinding="{Binding Ratio, StringFormat={}{0:P2}}"
                                        Header="占比" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </ScrollViewer>
            </Border>

            <Border
                Grid.Column="2"
                BorderBrush="LightGray"
                BorderThickness="1">
                <TabControl>
                    <!--  第一页：数据页  -->
                    <TabItem FontSize="25" Header="监测数据">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  检测结果表格  -->
                            <DataGrid
                                x:Name="DgDetection"
                                Height="Auto"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AutoGenerateColumns="False"
                                Background="#FFF5F5F5"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                ItemsSource="{Binding InspectionResultList}"
                                RowHeaderWidth="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                        <Setter Property="Background" Value="#FFF5F5F5" />
                                        <Setter Property="FontSize" Value="20" />
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="1.6*"
                                        MinWidth="100"
                                        Binding="{Binding Barcode}"
                                        Header="条码">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>


                                    <DataGridTextColumn
                                        Width="1.2*"
                                        MinWidth="80"
                                        Binding="{Binding DefectType}"
                                        Header="缺陷类型">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="13" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        MinWidth="80"
                                        Binding="{Binding DetectionResult}"
                                        Header="检测结果">
                                        <!--  结果文字颜色：OK绿色，NG红色  -->
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="FontSize" Value="15" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="NG">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="算法异常">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="超时">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem
                        d:IsSelected="True"
                        FontSize="25"
                        Header="数据检索">
                        <DockPanel Margin="5,10">
                            <hc:DateTimePicker
                                Margin="0,5"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                hc:InfoElement.Placeholder="请输入开始时间"
                                hc:InfoElement.Title="开始时间："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                SelectedDateTime="{Binding StartDate}"
                                Style="{StaticResource DateTimePickerPlus}" />
                            <hc:DateTimePicker
                                Margin="0,5"
                                hc:InfoElement.Placeholder="请输入结束时间"
                                hc:InfoElement.Title="结束时间："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                SelectedDateTime="{Binding EndDate}"
                                Style="{StaticResource DateTimePickerPlus}" />
                            <hc:CheckComboBox
                                Margin="0,5"
                                hc:InfoElement.Placeholder="请选择类型"
                                hc:InfoElement.Title="类型筛选："
                                vm:CheckComboBoxHelper.SelectedItems="{Binding DefectSelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                DisplayMemberPath="DefectType"
                                DockPanel.Dock="Top"
                                FontSize="15"
                                ItemsSource="{Binding DefectDataList}"
                                SelectedValuePath="DefectType"
                                ShowSelectAllButton="True"
                                Style="{StaticResource CheckComboBoxExtend}" />
                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,5"
                                Background="#5DADE2"
                                BorderThickness="0"
                                Command="{Binding QueryCommand}"
                                Content="查询"
                                DockPanel.Dock="Top"
                                Foreground="White" />
                            <hc:TextBox
                                Margin="0,5"
                                hc:InfoElement.Placeholder="这是筛选后检索出来的总数量"
                                hc:InfoElement.Title="总数量："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                IsReadOnly="True"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding TotalCount, Mode=OneWay}" />

                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,5"
                                Background="#5DADE2"
                                BorderThickness="0"
                                Command="{Binding ExportCommand}"
                                Content="导出文件"
                                DockPanel.Dock="Top"
                                Foreground="White" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid
                                    x:Name="cxDetection"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AutoGenerateColumns="False"
                                    Background="#FFF5F5F5"
                                    CanUserAddRows="False"
                                    CanUserSortColumns="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding ShowResults}"
                                    RowHeaderWidth="0">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FFF5F5F5" />
                                            <Setter Property="FontSize" Value="20" />
                                        </Style>

                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1.1*"
                                            MinWidth="125"
                                            Binding="{Binding Time, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                            Header="时间">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn
                                            Width="1*"
                                            MinWidth="125"
                                            Binding="{Binding Barcode}"
                                            Header="电芯条码">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn
                                            Width="1*"
                                            MinWidth="80"
                                            Binding="{Binding DefectType}"
                                            Header="缺陷类型">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <hc:Pagination
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    IsJumpEnabled="True"
                                    MaxPageCount="{Binding MaxPageCount}"
                                    PageIndex="{Binding PageIndex}">
                                    <hc:Interaction.Triggers>
                                        <hc:EventTrigger EventName="PageUpdated">
                                            <hc:EventToCommand Command="{Binding PageUpdatedCommand}" PassEventArgsToCommand="True" />
                                        </hc:EventTrigger>
                                    </hc:Interaction.Triggers>
                                </hc:Pagination>
                            </Grid>
                        </DockPanel>
                    </TabItem>

                    <TabItem FontSize="25" Header="参数设置">
                        <ScrollViewer
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ParameterSetPanel" SizeChanged="ParameterSetPanel_SizeChanged">

                                <ItemsControl
                                    Margin="10,20,10,0"
                                    d:ItemsSource="{d:SampleData ItemCount=4}"
                                    ItemsSource="{Binding Monitors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,12"
                                                Padding="12"
                                                Background="White"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="10" />
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="8" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <!--  第一行：ID + 状态指示 + 启停按钮  -->
                                                    <DockPanel Grid.Row="0" LastChildFill="False">

                                                        <TextBlock
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Left"
                                                            FontSize="15"
                                                            FontWeight="Bold"
                                                            Foreground="#1A1A2E"
                                                            Text="{Binding Id}" />

                                                        <!--  启停按钮  -->
                                                        <ToggleButton
                                                            Width="52"
                                                            Height="30"
                                                            Padding="0"
                                                            hc:VisualElement.HighlightBrush="#2ECC71"
                                                            Command="{Binding ToggleCommand}"
                                                            DockPanel.Dock="Right"
                                                            IsChecked="{Binding IsRunning, Mode=OneWay}"
                                                            Style="{StaticResource ToggleButtonSwitch.Small}" />

                                                        <!--  状态指示器  -->
                                                        <StackPanel
                                                            Margin="0,0,16,0"
                                                            VerticalAlignment="Center"
                                                            DockPanel.Dock="Right"
                                                            Orientation="Horizontal">
                                                            <Ellipse
                                                                Width="9"
                                                                Height="9"
                                                                Margin="0,0,5,0">
                                                                <Ellipse.Style>
                                                                    <Style TargetType="Ellipse">
                                                                        <Setter Property="Fill" Value="#95A5A6" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                                <Setter Property="Fill" Value="#2ECC71" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Ellipse.Style>
                                                            </Ellipse>

                                                            <TextBlock
                                                                VerticalAlignment="Center"
                                                                FontSize="12"
                                                                Foreground="#666666"
                                                                Text="{Binding StatusText}" />
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <!--  第二行：监听路径  -->
                                                    <Grid Grid.Row="2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="#888"
                                                            Text="监听路径" />

                                                        <TextBox
                                                            Grid.Column="1"
                                                            Margin="0,0,6,0"
                                                            FontSize="15"
                                                            IsEnabled="{Binding CanEdit}"
                                                            Text="{Binding RemotePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <Button
                                                            Grid.Column="2"
                                                            Width="52"
                                                            Height="28"
                                                            Background="#5DADE2"
                                                            BorderThickness="0"
                                                            Command="{Binding BrowseRemotePathCommand}"
                                                            Content="浏览"
                                                            IsEnabled="{Binding CanEdit}" />
                                                    </Grid>

                                                    <!--  第三行：输出路径  -->
                                                    <Grid Grid.Row="4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="70" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="60" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            FontSize="12"
                                                            Foreground="#888"
                                                            Text="输出路径" />

                                                        <TextBox
                                                            Grid.Column="1"
                                                            Margin="0,0,6,0"
                                                            FontSize="15"
                                                            IsEnabled="{Binding CanEdit}"
                                                            Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                        <Button
                                                            Grid.Column="2"
                                                            Width="52"
                                                            Height="28"
                                                            Background="#5DADE2"
                                                            BorderThickness="0"
                                                            Command="{Binding BrowseOutputDirectoryCommand}"
                                                            Content="浏览"
                                                            IsEnabled="{Binding CanEdit}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!--  视野阈值表格（共享）  -->
                                <Border
                                    Margin="12,0,12,12"
                                    Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <DataGrid
                                        d:ItemsSource="{d:SampleData ItemCount=8}"
                                        hc:DataGridAttach.ShowRowNumber="False"
                                        hc:DataGridAttach.ShowSelectAllButton="False"
                                        AutoGenerateColumns="False"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CanUserAddRows="False"
                                        CanUserDeleteRows="False"
                                        CanUserReorderColumns="False"
                                        CanUserSortColumns="False"
                                        FontSize="11"
                                        GridLinesVisibility="None"
                                        HeadersVisibility="Column"
                                        IsEnabled="{Binding AreAllMonitorsStopped}"
                                        ItemsSource="{Binding SharedGapThresholdRows}"
                                        RowHeaderWidth="45"
                                        RowHeight="28"
                                        SelectionMode="Single">

                                        <DataGrid.Resources>
                                            <!--  表头  -->
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#D9D9D9" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="Padding" Value="6,4" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>

                                            <!--  行头（行号）  -->
                                            <Style TargetType="DataGridRowHeader">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                            </Style>

                                            <!--  行  -->
                                            <Style TargetType="DataGridRow">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="#D0D0D0" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Setter Property="Margin" Value="0,0,0,6" />
                                            </Style>

                                            <!--  单元格  -->
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Padding" Value="4,2" />
                                                <Setter Property="FontSize" Value="11" />
                                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            </Style>

                                            <!--  只读文本  -->
                                            <Style x:Key="GridTextBlockStyle" TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>
                                        </DataGrid.Resources>

                                        <DataGrid.Columns>
                                            <!--  角位  -->
                                            <DataGridTextColumn
                                                Width="40"
                                                Binding="{Binding ViewType}"
                                                Header="角位"
                                                IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextAlignment" Value="Center" />
                                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!--  OH下限  -->
                                            <DataGridTemplateColumn Width="65" Header="OH下限">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource GridTextBlockStyle}" Text="{Binding OhLower, StringFormat=F3}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding OhLower, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <!--  OH上限  -->
                                            <DataGridTemplateColumn Width="65" Header="OH上限">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource GridTextBlockStyle}" Text="{Binding OhUpper, StringFormat=F3}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding OhUpper, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <!--  负极差  -->
                                            <DataGridTemplateColumn Width="65" Header="负极差">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding NegDiff, StringFormat=F3}">
                                                            <TextBlock.Style>
                                                                <Style BasedOn="{StaticResource GridTextBlockStyle}" TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNegDiff}" Value="False">
                                                                            <Setter Property="Foreground" Value="#DDDDDD" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding NegDiff, Mode=TwoWay, UpdateSourceTrigger=LostFocus}">
                                                            <TextBox.Style>
                                                                <Style BasedOn="{StaticResource TextBoxBaseStyle}" TargetType="TextBox">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasNegDiff}" Value="False">
                                                                            <Setter Property="IsEnabled" Value="False" />
                                                                            <Setter Property="Opacity" Value="0.6" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBox.Style>
                                                        </TextBox>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <!--  负极边缘  -->
                                            <DataGridTemplateColumn Width="65" Header="负极边缘">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource GridTextBlockStyle}" Text="{Binding FjEnd, StringFormat=F3}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding FjEnd, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <!--  正极边缘  -->
                                            <DataGridTemplateColumn Width="65" Header="正极边缘">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource GridTextBlockStyle}" Text="{Binding PosEnd, StringFormat=F3}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding PosEnd, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <!--  正极中间  -->
                                            <DataGridTemplateColumn Width="65" Header="正极中间">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Style="{StaticResource GridTextBlockStyle}" Text="{Binding PosMiddle, StringFormat=F3}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <TextBox Text="{Binding PosMiddle, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>

                                <!--  掉片专用阈值（共享）  -->
                                <Border
                                    Margin="12,0,12,12"
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel IsEnabled="{Binding AreAllMonitorsStopped}">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="正极Y方向掉片参数" />

                                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                            <TextBlock
                                                Width="160"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="12"
                                                Text="中间层与相邻两层差值≥" />
                                            <hc:NumericUpDown
                                                Height="22"
                                                VerticalContentAlignment="Center"
                                                DecimalPlaces="3"
                                                FontSize="12"
                                                Increment="0.001"
                                                Minimum="0"
                                                Value="{Binding SharedGap45Limit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                        <DockPanel LastChildFill="True">
                                            <TextBlock
                                                Width="160"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="12"
                                                Text="|1-Y + 3-Y - 2-Y - 4-Y|≥" />
                                            <hc:NumericUpDown
                                                Height="22"
                                                VerticalContentAlignment="Center"
                                                DecimalPlaces="3"
                                                FontSize="12"
                                                Increment="0.001"
                                                Minimum="0"
                                                Value="{Binding SharedGap46Limit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                    </StackPanel>
                                </Border>

                                <Border
                                    Margin="12,0,12,12"
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                    <StackPanel IsEnabled="{Binding AreAllMonitorsStopped}">
                                        <TextBlock
                                            Margin="0,0,0,8"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="每日上传参数" />

                                        <!--  启用开关  -->
                                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                            <ToggleButton
                                                Width="52"
                                                Height="30"
                                                Padding="0"
                                                hc:VisualElement.HighlightBrush="#2ECC71"
                                                DockPanel.Dock="Right"
                                                IsChecked="{Binding IsEnabled}"
                                                Style="{StaticResource ToggleButtonSwitch.Small}" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="12"
                                                Text="启用每日上传" />
                                        </DockPanel>

                                        <!--  目标目录  -->
                                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                            <TextBlock
                                                Width="160"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="12"
                                                Text="上传目标目录" />
                                            <hc:TextBox
                                                hc:InfoElement.Placeholder="请输入上传目标目录"
                                                FontSize="12"
                                                Text="{Binding UploadTargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="目标根目录" />
                                        </DockPanel>

                                        <!--  触发时间  -->
                                        <DockPanel Margin="0,0,0,8" LastChildFill="True">
                                            <TextBlock
                                                Width="160"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="12"
                                                Text="触发时间" />
                                            <StackPanel Orientation="Horizontal">
                                                <hc:NumericUpDown
                                                    Width="55"
                                                    DecimalPlaces="0"
                                                    FontSize="12"
                                                    Maximum="23"
                                                    Minimum="0"
                                                    ToolTip="触发小时（0–23）"
                                                    Value="{Binding TriggerHour, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Margin="4,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="时" />
                                                <hc:NumericUpDown
                                                    Width="55"
                                                    DecimalPlaces="0"
                                                    FontSize="12"
                                                    Maximum="59"
                                                    Minimum="0"
                                                    ToolTip="触发分钟（0–59）"
                                                    Value="{Binding TriggerMinute, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Margin="4,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Text="分"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DockPanel>

                                        <DockPanel LastChildFill="True">
                                            <TextBlock
                                                Width="160"
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Left"
                                                FontSize="12"
                                                Text="上传缺陷类型" />
                                            <hc:CheckComboBox
                                                hc:InfoElement.Placeholder="请选择类型"
                                                vm:CheckComboBoxHelper.SelectedItems="{Binding UploadDefectSelectedItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                DisplayMemberPath="DefectType"
                                                DockPanel.Dock="Top"
                                                FontSize="15"
                                                ItemsSource="{Binding DefectDataList}"
                                                SelectedValuePath="DefectType"
                                                ShowSelectAllButton="True"
                                                Style="{StaticResource CheckComboBoxExtend}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>


                                <hc:UniformSpacingPanel
                                    x:Name="saveAndresetBtnPanel"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Center">
                                    <Button
                                        x:Name="saveParameterBtn"
                                        Height="35"
                                        Background="#4CAF50"
                                        BorderThickness="0"
                                        Command="{Binding SaveSettingsCommand}"
                                        Content="保存设置"
                                        FontSize="20"
                                        Foreground="White"
                                        IsEnabled="{Binding AreAllMonitorsStopped}" />
                                    <Button
                                        x:Name="resetParameterBtn"
                                        Height="35"
                                        Background="#F44336"
                                        BorderThickness="0"
                                        Command="{Binding ResetSettingsCommand}"
                                        Content="重置设置"
                                        FontSize="20"
                                        Foreground="White"
                                        IsEnabled="{Binding AreAllMonitorsStopped}" />
                                </hc:UniformSpacingPanel>
                                <StackPanel
                                    Margin="0,10"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal" />

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!--  底部版权信息  -->
        <Border
            Grid.Row="2"
            BorderBrush="LightGray"
            BorderThickness="1">
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                FontSize="15"
                Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />
        </Border>
    </Grid>
</Page>
