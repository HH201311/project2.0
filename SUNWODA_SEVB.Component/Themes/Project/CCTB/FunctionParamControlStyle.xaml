<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ParamTitleLabelStyle" TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Label">
                    <StackPanel
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Width="5"
                            Height="{TemplateBinding FontSize}"
                            Margin="0,0,10,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Background="#FF3DCC84"
                            CornerRadius="3" />
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParamHeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style
        x:Key="PPairContentControlStyle"
        BasedOn="{StaticResource ParamPairContentControlStyle}"
        TargetType="{x:Type uccc:PairContentControl}">
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,10,0,0" />
        <Setter Property="PairKeyWidth" Value="260" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style
        x:Key="HCTitleValueTextBox"
        BasedOn="{StaticResource TextBoxExtend}"
        TargetType="TextBox">
        <Setter Property="Height" Value="40" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
        <Setter Property="hc:InfoElement.TitleWidth" Value="180" />
        <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        <Setter Property="hc:InfoElement.Symbol" Value="*" />
        <Setter Property="hc:InfoElement.Necessary" Value="True" />
    </Style>

    <Style
        x:Key="PValueTextBoxStyle"
        BasedOn="{StaticResource ParamValueTextBoxStyle}"
        TargetType="TextBox">
        <Setter Property="MinWidth" Value="100" />
        <Setter Property="Height" Value="40" />
    </Style>

    <Style x:Key="ParamLineRectangleStyle" TargetType="Rectangle">
        <Setter Property="Margin" Value="0,30,0,30" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Stroke" Value="#33FFFFFF" />
    </Style>
</ResourceDictionary>