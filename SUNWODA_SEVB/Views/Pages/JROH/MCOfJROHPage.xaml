<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JROH.MCOfJROHPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:jrohuc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JROH;assembly=SUNWODA_SEVB.Component"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JROH"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="MCOfJROHPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JROH/JROHCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style BasedOn="{StaticResource SimpleGroupBoxStyle}" TargetType="GroupBox" />
            <Style BasedOn="{StaticResource SimpleDataGridStyle}" TargetType="DataGrid" />
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="hc:TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="hc:InfoElement.Necessary" Value="False" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <jrohuc:MultiCorrectPlot
            Title="周期内入料纠偏数据图"
            Grid.Column="0"
            LineSeriesCollection="{Binding InputSeriesOfTop}"
            ShowGrid="True"
            ShowLegend="True"
            TargetLine="{Binding TargetOfInput}"
            YAxisLabel="OH值 (mm)" />
        <jrohuc:MultiCorrectPlot
            Title="周期内过程纠偏数据图"
            Grid.Column="1"
            LineSeriesCollection="{Binding CourseSeriesOfTop}"
            ShowGrid="True"
            ShowLegend="True"
            TargetLine="{Binding TargetOfCourse}"
            YAxisLabel="OH值 (mm)" />
        <jrohuc:MultiCorrectPlot
            Title="周期内翻卷纠偏数据图"
            Grid.Column="2"
            LineSeriesCollection="{Binding UnreelSeriesOfBottom}"
            ShowGrid="True"
            ShowLegend="True"
            TargetLine="{Binding TargetOfUnreel}"
            YAxisLabel="OH值 (mm)" />
        <Grid
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                LastChildFill="False">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="调机日志" />
                <Button
                    Command="{Binding BusinessParamCommand}"
                    Content="参数配置"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SimpleButtonStyle}"
                    Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}" />
            </DockPanel>
            <!--  调机记录  -->
            <TabControl Grid.Row="1">
                <TabItem Header="正极纠偏控制">
                    <DataGrid ItemsSource="{Binding AdjustmentRecordsView}" />
                </TabItem>
                <TabItem Header="负极纠偏控制">
                    <DataGrid ItemsSource="{Binding AdjustmentRecordsView}" />
                </TabItem>
                <TabItem Header="隔膜纠偏控制">
                    <DataGrid ItemsSource="{Binding AdjustmentRecordsView}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
