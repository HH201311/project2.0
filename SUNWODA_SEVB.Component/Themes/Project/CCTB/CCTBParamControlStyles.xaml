                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--  列表框  -->
    <Style x:Key="ParamValueComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!--  整体背景框  -->
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" />

                        <!--  内容展示区域  -->
                        <ContentPresenter
                            x:Name="ContentSite"
                            Margin="10,0,34,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />

                        <!--  下拉按钮区域：自定义形状和颜色  -->
                        <ToggleButton
                            x:Name="DropDownToggle"
                            Margin="10,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ClickMode="Press"
                            Focusable="false"
                            IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid
                                        Width="14"
                                        Height="14"
                                        Background="Transparent">
                                        <Path
                                            x:Name="SimpleArrow"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Data="M0,0 L4,4 L8,0"
                                            Stroke="#61FFFFFF"
                                            StrokeThickness="1" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="SimpleArrow" Property="Stroke" Value="#CCFFFFFF" />
                                            <Setter TargetName="SimpleArrow" Property="StrokeThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!--  下拉弹出框  -->
                        <Popup
                            x:Name="PART_Popup"
                            Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                            AllowsTransparency="True"
                            Focusable="False"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide">
                            <Border
                                x:Name="PopupBorder"
                                Background="#2B2B2B"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                <ScrollViewer
                                    Margin="4"
                                    Background="{TemplateBinding Background}"
                                    SnapsToDevicePixels="True">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!--  选中项的字体颜色随背景对比调整  -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.8" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ParamValueRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!--  图标  -->
                        <Border
                            Grid.Column="0"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderBrush="#3DCC84"
                            BorderThickness="1"
                            CornerRadius="10">
                            <Ellipse
                                x:Name="selected_ep"
                                Width="7"
                                Height="7"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Fill="#3DCC84" />
                        </Border>
                        <!--  文本  -->
                        <ContentPresenter
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Opacity="0.8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  选中状态 (IsChecked = True)  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="selected_ep" Property="Fill" Value="#3DCC84" />
                        </Trigger>
                        <!--  未选中状态 (IsChecked = False)  -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="selected_ep" Property="Fill" Value="Transparent" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParamGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Margin" Value="0,0,20,20" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="MinHeight" Value="280" />
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  Header  -->
                            <StackPanel
                                Grid.Row="0"
                                Margin="20,20,20,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,20"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextAlignment="Left" />
                                <Rectangle
                                    Height="1"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Bottom"
                                    Stroke="#61FFFFFF" />
                            </StackPanel>

                            <!--  内容  -->
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  键值对样式  -->
    <Style x:Key="ParamPairContentControlStyle" TargetType="{x:Type uccc:PairContentControl}">
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type uccc:PairContentControl}">
                    <Grid Width="{TemplateBinding Width}" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{TemplateBinding PairKeyWidth}" />
                            <ColumnDefinition Width="{TemplateBinding PairSeparateWidth}" MinWidth="10" />
                            <ColumnDefinition
                                Width="{TemplateBinding PairValueWidth}"
                                MinWidth="{TemplateBinding PairValueMinWidth}"
                                MaxWidth="{TemplateBinding PairValueMaxWidth}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            Opacity="{TemplateBinding PairKeyOpacity}"
                            Style="{StaticResource ParamNameTextBlockStyle}"
                            Text="{TemplateBinding PairKeyText}" />
                        <ContentPresenter
                            Grid.Column="2"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region Slider样式模板-->
    <!--#region 水平-->
    <Style x:Key="ParamHorizontalSliderDecreaseRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="15" Background="Transparent">
                        <Border
                            Height="6"
                            Background="#FF3DCC84"
                            CornerRadius="3 0 0 3" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParamHorizontalSliderIncreaseRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Height="5" Background="Transparent">
                        <Border
                            Height="6"
                            Background="#CCFFFFFF"
                            CornerRadius="0 3 3 0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParamHorizontalSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        Width="10"
                        Height="20"
                        Margin="-1,0"
                        Background="#FF3DCC84"
                        CornerRadius="5" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->
    <!--#region 垂直-->
    <Style x:Key="ParamVerticalSliderDecreaseRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Width="15" Background="Transparent">
                        <Border
                            Width="6"
                            Background="#FF3DCC84"
                            CornerRadius="0 0 3 3" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParamVerticalSliderIncreaseRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Width="5" Background="Transparent">
                        <Border
                            Width="6"
                            Background="#CCFFFFFF"
                            CornerRadius="3 3 0 0" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ParamVerticalSliderThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border
                        Width="20"
                        Height="10"
                        Margin="-1,0"
                        Background="#FF3DCC84"
                        CornerRadius="5" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->
    <Style x:Key="ParamSliderStyle" TargetType="Slider">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid x:Name="RootGrid">
                        <Border
                            x:Name="Border"
                            Height="6"
                            Background="#CCFFFFFF"
                            CornerRadius="4" />
                        <Track Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    x:Name="DecreaseRepeatButton"
                                    Command="Slider.DecreaseLarge"
                                    Style="{StaticResource ParamHorizontalSliderDecreaseRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    x:Name="IncreaseRepeatButton"
                                    Command="Slider.IncreaseLarge"
                                    Style="{StaticResource ParamHorizontalSliderIncreaseRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource ParamHorizontalSliderThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter TargetName="DecreaseRepeatButton" Property="Style" Value="{StaticResource ParamVerticalSliderDecreaseRepeatButtonStyle}" />
                            <Setter TargetName="IncreaseRepeatButton" Property="Style" Value="{StaticResource ParamVerticalSliderIncreaseRepeatButtonStyle}" />
                            <Setter TargetName="Thumb" Property="Style" Value="{StaticResource ParamVerticalSliderThumbStyle}" />
                            <Setter TargetName="Border" Property="Width" Value="6" />
                            <Setter TargetName="Border" Property="Height" Value="Auto" />
                            <Setter TargetName="PART_Track" Property="Orientation" Value="Vertical" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <Style x:Key="ParamHorizontalSliderTextStyle" TargetType="Slider">
        <Setter Property="BorderThickness" Value="10" />
        <Setter Property="Background" Value="Red" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6*" MinWidth="60" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="5*" MinWidth="50" />
                        </Grid.ColumnDefinitions>
                        <Slider
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="{TemplateBinding IsSnapToTickEnabled}"
                            LargeChange="{TemplateBinding LargeChange}"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Orientation="Horizontal"
                            SmallChange="{TemplateBinding SmallChange}"
                            Style="{StaticResource ParamSliderStyle}"
                            TickFrequency="{TemplateBinding TickFrequency}"
                            Value="{Binding Path=Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <TextBox
                            x:Name="PART_TextBox"
                            Grid.Column="2"
                            Style="{StaticResource ParamValueTextBoxStyle}">
                            <TextBox.Text>
                                <Binding
                                    Mode="TwoWay"
                                    Path="Value"
                                    RelativeSource="{RelativeSource TemplatedParent}"
                                    UpdateSourceTrigger="PropertyChanged">
                                    <Binding.Converter>
                                        <convert:SliderValueConverter />
                                    </Binding.Converter>
                                    <Binding.ValidationRules>
                                        <convert:SliderValidationRule />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>