                    <TabItem
                        d:IsSelected="True"
                        FontSize="25"
                        Header="数据检索">
                        <DockPanel Margin="5,10">
                            <hc:DateTimePicker
                                Margin="0,5"
                                VerticalAlignment="Center"
                                VerticalContentAlignment="Center"
                                hc:InfoElement.Placeholder="请输入开始时间"
                                hc:InfoElement.Title="开始时间："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                Style="{StaticResource DateTimePickerPlus}" />
                            <hc:DateTimePicker
                                Margin="0,5"
                                hc:InfoElement.Placeholder="请输入结束时间"
                                hc:InfoElement.Title="结束时间："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                Style="{StaticResource DateTimePickerPlus}" />
                            <hc:CheckComboBox
                                Margin="0,5"
                                hc:InfoElement.Placeholder="请选择类型"
                                hc:InfoElement.Title="类型筛选："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                Style="{StaticResource CheckComboBoxPlus}" />
                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,5"
                                Background="#5DADE2"
                                BorderThickness="0"
                                Command="{Binding QueryCommand}"
                                Content="查询"
                                DockPanel.Dock="Top"
                                Foreground="White" />
                            <hc:TextBox
                                Margin="0,5"
                                hc:InfoElement.Placeholder="这是筛选后检索出来的总数量"
                                hc:InfoElement.Title="总数量："
                                DockPanel.Dock="Top"
                                FontSize="15"
                                IsReadOnly="True"
                                Style="{StaticResource TextBoxExtend}"
                                Text="{Binding TotalCount, Mode=OneWay}" />

                            <Button
                                Width="80"
                                Height="30"
                                Margin="0,5"
                                Background="#5DADE2"
                                BorderThickness="0"
                                Command="{Binding ExportCommand}"
                                Content="导出文件"
                                DockPanel.Dock="Top"
                                Foreground="White" />

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DataGrid
                                    x:Name="cxDetection"
                                    Margin="0,5"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    AutoGenerateColumns="False"
                                    Background="#FFF5F5F5"
                                    CanUserAddRows="False"
                                    CanUserSortColumns="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding PagedAbnormalDataList}"
                                    RowHeaderWidth="0">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                            <Setter Property="Background" Value="#FFF5F5F5" />
                                            <Setter Property="FontSize" Value="20" />
                                        </Style>

                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="1.1*"
                                            MinWidth="125"
                                            Binding="{Binding [Time]}"
                                            Header="时间">
                                            <DataGridTextColumn.ElementStyle>
