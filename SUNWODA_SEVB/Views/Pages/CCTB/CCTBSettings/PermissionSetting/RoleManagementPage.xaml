<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.PermissionSetting.RoleManagementPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB.FormEnums;assembly=SUNWODA_SEVB.Core"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.PermissionSetting"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:role="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.RoleModels;assembly=SUNWODA_SEVB.Core"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Title="RoleManagementPage"
    d:DesignHeight="940"
    d:DesignWidth="1440"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBDataGridControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:ContentToStringConverter x:Key="ContentToStringConverter" />
            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />

            <Style x:Key="ParamComboBoxItemConetntControlStyle" TargetType="ContentControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Viewbox
                                Width="20"
                                Height="20"
                                Stretch="Uniform">
                                <Path
                                    x:Name="mark"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    StrokeThickness="0" />
                            </Viewbox>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="ReadOnly">
                                    <Setter TargetName="mark" Property="Data" Value="M1.407,0,.009,1.173a55.748,55.748,0,0,1,6.846,6.1C3.734,10.412,1.287,13.5,0,14.739l2.66,2.218a39.829,39.829,0,0,1,5.755-7.99A40.218,40.218,0,0,1,14.178,17S16.77,14.255,17,14.68c-1-1.122-3.436-4.386-6.71-7.727a53.255,53.255,0,0,1,6.232-5.5L15.909.315A32.231,32.231,0,0,0,8.747,5.457,34.075,34.075,0,0,0,1.407,0" />
                                    <Setter TargetName="mark" Property="Fill" Value="#FFCC5252" />
                                    <Setter TargetName="mark" Property="Margin" Value="3,3,3,3" />
                                </Trigger>
                                <Trigger Property="Content" Value="ReadAndEdit">
                                    <Setter TargetName="mark" Property="Data" Value="M20,1.688s-3.2,1.039-6.933,5.195a40.29,40.29,0,0,0-5.6,7.4A18.524,18.524,0,0,0,0,7.662l2.8-2.6A15.066,15.066,0,0,1,7.067,9.87,29.125,29.125,0,0,1,20,0Z" />
                                    <Setter TargetName="mark" Property="Fill" Value="#FF3DCC84" />
                                    <Setter TargetName="mark" Property="Margin" Value="0,3,0,3" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Margin" Value="0,0,0,5" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Grid>
                                <Border
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    CornerRadius="5" />
                                <ContentControl
                                    Margin="5,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{Binding DisplayName}"
                                    Style="{StaticResource ParamComboBoxItemConetntControlStyle}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ParamComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource ParamComboBoxItemStyle}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!--  整体背景框  -->
                                <Border
                                    x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" />

                                <!--  内容展示区域  -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Margin="20,0,34,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                                    <ContentPresenter.ContentTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding DisplayName}" Style="{StaticResource ParamComboBoxItemConetntControlStyle}" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>

                                <!--  下拉按钮区域：自定义形状和颜色  -->
                                <ToggleButton
                                    x:Name="DropDownToggle"
                                    Margin="10,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ClickMode="Press"
                                    Focusable="false"
                                    IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid
                                                Width="14"
                                                Height="14"
                                                Background="Transparent">
                                                <Path
                                                    x:Name="SimpleArrow"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Data="M0,0 L4,4 L8,0"
                                                    Stroke="#61FFFFFF"
                                                    StrokeThickness="1" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="SimpleArrow" Property="Stroke" Value="#CCFFFFFF" />
                                                    <Setter TargetName="SimpleArrow" Property="StrokeThickness" Value="2" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!--  下拉弹出框  -->
                                <Popup
                                    x:Name="PART_Popup"
                                    Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    AllowsTransparency="True"
                                    Focusable="False"
                                    IsOpen="{TemplateBinding IsDropDownOpen}"
                                    Placement="Bottom"
                                    PopupAnimation="Slide"
                                    VerticalOffset="10">
                                    <Border
                                        x:Name="PopupBorder"
                                        Background="#FF2B2B2B"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="5"
                                        SnapsToDevicePixels="True">
                                        <ScrollViewer
                                            Margin="15,10,15,5"
                                            Background="{TemplateBinding Background}"
                                            SnapsToDevicePixels="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>

                <!--  选中项的字体颜色随背景对比调整  -->
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <DockPanel
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                LastChildFill="False">
                <Label
                    Margin="20,0"
                    Content="角色管理"
                    DockPanel.Dock="Left"
                    Style="{StaticResource ParamTitleLabelStyle}" />
                <Button
                    Margin="0,0,20,0"
                    Command="{Binding ParamSaveCommand}"
                    Content="保存"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ParamOKButtonStyle}" />
            </DockPanel>
        </Border>
        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <Border
                Margin="20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0.5,0.5,0,0"
                CornerRadius="0">
                <DataGrid ItemsSource="{Binding RoleManagementConfigs, Mode=TwoWay}" Style="{StaticResource AccountDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*" Header="功能">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox
                                        Margin="5,0"
                                        Background="Transparent"
                                        Foreground="#99FFFFFF"
                                        IsReadOnly="True"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="180" Header="访客">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Background="Transparent"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding DataContext.UserPermissionSource, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding GuestPermission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamComboBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="180" Header="工程师">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Background="Transparent"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding DataContext.UserPermissionSource, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding EngineerPermission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamComboBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="180" Header="管理员">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox
                                        Background="Transparent"
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding DataContext.UserPermissionSource, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValue="{Binding AdminPermission, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamComboBoxStyle}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Border>
    </Grid>
</Page>
