<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.UserOperation.UserLoginDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:o="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    Width="400"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBHCControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  标题样式  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  关闭按钮  -->
            <Style x:Key="ClosedButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20,0,20,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,20,0,20"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="切换账号" />

            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource ClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <StackPanel Grid.Row="1">
            <hc:TextBox
                Height="40"
                Margin="0,0,0,20"
                hc:InfoElement.Placeholder="请输入用户账号"
                hc:InfoElement.ShowClearButton="True"
                Background="#0DFFFFFF"
                BorderThickness="0"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                FontSize="14"
                Foreground="#99FFFFFF"
                Text="{Binding UserModel.Account, UpdateSourceTrigger=PropertyChanged}" />

            <hc:PasswordBox
                Height="40"
                hc:InfoElement.Placeholder="请输入密码"
                Background="#0DFFFFFF"
                BorderThickness="0"
                CaretBrush="#FFFFFFFF"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                FontSize="12"
                Foreground="#99FFFFFF"
                IsSafeEnabled="False"
                PasswordChar="*"
                ShowEyeButton="True"
                Style="{StaticResource HCPasswordBoxStyle}"
                UnsafePassword="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button
                Margin="10,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="登录"
                Style="{StaticResource ParamOKButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding CancleCommand}"
                Content="取消"
                Style="{StaticResource ParamCancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

