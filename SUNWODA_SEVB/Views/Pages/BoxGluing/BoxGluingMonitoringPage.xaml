<Page
    x:Class="SUNWODA_SEVB.Views.Pages.BoxGluing.BoxGluingMonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
    Title="BoxGluingMonitoringPage"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Width="88"
                        Margin="4,0"
                        Command="{Binding SaveConfigCommand}"
                        Content="保存配置" />
                    <Button
                        Width="100"
                        Margin="4,0"
                        Command="{Binding OpenCsvFolderCommand}"
                        Content="打开CSV目录" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="口琴管涂胶监测" />
            </DockPanel>

            <WrapPanel Grid.Row="1" Margin="0,12,0,8">
                <TextBlock
                    Margin="0,6,12,0"
                    VerticalAlignment="Center"
                    Text="采样(ms)" />
                <TextBox
                    Width="72"
                    Margin="0,0,16,0"
                    Text="{Binding SampleIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Margin="0,6,12,0"
                    VerticalAlignment="Center"
                    Text="CSV根目录" />
                <TextBox
                    Width="280"
                    Margin="0,0,16,0"
                    Text="{Binding CsvRootPath, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox
                    Margin="0,6,16,0"
                    VerticalAlignment="Center"
                    Content="模拟采集"
                    IsChecked="{Binding UseSimulation}" />
                <Button
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Command="{Binding GlueTriggerCommand}"
                    CommandParameter="1"
                    Content="出胶1"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <Button
                    Width="88"
                    Height="32"
                    Margin="0,0,8,0"
                    Command="{Binding GlueTriggerCommand}"
                    CommandParameter="2"
                    Content="出胶2"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <Button
                    Width="88"
                    Height="32"
                    Margin="0,0,16,0"
                    Command="{Binding GlueTriggerCommand}"
                    CommandParameter="3"
                    Content="出胶3"
                    FontSize="14"
                    FontWeight="SemiBold" />
                <TextBlock
                    Margin="8,6,0,0"
                    VerticalAlignment="Center"
                    Text="{Binding GlueStateText}" />
            </WrapPanel>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,0,8"
                    Text="{Binding StatusText}"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="1" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,6,0">
                        <ScottPlot:WpfPlot x:Name="Station1Plot" />
                        <Button
                            Width="64"
                            Height="26"
                            Margin="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding MaximizePlotCommand}"
                            CommandParameter="1"
                            Content="最大化" />
                    </Grid>
                    <Grid Grid.Column="1" Margin="3,0">
                        <ScottPlot:WpfPlot x:Name="Station2Plot" />
                        <Button
                            Width="64"
                            Height="26"
                            Margin="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding MaximizePlotCommand}"
                            CommandParameter="2"
                            Content="最大化" />
                    </Grid>
                    <Grid Grid.Column="2" Margin="6,0,0,0">
                        <ScottPlot:WpfPlot x:Name="Station3Plot" />
                        <Button
                            Width="64"
                            Height="26"
                            Margin="6"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding MaximizePlotCommand}"
                            CommandParameter="3"
                            Content="最大化" />
                    </Grid>
                </Grid>
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Padding="12"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1"
                    Background="#FFF7F7F7">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#FF666666"
                            Text="算法结果区（预留）" />
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Foreground="#FF999999"
                            Text="Python 判定结果将显示于此"
                            TextWrapping="Wrap"
                            TextAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Padding="8"
                    BorderBrush="#FFD0D0D0"
                    BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Grid.Row="0"
                            Margin="4,0,0,6"
                            FontWeight="SemiBold"
                            Text="出胶口实时数据" />
                        <ItemsControl
                            Grid.Row="1"
                            ItemsSource="{Binding RealtimeStations}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="4"
                                        Padding="10,8"
                                        BorderBrush="#FFE0E0E0"
                                        BorderThickness="1"
                                        Background="#FAFAFA">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <TextBlock
                                                    DockPanel.Dock="Right"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding StateText}" />
                                                <TextBlock
                                                    FontSize="15"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Title}" />
                                            </DockPanel>
                                            <UniformGrid Grid.Row="2" Columns="2" Margin="0,8,0,0">
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FF4169E1" Text="扭矩A  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding TorqueA}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FF4169E1" Text="扭矩B  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding TorqueB}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FFFFA500" Text="入口压力A  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PressureA}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FFFFA500" Text="入口压力B  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding PressureB}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FFDC143C" Text="计量压力A  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding MeteringPressureA}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FFDC143C" Text="计量压力B  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding MeteringPressureB}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FF228B22" Text="液位A  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding LevelA}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2" Orientation="Horizontal">
                                                    <TextBlock Foreground="#FF228B22" Text="液位B  " />
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding LevelB}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border
            Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
            Panel.ZIndex="20"
            Visibility="{Binding MaximizeOverlayVisibility}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="12,8">
                    <Button
                        Width="100"
                        Height="32"
                        Margin="8,0,0,0"
                        DockPanel.Dock="Right"
                        Command="{Binding RestorePlotCommand}"
                        Content="还原窗口"
                        FontSize="14" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding MaximizedTitle}" />
                </DockPanel>
                <ScottPlot:WpfPlot x:Name="MaximizedPlot" Grid.Row="1" Margin="8" />
            </Grid>
        </Border>
    </Grid>
</Page>
