<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.JROH.BusinessDialogs.PWBusinessParamDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="576"
    Background="#FFFFFFFF"
    BorderBrush="#FFE2E8F0"
    BorderThickness="1"
    CornerRadius="10">
    <Border.Resources>
        <ResourceDictionary>

            <!--  ============ 取色：对齐 JROH 主界面（浅色） ============  -->
            <SolidColorBrush x:Key="StrokeBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="InputStrokeBrush" Color="#FFCBD5E1" />
            <SolidColorBrush x:Key="SectionBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="InputHiBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1E293B" />
            <SolidColorBrush x:Key="TextBodyBrush" Color="#FF334155" />
            <SolidColorBrush x:Key="TextSubBrush" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3DCC84" />
            <SolidColorBrush x:Key="ConfirmBrush" Color="#FF29CC7A" />

            <!--  ============ 标题 ============  -->
            <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="DialogKeyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="CloseIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FF64748B" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFF1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ============ Tab（浅色） ============  -->
            <Style x:Key="LightTabItemStyle" TargetType="TabItem">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="#FF64748B" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    Grid.Row="0"
                                    Margin="10,4,10,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LineHeight" Value="20" />
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border
                                    x:Name="ul"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    CornerRadius="1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ul" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LightTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    IsItemsHost="True"
                                    Orientation="Horizontal" />
                                <ContentPresenter
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ============ 分区（区块） ============  -->
            <Style x:Key="SectionBarStyle" TargetType="Border">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="14" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                <Setter Property="Margin" Value="9,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionBodyStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SectionBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,12,14,12" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!--  ============ 列头与行 ============  -->
            <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="6,0,6,6" />
            </Style>

            <Style
                x:Key="ColHeaderLeftStyle"
                BasedOn="{StaticResource ColHeaderStyle}"
                TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style
                x:Key="ColHeaderLowerStyle"
                BasedOn="{StaticResource ColHeaderStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFDC2626" />
            </Style>

            <Style
                x:Key="ColHeaderUpperStyle"
                BasedOn="{StaticResource ColHeaderStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFD97706" />
            </Style>

            <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="RowSubLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="Margin" Value="0,1,0,0" />
            </Style>

            <Style x:Key="NoteTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="ParamRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,2" />
            </Style>

            <!--  ============ 输入框 ============  -->
            <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="Padding" Value="0,0,13,0" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource InputStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextSubBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="bd" Property="Background" Value="#FFECFDF5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="ParamTextBoxCenterStyle"
                BasedOn="{StaticResource ParamTextBoxStyle}"
                TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputHiBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TextSubBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style
                x:Key="ParamTextBoxFixedStyle"
                BasedOn="{StaticResource ParamTextBoxStyle}"
                TargetType="TextBox">
                <Setter Property="Width" Value="144" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!--  ============ 开关（保留 Tag 文案机制） ============  -->
            <Style x:Key="PillSwitchStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="6,0" />
                <Setter Property="MinWidth" Value="108" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="#FF64748B" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="bd"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource InputStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="dot"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,8,0"
                                        Fill="{StaticResource TextSubBrush}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFECFDF5" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="#FF047857" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextSubBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="开关" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="开" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="开关" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="关" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="启用关闭" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="已启用" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="启用关闭" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="已关闭" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="正反面" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="正面" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="正反面" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="反面" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--  ============ 提示条 ============  -->
            <Style x:Key="TipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFBEB" />
                <Setter Property="BorderBrush" Value="#FFFDE68A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="13,10" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="TipTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#FF92400E" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  ============ 底栏与按钮 ============  -->
            <Style x:Key="FooterNoteStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ConfirmButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="86" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="Content" Value="保存" />
                <Setter Property="Command" Value="{Binding ConfirmCommand}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Background="{StaticResource ConfirmBrush}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF22B76D" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CancelButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="86" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                <Setter Property="Content" Value="取消" />
                <Setter Property="Command" Value="{Binding CancleCommand}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource InputStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFF1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Style="{StaticResource DialogTitleStyle}" Text="极片宽度闭环 · 参数配置" />
                <TextBlock Style="{StaticResource DialogKeyStyle}" Text="PWBusinessParam" />
            </StackPanel>
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource CloseIconButtonStyle}" />
        </DockPanel>

        <Border
            Grid.Row="1"
            Height="1"
            Margin="0,14,0,0"
            Background="{StaticResource StrokeBrush}" />

        <!--  内容  -->
        <TabControl Grid.Row="2" Style="{StaticResource LightTabControlStyle}">
            <!--  ============ 组 1：尺寸基准 ============  -->
            <TabItem Header="CP管控参数" Style="{StaticResource LightTabItemStyle}">
                <ScrollViewer
                    Width="538"
                    MaxHeight="360"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="尺寸基准" />
                            <TextBlock Style="{StaticResource SectionHintStyle}" Text="每种尺寸含 基准 / 范围下限 / 范围上限" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource ColHeaderLeftStyle}"
                                        Text="参数" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource ColHeaderStyle}"
                                        Text="基准值" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource ColHeaderLowerStyle}"
                                        Text="范围下限值" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Style="{StaticResource ColHeaderUpperStyle}"
                                        Text="范围上限值" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="隔膜总宽度" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.TotalWidthOfMold_Center, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.TotalWidthOfMold_LowerLimit, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="3"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.TotalWidthOfMold_UpperLimit, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="负极极片总宽" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.PoleWidthOfNeg_Center, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.PoleWidthOfNeg_LowerLimit, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="3"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.PoleWidthOfNeg_UpperLimit, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="正极极片总宽" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.PoleWidthOfPos_Center, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.PoleWidthOfPos_LowerLimit, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="3"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.PoleWidthOfPos_UpperLimit, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="正极极片涂膜宽度" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.CoatedWidthOfPos_Center, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.CoatedWidthOfPos_LowerLimit, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="3"
                                        Style="{StaticResource ParamTextBoxStyle}"
                                        Text="{Binding ItemSource.CoatedWidthOfPos_UpperLimit, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
