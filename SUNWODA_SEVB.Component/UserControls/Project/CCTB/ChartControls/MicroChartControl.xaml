<UserControl x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls.MicroChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--标题文本样式-->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontWeight" Value="Regular"/>
                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                <Setter Property="Opacity" Value="0.8"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition MinHeight="20" Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="50" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--X轴渲染器-->
        <local:AxisRenderer x:Name="XAxisPainter" AxisType="X" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Opacity="0.5"/>
        <!--Y轴渲染器-->
        <local:AxisRenderer x:Name="YAxisPainter" AxisType="Y" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" Opacity="0.5"/>

        <Grid x:Name="ChartGrid" Grid.Row="0" Grid.Column="1" SizeChanged="ChartGrid_SizeChanged">
            <!--XY坐标轴-->
            <Border BorderThickness="1,0,0,1" BorderBrush="#FFCCCCCC" Opacity="0.5"/>
            <!--标题-->
            <TextBlock x:Name="TitleTextBlock" Style="{StaticResource TitleTextBlockStyle}"/>
            <!-- 虚线路径 -->
            <Path x:Name="DashPath" Stroke="#FF29CC7A" StrokeDashArray="5,5" StrokeThickness="1" Opacity="0.7" VerticalAlignment="Top" HorizontalAlignment="Left"/>
            <!-- 曲线路径 -->
            <Path x:Name="ChartPath" Stroke="#FF29CC7A" StrokeThickness="1" Opacity="0.7" VerticalAlignment="Top" HorizontalAlignment="Left"/>

            <!-- 填充区域(可选，做渐变效果) -->
            <Path x:Name="FillPath" Opacity="0.3" VerticalAlignment="Top" HorizontalAlignment="Left">
                <Path.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF29CC7A" Offset="0"/>
                        <GradientStop Color="#1A29CC7A" Offset="0.6"/>
                        <GradientStop Color="#0029CC7A" Offset="0.8"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Path.Fill>
            </Path>
        </Grid>
    </Grid>
</UserControl>
