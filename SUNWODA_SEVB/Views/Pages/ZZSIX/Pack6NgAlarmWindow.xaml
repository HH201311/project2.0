<Window
    x:Class="SUNWODA_SEVB.Views.Pages.ZZSIX.Pack6NgAlarmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="扫码 NG 警示"
    Width="720"
    Height="520"
    MinWidth="560"
    MinHeight="400"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ShowInTaskbar="True"
    Background="#FFFFF5F5"
    ResizeMode="CanResizeWithGrip">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="16,12"
            Background="#FFE74C3C"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="36"
                    FontWeight="Bold"
                    Foreground="White"
                    Text="NG 警示" />
                <TextBlock
                    Margin="0,6,0,0"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="#FFFFE0E0"
                    Text="程序继续运行；点「确定」关闭即可" />
            </StackPanel>
        </Border>

        <TextBlock
            Grid.Row="1"
            Margin="0,16,0,8"
            FontSize="16"
            FontWeight="SemiBold"
            Foreground="#FFC0392B"
            Text="当前未确认 NG 产品码：" />

        <Border
            Grid.Row="2"
            Background="White"
            BorderBrush="#FFE74C3C"
            BorderThickness="2"
            CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox
                    x:Name="NgListBox"
                    Margin="8"
                    AcceptsReturn="True"
                    BorderThickness="0"
                    FontFamily="Consolas"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#FFC0392B"
                    IsReadOnly="True"
                    TextWrapping="Wrap"
                    VerticalScrollBarVisibility="Disabled" />
            </ScrollViewer>
        </Border>

        <Button
            Grid.Row="3"
            Height="52"
            Margin="0,16,0,0"
            HorizontalAlignment="Stretch"
            Background="#FFE74C3C"
            Click="OnConfirmClick"
            Content="确定"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White" />
    </Grid>
</Window>
