<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.UserOperation.UserModifyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    d:Width="400"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBHCControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:ConfigToVisibilityMultiValueConverter x:Key="ConfigToVisibilityMultiValueConverter" />

            <!--  标题样式  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  关闭按钮  -->
            <Style x:Key="ClosedButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20,0,20,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,20,0,20"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="修改用户" />

            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource ClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBox
                Height="40"
                Margin="0,0,0,20"
                hc:InfoElement.Placeholder="用户工号"
                hc:InfoElement.Title="账号"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="110"
                Background="#1AFFFFFF"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CaretBrush="#FFFFFF"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                FontSize="14"
                Foreground="#61FFFFFF"
                IsReadOnly="True"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Result.Account}" />
            <TextBox
                Height="40"
                Margin="0,0,0,20"
                hc:InfoElement.Placeholder="请输入用户姓名"
                hc:InfoElement.Title="用户姓名"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="110"
                Background="#0DFFFFFF"
                BorderThickness="0"
                CaretBrush="#FFFFFF"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                FontSize="14"
                Foreground="#99FFFFFF"
                Style="{StaticResource TextBoxExtend}"
                Text="{Binding Result.Name}" />
            <ComboBox
                Height="40"
                hc:InfoElement.Placeholder="请选择用户角色"
                hc:InfoElement.Title="角色"
                hc:InfoElement.TitlePlacement="Left"
                hc:InfoElement.TitleWidth="110"
                Background="#0DFFFFFF"
                BorderThickness="0"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                FontSize="14"
                Foreground="#99FFFFFF"
                ItemsSource="{Binding UserRoleSource}"
                SelectedItem="{Binding Result.Role}"
                Style="{StaticResource HCComboBoxExtend}" />
        </StackPanel>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button
                Margin="10,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="确认"
                Style="{StaticResource ParamOKButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding CancleCommand}"
                Content="取消"
                Style="{StaticResource ParamCancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

