<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!--#region DataGrid 样式-->
    <!--  ========== 调色板资源 ==========  -->
    <SolidColorBrush x:Key="DataGridBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#F8FAFC" />
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#1E293B" />
    <SolidColorBrush x:Key="DataGridCellForeground" Color="#1E293B" />
    <SolidColorBrush x:Key="DataGridRowHoverBackground" Color="#EFF6FF" />
    <SolidColorBrush x:Key="DataGridRowSelectedBackground" Color="#3B82F6" />
    <SolidColorBrush x:Key="DataGridRowSelectedForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DataGridAlternateRowBackground" Color="#F8FAFC" />

    <!--  ========== DataGrid 单元格样式 ==========  -->
    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource DataGridCellForeground}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource DataGridRowSelectedForeground}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ========== DataGrid 行样式 ==========  -->
    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource DataGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="MinHeight" Value="44" />

        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="{StaticResource DataGridAlternateRowBackground}" />
            </Trigger>

            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowHoverBackground}" />
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource DataGridRowSelectedBackground}" />
                <Setter Property="Foreground" Value="{StaticResource DataGridRowSelectedForeground}" />
                <Setter Property="BorderBrush" Value="#2563EB" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ========== DataGrid 列标题样式 ==========  -->
    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource DataGridHeaderBackground}" />
        <Setter Property="Foreground" Value="{StaticResource DataGridHeaderForeground}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="BorderBrush" Value="{StaticResource DataGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F1F5F9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ========== DataGrid 样式 ==========  -->
    <Style
        x:Key="SimpleDataGridStyle"
        BasedOn="{x:Null}"
        TargetType="DataGrid">
        <Setter Property="Background" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource DataGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource DataGridCellForeground}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinRowHeight" Value="44" />
        <Setter Property="ColumnHeaderHeight" Value="44" />
        <Setter Property="AlternationCount" Value="2" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="HeadersVisibility" Value="Column" />

        <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="true" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />

        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="CanUserResizeColumns" Value="True" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="ColumnWidth" Value="*" />
        <Setter Property="IsReadOnly" Value="True" />

        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />

        <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}" />
        <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}" />
        <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}" />
    </Style>
    <!--#endregion-->

    <Style x:Key="SimpleGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="FontFamily" Value="{StaticResource CCTB.AlimamaShuHeiTi}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CCTB.AlimamaShuHeiTi}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!--#region  按钮样式-->
    <!--  简单俺就样式  -->
    <Style x:Key="SimpleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="AliceBlue" />
    </Style>

    <!--  确认按钮  -->
    <Style x:Key="GrowlConfirmButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Background" Value="#FF29CC7A" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Content" Value="确认" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Opacity="0.87" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  取消按钮  -->
    <Style x:Key="GrowlCancleButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Opacity" Value="0.8" />
        <Setter Property="Content" Value="取消" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="#CCFFFFFF"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Opacity="0.8" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--  基于 HandyControl 的输入框样式  -->
    <Style
        x:Key="HCTitleValueTextBox"
        BasedOn="{StaticResource TextBoxExtend}"
        TargetType="TextBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="CaretBrush" Value="#FFFFFFFF" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
        <Setter Property="hc:InfoElement.TitleWidth" Value="180" />
        <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        <Setter Property="hc:InfoElement.Symbol" Value="*" />
        <Setter Property="hc:InfoElement.Necessary" Value="True" />
    </Style>

    <!--  基于 HandyControl 的下拉框样式  -->
    <Style
        x:Key="HCParamComboBoxStyle"
        BasedOn="{StaticResource ComboBoxExtend}"
        TargetType="ComboBox">
        <Style.Resources>
            <ResourceDictionary>
                <SolidColorBrush x:Key="RegionBrush" Color="#FF2B2B2B" />
                <SolidColorBrush x:Key="BorderBrush" Color="#1AFFFFFF" />
                <SolidColorBrush x:Key="SecondaryBorderBrush" Color="#3AFFFFFF" />
                <SolidColorBrush x:Key="PrimaryBrush" Color="#4AFFFFFF" />
                <SolidColorBrush x:Key="PrimaryTextBrush" Color="#CCFFFFFF" />
                <SolidColorBrush x:Key="SecondaryTextBrush" Color="#99FFFFFF" />
            </ResourceDictionary>
        </Style.Resources>
        <Setter Property="Width" Value="360" />
        <Setter Property="Height" Value="30" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
        <Setter Property="hc:InfoElement.TitleWidth" Value="180" />
        <Setter Property="hc:InfoElement.TitlePlacement" Value="Left" />
        <Setter Property="hc:InfoElement.Symbol" Value="*" />
        <Setter Property="hc:InfoElement.Necessary" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="hc:BorderElement.CornerRadius" Value="5" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,5" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#CCFFFFFF" />
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#2AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#1AFFFFFF" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region 基于 HandyControl 分页容器样式-->
    <!--  TabItem 项样式  -->
    <Style x:Key="HCTabItemStyle" TargetType="hc:TabItem">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#99FFFFFF" />
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Margin" Value="-2,0,5,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="hc:TabItem">
                    <Border
                        Name="TabBorder"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10,10,0,0">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="Center"
                            ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  选中状态  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#0DFFFFFF" />
                            <Setter Property="Foreground" Value="#FF3DCC84" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                        </Trigger>
                        <!--  鼠标悬停状态  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#10FFFFFF" />
                            <Setter Property="Foreground" Value="#FF3DCC84" />
                        </Trigger>
                        <!--  不可用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabControl 容器样式  -->
    <Style x:Key="HCTabControlStyle" TargetType="hc:TabControl">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="hc:TabControl.IsTabFillEnabled" Value="False" />
    </Style>
    <!--#endregion-->

    <!--#region ListView相关样式-->
    <Style x:Key="CustomItemContainerStyleStyle" TargetType="ListBoxItem">
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Border
                            Name="SelectBorder"
                            Margin="1"
                            Padding="2"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="0">
                            <Grid x:Name="DockPanel1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <DockPanel VerticalAlignment="Center">
                                    <TextBlock
                                        Name="SelectText"
                                        Margin="5,0,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="#666666"
                                        Text="{Binding PName}" />
                                    <TextBlock
                                        Margin="0,0,20,0"
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="#3355FF"
                                        Text="{Binding PValue}">
                                        <TextBlock.ToolTip>
                                            <TextBlock
                                                MaxWidth="500"
                                                Text="{Binding PValue}"
                                                TextWrapping="NoWrap" />
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="DockPanel1" Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EAEDFF" />
                        </Trigger>
                        <!--  选中  -->
                        <Trigger Property="Selector.IsSelected" Value="true">
                            <Setter Property="Background" Value="#EAEDFF" />
                            <Setter TargetName="SelectBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="SelectText" Property="Foreground" Value="#3355FF" />
                        </Trigger>
                        <!--  多条件触发器  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <!--  是否已被选中，含多选情况  -->
                                <Condition Property="Selector.IsSelected" Value="True" />
                                <!--  是否是当前选中项，多选时为焦点所在项  -->
                                <Condition Property="Selector.IsFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Background" Value="Transparent" />
                            <Setter TargetName="SelectBorder" Property="BorderBrush" Value="#14AAE6" />
                            <Setter TargetName="SelectText" Property="Foreground" Value="#14AAE6" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->
</ResourceDictionary>