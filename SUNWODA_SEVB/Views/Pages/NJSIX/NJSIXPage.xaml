<Page
    x:Class="SUNWODA_SEVB.Views.Pages.NJSIX.NJSIXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    Title="NJSIXPage"
    d:DesignHeight="860"
    d:DesignWidth="1400"
    Background="#FFF0F4F8"
    mc:Ignorable="d">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏：标题 + 运行状态 + 当前产品（南京暂无 PLC） -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="4,0,4,6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Text="NJSIX 六面拍照工位检测" />
                <Border
                    Margin="16,0,0,0"
                    Padding="10,4"
                    Background="#FFE8F0FE"
                    CornerRadius="4">
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="运行状态：" />
                        <Run FontWeight="Bold" Text="{Binding StatusText, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <Border
                    Margin="8,0,0,0"
                    Padding="6,2"
                    Background="#FFF5F5F5"
                    CornerRadius="4">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="当前产品：" />
                        <TextBox
                            MinWidth="220"
                            Margin="4,0,0,0"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="Bold"
                            IsReadOnly="True"
                            Text="{Binding ProductId, Mode=OneWay}"
                            ToolTip="可选中复制" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="4,0,4,8"
            Padding="10,6"
            Background="White"
            BorderBrush="#FFD0D7DE"
            BorderThickness="1"
            CornerRadius="4">
            <TextBlock
                x:Name="ConfigSummaryText"
                FontSize="13"
                LineHeight="20"
                TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2" Margin="4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" MinWidth="270" />
            </Grid.ColumnDefinitions>

            <!-- 左：预览 4/5 + 日志 1/5 -->
            <Grid Grid.Column="0" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" MinHeight="280" />
                    <RowDefinition Height="*" MinHeight="72" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Background="White"
                    BorderBrush="#FFD0D7DE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="2,0,0,4"
                            FontWeight="SemiBold"
                            Text="十相机预览" />
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CameraSlots}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" Rows="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="2"
                                        Background="#FF1A1A1A"
                                        BorderBrush="#FFB0B0B0"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="CameraPreview_MouseLeftButtonDown"
                                        ToolTip="双击全屏查看标注图">
                                        <Grid>
                                            <Image
                                                Margin="1"
                                                Stretch="Uniform"
                                                Source="{Binding Preview}" />
                                            <DockPanel VerticalAlignment="Top" Background="#99000000">
                                                <TextBlock
                                                    DockPanel.Dock="Right"
                                                    Margin="4,2"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding StatusBrush}"
                                                    Text="{Binding LastResult, StringFormat=检测结果: {0}}" />
                                                <TextBlock
                                                    Margin="4,2"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="{Binding Title}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Background="White"
                    BorderBrush="#FFD0D7DE"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Margin="2,0,0,2"
                            FontWeight="SemiBold"
                            Text="检测日志" />
                        <DataGrid
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            Background="Transparent"
                            BorderThickness="0"
                            CanUserAddRows="False"
                            CanUserResizeRows="False"
                            EnableRowVirtualization="False"
                            GridLinesVisibility="Horizontal"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding ResultLogs}"
                            FontSize="12">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding TimeText}"
                                    Header="时间" />
                                <DataGridTextColumn
                                    Width="*"
                                    MinWidth="160"
                                    Binding="{Binding Sn}"
                                    Header="SN" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Result}"
                                    Header="检测结果" />
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding NgDetail}"
                                    Header="NG详情">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="2,4" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右：功能 / 饼图 / 紧凑统计 / 启停 -->
            <Border
                Grid.Column="1"
                Background="White"
                BorderBrush="#FFD0D7DE"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 产品类型下拉：南京暂不核档位，隐藏保留绑定以便日后恢复 -->
                    <Grid Margin="0,0,0,8" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="产品类型" />
                        <ComboBox
                            Grid.Column="1"
                            Height="30"
                            VerticalContentAlignment="Center"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding CanEditRuntimeConfig}"
                            ItemsSource="{Binding ProductCodeProfiles}"
                            SelectedItem="{Binding SelectedProductCodeProfile, Mode=TwoWay}"
                            ToolTip="检测运行中不可切换" />
                    </Grid>

                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <Button
                            Height="30"
                            Margin="0,0,4,6"
                            Background="#FF2F80ED"
                            Command="{Binding OpenSettingsCommand}"
                            Content="功能设置"
                            FontWeight="SemiBold"
                            Foreground="White"
                            ToolTip="检测运行中不可打开" />
                        <Button
                            Height="30"
                            Margin="4,0,0,6"
                            Background="#FFE74C3C"
                            Command="{Binding OpenResultFolderCommand}"
                            Content="NG结果查询"
                            FontWeight="SemiBold"
                            Foreground="White" />
                        <Button
                            Height="28"
                            Margin="0,0,4,0"
                            Command="{Binding ResetCommand}"
                            Content="统计清零" />
                        <Button
                            Height="28"
                            Margin="4,0,0,0"
                            Background="#FFF39C12"
                            Command="{Binding OpenOfflineTestCommand}"
                            Content="离线测试"
                            FontWeight="SemiBold"
                            ToolTip="自动检测未启动时，选本地图单独调视觉 DLL" />
                    </UniformGrid>

                    <Border
                        Grid.Row="2"
                        Margin="0,10,0,6"
                        Padding="6"
                        Background="#FFF7FAFC"
                        BorderBrush="#FFE2E8F0"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <oxy:PlotView
                                Width="132"
                                Height="132"
                                IsHitTestVisible="False"
                                Model="{Binding PieModel}" />
                            <StackPanel Grid.Column="1" Margin="8,4,0,0" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="检测信息" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="#FF27AE60"
                                    Text="{Binding YieldRateText, Mode=OneWay}" />
                                <TextBlock Foreground="#FF666666" Text="一次优率" />
                                <TextBlock Margin="0,8,0,0" FontSize="12">
                                    <Run Text="总数 " />
                                    <Run FontWeight="Bold" Text="{Binding TotalCountText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="12">
                                    <Run Text="OK " />
                                    <Run FontWeight="Bold" Foreground="#FF27AE60" Text="{Binding OkCountText, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run FontWeight="Bold" Foreground="#FF27AE60" Text="{Binding OkPctText, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="12">
                                    <Run Text="NG " />
                                    <Run FontWeight="Bold" Foreground="#FFE74C3C" Text="{Binding NgCountText, Mode=OneWay}" />
                                    <Run Text=" (" />
                                    <Run FontWeight="Bold" Foreground="#FFE74C3C" Text="{Binding NgPctText, Mode=OneWay}" />
                                    <Run Text=")" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 紧凑行高：按检测项（当前两路码检） -->
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="2,0,2,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="检测项" />
                            <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="OK" />
                            <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="NG" />
                            <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="NG率" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding DetectionItemStats}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="18" Margin="2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="11" VerticalAlignment="Center" Text="{Binding Station}" />
                                        <TextBlock Grid.Column="1" FontSize="11" VerticalAlignment="Center" Text="{Binding OK}" />
                                        <TextBlock Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="{Binding NG}" />
                                        <TextBlock Grid.Column="3" FontSize="11" VerticalAlignment="Center" Text="{Binding Rate}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <UniformGrid Grid.Row="5" Columns="2" Margin="0,8,0,0">
                        <Button
                            Height="44"
                            Margin="0,0,4,0"
                            Background="#FF27AE60"
                            Command="{Binding StartCommand}"
                            Content="启动"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White" />
                        <Button
                            Height="44"
                            Margin="4,0,0,0"
                            Background="#FFE74C3C"
                            Command="{Binding StopCommand}"
                            Content="停止"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="White" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
