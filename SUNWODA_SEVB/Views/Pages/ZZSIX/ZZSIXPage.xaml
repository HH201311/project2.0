<Page
    x:Class="SUNWODA_SEVB.Views.Pages.ZZSIX.ZZSIXPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ZZSIXPage"
    d:DesignHeight="800"
    d:DesignWidth="1280"
    mc:Ignorable="d">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Button
                    Width="88"
                    Margin="4,0"
                    Command="{Binding StartCommand}"
                    Content="启动"
                    FontWeight="SemiBold" />
                <Button
                    Width="88"
                    Margin="4,0"
                    Command="{Binding StopCommand}"
                    Content="停止" />
                <Button
                    Width="88"
                    Margin="4,0"
                    Command="{Binding ResetCommand}"
                    Content="清零统计" />
                <Button
                    Width="100"
                    Margin="4,0"
                    Command="{Binding SaveConfigCommand}"
                    Content="保存配置" />
                <Button
                    Width="110"
                    Margin="4,0"
                    Command="{Binding OpenResultFolderCommand}"
                    Content="打开结果目录" />
                <Button
                    Width="120"
                    Margin="4,0"
                    Command="{Binding SimulateOnePackCommand}"
                    Content="模拟一整包" />
            </StackPanel>
            <StackPanel Orientation="Vertical">
                <TextBlock
                    FontSize="22"
                    FontWeight="SemiBold"
                    Text="PACK 六面检" />
                <TextBlock
                    Margin="0,4,0,0"
                    Foreground="Gray"
                    Text="{Binding StatusText, StringFormat=状态：{0}}" />
            </StackPanel>
        </DockPanel>

        <WrapPanel Grid.Row="1" Margin="0,12,0,8">
            <TextBlock
                Margin="0,6,8,0"
                VerticalAlignment="Center"
                Text="电芯型号" />
            <TextBox
                Width="80"
                Margin="0,0,16,0"
                Text="{Binding CellType, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Margin="0,6,8,0"
                VerticalAlignment="Center"
                Text="当前产品" />
            <TextBlock
                MinWidth="120"
                Margin="0,6,16,0"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="{Binding ProductId}" />
            <TextBlock
                Margin="0,6,8,0"
                VerticalAlignment="Center"
                Text="最近一帧" />
            <TextBlock
                MinWidth="240"
                Margin="0,6,16,0"
                VerticalAlignment="Center"
                Text="{Binding LastFrameInfo}" />
            <CheckBox
                Margin="0,6,16,0"
                VerticalAlignment="Center"
                Content="模拟检测（未接 ZZPack）"
                IsChecked="{Binding UseSimulation}" />
        </WrapPanel>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,4,8,4"
                VerticalAlignment="Center"
                Text="结果根目录" />
            <TextBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,4,16,4"
                Text="{Binding LocalPathPre, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,4,8,4"
                VerticalAlignment="Center"
                Text="上盖路径" />
            <TextBox
                Grid.Row="0"
                Grid.Column="3"
                Margin="0,4,0,4"
                Text="{Binding TopCamPath, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,4,8,4"
                VerticalAlignment="Center"
                Text="底部路径" />
            <TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,4,16,4"
                Text="{Binding BottomCamPath, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,4,8,4"
                VerticalAlignment="Center"
                Text="侧面路径" />
            <TextBox
                Grid.Row="1"
                Grid.Column="3"
                Margin="0,4,0,4"
                Text="{Binding SideCamPath, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <DataGrid
            Grid.Row="3"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            ItemsSource="{Binding StationStats}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding Station}"
                    Header="工位" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding Total}"
                    Header="总数" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding OK}"
                    Header="OK" />
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding NG}"
                    Header="NG" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Rate}"
                    Header="NG率" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox
            Grid.Row="4"
            Margin="0,8,0,0"
            Header="运行日志">
            <ListBox ItemsSource="{Binding LogMessages}" />
        </GroupBox>
    </Grid>
</Page>
