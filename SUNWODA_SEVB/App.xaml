<Application
    x:Class="SUNWODA_SEVB.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SUNWODA_SEVB">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/AIMarkdownViewerStyle.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />

                <ResourceDictionary x:Name="CCTBThemeResourceDictionary">
                    <FontFamily x:Key="CCTB.SourceHanSansCN">pack://application:,,,/SUNWODA_SEVB;component/Assets/Fonts/#sourcehansanscn</FontFamily>
                    <FontFamily x:Key="CCTB.AlimamaShuHeiTi">pack://application:,,,/SUNWODA_SEVB;component/Assets/Fonts/#阿里妈妈数黑体</FontFamily>
                    <FontFamily x:Key="CCTB.IconFont">pack://application:,,,/SUNWODA_SEVB;component/Assets/Fonts/#iconfont_cctb</FontFamily>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
