<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.JROH.FloderPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JROH"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
    FontSize="14"
    Foreground="#CCFFFFFF"
    mc:Ignorable="d">

    <Border
        Background="#0DFFFFFF"
        BorderThickness="0"
        CornerRadius="5"
        Style="{x:Null}">
        <Grid Style="{x:Null}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Margin="10,0"
                VerticalContentAlignment="Center"
                d:Text="D:\MESDATA\12_张力数据-TensionData-ข้อมูลแรงตึง"
                Background="Transparent"
                BorderThickness="0"
                CaretBrush="#FFFFFFFF"
                FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Style="{x:Null}"
                Text="{Binding FloderText, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextAlignment="Left" />
            <Button
                Grid.Column="1"
                Margin="0,5"
                Padding="10,0"
                d:Content="更改"
                Background="Transparent"
                BorderThickness="0"
                Click="FloderPick_Click"
                Content="{Binding PickerContent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Foreground="#FF3DCC84"
                Style="{x:Null}" />
        </Grid>
    </Border>
</UserControl>
