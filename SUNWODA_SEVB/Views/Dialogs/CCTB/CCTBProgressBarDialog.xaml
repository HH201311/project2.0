<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.CCTBProgressBarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    MinWidth="400"
    MinHeight="200"
    MaxWidth="500"
    MaxHeight="400"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:ConfigToVisibilityMultiValueConverter x:Key="ConfigToVisibilityMultiValueConverter" />

            <!--  标题样式  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  关闭按钮  -->
            <Style x:Key="ClosedButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  消息样式  -->
            <Style x:Key="MessageTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Opacity" Value="1" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  图标  -->
        <Viewbox
            Width="30"
            Height="30"
            Margin="0,0,10,25"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="{Binding ShowImage, Converter={StaticResource Boolean2VisibilityConverter}}">
            <Path
                d:Data="{StaticResource InfoGeometry}"
                d:Fill="#FFCC5252"
                Data="{Binding Image}"
                Fill="{Binding ImageBrush}" />
        </Viewbox>
        <!--  标题  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,0,0,20"
            d:Text="标题"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{Binding Title}"
            Visibility="{Binding ShowTitle, Converter={StaticResource Boolean2VisibilityConverter}}" />

        <!--  关闭按钮  -->
        <Button
            Grid.Row="0"
            Grid.Column="2"
            Margin="0,0,0,20"
            Command="{Binding CloseCommand}"
            Style="{StaticResource ClosedButtonStyle}" />

        <!--  内容  -->
        <ScrollViewer
            Grid.Row="1"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            MaxHeight="300"
            Padding="0,0,20,0"
            VerticalScrollBarVisibility="Auto">
            <TextBlock d:Text="删除用户“林小小2603270042”？" Text="{Binding Message}">
                <TextBlock.Style>
                    <Style BasedOn="{StaticResource MessageTextBlockStyle}" TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowTitle}" Value="False">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </ScrollViewer>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="1"
            Grid.ColumnSpan="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button
                Margin="10,0,0,0"
                d:Background="#FF3DCC84"
                d:Content="OK"
                Background="{Binding OKButtonModel.Background}"
                Command="{Binding OKButtonModel.Command}"
                Content="{Binding OKButtonModel.Content}"
                Style="{StaticResource ParamOKButtonStyle}"
                Visibility="{Binding OKButtonModel.Visibility}" />
            <Button
                Margin="10,0,0,0"
                d:Background="#FF3DCC84"
                d:Content="Yes"
                Background="{Binding YesButtonModel.Background}"
                Command="{Binding YesButtonModel.Command}"
                Content="{Binding YesButtonModel.Content}"
                Style="{StaticResource ParamOKButtonStyle}"
                Visibility="{Binding YesButtonModel.Visibility}" />
            <Button
                Margin="10,0,0,0"
                d:Background="#FF3DCC84"
                d:Content="No"
                Background="{Binding NoButtonModel.Background}"
                Command="{Binding NoButtonModel.Command}"
                Content="{Binding NoButtonModel.Content}"
                Style="{StaticResource ParamOKButtonStyle}"
                Visibility="{Binding NoButtonModel.Visibility}" />
            <Button
                Margin="10,0,0,0"
                d:Content="Cancle"
                Background="{Binding CancleButtonModel.Background}"
                Command="{Binding CancleButtonModel.Command}"
                Content="{Binding CancleButtonModel.Content}"
                Style="{StaticResource ParamCancleButtonStyle}"
                Visibility="{Binding CancleButtonModel.Visibility}" />
        </StackPanel>
    </Grid>
</Border>

