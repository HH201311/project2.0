<UserControl x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ArithmeticSettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
             mc:Ignorable="d" 
             d:DesignHeight="190" d:DesignWidth="510">
    <UserControl.Resources>
        <Style x:Key="ArithmeticGropBoxStyle" TargetType="GroupBox">
            <Setter Property="Background" Value="#0DFFFFFF"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border CornerRadius="10" Background="{TemplateBinding Background}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <!--Header-->
                                <StackPanel Grid.Row="0" Margin="20,20,20,0" Orientation="Horizontal" VerticalAlignment="Stretch">
                                    <TextBlock Margin="0,0,0,0" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left"
                                             FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}"/>
                                </StackPanel>

                                <!--内容-->
                                <ContentPresenter Grid.Row="1"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--算法名称编辑按钮样式-->
        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="14"/>
            <Setter Property="MinHeight" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="&#xe66c;" Foreground="#99FFFFFF" FontFamily="{StaticResource CCTB.IconFont}"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--算法名称输入框样式-->
        <Style x:Key="ArithmeticTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <!--参数设置按钮样式-->
        <Style x:Key="ParamSettingButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF3DCC84"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF3DCC84"/>
            <Setter Property="Content" Value="参数设置"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="5" BorderThickness="1" BorderBrush="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--算法开关按钮样式-->
        <Style x:Key="ArithmeticEnableToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#FF3DCC84"/>
            <Setter Property="Content" Value="启用"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border CornerRadius="5" Background="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Content" Value="关闭算法"/>
                                <Setter Property="Background" Value="#0DFFFFFF"/>
                                <Setter Property="Foreground" Value="#99FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="EnabledGrid" Visibility="Collapsed" Width="50" Height="50" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Border CornerRadius="0,10,0,50" Background="#0DFFFFFF"/>
            <Path Fill="#3DCC84"
                  Data="M42.0 13.12
                        s-4.0 1.3 -8.67 6.5
                        a50.4 50.4 0 0 0 -7.0 9.26
                        A23.15 23.15 0 0 0 16.99 20.58
                        l3.5 -3.25
                        a18.84 18.84 0 0 1 5.34 6.01
                        A36.4 36.4 0 0 1 42.0 11.0
                        z"/>
        </Grid>
        <GroupBox x:Name="GB" d:Header="xx算法" Style="{StaticResource ArithmeticGropBoxStyle}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Top" ToolTip="单击Esc退出编辑&#x0a;单击Enter完成输入">
                    <Border x:Name="Edit_Bd1" BorderThickness="0" CornerRadius="5" BorderBrush="#FF3DCC84"/>
                    <Grid Margin="8,10,8,6" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border x:Name="Edit_Bd2" Visibility="Hidden" Background="#FF3DCC84" Opacity="0.1"/>
                            <TextBox x:Name="ArithmeticTB" d:Text="DY-ASDASDASDASDASD" KeyDown="ArithmeticTB_KeyDown" LostFocus="ArithmeticTB_LostFocus" Style="{StaticResource ArithmeticTextBoxStyle}"/>
                        </Grid>
                        <Button x:Name="Edit_Btn" Grid.Column="1" Margin="10,0,0,0" Click="EditBtn_Click" HorizontalAlignment="Left" Style="{StaticResource EditButtonStyle}"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <Button x:Name="ParamSetting_Btn" Style="{StaticResource ParamSettingButtonStyle}"/>
                    <Rectangle Width="20"/>
                    <ToggleButton x:Name="ArithmeticEnable_TB" Click="ArithmeticEnableTB_Click" Style="{StaticResource ArithmeticEnableToggleButtonStyle}"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
