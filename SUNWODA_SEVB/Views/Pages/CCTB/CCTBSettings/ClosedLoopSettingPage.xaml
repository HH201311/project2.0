<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.ClosedLoopSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cctbmodels="[cctbmodels ]clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccctb="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    Title="ClosedLoopSettingPage"
    d:DesignHeight="940"
    d:DesignWidth="1610"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="270*" />
            <RowDefinition Height="270*" />
            <RowDefinition Height="360*" />
        </Grid.RowDefinitions>
        <GroupBox
            Grid.Row="0"
            Margin="0,0,0,20"
            Header="A面"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid
                Margin="20,20,0,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Rows="1">
                <uccctb:ArithmeticSettingControl
                    Margin="0,0,20,0"
                    ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"
                    ArithmeticName="{Binding ArithmeticModel_MDA.ArithmeticName, Mode=TwoWay}"
                    ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}"
                    ClosedLoopType="MD"
                    Header="MD算法"
                    IsArithmeticEnabled="{Binding ArithmeticModel_MDA.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="A" />
                <uccctb:ArithmeticSettingControl
                    Margin="0,0,20,0"
                    ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"
                    ArithmeticName="{Binding ArithmeticModel_TDA.ArithmeticName, Mode=TwoWay}"
                    ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}"
                    ClosedLoopType="TD"
                    Header="TD算法"
                    IsArithmeticEnabled="{Binding ArithmeticModel_TDA.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="A" />
                <uccctb:ArithmeticSettingControl
                    Margin="0,0,20,0"
                    ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"
                    ArithmeticName="{Binding ArithmeticModel_MDTDA.ArithmeticName, Mode=TwoWay}"
                    ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}"
                    ClosedLoopType="MDTD"
                    Header="MDTD算法"
                    IsArithmeticEnabled="{Binding ArithmeticModel_MDTDA.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="A" />

            </UniformGrid>
        </GroupBox>
        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,20"
            Header="B面"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid
                Margin="20,20,0,20"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Rows="1">
                <uccctb:ArithmeticSettingControl
                    Margin="0,0,20,0"
                    ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"
                    ArithmeticName="{Binding ArithmeticModel_MDB.ArithmeticName, Mode=TwoWay}"
                    ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}"
                    ClosedLoopType="MD"
                    Header="MD算法"
                    IsArithmeticEnabled="{Binding ArithmeticModel_MDB.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="B" />
                <uccctb:ArithmeticSettingControl
                    Margin="0,0,20,0"
                    ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"
                    ArithmeticName="{Binding ArithmeticModel_TDB.ArithmeticName, Mode=TwoWay}"
                    ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}"
                    ClosedLoopType="TD"
                    Header="TD算法"
                    IsArithmeticEnabled="{Binding ArithmeticModel_TDB.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="B" />
                <uccctb:ArithmeticSettingControl
                    Margin="0,0,20,0"
                    ArithmeticEnableChangedCommand="{Binding ArithmeticEnableChangedCommand}"
                    ArithmeticName="{Binding ArithmeticModel_MDTDB.ArithmeticName, Mode=TwoWay}"
                    ArithmeticVerifyCommand="{Binding ArithmeticVerifyCommand}"
                    ClosedLoopType="MDTD"
                    Header="MDTD算法"
                    IsArithmeticEnabled="{Binding ArithmeticModel_MDTDB.IsEnable, Mode=TwoWay}"
                    ParamSettingClickCommand="{Binding ParamSettingClickCommand}"
                    SideType="B" />
            </UniformGrid>
        </GroupBox>
        <Grid Grid.Row="2" Margin="0">
            <GroupBox Header="通用设置" Style="{StaticResource SimpleGroupBoxStyle}">
                <ScrollViewer
                    Margin="20,20,0,5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
                        <GroupBox
                            MinWidth="300"
                            Margin="0,0,20,0"
                            Header="数据处理设置"
                            Style="{StaticResource SimpleGroupBoxStyle1}">
                            <StackPanel
                                Margin="20,0,20,20"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical">
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="闭环数据源" />
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding WeightDataTypeSource}"
                                        SelectedValue="{Binding GeneralSettingsModel.WeightDataType, Mode=TwoWay}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamValueComboBoxStyle}" />
                                </UniformGrid>
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="膜区处理" />
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding EMembraneZoneTypeSource}"
                                        SelectedValue="{Binding GeneralSettingsModel.MembraneZoneType, Mode=TwoWay}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamValueComboBoxStyle}" />
                                </UniformGrid>
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="刀距滞后变化值" />
                                    <TextBox
                                        d:Text="1"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Tag="(mm)"
                                        Text="{Binding GeneralSettingsModel.Lag_DearanceConditiont, Mode=TwoWay}" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox
                            MinWidth="300"
                            Margin="0,0,20,0"
                            Header="PLC设定泵速读取配置"
                            Style="{StaticResource SimpleGroupBoxStyle1}">
                            <StackPanel
                                Margin="20,0,20,20"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical">
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="小数位/精度" />
                                    <TextBox
                                        d:Text="2"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Text="{Binding GeneralSettingsModel.SetB_Digits, Mode=TwoWay}" />
                                </UniformGrid>
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="四舍五入" />
                                    <ToggleButton
                                        d:IsChecked="False"
                                        IsChecked="{Binding GeneralSettingsModel.SetB_IsRound, Mode=TwoWay}"
                                        Style="{StaticResource ParamValueToggleButton}" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox
                            MinWidth="300"
                            Margin="0,0,20,0"
                            Header="数据判异/数采设置"
                            Style="{StaticResource SimpleGroupBoxStyle1}">
                            <StackPanel
                                Margin="20,0,20,20"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical">
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="走带速度" />
                                    <TextBox
                                        d:Text="20"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Tag="(m/min)"
                                        Text="{Binding GeneralSettingsModel.VelocityCondition, Mode=TwoWay}" />
                                </UniformGrid>
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="面密度目标值" />
                                    <TextBox
                                        d:Text="±20"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Tag="(mg)"
                                        Text="{Binding GeneralSettingsModel.TargetOffset, Mode=TwoWay, StringFormat={} ±{0}}" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox
                            MinWidth="300"
                            Margin="0,0,20,0"
                            Header="设备参数配置"
                            Style="{StaticResource SimpleGroupBoxStyle1}">
                            <StackPanel
                                Margin="20,0,20,20"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Orientation="Vertical">
                                <UniformGrid
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="2">
                                    <TextBlock Style="{StaticResource ParamNameTextBlockStyle}" Text="AB面走带间隔距离" />
                                    <TextBox
                                        d:Text="85"
                                        Style="{StaticResource ParamValueTextBoxStyle}"
                                        Tag="(m)"
                                        Text="{Binding GeneralSettingsModel.DistanceBetweenAB, Mode=TwoWay}" />
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox
                            MinWidth="300"
                            Margin="0,0,20,0"
                            Header="膜区配置"
                            Style="{StaticResource SimpleGroupBoxStyle1}">
                            <Grid
                                Margin="20,0,20,20"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <UniformGrid
                                    Grid.Row="0"
                                    MinHeight="30"
                                    Margin="0,20,0,0"
                                    Columns="1">
                                    <ComboBox
                                        DisplayMemberPath="DisplayName"
                                        ItemsSource="{Binding PartitionedTypeSource}"
                                        SelectedValue="{Binding GeneralSettingsModel.PartitionedType, Mode=TwoWay}"
                                        SelectedValuePath="ItemValue"
                                        Style="{StaticResource ParamValueComboBoxStyle}">
                                        <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="SelectionChanged">
                                                <i:InvokeCommandAction Command="{Binding PartitionedSelectionChangedCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                    </ComboBox>
                                </UniformGrid>
                                <ScrollViewer
                                    Grid.Row="1"
                                    Margin="0,20,0,0"
                                    HorizontalScrollBarVisibility="Hidden"
                                    VerticalScrollBarVisibility="Visible">
                                    <ItemsControl ItemsSource="{Binding PartitionedModels, Mode=TwoWay}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid
                                                    Margin="0,0,0,0"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Top"
                                                    Columns="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <UniformGrid Columns="1" Rows="3">
                                                    <TextBlock
                                                        d:Text="膜区一"
                                                        Foreground="#CCFFFFFF"
                                                        Style="{StaticResource ParamNameTextBlockStyle}"
                                                        Text="{Binding PartitionedName, Mode=TwoWay}" />
                                                    <UniformGrid
                                                        MinHeight="30"
                                                        Margin="0,0,0,20"
                                                        Columns="2">
                                                        <TextBlock
                                                            Opacity="0.6"
                                                            Style="{StaticResource ParamNameTextBlockStyle}"
                                                            Text="起止位置" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBox
                                                                Grid.Column="0"
                                                                d:Text="1"
                                                                Style="{StaticResource ParamValueTextBoxStyle}"
                                                                Text="{Binding StartIndex, Mode=TwoWay}" />
                                                            <Rectangle
                                                                Grid.Column="1"
                                                                Width="20"
                                                                Height="1"
                                                                Margin="6,0"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Opacity="0.6"
                                                                Stroke="#FFFFFF" />
                                                            <TextBox
                                                                Grid.Column="2"
                                                                d:Text="1"
                                                                Style="{StaticResource ParamValueTextBoxStyle}"
                                                                Text="{Binding EndIndex, Mode=TwoWay}" />
                                                        </Grid>
                                                    </UniformGrid>
                                                    <UniformGrid
                                                        MinHeight="30"
                                                        Margin="0,0,0,20"
                                                        Columns="2">
                                                        <TextBlock
                                                            Opacity="0.6"
                                                            Style="{StaticResource ParamNameTextBlockStyle}"
                                                            Text="分区个数" />
                                                        <TextBox
                                                            d:Text="1"
                                                            Style="{StaticResource ParamValueTextBoxStyle}"
                                                            Text="{Binding PartitionedCount, Mode=TwoWay}" />
                                                    </UniformGrid>
                                                </UniformGrid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
            <Button
                Margin="0,20,20,0"
                Command="{Binding ParamSaveCommand}"
                Style="{StaticResource ParamSaveButtonStyle}" />
        </Grid>
    </Grid>
</Page>
