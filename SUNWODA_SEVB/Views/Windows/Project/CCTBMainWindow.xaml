<hc:Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CCTBMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB.FormEnums;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity;assembly=HandyControl"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Windows.Project"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Title="单机数字化平台"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    AllowsTransparency="True"
    Background="#FF121212"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  添加资源和转换器  -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />

            <Style BasedOn="{StaticResource IndustrialGrowlStyle}" TargetType="hc:Growl" />
            <Style BasedOn="{StaticResource ParamPairContentControlStyle}" TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="PairKeyWidth" Value="85" />
                <Setter Property="Margin" Value="0,0,20,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="AccountMenuItemStyle" TargetType="MenuItem">
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="5">
                                <ContentPresenter
                                    Margin="10,13"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccountButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentControl
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  顶部标题栏  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Vertical">
            <DockPanel Background="#0DFFFFFF" LastChildFill="True">
                <TextBlock
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontStretch="{Binding FontStretch, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                    Opacity="0.8"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                    TextAlignment="Center" />
                <StackPanel
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Click="Minimize_Click"
                        Content="&#xe679;"
                        Style="{StaticResource ControlButtonStyle}" />
                    <Button
                        Click="Reduction_Click"
                        Content="&#xe6a2;"
                        Style="{StaticResource ControlButtonStyle}" />
                    <Button
                        Background="DarkRed"
                        Click="Close_Click"
                        Content="&#xe669;"
                        Style="{StaticResource ControlButtonStyle}" />
                </StackPanel>
                <Border
                    Margin="20,0,20,0"
                    Background="Transparent"
                    DockPanel.Dock="Right"
                    MouseLeftButtonDown="TopHeader_MouseLeftButtonDown"
                    MouseLeftButtonUp="TopHeader_MouseDoubleClick" />
            </DockPanel>
            <Rectangle
                Height="1"
                Opacity="0.2"
                Stroke="#CCFFFFFF" />
        </StackPanel>

        <!--  顶部状态栏  -->
        <DockPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#0DFFFFFF"
            LastChildFill="False">
            <Image
                Height="40"
                Margin="20,0,0,0"
                Source="/Assets/images/logo.png"
                Stretch="Uniform" />
            <TextBlock
                Margin="20,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource CCTB.AlimamaShuHeiTi}"
                FontSize="40"
                FontWeight="Bold"
                Foreground="#FFFFFFFF"
                Opacity="0.8"
                Text="涂布控制系统" />
            <UniformGrid Margin="100,0,0,0" Rows="1">
                <uccc:DeviceStatusControl
                    Margin="0,0,10,0"
                    AcceptDeviceCount="{Binding WMDeviceStatus.AcceptDeviceCount}"
                    DeviceName="{Binding WMDeviceStatus.DeviceName}"
                    DeviceStatus="{Binding WMDeviceStatus.DeviceStatus}" />
                <uccc:DeviceStatusControl
                    Margin="0,0,10,0"
                    AcceptDeviceCount="{Binding CMDeviceStatus.AcceptDeviceCount}"
                    DeviceName="{Binding CMDeviceStatus.DeviceName}"
                    DeviceStatus="{Binding CMDeviceStatus.DeviceStatus}" />
                <uccc:DeviceStatusControl
                    Margin="0,0,10,0"
                    AcceptDeviceCount="{Binding DHADeviceStatus.AcceptDeviceCount}"
                    DeviceName="{Binding DHADeviceStatus.DeviceName}"
                    DeviceStatus="{Binding DHADeviceStatus.DeviceStatus}" />
                <uccc:DeviceStatusControl
                    Margin="0,0,10,0"
                    AcceptDeviceCount="{Binding DHBDeviceStatus.AcceptDeviceCount}"
                    DeviceName="{Binding DHBDeviceStatus.DeviceName}"
                    DeviceStatus="{Binding DHBDeviceStatus.DeviceStatus}" />
                <uccc:DeviceStatusControl
                    Margin="0,0,10,0"
                    AcceptDeviceCount="{Binding CCDDeviceStatus.AcceptDeviceCount}"
                    DeviceName="{Binding CCDDeviceStatus.DeviceName}"
                    DeviceStatus="{Binding CCDDeviceStatus.DeviceStatus}" />
            </UniformGrid>
            <Rectangle
                Width="1"
                Height="50"
                Margin="10,0,10,0"
                VerticalAlignment="Center"
                Opacity="0.5"
                Stroke="#CCFFFFFF" />
            <UniformGrid Margin="10,10,0,10" Rows="2">
                <uccc:PairContentControl PairKeyText="A面-TD闭环">
                    <uccc:SimpleToggleButton Command="{Binding ControlSwitchoverCommand}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
                <uccc:PairContentControl PairKeyText="A面-MD闭环">
                    <uccc:SimpleToggleButton Command="{Binding ControlSwitchoverCommand}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
                <uccc:PairContentControl PairKeyText="A面-尺寸闭环">
                    <uccc:SimpleToggleButton Command="{Binding ControlSwitchoverCommand}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
                <uccc:PairContentControl PairKeyText="B面-TD闭环">
                    <uccc:SimpleToggleButton Command="{Binding ControlSwitchoverCommand}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
                <uccc:PairContentControl PairKeyText="B面-MD闭环">
                    <uccc:SimpleToggleButton Command="{Binding ControlSwitchoverCommand}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
                <uccc:PairContentControl PairKeyText="B面-尺寸闭环">
                    <uccc:SimpleToggleButton Command="{Binding ControlSwitchoverCommand}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
            </UniformGrid>

            <!--  登录用户信息  -->
            <StackPanel
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Grid>
                    <Ellipse
                        Width="40"
                        Height="40"
                        Fill="#FF29CC7A"
                        Opacity="0.1" />

                    <Button
                        x:Name="AccountButton"
                        Click="AccountButton_Click"
                        Style="{StaticResource AccountButtonStyle}">
                        <Button.Content>
                            <TextBlock
                                d:Text="小"
                                FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                                FontSize="20"
                                Foreground="#FF29CC7A"
                                Text="{Binding UserIcon}"
                                TextAlignment="Center" />
                        </Button.Content>
                        <Button.ContextMenu>
                            <ContextMenu
                                x:Name="contextMenu"
                                Background="#FF2B2B2B"
                                BorderThickness="0">
                                <MenuItem
                                    Command="{Binding ChangeAccountCommand}"
                                    Header="切换用户"
                                    Style="{StaticResource AccountMenuItemStyle}" />
                                <MenuItem
                                    Command="{Binding ChangePasswordCommand}"
                                    Header="修改密码"
                                    Style="{StaticResource AccountMenuItemStyle}"
                                    Visibility="{Binding ChangePasswordVisibility}" />
                                <MenuItem
                                    Command="{Binding LogoutCommand}"
                                    Header="退出登录"
                                    Style="{StaticResource AccountMenuItemStyle}"
                                    Visibility="{Binding LogoutVisibility}" />
                                <ContextMenu.Template>
                                    <ControlTemplate TargetType="ContextMenu">
                                        <Border
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="5">
                                            <ItemsPresenter Margin="10,13" />
                                        </Border>
                                    </ControlTemplate>
                                </ContextMenu.Template>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Button.ToolTip>
                            <TextBlock
                                MaxWidth="500"
                                Text="用户选项"
                                TextWrapping="NoWrap" />
                        </Button.ToolTip>
                    </Button>
                </Grid>

                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Text="林小小"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                    FontSize="20"
                    Foreground="#CCFFFFFF"
                    Text="{Binding UserName}"
                    TextAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!--  左侧导航栏  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Background="#0DFFFFFF"
            Orientation="Vertical">
            <RadioButton
                d:IsChecked="True"
                Command="{Binding MonitoringCommand}"
                Content="生产监控"
                IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_CCTBMonitoringPage'}"
                Style="{StaticResource MainNavigationRadioButtonStyle}"
                Tag="&#xe602;" />
            <RadioButton
                d:IsChecked="False"
                Command="{Binding SettingsCommand}"
                Content="系统设置"
                IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_CCTBSettingsPage'}"
                Style="{StaticResource MainNavigationRadioButtonStyle}"
                Tag="&#xe603;" />
            <RadioButton
                d:IsChecked="False"
                Command="{Binding RecordingsCommand}"
                Content="系统记录"
                IsChecked="{Binding SelectedModule.Name, Mode=OneWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='VM_CCTBRecordingsPage'}"
                Style="{StaticResource MainNavigationRadioButtonStyle}"
                Tag="&#xe601;" />
        </StackPanel>

        <!--  内容区  -->
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="20"
            Background="Transparent">
            <Frame
                x:Name="NavigationFrame"
                BorderThickness="0"
                Content="{Binding NavigationPage}"
                NavigationUIVisibility="Hidden" />

            <!--  Growl 专用容器  -->
            <ScrollViewer
                Width="Auto"
                Margin="0,0,0,-20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    hc:Growl.Token="ProductionMonitor" />
            </ScrollViewer>
        </Grid>
    </Grid>
</hc:Window>