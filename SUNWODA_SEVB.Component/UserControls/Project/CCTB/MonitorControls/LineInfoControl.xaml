<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.LineInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:modelcctb="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    d:DesignHeight="260"
    d:DesignWidth="350"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style
                x:Key="PPairContentStyle"
                BasedOn="{StaticResource ParamPairContentControlStyle}"
                TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="PairKeyWidth" Value="70" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <GroupBox Header="拉线信息" Style="{StaticResource SimpleGroupBoxStyle}">
            <UniformGrid Margin="60,25,60,25" Columns="1">
                <uccc:PairContentControl
                    d:Content="德阳基地"
                    Content="{Binding ParameterSource.LineBase, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PairKeyText="基地"
                    Style="{StaticResource PPairContentStyle}" />
                <uccc:PairContentControl
                    d:Content="正极"
                    Content="{Binding ParameterSource.Electrode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PairKeyText="电极"
                    Style="{StaticResource PPairContentStyle}" />
                <uccc:PairContentControl
                    d:Content="L1"
                    Content="{Binding ParameterSource.LineName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PairKeyText="拉线"
                    Style="{StaticResource PPairContentStyle}" />
                <uccc:PairContentControl
                    d:Content="2#"
                    Content="{Binding ParameterSource.DeviceName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PairKeyText="机台"
                    Style="{StaticResource PPairContentStyle}" />
                <uccc:PairContentControl
                    d:Content="127.0.0.1"
                    Content="{Binding ParameterSource.DeviceIp, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    PairKeyText="本机IP"
                    Style="{StaticResource PPairContentStyle}" />
            </UniformGrid>
        </GroupBox>
    </Grid>
</UserControl>
