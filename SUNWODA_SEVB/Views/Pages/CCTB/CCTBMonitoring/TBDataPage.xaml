<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring.TBDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:core="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.Core;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoring"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pjconvert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:uccharts="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls;assembly=SUNWODA_SEVB.Component"
    xmlns:ucdatagrids="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.DataGridControls;assembly=SUNWODA_SEVB.Component"
    Title="TBDataPage"
    d:DesignHeight="860"
    d:DesignWidth="1780"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <pjconvert:StringToBooleanConverter x:Key="StringToBooleanConverter" />
            <pjconvert:UMToReadOnlyConverter x:Key="UMToReadOnlyConverter" />
            <pjconvert:UMToVisibilityConverter x:Key="UMToVisibilityConverter" />
            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="280*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="260*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="280*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  机头A-面密度实时数据  -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="0"
            Header="机头A-面密度实时数据"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBDataChartControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamA}"
                ItemSource="{Binding CoatingDatasA}"
                ParamOptionSelectedCommand="{Binding ParamOptionSelectedCommand}"
                ParamOptionSelectedCommandParameter="{x:Static enums:ESideType.A}"
                ParamOptions="{Binding ParamOptionsA}"
                YMax="{Binding MaxOfCoatingA}"
                YMin="{Binding MinOfCoatingA}" />
        </GroupBox>
        <!--  机头B-面密度实时数据  -->
        <GroupBox
            Grid.Row="0"
            Grid.Column="2"
            Header="机头B-面密度实时数据"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBDataChartControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamB}"
                ItemSource="{Binding CoatingDatasB}"
                ParamOptionSelectedCommand="{Binding ParamOptionSelectedCommand}"
                ParamOptionSelectedCommandParameter="{x:Static enums:ESideType.B}"
                ParamOptions="{Binding ParamOptionsB}"
                YMax="{Binding MaxOfCoatingB}"
                YMin="{Binding MinOfCoatingB}" />
        </GroupBox>
        <!--  机头A-面密度实时数据列表  -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="0"
            Header="机头A-面密度实时数据列表"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <ucdatagrids:TBDataGridControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamA}"
                ItemsSource="{Binding TBDataHistoryA}" />
        </GroupBox>
        <!--  机头B-面密度实时数据列表  -->
        <GroupBox
            Grid.Row="2"
            Grid.Column="2"
            Header="机头B-面密度实时数据列表"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <ucdatagrids:TBDataGridControl
                Margin="20,10,10,20"
                DataLimitParam="{Binding TBDataLimitParamB}"
                ItemsSource="{Binding TBDataHistoryB}" />
        </GroupBox>
        <!--  机头A-T块实时位置  -->
        <GroupBox
            Grid.Row="4"
            Grid.Column="0"
            Header="机头A-T块实时位置"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBlockChartControl
                Margin="20,10,10,20"
                CenterValue="{Binding CenterValue}"
                ItemSource="{Binding TBlockDatasA}"
                YMax="{Binding MaxOfTBlock}"
                YMin="{Binding MinOfTBlock}"
                YStep="{Binding YStep}" />
        </GroupBox>
        <!--  机头B-T块实时位置  -->
        <GroupBox
            Grid.Row="4"
            Grid.Column="2"
            Header="机头B-T块实时位置"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <uccharts:TBlockChartControl
                Margin="20,10,10,20"
                CenterValue="{Binding CenterValue}"
                ItemSource="{Binding TBlockDatasB}"
                YMax="{Binding MaxOfTBlock}"
                YMin="{Binding MinOfTBlock}"
                YStep="{Binding YStep}" />
        </GroupBox>
    </Grid>
</Page>
