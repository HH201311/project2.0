<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JROH.MCOfJROHPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:jrohuc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JROH;assembly=SUNWODA_SEVB.Component"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JROH"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="MCOfJROHPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JROH/JROHCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style BasedOn="{StaticResource SimpleGroupBoxStyle}" TargetType="GroupBox" />
            <Style BasedOn="{StaticResource SimpleDataGridStyle}" TargetType="DataGrid" />

            <!--  曲线图统一外观：每组每个通道一个图  -->
            <Style TargetType="{x:Type jrohuc:MultiCorrectPlot}">
                <Setter Property="Margin" Value="2" />
                <Setter Property="ShowGrid" Value="True" />
                <Setter Property="ShowLegend" Value="True" />
                <Setter Property="YAxisLabel" Value="纠偏值 (mm)" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="240" />
        </Grid.RowDefinitions>

        <!--  曲线区：3 组（正极 5 路 / 负极 4 路 / 隔膜 2 路），每组每个通道一个曲线图，数据源为 VM 中的 11 路采集集合  -->
        <TabControl Grid.Row="0">
            <TabItem Header="正极纠偏控制">
                <UniformGrid
                    Margin="4"
                    Columns="3"
                    Rows="2">
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding InfeedOfPosSeries1}"
                        LineSeries2Collection="{Binding InfeedOfPosSeries2}"
                        Title="正极入料纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake4OfPosSeries1}"
                        LineSeries2Collection="{Binding Snake4OfPosSeries2}"
                        Title="正极蛇形4纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake3OfPosSeries1}"
                        LineSeries2Collection="{Binding Snake3OfPosSeries2}"
                        Title="正极蛇形3纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake2OfPosSeries1}"
                        LineSeries2Collection="{Binding Snake2OfPosSeries2}"
                        Title="正极蛇形2纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake1OfPosSeries1}"
                        LineSeries2Collection="{Binding Snake1OfPosSeries2}"
                        Title="正极蛇形1纠偏曲线" />
                </UniformGrid>
            </TabItem>

            <TabItem Header="负极纠偏控制">
                <UniformGrid
                    Margin="4"
                    Columns="2"
                    Rows="2">
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding InfeedOfNegSeries1}"
                        LineSeries2Collection="{Binding InfeedOfNegSeries2}"
                        Title="负极入料纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake3OfNegSeries1}"
                        LineSeries2Collection="{Binding Snake3OfNegSeries2}"
                        Title="负极蛇形3纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake2OfNegSeries1}"
                        LineSeries2Collection="{Binding Snake2OfNegSeries2}"
                        Title="负极蛇形2纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding Snake1OfNegSeries1}"
                        LineSeries2Collection="{Binding Snake1OfNegSeries2}"
                        Title="负极蛇形1纠偏曲线" />
                </UniformGrid>
            </TabItem>

            <TabItem Header="隔膜纠偏控制">
                <UniformGrid
                    Margin="4"
                    Columns="2"
                    Rows="1">
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding UpperDiaSeries1}"
                        LineSeries2Collection="{Binding UpperDiaSeries2}"
                        Title="上隔膜纠偏曲线" />
                    <jrohuc:MultiCorrectPlot
                        LineSeries1Collection="{Binding LowerDiaSeries1}"
                        LineSeries2Collection="{Binding LowerDiaSeries2}"
                        Title="下隔膜纠偏曲线" />
                </UniformGrid>
            </TabItem>
        </TabControl>

        <!--  调机日志（与曲线区同为 3 组）  -->
        <Grid
            Grid.Row="1"
            Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="0,0,0,10"
                LastChildFill="False">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="调机日志" />
                <Button
                    Command="{Binding BusinessParamCommand}"
                    Content="参数配置"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SimpleButtonStyle}"
                    Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}" />
            </DockPanel>
            <!--  调机记录  -->
            <TabControl Grid.Row="1">
                <TabItem Header="正极纠偏控制">
                    <DataGrid ItemsSource="{Binding PosRecordsView}" />
                </TabItem>
                <TabItem Header="负极纠偏控制">
                    <DataGrid ItemsSource="{Binding NegRecordsView}" />
                </TabItem>
                <TabItem Header="隔膜纠偏控制">
                    <DataGrid ItemsSource="{Binding DiaphragmRecordsView}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
