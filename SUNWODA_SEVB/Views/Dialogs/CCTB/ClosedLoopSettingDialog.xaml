<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.ClosedLoopSettingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Width="Auto"
    Height="Auto"
    MinWidth="1292"
    MinHeight="410"
    d:Height="1050"
    d:Width="1630"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:ConfigToVisibilityMultiValueConverter x:Key="ConfigToVisibilityMultiValueConverter" />

            <!--  标题样式  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  文本样式  -->
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="{x:Type hc:TextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="260" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="160" />
            </Style>

            <!--  下拉框样式  -->
            <Style BasedOn="{StaticResource HCParamComboBoxStyle}" TargetType="{x:Type hc:ComboBox}">
                <Setter Property="Width" Value="260" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="160" />
            </Style>

            <!--  键值对容器样式  -->
            <Style BasedOn="{StaticResource ParamPairContentControlStyle}" TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="Width" Value="260" />
                <Setter Property="PairKeyWidth" Value="140" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!--  开关样式  -->
            <Style
                x:Key="PVSimpleToggleButtonStyle"
                BasedOn="{StaticResource ParamValueSimpleToggleButtonStyle}"
                TargetType="{x:Type uccc:SimpleToggleButton}">
                <Setter Property="Width" Value="50" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="CheckedText" Value="是" />
                <Setter Property="UnCheckedText" Value="否" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20,0,20,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel
            Grid.Row="0"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource TitleTextBlockStyle}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}面-{1}闭环算法设置">
                        <Binding FallbackValue="x" Path="SideType" />
                        <Binding FallbackValue="xxxx" Path="ClosedLoopType" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource IconClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <WrapPanel Grid.Row="1" Margin="0,0,-20,0">
            <GroupBox
                d:Visibility="Visible"
                Header="异常数据设置"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                <x:Static Member="enums:EClosedLoopType.MD" />
                                <x:Static Member="enums:EClosedLoopType.TD" />
                                <x:Static Member="enums:EClosedLoopType.MDTD" />
                            </x:Array>
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="速度判异-走带速度"
                        Text="{Binding ClosedLoopSettingModel.Rid_VelocityCondition, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="阈值判异-剔除规格"
                        Text="{Binding ClosedLoopSettingModel.Rid_Threshold, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="阈值判异-判异个数"
                        Text="{Binding ClosedLoopSettingModel.Rid_Count, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="间隔个数"
                        Text="{Binding ClosedLoopSettingModel.Rid_Interval, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="开机判断设置"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                <x:Static Member="enums:EClosedLoopType.MD" />
                                <x:Static Member="enums:EClosedLoopType.TD" />
                                <x:Static Member="enums:EClosedLoopType.MDTD" />
                            </x:Array>
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <uccc:PairContentControl PairKeyText="开机判定">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                d:IsChecked="True"
                                Command="{Binding SelectBootUpTypeCommand}"
                                CommandParameter="{x:Static enums:EBootUpType.DataNumber}"
                                Content="趟数"
                                IsChecked="{Binding ClosedLoopSettingModel.BootUp_EBootUpType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EBootUpType.DataNumber}}"
                                Style="{StaticResource ParamValueRadioButtonStyle}" />
                            <Rectangle Width="10" />
                            <RadioButton
                                d:IsChecked="False"
                                Command="{Binding SelectBootUpTypeCommand}"
                                CommandParameter="{x:Static enums:EBootUpType.Time}"
                                Content="时间"
                                IsChecked="{Binding ClosedLoopSettingModel.BootUp_EBootUpType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static enums:EBootUpType.Time}}"
                                Style="{StaticResource ParamValueRadioButtonStyle}" />
                        </StackPanel>
                    </uccc:PairContentControl>
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="开机判定参数(趟数)"
                        Text="{Binding ClosedLoopSettingModel.BootUp_ZeroCount, Mode=TwoWay}"
                        Visibility="{Binding ClosedLoopSettingModel.BootUp_EBootUpType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:EBootUpType.DataNumber}}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="开机判定参数(时间s)"
                        Text="{Binding ClosedLoopSettingModel.BootUp_EBootUpType, Mode=TwoWay}"
                        Visibility="{Binding ClosedLoopSettingModel.BootUp_BootTime, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static enums:EBootUpType.DataNumber}}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="开机剔除躺数"
                        Text="{Binding ClosedLoopSettingModel.BootUp_RidCount, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="算法信息配置"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                <x:Static Member="enums:EClosedLoopType.MD" />
                                <x:Static Member="enums:EClosedLoopType.TD" />
                                <x:Static Member="enums:EClosedLoopType.MDTD" />
                            </x:Array>
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="入参躺数"
                        Text="{Binding ClosedLoopSettingModel.Arithmetic_InputDataCount, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="调机下发配置"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                <x:Static Member="enums:EClosedLoopType.MD" />
                                <x:Static Member="enums:EClosedLoopType.TD" />
                                <x:Static Member="enums:EClosedLoopType.MDTD" />
                            </x:Array>
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="泵速下发系数"
                        Text="{Binding ClosedLoopSettingModel.SetB_Coefficient, Mode=TwoWay}">
                        <hc:TextBox.Visibility>
                            <Binding Converter="{StaticResource EnumToVisibilityConverter}" Path="ClosedLoopType">
                                <Binding.ConverterParameter>
                                    <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                        <x:Static Member="enums:EClosedLoopType.MD" />
                                        <x:Static Member="enums:EClosedLoopType.MDTD" />
                                    </x:Array>
                                </Binding.ConverterParameter>
                            </Binding>
                        </hc:TextBox.Visibility>
                    </hc:TextBox>
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="T块下发系数"
                        Text="{Binding ClosedLoopSettingModel.SetT_Coefficient, Mode=TwoWay}">
                        <hc:TextBox.Visibility>
                            <Binding Converter="{StaticResource EnumToVisibilityConverter}" Path="ClosedLoopType">
                                <Binding.ConverterParameter>
                                    <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                        <x:Static Member="enums:EClosedLoopType.TD" />
                                        <x:Static Member="enums:EClosedLoopType.MDTD" />
                                    </x:Array>
                                </Binding.ConverterParameter>
                            </Binding>
                        </hc:TextBox.Visibility>
                    </hc:TextBox>
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="MA运算设置"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <uccc:PairContentControl PairKeyText="流量趋势计算MA使能">
                        <uccc:SimpleToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ClosedLoopSettingModel.IsEnableFlowTrendMA, Mode=TwoWay}"
                            Style="{StaticResource PVSimpleToggleButtonStyle}" />
                    </uccc:PairContentControl>
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="取值个数"
                        Text="{Binding ClosedLoopSettingModel.EWMA_Count, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="阈值判定"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="调节阈值"
                        Text="{Binding ClosedLoopSettingModel.JudgThreshold_Threshold, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="判定范围"
                        Text="{Binding ClosedLoopSettingModel.JudgThreshold_Range, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="累计个数"
                        Text="{Binding ClosedLoopSettingModel.JudgThreshold_Count, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="趋势判定"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="连续个数"
                        Text="{Binding ClosedLoopSettingModel.JudgTrend_Count, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="位置判定"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="调节阈值"
                        Text="{Binding ClosedLoopSettingModel.JudgPosition_Threshold, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="连续个数"
                        Text="{Binding ClosedLoopSettingModel.JudgPosition_Count, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="比例判定"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="调节阈值"
                        Text="{Binding ClosedLoopSettingModel.JudgRatio_Threshold, Mode=TwoWay}" />
                    <uccc:PairContentControl PairKeyText="判定值">
                        <Slider
                            d:Value="0.5"
                            IsSnapToTickEnabled="True"
                            LargeChange="0.1"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Style="{StaticResource ParamHorizontalSliderTextStyle}"
                            TickFrequency="0.01"
                            Value="{Binding ClosedLoopSettingModel.JudgRatio_Ratio, Mode=TwoWay}" />
                    </uccc:PairContentControl>
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="判定范围"
                        Text="{Binding ClosedLoopSettingModel.JudgRatio_Range, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="累计个数"
                        Text="{Binding ClosedLoopSettingModel.JudgRatio_Count, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="动态判定"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <uccc:PairContentControl PairKeyText="动态判定">
                        <Slider
                            d:Value="99"
                            IsSnapToTickEnabled="True"
                            LargeChange="10"
                            Maximum="100"
                            Minimum="0"
                            SmallChange="1"
                            Style="{StaticResource ParamHorizontalSliderTextStyle}"
                            TickFrequency="1"
                            Value="{Binding ClosedLoopSettingModel.JudgDynamic_Value, Mode=TwoWay}" />
                    </uccc:PairContentControl>
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="流量趋势判定"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <uccc:PairContentControl PairKeyText="流量趋势判定使能">
                        <uccc:SimpleToggleButton
                            d:IsChecked="False"
                            IsChecked="{Binding ClosedLoopSettingModel.JudgFluTrend_IsEnable, Mode=TwoWay}"
                            Style="{StaticResource PVSimpleToggleButtonStyle}" />
                    </uccc:PairContentControl>
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="连续个数"
                        Text="{Binding ClosedLoopSettingModel.JudgFluTrend_Count, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="流量趋势变化阈值"
                        Text="{Binding ClosedLoopSettingModel.JudgFluTrend_VariationThreshold, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="上下流量趋势阈值"
                        Text="{Binding ClosedLoopSettingModel.JudgFluTrend_BoundaryThreshold, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="极差拦截"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="极差拦截阈值"
                        Text="{Binding ClosedLoopSettingModel.JudgRange_Threshold, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="泵速拦截"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Static Member="enums:EClosedLoopType.MD" />
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <uccc:PairContentControl PairKeyText="泵速调节区间">
                        <Slider
                            d:Value="0.02"
                            IsSnapToTickEnabled="True"
                            LargeChange="0.1"
                            Maximum="1"
                            Minimum="0"
                            SmallChange="0.01"
                            Style="{StaticResource ParamHorizontalSliderTextStyle}"
                            TickFrequency="0.01"
                            Value="{Binding ClosedLoopSettingModel.JudgSpeed_Range, Mode=TwoWay}" />
                    </uccc:PairContentControl>
                </StackPanel>
            </GroupBox>
            <GroupBox
                d:Visibility="Visible"
                Header="目标值设置"
                Style="{StaticResource ParamGroupBoxStyle}">
                <GroupBox.Visibility>
                    <MultiBinding Converter="{StaticResource ConfigToVisibilityMultiValueConverter}">
                        <MultiBinding.ConverterParameter>
                            <x:Array xmlns:sys="clr-namespace:System;assembly=mscorlib" Type="sys:Object">
                                <x:Static Member="enums:EClosedLoopType.MD" />
                                <x:Static Member="enums:EClosedLoopType.TD" />
                                <x:Static Member="enums:EClosedLoopType.MDTD" />
                            </x:Array>
                        </MultiBinding.ConverterParameter>
                        <Binding Path="ClosedLoopType" />
                    </MultiBinding>
                </GroupBox.Visibility>
                <StackPanel Margin="20,0,20,20">
                    <uccc:PairContentControl PairKeyText="使用动态目标值">
                        <uccc:SimpleToggleButton
                            d:IsChecked="False"
                            IsChecked="{Binding ClosedLoopSettingModel.IsUseDynamicTargetValue, Mode=TwoWay}"
                            Style="{StaticResource PVSimpleToggleButtonStyle}" />
                    </uccc:PairContentControl>
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="净重目标值设置"
                        Text="{Binding ClosedLoopSettingModel.TChange, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="260"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="目标值偏移量设置"
                        Text="{Binding ClosedLoopSettingModel.TOffset, Mode=TwoWay}" />
                </StackPanel>
            </GroupBox>
        </WrapPanel>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button
                Margin="10,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="确认"
                Style="{StaticResource ParamOKButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding CancleCommand}"
                Content="取消"
                Style="{StaticResource ParamCancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

