<Window
    x:Class="SUNWODA_SEVB.Views.Pages.ZZSIX.Pack6NgAlarmWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pack六面检测缺陷报警"
    Width="820"
    Height="520"
    MinWidth="720"
    MinHeight="480"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    ShowInTaskbar="True"
    ResizeMode="NoResize"
    Background="White"
    Closing="OnClosing"
    Loaded="OnLoaded">

    <Grid Margin="24,16,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <!-- 缺陷文案限高可滚，避免挤掉扫码区 -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶：logo + 时间 -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image
                    Width="56"
                    Height="56"
                    Margin="0,0,10,0"
                    Stretch="Uniform"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.png" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="#FFE53935"
                        Text="SEVB" />
                    <TextBlock
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#FF666666"
                        Text="欣旺达动力" />
                </StackPanel>
            </StackPanel>
            <TextBlock
                x:Name="AlarmTimeText"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="36"
                FontWeight="Bold"
                Foreground="#FFE53935"
                Text="----/--/-- --:--:--" />
        </Grid>

        <!-- 产品编码 -->
        <StackPanel Grid.Row="1" Margin="0,12,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                VerticalAlignment="Center"
                Text="产品编码 (SN):" />
            <TextBlock
                x:Name="ProductSnText"
                Margin="16,0,0,0"
                FontSize="22"
                FontWeight="SemiBold"
                VerticalAlignment="Center"
                Text="-" />
        </StackPanel>

        <!-- 缺陷类型标题 -->
        <TextBlock
            Grid.Row="2"
            Margin="0,16,0,8"
            HorizontalAlignment="Center"
            FontSize="22"
            FontWeight="Bold"
            Text="缺陷类型:" />

        <!-- 缺陷正文：ScrollViewer 自带 MaxHeight，才能真正滚动 -->
        <Border
            Grid.Row="3"
            Margin="24,0"
            Padding="12,8"
            BorderBrush="#FFE0E0E0"
            BorderThickness="1"
            CornerRadius="4"
            Background="#FFFAFAFA">
            <ScrollViewer
                MaxHeight="148"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                CanContentScroll="False">
                <TextBlock
                    x:Name="DefectTypeText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="#FFE53935"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Text="-" />
            </ScrollViewer>
        </Border>

        <!-- 扫码输入：固定底部，不被缺陷文案挤掉 -->
        <StackPanel Grid.Row="4" Margin="40,20,40,0">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Text="SN码 (扫码枪扫描):" />
            <TextBox
                x:Name="ScanInputBox"
                Height="48"
                Margin="0,12,0,0"
                Padding="10,8"
                FontSize="20"
                VerticalContentAlignment="Center"
                BorderBrush="#FFBDBDBD"
                BorderThickness="2"
                TextChanged="OnScanTextChanged"
                PreviewKeyDown="OnScanPreviewKeyDown" />
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="#FF4CAF50"
                Text="等待扫描二维码，请务必切换成英文输入！" />
        </StackPanel>
    </Grid>
</Window>
