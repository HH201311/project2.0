<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JROH.OHOfJROHPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:jrohuc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JROH;assembly=SUNWODA_SEVB.Component"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JROH"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="OHOfJROHPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JROH/JROHCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style BasedOn="{StaticResource SimpleGroupBoxStyle}" TargetType="GroupBox" />
            <Style BasedOn="{StaticResource SimpleDataGridStyle}" TargetType="DataGrid" />
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="hc:TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="hc:InfoElement.Necessary" Value="False" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="100" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="4*" />
        </Grid.ColumnDefinitions>
        <Viewbox>
            <Grid Margin="5">
                <Path Data="M80,25 L75,0 L65,0 L60,25 Z" Fill="Green" />
                <Path Data="M20,25 L25,0 L35,0 L40,25 Z" Fill="Yellow" />
                <Path Data="M0,100 L100,100 L100,25 L0,25 Z" Fill="DarkBlue" />
            </Grid>
        </Viewbox>
        <UniformGrid
            Grid.Column="1"
            Margin="0,0,20,0"
            Rows="4">
            <hc:TextBox
                d:Text="100"
                hc:InfoElement.Title="顶部SA"
                Text="{Binding SAOfTop}" />
            <hc:TextBox
                d:Text="100"
                hc:InfoElement.Title="顶部AC"
                Text="{Binding SAOfTop}" />
            <hc:TextBox
                d:Text="100"
                hc:InfoElement.Title="底部AC"
                Text="{Binding SAOfTop}" />
            <hc:TextBox
                d:Text="100"
                hc:InfoElement.Title="底部SA"
                Text="{Binding SAOfTop}" />
        </UniformGrid>
        <!--  包覆OH极值曲线  -->
        <jrohuc:CoatedOHPlot
            Title="包覆OH极值曲线"
            Grid.Column="2"
            Line1SeriesCollection="{Binding MinSeriesOfTop}"
            Line2SeriesCollection="{Binding MaxSeriesOfTop}"
            Line3SeriesCollection="{Binding MinSeriesOfBottom}"
            Line4SeriesCollection="{Binding MaxSeriesOfBottom}"
            ShowGrid="True"
            ShowLegend="True"
            YAxisLabel="OH值 (mm)" />
        <Grid
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,20,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                LastChildFill="False">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="调机日志" />
                <Button
                    Command="{Binding BusinessParamCommand}"
                    Content="参数配置"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SimpleButtonStyle}"
                    Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}" />
            </DockPanel>
            <!--  调机记录  -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding AdjustmentRecordsView}" />
        </Grid>
    </Grid>
</Page>
