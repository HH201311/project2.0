<Page x:Class="SUNWODA_SEVB.Views.Pages.PTO.PTODamageDetectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.PTO"
      xmlns:vm="clr-namespace:SUNWODA_SEVB.ViewModels.Pages.PTO"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
      mc:Ignorable="d" 
      d:DesignHeight="1080" d:DesignWidth="1920" FontSize="15"
      Title="PTODamageDetectionPage">
    <Page.Resources>
        <vm:VM_PTODamageDetectionPage x:Key="DamageDetectionVM"/>
    </Page.Resources>

    <Grid DataContext="{StaticResource DamageDetectionVM}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题行 -->
        <Grid Grid.Row="0" Background="LightGray"  Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <!-- logo图片 -->
                <Image Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.png" MaxWidth="80" MaxHeight="90"/>
                <!-- 项目名称文本 -->
                <TextBlock Text="PTO叠片 AI检测系统V1.0" 
                   FontSize="35" FontWeight="Bold" 
                   Foreground="Black" VerticalAlignment="Center" MinWidth="400"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.9*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <!-- 左列：标题区域 -->
                <Border Grid.Column="0" Background="White"  BorderBrush="#E0E0E0" BorderThickness="1" Margin="0 0 0 0">
                    <StackPanel Orientation="Vertical" Margin="0">
                        <TextBlock Text="叠片缺陷AI检测界面" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" Margin="20 0 0 0"/>
                    </StackPanel>
                </Border>
                <!-- 实时检测图 + 进度条 -->
                <Border Grid.Row="1" 
                        Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        Margin="0">
                    <Grid ClipToBounds="True" Background="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0"
                                   Text="实时检测" 
                                   FontSize="16" 
                                   FontWeight="SemiBold" 
                                   Foreground="#2C3E50" 
                                   Margin="10,10,0,10"/>

                        <Image Grid.Row="1"
                               x:Name="ImgRealTimeDetect" 
                               Stretch="Uniform"
                            MaxHeight="540"
                               MaxWidth="1100" 
                            Margin="10"
                               Source="{Binding CurrentResultImage}" 
                               RenderTransformOrigin="0.5,0.5">

                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform 
                                    ScaleX="{Binding RealTimeImageScaleX}" 
                                    ScaleY="{Binding RealTimeImageScaleY}"/>
                                    <TranslateTransform 
                                    X="{Binding RealTimeImageTranslateX}" 
                                    Y="{Binding RealTimeImageTranslateY}"/>
                                </TransformGroup>
                            </Image.RenderTransform>

                            <behaviors:Interaction.Triggers>
                                <!-- 滚轮缩放命令 -->
                                <behaviors:EventTrigger EventName="MouseWheel">
                                    <behaviors:InvokeCommandAction 
                                            Command="{Binding ZoomRealTimeImageCommand}" 
                                            PassEventArgsToCommand="True"/>
                                </behaviors:EventTrigger>
                                <!-- 鼠标按下命令 -->
                                <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                    <behaviors:InvokeCommandAction 
                                            Command="{Binding ImageMouseDownCommand}" 
                                            PassEventArgsToCommand="True"/>
                                </behaviors:EventTrigger>
                                <!--鼠标移动命令 -->
                                <behaviors:EventTrigger EventName="MouseMove">
                                    <behaviors:InvokeCommandAction 
                                            Command="{Binding ImageMouseMoveCommand}" 
                                            PassEventArgsToCommand="True"/>
                                </behaviors:EventTrigger>
                                <!--鼠标松开命令 -->
                                <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                    <behaviors:InvokeCommandAction 
                                        Command="{Binding ImageMouseUpCommand}" 
                                        PassEventArgsToCommand="True"/>
                                </behaviors:EventTrigger>
                                <!-- 鼠标离开控件-->
                                <behaviors:EventTrigger EventName="MouseLeave">
                                    <behaviors:InvokeCommandAction 
                                            Command="{Binding ImageMouseUpCommand}" 
                                            PassEventArgsToCommand="True"/>
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>
                            <!-- 图片上双击还原-->
                            <Image.InputBindings>
                                <MouseBinding 
                                            MouseAction="LeftDoubleClick" 
                                            Command="{Binding ResetRealTimeImageZoomCommand}"/>
                            </Image.InputBindings>
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommand}"/>
                                    <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommand}"/>
                                    <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommand}"/>
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="放大" Command="{Binding ZoomInRealTimeCommand}"/>
                                <MenuItem Header="缩小" Command="{Binding ZoomOutRealTimeCommand}"/>
                                <MenuItem Header="适应窗口" Command="{Binding ResetRealTimeImageZoomCommand}"/>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Grid.InputBindings>
                            <MouseBinding 
                                MouseAction="LeftDoubleClick" 
                                Command="{Binding ResetRealTimeImageZoomCommand}"/>
                        </Grid.InputBindings>
                    </Grid>
                </Border>

                <Border Grid.Row="2" 
                        Background="White" 
                        BorderBrush="#E0E0E0" 
                        BorderThickness="1" 
                        Margin="0,0,0,0"
                        Visibility="{Binding IsOfflineProgressVisible}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Text="离线进度条" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#333" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,15,0"/>

                        <ProgressBar Grid.Column="1" 
                                     x:Name="PbOfflineProgress" 
                                     Minimum="0" 
                                     Maximum="100" 
                                     Value="{Binding OfflineProgressValue, FallbackValue=0}" 
                                     Height="20" 
                                     Foreground="Red"
                                     Background="#E0E0E0" 
                                     Margin="0,0,15,0"/>

                        <TextBlock Grid.Column="2" 
                                   Text="{Binding OfflineProgressTip}"
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="#333" 
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <!-- 日志区域：DataGrid表格形式-->
                <Border Grid.Row="3" BorderBrush="Black" BorderThickness="1" Margin="0"
                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="系统日志" FontWeight="Bold" FontSize="20" Margin="0,0,0,0"/>
                        <DataGrid 
                            x:Name="LogDataGrid"
                            Grid.Row="1"
                            ItemsSource="{Binding LogTable, Mode=OneWay}" 
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            RowHeaderWidth="0"
                            HeadersVisibility="None"
                            Background="White"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            RowHeight="24">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn 
                                    Binding="{Binding Item1}" 
                                    Width="180" 
                                    IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <!-- 时间居中 -->
                                        </Style>

                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn 
                                        Binding="{Binding Item2}" 
                                        Width="1000"
                                        IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Padding" Value="5,2"/>
                                            <Setter Property="ToolTip" Value="{Binding Item2}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <TextBlock 
                                                        Text="{Binding Item2}" 
                                                        Foreground="{TemplateBinding Foreground}"
                                                        FontSize="{TemplateBinding FontSize}"
                                                        Padding="{TemplateBinding Padding}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>


            <!-- 右侧：数据/设置面板/状态信息面板 -->
            <Border Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,0,0">
                <TabControl Margin="0" Height="Auto">
                    <!-- 「数据」标签页 -->
                    <TabItem Header="生产统计" FontSize="25" >
                        <Grid Margin="0" Height="Auto">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*"/>
                                <RowDefinition Height="1.3*"/>
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="DgDetection" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                        RowHeaderWidth="0"
                                        AlternationCount="2"
                                      HorizontalAlignment="Stretch" 
                                      VerticalAlignment="Stretch"
                                Margin="0,0,0,0" Height="Auto"
                                        HorizontalScrollBarVisibility="Auto" ItemsSource="{Binding DetectionDataList}" Grid.ColumnSpan="2" 
                                        SelectedItem="{Binding SelectedDetectionData}"
                                      CanUserSortColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn 
                                        Header="图片名" 
                                        Binding="{Binding ImageName}"  
                                        Width="*" 
                                        MinWidth="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="FontSize" Value="10"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn 
                                            Header="正负极" 
                                            Binding="{Binding Polarity}" 
                                            Width="0.9*" 
                                            MinWidth="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="15"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>


                                    <DataGridTextColumn 
                                        Header="工位" 
                                        Binding="{Binding Camerainformation}" 
                                        Width="0.8" 
                                        MinWidth="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="15"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn 
                                    Header="检测结果" 
                                    Binding="{Binding DetectionResult}" 
                                    Width="1.1*" 
                                    MinWidth="125">
                                        <!-- 结果文字颜色：OK绿色，NG红色 -->
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="15"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="NG">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!-- 查看结果按钮列 -->
                                    <DataGridTemplateColumn Header="查看结果" Width="1.1*" MinWidth="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="查看" 
                                            Command="{Binding DataContext.ViewResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <!-- 跳转存储按钮列 -->
                                    <DataGridTemplateColumn Header="跳转存储" Width="1.1*" MinWidth="125">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="跳转" 
                                            Command="{Binding DataContext.JumpToStorageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,0" Grid.RowSpan="2"/>

                            <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Margin="0,5,0,0" MaxHeight="400" Grid.RowSpan="2">
                                <StackPanel Margin="10">
                                    <TextBlock 
                                            Text="负极缺陷检测信息" 
                                            FontWeight="Bold" 
                                            FontSize="20" 
                                            Foreground="DarkBlue"
                                            HorizontalAlignment="Center" 
                                            Margin="0,0,0,15"/>

                                    <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <Grid>
                                            <Grid.Resources>

                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Black"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                    <Setter Property="Padding" Value="10"/>
                                                </Style>
                                            </Grid.Resources>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 行1 -->
                                            <Border Grid.Row="0" Grid.Column="0">
                                                <TextBlock Text="总检测数" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="0" Grid.Column="1" BorderThickness="0,0,0,1">
                                                <TextBlock Text="OK数" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 行2 -->
                                            <Border Grid.Row="1" Grid.Column="0">
                                                <TextBlock Text="{Binding TotalNeDetectionCount}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="1" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{Binding OKCount}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 行3 -->
                                            <Border Grid.Row="2" Grid.Column="0">
                                                <TextBlock Text="NG数" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="1" BorderThickness="0,0,0,1">
                                                <TextBlock Text="一次优率" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- 行4 -->
                                            <Border Grid.Row="3" Grid.Column="0" BorderThickness="0,0,1,0">
                                                <TextBlock Text="{Binding NGCount}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="3" Grid.Column="1" BorderThickness="0">
                                                <TextBlock Text="{Binding OKRate, StringFormat={}{0:F2}%}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,40,0,0">
                                        <Button 
                                            Content="停止检测" 
                                            FontSize="16" 
                                            Width="120" 
                                            Height="35" 
                                            Background="#F5B0"
                                            Foreground="Black"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            Command="{Binding StopDetectionCommand}"
                                            Margin="0,0,40,0"/>

                                        <Button 
                                            Content="清空列表" 
                                            FontSize="16" 
                                            Width="120" 
                                            Height="35" 
                                            Background="#F5B041"
                                            Foreground="Black"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            Command="{Binding ClearListCommand}"
                                            Margin="0,0,20,0"/>

                                        <Button 
                                                Content="统计清零" 
                                                FontSize="16" 
                                                Width="120" 
                                                Height="35" 
                                                Background="#F5B041"
                                                Foreground="Black"
                                                BorderBrush="Gray"
                                                BorderThickness="1"
                                                Command="{Binding ClearStatisticsCommand}"
                                                Margin="20,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="参数设定" FontSize="25">
                        <StackPanel Margin="10,0,10,0" Height="Auto" VerticalAlignment="Top">
                            <!-- A工位路径 -->
                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                <TextBlock Text="A工位监听路径：" FontWeight="Bold" VerticalAlignment="Center" Width="Auto"/>
                                <TextBox 
                                    Text="{Binding SelectedMonitorFolderPathA, Mode=TwoWay}" 
                                    IsEnabled="{Binding IsInAnyDetectionA}"
                                    Width="200" Height="30" 
                                    Margin="5,0" 
                                    BorderBrush="#CCCCCC" BorderThickness="1" 
                                    FontSize="18"/>
                                <Button 
                                    Content="浏览..." 
                                    Command="{Binding SelectMonitorFolderCommandA}" 
                                    IsEnabled="{Binding IsInAnyDetectionA}"
                                    Width="60" Height="30" 
                                    Margin="5,0" 
                                    Background="#5DADE2" Foreground="White"
                                    BorderThickness="0"/>
                            </StackPanel>
                            <!-- B工位路径-->
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="B工位监听路径：" FontWeight="Bold" VerticalAlignment="Center" Width="Auto"/>
                                <TextBox 
                                    Text="{Binding SelectedMonitorFolderPathB, Mode=TwoWay}" 
                                    IsEnabled="{Binding IsInAnyDetectionB}"
                                    Width="200" Height="30" 
                                    Margin="5,0" 
                                    BorderBrush="#CCCCCC" BorderThickness="1" 
                                    FontSize="18"/>
                                <Button 
                                    Content="浏览..." 
                                    Command="{Binding SelectMonitorFolderCommandB}" 
                                    IsEnabled="{Binding IsInAnyDetectionB}"
                                    Width="60" Height="30" 
                                    Margin="5,0" 
                                    Background="#5DADE2" Foreground="White"
                                    BorderThickness="0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,20,0,0" VerticalAlignment="Center">
                                <TextBlock Text="在线检测：" FontWeight="Bold" Width="Auto" Margin="0,0,10,0"/>

                                <!-- A工位开关 -->
                                <ToggleButton 
                                            FontSize="15"
                                            Height="30"
                                            IsChecked="{Binding IsOnlineDetectionEnabledA, Mode=TwoWay}" 
                                            IsEnabled="{Binding IsOnlineToggleEnabledA}" 
                                            Margin="0,0,20,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonSwitch.Small}">
                                            <Setter Property="Content" Value="A工位已关闭"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Content" Value="A工位已打开"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                                    <Setter Property="Content" Value="A工位已关闭"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>

                                <!-- B工位开关-->
                                <ToggleButton 
                                            FontSize="15"
                                            Height="30"
                                            IsChecked="{Binding IsOnlineDetectionEnabledB, Mode=TwoWay}" 
                                            IsEnabled="{Binding IsOnlineToggleEnabledB}" 
                                            Margin="0,0,0,0">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonSwitch.Small}">
                                            <Setter Property="Content" Value="B工位已关闭"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Content" Value="B工位已打开"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                                    <Setter Property="Content" Value="B工位已关闭"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*"/>
                                    <ColumnDefinition Width="*"/>

                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="图像检索：" FontWeight="Bold" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="工位:" Grid.Column="0" VerticalAlignment="Center" FontSize="25" Margin="0,0,23,0"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
                                            <CheckBox Content="正极" IsChecked="{Binding IsPositive, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"/>
                                            <CheckBox Content="负极" IsChecked="{Binding IsNegative, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"/>
                                        </StackPanel>
                                        <TextBlock Text="相机：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontSize="25"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">
                                            <CheckBox Content="相机1" IsChecked="{Binding IsCamera1, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"/>
                                            <CheckBox Content="相机2" IsChecked="{Binding IsCamera2, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical" Margin="20,0,0,0">
                                            <CheckBox Content="相机3" IsChecked="{Binding IsCamera3, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"/>
                                            <CheckBox Content="相机4" IsChecked="{Binding IsCamera4, Mode=TwoWay}" IsEnabled="{Binding IsInAnyDetection}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="图像存储：" FontWeight="Bold" Margin="0,0,0,10" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="原图:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" FontSize="25" Margin="0,0,0,0"/>
                                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical" Margin="0,0,0,0">
                                            <CheckBox Content="OK" IsChecked="{Binding IsSaveOriginalOK}" IsEnabled="{Binding IsInAnyDetection}"/>
                                            <CheckBox Content="NG" IsChecked="{Binding IsSaveOriginalNG}" IsEnabled="{Binding IsInAnyDetection}"/>
                                        </StackPanel>

