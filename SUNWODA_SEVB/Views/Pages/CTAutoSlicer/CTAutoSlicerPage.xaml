<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CTAutoSlicer.CTAutoSlicerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CTAutoSlicer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    Title="CTAutoSlicerPage"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CTAutoSlicerPageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style TargetType="ComboBox" BasedOn="{StaticResource CasComboBoxStyle}" />
            <Style x:Key="ParamHelpIconBorderStyle" BasedOn="{StaticResource CasParamHelpIconBorderStyle}" TargetType="Border" />
            <Style x:Key="ParamHelpIconTextStyle" BasedOn="{StaticResource CasParamHelpIconTextStyle}" TargetType="TextBlock" />
            <Style x:Key="ParamHelpToolTipTextStyle" BasedOn="{StaticResource CasParamHelpToolTipTextStyle}" TargetType="TextBlock" />
        </ResourceDictionary>
    </Page.Resources>

    <Border Style="{StaticResource CasPageRootStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CasSidebarStyle}">
                <DockPanel>
                    <Button
                        DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Command="{Binding SelectNavCommand}"
                        CommandParameter="11"
                        ToolTip="偏好设置">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavPreferences}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource CasCoralBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="PaletteOutline" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="偏好" />
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="0" ToolTip="运行总览">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavOverview}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ViewDashboardOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="运行总览" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="1" ToolTip="应用参数"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavApp}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="CogOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="应用参数" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="2" ToolTip="导入参数"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavImport}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="FolderOpenOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="导入参数" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="3" ToolTip="渲染与厚板"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavRender}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="CubeOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="渲染厚板" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="4" ToolTip="直方图标定"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavHistogram}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ChartBar" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="直方图标定" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="5" ToolTip="视觉对齐"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavVision}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="AxisArrow" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="视觉对齐" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="6" ToolTip="对齐后拖拽"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavPostAlign}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="CursorDefaultClickOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="对齐后拖拽" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="7" ToolTip="切片导出"
                                Visibility="{Binding ShowSlicePipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavSlice}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ImageMultipleOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="切片导出" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="8" ToolTip="AI图像标注"
                                Visibility="{Binding ShowAiPipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavAiAnnotate}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="EyeOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="AI图像标注" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="9" ToolTip="二次手动标注"
                                Visibility="{Binding ShowAiPipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavManualMeasure}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="Ruler" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="二次手动标注" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="12" ToolTip="检测统计（当日 OK/NG）"
                                Visibility="{Binding ShowAiPipelineNav, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavStats}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ChartBar" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="检测统计" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding SelectNavCommand}"
                            CommandParameter="10"
                            ToolTip="单步测试（仅调试）"
                            Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavStepTest}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="FlaskOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="单步测试" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Alt+P 暂停态醒目横幅 -->
                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="16,12"
                        Background="#D32F2F"
                        CornerRadius="6"
                        Visibility="{Binding IsFlowPaused, Converter={StaticResource BoolToVis}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="暂停中 — 再按 Alt+P 继续检查后恢复"/>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding CurrentSectionTitle}" Style="{StaticResource CasTitleTextStyle}"/>
                        <!-- 运行总览不在此显示状态文案，避免长日志挤占布局；详见底部栏与流程日志区 -->
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding MessageShower}"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="520">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CasMutedTextStyle}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavOverview}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource CasPillBorderStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RunModeDisplayText}" Foreground="{StaticResource CasPrimaryTextBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Background="{StaticResource CasWhiteBrush}"
                                    BorderBrush="{StaticResource CasBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="3"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="切图模式"
                                            Command="{Binding SwitchToSlicePipelineModeCommand}"
                                            ToolTip="切图流水线：导出后交接上视图送检图，不跑 NJCT">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasModeSegmentButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSlicePipelineMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CasPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="AI标注模式"
                                            Command="{Binding SwitchToAiPipelineModeCommand}"
                                            ToolTip="AI 标注流水线：扫描交接目录批量 NJCT（不启 VG）">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasModeSegmentButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAiPipelineMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CasPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource CasWhiteBrush}"
                                    BorderBrush="{StaticResource CasBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="生产"
                                            Command="{Binding SwitchToProductionModeCommand}"
                                            ToolTip="生产界面：隐藏单步测试">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasModeSegmentButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProductionMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CasPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="调试"
                                            Command="{Binding SwitchToDebugModeCommand}"
                                            ToolTip="调试界面：可切换切图/AI 模式，并显示单步测试">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasModeSegmentButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CasPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="2">
                <Grid Visibility="{Binding IsNavOverview, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CasHeroCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding OverviewHeroTitle}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource CasPrimaryTextBrush}"/>
                            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                <StackPanel Visibility="{Binding IsSlicePipelineMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="VG 路径"/>
                                    <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                               Text="{Binding VGAppPath}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="CT 体素文件夹"/>
                                    <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                               Text="{Binding CTFileFolder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="切片导出目录"/>
                                    <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                               Text="{Binding SliceExportFolder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsAiPipelineMode, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="ONNX 模型"/>
                                    <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                               Text="{Binding OverviewOfflineCtModelPathDisplay}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                    <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="标注结果根目录"/>
                                    <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                               Text="{Binding SliceExportFolder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="上视图交接目录"/>
                                <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                           Text="{Binding TopViewHandoffFolder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource CasPrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Content="{Binding PrimaryActionButtonText}"
                                        Command="{Binding RunSimulationCommand}"
                                        IsEnabled="{Binding IsEnableSimulationBtn}"
                                        ToolTip="{Binding PrimaryActionToolTip}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CasWhiteCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <TextBlock Text="流程日志" Style="{StaticResource CasSectionHeaderStyle}" Margin="0" DockPanel.Dock="Left"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CasSecondaryButtonStyle}"
                                        Content="清除日志" Command="{Binding ClearImportLogCommand}"/>
                            </DockPanel>
                            <TextBox
                                x:Name="ImportLogTextBox"
                                Grid.Row="1"
                                MinHeight="180"
                                FontFamily="Consolas"
                                FontSize="14"
                                IsReadOnly="True"
                                Text="{Binding ImportLogText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                Background="#FAF8FC"
                                BorderBrush="{StaticResource CasBorderBrush}"
                                BorderThickness="1"
                                Padding="8"
                                AcceptsReturn="True"
                                VerticalContentAlignment="Top" />
                        </Grid>
                    </Border>
                </Grid>

                                <Border Visibility="{Binding IsNavApp, Converter={StaticResource BoolToVis}}" Style="{StaticResource CasWhiteCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="应用参数" Style="{StaticResource CasSectionHeaderStyle}" Margin="0"/>
                                <Border Style="{StaticResource CasParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource CasParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="配置 VGSTUDIO MAX 可执行程序及启动就绪判定，是整条自动化链路的入口。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• VG应用路径：VG 安装目录下的可执行文件。进程名、冷启动与附着单测均由此推导；路径错误则无法启动/附着。" />
                                            <LineBreak />
                                            <Run Text="• VG启动就绪最大等待(ms)：轮询「自动保存恢复」弹窗或「文件(F)」菜单可点的上限。机器慢或首次启动慢时应加大，避免误判启动失败。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource CasParamHelpIconTextStyle}" />
                            </Border>
                            </StackPanel>

                            <Border Style="{StaticResource CasFormSectionStyle}" Margin="0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CasFormSectionTitleStyle}" Text="VG 启动" />
                                    <TextBlock
                                        Style="{StaticResource CasFormSectionDescStyle}"
                                        Text="指定 VG 可执行文件路径，以及冷启动后等待界面就绪的最长时间。" />

                                    <Grid Style="{StaticResource CasFormRowStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource CasFormLabelStyle}" Text="VG应用路径" />
                                        <hc:TextBox
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            IsReadOnly="True"
                                            hc:InfoElement.Necessary="True">
                                            <hc:TextBox.Text>
                                                <Binding Path="VGAppPath" UpdateSourceTrigger="PropertyChanged">
                                                    <Binding.ValidationRules>
                                                        <hc:NoBlankTextRule />
                                                    </Binding.ValidationRules>
                                                </Binding>
                                            </hc:TextBox.Text>
                                        </hc:TextBox>
                                        <Button
                                            Grid.Column="2"
                                            Style="{StaticResource CasFormActionButtonStyle}"
                                            Width="40"
                                            MinWidth="40"
                                            Padding="0"
                                            Command="{Binding OpenVGAppPathCommand}">
                                            <Image Width="18" RenderTransformOrigin="0.5,0.5">
                                                <Image.RenderTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform ScaleY="-1" />
                                                    </TransformGroup>
                                                </Image.RenderTransform>
                                                <Image.Source>
                                                    <DrawingImage>
                                                        <DrawingImage.Drawing>
                                                            <DrawingGroup>
