<UserControl x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ClosedLoopToggleButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="200">

    <UserControl.Resources>
        <!--闭环状态开关按钮-->
        <Style x:Key="ColsedLoopToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Foreground" Value="#99FFFFFF"/>
            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Width="50" Height="20" CornerRadius="10" Background="{TemplateBinding Background}">
                            <Grid Margin="5,0,5,0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusTB" Text="开启" Opacity="{TemplateBinding Opacity}" 
                                         FontFamily="{TemplateBinding FontFamily}" FontSize="12" 
                                         HorizontalAlignment="Right" TextAlignment="Center"/>
                                <Ellipse x:Name="StatusE" Width="14" Height="14" Fill="#CCFFFFFF" HorizontalAlignment="Left" Opacity="0.87"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 悬停状态 (可选，稍微变亮) -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>

                            <!-- 选中状态 (IsChecked = True) -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StatusTB" Property="Text" Value="开启"/>
                                <Setter TargetName="StatusTB" Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Opacity" Value="0.87"/>
                                <Setter TargetName="StatusE" Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Background" Value="#FF29CC7A"/>
                                <Setter Property="Foreground" Value="#CCFFFFFF"/>
                            </Trigger>
                            <!-- 未选中状态 (IsChecked = False) -->
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="StatusTB" Property="Text" Value="关闭"/>
                                <Setter TargetName="StatusTB" Property="HorizontalAlignment" Value="Left"/>
                                <Setter Property="Opacity" Value="1"/>
                                <Setter TargetName="StatusE" Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="#99FFFFFF"/>
                            </Trigger>

                            <!-- 禁用状态 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="ToggleButtonTB" FontSize="14" FontWeight="Medium"
                   Foreground="#99FFFFFF" FontFamily="{StaticResource CCTB.SourceHanSansCN}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Center" TextAlignment="Right"/>
        <ToggleButton x:Name="ToggleButton" Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource ColsedLoopToggleButtonStyle}"/>
    </Grid>
</UserControl>
