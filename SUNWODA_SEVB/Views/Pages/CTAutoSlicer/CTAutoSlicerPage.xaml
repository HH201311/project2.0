                    HorizontalAlignment="Center"
                    Foreground="Gray"
                    Text="「测试直方图灰度调整」：截图+目标色换纯绿+峰谷+拖红线。「测试简单3-2-1对齐」：需先标定 3D 区域与「简单对齐」下拉点击位置。"
                    TextWrapping="Wrap" />
                <TextBlock Margin="5" Text="{Binding MessageShower}" TextWrapping="Wrap" />

                <Expander Margin="5" Header="流程日志">
                    <Border
                        BorderBrush="LightGray"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,5,5">
                        <StackPanel Margin="10">
                            <Button
                                Width="100"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Left"
                                Command="{Binding ClearImportLogCommand}"
                                Content="清除日志" />
                            <TextBox
                                x:Name="ImportLogTextBox"
                                Height="200"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                Text="{Binding ImportLogText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
