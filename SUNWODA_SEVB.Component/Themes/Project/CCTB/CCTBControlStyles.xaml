<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!--  标题栏控制按钮  -->
    <Style x:Key="ControlButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="MinHeight" Value="10" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        Margin="{TemplateBinding Margin}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}">
                        <Border x:Name="border">
                            <ContentPresenter
                                Margin="10,0,10,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  设备状态开关按钮  -->
    <Style x:Key="DeviceToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="60" />
        <Setter Property="Height" Value="60" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="#99FFFFFF" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10"
                        Opacity="{TemplateBinding Opacity}">
                        <UniformGrid Margin="6" Rows="2">
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Left" />
                            <TextBlock
                                x:Name="StatusTB"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{TemplateBinding Foreground}"
                                TextAlignment="Left" />
                        </UniformGrid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  选中状态 (IsChecked = True)  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="StatusTB" Property="Text" Value="已连接" />
                            <Setter Property="Background" Value="#FF29CC7A" />
                            <Setter Property="Foreground" Value="#CCFFFFFF" />
                        </Trigger>
                        <!--  未选中状态 (IsChecked = False)  -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="StatusTB" Property="Text" Value="未连接" />
                            <Setter Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="#99FFFFFF" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region 导航按钮RadioButton样式-->
    <!--  主导航  -->
    <Style x:Key="MainNavigationRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <!--  背景  -->
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderThickness="0"
                            CornerRadius="20" />

                        <DockPanel Margin="14" LastChildFill="False">
                            <!--  图标  -->
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Top"
                                FontFamily="{StaticResource CCTB.IconFont}"
                                FontSize="30"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Path=Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <!--  文本  -->
                            <TextBlock
                                x:Name="TextTB"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Bottom"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontStretch="{TemplateBinding FontStretch}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"
                                TextAlignment="Center" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  选中状态 (IsChecked = True)  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TextTB" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="#FF29CC7A" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                            <Setter Property="Background" Value="#FF29CC7A" />
                            <Setter TargetName="border" Property="Opacity" Value="0.1" />
                        </Trigger>
                        <!--  未选中状态 (IsChecked = False)  -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="TextTB" Property="Opacity" Value="0.8" />
                            <Setter Property="Foreground" Value="#CCFFFFFF" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  次级导航  -->
    <Style x:Key="SubNavigationRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Width" Value="150" />
        <Setter Property="Height" Value="60" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
        <Setter Property="Foreground" Value="#99FFFFFF" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Grid
                            x:Name="checkedTag"
                            Width="20"
                            Height="20"
                            Margin="-10,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Visibility="Hidden">
                            <Ellipse
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Fill="#FF2B2B2B" />
                            <Path
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M5.42,0 L0,5 L5.42,10"
                                Stroke="#CCFFFFFF" />
                        </Grid>
                        <Grid Margin="10">
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderThickness="0"
                                CornerRadius="10"
                                Opacity="0.1" />
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#CCFFFFFF" />
                            <Setter Property="Background" Value="#FF3DCC84" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                            <Setter TargetName="checkedTag" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  标签导航  -->
    <Style x:Key="TabNavigationRadioButtonStyle" TargetType="RadioButton">
        <Setter Property="Margin" Value="50,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid VerticalAlignment="Stretch">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border
                            Name="border"
                            Width="30"
                            Height="5"
                            VerticalAlignment="Bottom"
                            CornerRadius="2"
                            DockPanel.Dock="Bottom" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  选中状态 (IsChecked = True)  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="#CCFFFFFF" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                            <Setter TargetName="border" Property="Background" Value="#FF29CC7A" />
                        </Trigger>
                        <!--  未选中状态 (IsChecked = False)  -->
                        <Trigger Property="IsChecked" Value="False">
                            <Setter Property="Foreground" Value="#99FFFFFF" />
                            <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                            <Setter TargetName="border" Property="Background" Value="Transparent" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--  监控界面功能按钮  -->
    <Style x:Key="ClickButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="20,0,0,0" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="Background" Value="#FF29CC7A" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            Opacity="0.87" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  悬停状态 (可选，稍微变亮)  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9" />
                        </Trigger>

                        <!--  禁用状态  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--#region GroupBox容器-->
    <!--  GroupBox容器的简单样式  -->
    <Style x:Key="SimpleGroupBoxStyle" TargetType="GroupBox">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="Foreground" Value="#CCFFFFFF" />
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  Header  -->
                            <StackPanel
                                Grid.Row="0"
                                Margin="20,20,20,0"
                                VerticalAlignment="Top"
                                Orientation="Horizontal">
                                <Border
                                    Width="5"
                                    Height="{TemplateBinding FontSize}"
                                    VerticalAlignment="Center"
                                    Background="#FF29CC7A"
                                    CornerRadius="3" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                    TextAlignment="Left" />
                            </StackPanel>

                            <!--  内容  -->
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region ScrollViewer容器样式-->
    <!--  ScrollViewer垂直滚动条滑块样式  -->
    <Style x:Key="ModernScrollThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="#61FFFFFF" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#909090" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter Property="Background" Value="#707070" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScrollViewer水平滚动条样式  -->
    <Style x:Key="ModernHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid
                        x:Name="GridRoot"
                        Height="{TemplateBinding Height}"
                        Background="Transparent">
                        <Track
                            x:Name="PART_Track"
                            Focusable="false"
                            IsDirectionReversed="False">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollThumb}" />
                            </Track.Thumb>
                            <!--  隐藏上下箭头按钮 (Increase/DecreaseRepeatButton)  -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageRightCommand"
                                    Focusable="false"
                                    Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageLeftCommand"
                                    Focusable="false"
                                    Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScrollViewer垂直滚动条样式  -->
    <Style x:Key="ModernVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Stylus.IsFlicksEnabled" Value="false" />
        <Setter Property="Width" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid
                        x:Name="GridRoot"
                        Width="{TemplateBinding Width}"
                        Background="Transparent">
                        <Track
                            x:Name="PART_Track"
                            Focusable="false"
                            IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ModernScrollThumb}" />
                            </Track.Thumb>
                            <!--  隐藏上下箭头按钮 (Increase/DecreaseRepeatButton)  -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageDownCommand"
                                    Focusable="false"
                                    Opacity="0" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageUpCommand"
                                    Focusable="false"
                                    Opacity="0" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ScrollViewer样式  -->
    <Style x:Key="ModernScrollViewer" TargetType="{x:Type ScrollViewer}">
        <Setter Property="Margin" Value="10,25,10,25" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter
                            x:Name="PART_ScrollContentPresenter"
                            Grid.Row="0"
                            Grid.RowSpan="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="{TemplateBinding Padding}"
                            CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <!--  水平滚动条  -->
                        <ScrollBar
                            x:Name="PART_HorizontalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Style="{StaticResource ModernHorizontalScrollBar}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                            Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <!--  垂直滚动条  -->
                        <ScrollBar
                            x:Name="PART_VerticalScrollBar"
                            Grid.Row="0"
                            Grid.Column="1"
                            Maximum="{TemplateBinding ScrollableHeight}"
                            Style="{StaticResource ModernVerticalScrollBar}"
                            ViewportSize="{TemplateBinding ViewportHeight}"
                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                            Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->

    <!--#region 文本框样式-->
    <!--  报错信息提示文本框  -->
    <Style x:Key="ErrorMessageTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
        <Setter Property="Foreground" Value="#FF0000" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Visibility" Value="Visible" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->
</ResourceDictionary>