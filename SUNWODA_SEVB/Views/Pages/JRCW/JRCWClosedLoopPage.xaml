<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JRCW.JRCWClosedLoopPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.JRCW;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JRCW"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxyWpf="http://oxyplot.org/wpf"
    xmlns:params="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JRCW.ParamControls;assembly=SUNWODA_SEVB.Component"
    Title="JRCWClosedLoopPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <convert:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <Style x:Key="SimpleGroupBoxStyle" TargetType="GroupBox">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.AlimamaShuHeiTi}" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="ConnectStatusContentControlStyle" TargetType="ContentControl">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Tag" Value="xx通信状态" />
                <Setter Property="Content" Value="离线" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,10,0"
                                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="Black"
                                    Text="{TemplateBinding Tag}" />
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="{TemplateBinding VerticalAlignment}" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Content" Value="已连接">
                                    <Setter Property="Foreground" Value="Blue" />
                                </Trigger>
                                <Trigger Property="Content" Value="离线">
                                    <Setter Property="Foreground" Value="Red" />
                                </Trigger>
                                <Trigger Property="Content" Value="连接中">
                                    <Setter Property="Foreground" Value="Orange" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*" MinHeight="320" />
            <RowDefinition Height="Auto" MinHeight="240" />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1048*" />
                <ColumnDefinition Width="752*" />
            </Grid.ColumnDefinitions>
            <GroupBox
                Grid.Column="0"
                Header="实时监控参数分析"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <!--  图表  -->
                    <oxyWpf:PlotView
                        Grid.Column="0"
                        Background="WhiteSmoke"
                        IsMouseWheelEnabled="False"
                        Model="{Binding LineSeriersModel}"
                        Visibility="Visible" />
                    <!--  PLC地址数据  -->
                    <Border
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Stretch"
                        Background="WhiteSmoke">
                        <ListBox
                            x:Name="plcAddressListView"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding PLCAddressModels}"
                            SelectionMode="Multiple">
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="SelectionChanged">
                                    <i:InvokeCommandAction Command="{Binding SelectionChangedCommand}" CommandParameter="{Binding SelectedItems, ElementName=plcAddressListView}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                    <Border
                                                        Name="SelectBorder"
                                                        Margin="1"
                                                        Padding="2"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="0">
                                                        <Grid x:Name="DockPanel1">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="auto" />
                                                                <RowDefinition />
                                                            </Grid.RowDefinitions>
                                                            <DockPanel VerticalAlignment="Center">
                                                                <TextBlock
                                                                    Name="SelectText"
                                                                    Margin="5,0,0,0"
                                                                    HorizontalAlignment="Center"
                                                                    FontSize="12"
                                                                    Foreground="#666666"
                                                                    Text="{Binding PName}" />
                                                                <TextBlock
                                                                    Margin="0,0,20,0"
                                                                    HorizontalAlignment="Right"
                                                                    FontSize="12"
                                                                    Foreground="#3355FF"
                                                                    Text="{Binding PValue}">
                                                                    <TextBlock.ToolTip>
                                                                        <TextBlock
                                                                            MaxWidth="500"
                                                                            Text="{Binding PValue}"
                                                                            TextWrapping="NoWrap" />
                                                                    </TextBlock.ToolTip>
                                                                </TextBlock>
                                                            </DockPanel>
                                                        </Grid>
                                                    </Border>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger SourceName="DockPanel1" Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#EAEDFF" />
                                                    </Trigger>
                                                    <!--  选中  -->
                                                    <Trigger Property="Selector.IsSelected" Value="true">
                                                        <Setter Property="Background" Value="#EAEDFF" />
                                                        <Setter TargetName="SelectBorder" Property="BorderBrush" Value="Transparent" />
                                                        <Setter TargetName="SelectText" Property="Foreground" Value="#3355FF" />
                                                    </Trigger>
                                                    <!--  多条件触发器  -->
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <!--  是否已被选中，含多选情况  -->
                                                            <Condition Property="Selector.IsSelected" Value="True" />
                                                            <!--  是否是当前选中项，多选时为焦点所在项  -->
                                                            <Condition Property="Selector.IsFocused" Value="False" />
                                                        </MultiTrigger.Conditions>
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter TargetName="SelectBorder" Property="BorderBrush" Value="#14AAE6" />
                                                        <Setter TargetName="SelectText" Property="Foreground" Value="#14AAE6" />
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>
                </Grid>
            </GroupBox>
            <GroupBox
                Grid.Column="1"
                Margin="20,0,0,0"
                Header="设备信息"
                Style="{StaticResource SimpleGroupBoxStyle}">
                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,20,0,0"
                    Background="WhiteSmoke"
                    CornerRadius="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <UniformGrid
                            Grid.Row="0"
                            Margin="20,0"
                            HorizontalAlignment="Right"
                            Columns="3">
                            <ContentControl
                                Margin="10,0"
                                d:Content="已连接"
                                Content="{Binding PLCConnectStatus}"
                                Style="{StaticResource ConnectStatusContentControlStyle}"
                                Tag="PLC通信状态" />
                            <ContentControl
                                Margin="10,0"
                                d:Content="离线"
                                Content="{Binding MESConnectStatus}"
                                Style="{StaticResource ConnectStatusContentControlStyle}"
                                Tag="MES通信状态" />
                            <ContentControl
                                Margin="10,0"
                                d:Content="离线"
                                Content="{Binding WEBConnectStatus}"
                                Style="{StaticResource ConnectStatusContentControlStyle}"
                                Tag="WEB通信状态" />
                        </UniformGrid>
                        <ItemsControl
                            Grid.Row="1"
                            d:ItemsSource="{d:SampleData ItemCount=7}"
                            ItemsSource="{Binding ProductInfoModel}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="5" CornerRadius="5">
                                        <StackPanel Margin="2,0" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="2*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,20,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
                                                    FontSize="14"
                                                    Text="{Binding PName}"
                                                    TextAlignment="Right" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                                                    FontSize="14"
                                                    Text="{Binding PValue}"
                                                    TextAlignment="Left">
                                                    <TextBlock.ToolTip>
                                                        <TextBlock
                                                            MaxWidth="500"
                                                            Text="{Binding PValue}"
                                                            TextWrapping="NoWrap" />
                                                    </TextBlock.ToolTip>
                                                </TextBlock>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </GroupBox>
        </Grid>

        <GroupBox
            Grid.Row="1"
            Margin="0,0,0,20"
            Header="闭环配置参数 (可在“设置”界面修改参数)"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <Grid>
                <params:YWParamControl
                    ParamModel="{Binding ParamSettingModel}"
                    UserRole="{Binding UserRole}"
                    Visibility="{Binding JRCWSetting, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=义乌}" />
            </Grid>
        </GroupBox>

        <GroupBox
            Grid.Row="2"
            Header="日志"
            Style="{StaticResource SimpleGroupBoxStyle}">
            <DataGrid
                x:Name="LogDataGrid"
                AlternatingRowBackground="#F8F9FA"
                AutoGenerateColumns="False"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                CanUserResizeRows="False"
                CanUserSortColumns="True"
                FontFamily="Consolas"
                FontSize="12"
                GridLinesVisibility="None"
                HeadersVisibility="Column"
                HorizontalGridLinesBrush="#E0E0E0"
                IsReadOnly="True"
                ItemsSource="{Binding AppLogs}"
                RowHeight="36"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                VerticalGridLinesBrush="#E0E0E0">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White" />
                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Style.Triggers>
                            <Trigger Property="AlternationIndex" Value="1">
                                <Setter Property="Background" Value="#F8F9FA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E3F2FD" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2196F3" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#1976D2" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0,0,1,0" />
                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="BorderBrush" Value="#1976D2" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="Background" Value="#FFF8F8F8" />
                        <Setter Property="BorderBrush" Value="#FFE0E0E0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="#FF333333" />
                        <Setter Property="Height" Value="40" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Grid>
                                        <Border
                                            x:Name="headerBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="0">
                                            <ContentPresenter
                                                Margin="{TemplateBinding Padding}"
                                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                        <Path
                                            x:Name="sortArrow"
                                            Width="10"
                                            Height="6"
                                            Margin="0,0,12,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Data="M 0,0 L 5,5 L 10,0 Z"
                                            Fill="#FF007ACC"
                                            Stretch="Uniform"
                                            Visibility="Collapsed" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFE6F2FF" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFCCE5FF" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Ascending">
                                            <Setter TargetName="sortArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="sortArrow" Property="Data" Value="M 0,5 L 5,0 L 10,5 Z" />
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFE1F0FF" />
                                        </Trigger>
                                        <Trigger Property="SortDirection" Value="Descending">
                                            <Setter TargetName="sortArrow" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="headerBorder" Property="Background" Value="#FFE1F0FF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Background" Value="#F5F5F5" />
                        <Setter Property="BorderBrush" Value="#E0E0E0" />
                        <Setter Property="Width" Value="12" />
                        <Setter Property="Height" Value="12" />
                    </Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="180"
                        Binding="{Binding LogTime}"
                        CanUserSort="True"
                        Header="时间">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Foreground" Value="#2C3E50" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip>
                                            <TextBlock
                                                Padding="4"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Text="{Binding LogTime}" />
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn
                        Width="*"
                        MinWidth="400"
                        Binding="{Binding Message}"
                        CanUserSort="True"
                        Header="日志内容">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="Consolas" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Foreground" Value="#2C3E50" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
                                <Setter Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip MaxWidth="600">
                                            <TextBlock
                                                Padding="4"
                                                FontFamily="Consolas"
                                                FontSize="11"
                                                Text="{Binding Message}"
                                                TextWrapping="Wrap" />
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn
                        Width="90"
                        CanUserSort="True"
                        Header="等级">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="6,2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#E8F4FD"
                                    BorderBrush="#3498DB"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe UI Semibold"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="#2980B9"
                                        Text="{Binding LogLevel}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</Page>
