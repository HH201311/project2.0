        <!--  底部版权栏  -->
        <Grid
            Grid.Row="2"
            Margin="0,0,0,0"
            Background="LightGray">
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                FontSize="15"
                Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />
        </Grid>

        <!--  绘制x极误判区域 - X工位相机X  -->
        <!--
            外层遮罩Grid：
            1. Grid.RowSpan="3"：跨3行覆盖整个窗口区域
            2. Visibility：绑定VM的IsDrawFlyoutOpen，控制整个绘制面板的显示/隐藏
            3. Background：半透明黑色遮罩（Opacity=0.8），弹出时聚焦用户注意力
        -->
        <Grid Grid.RowSpan="3" Visibility="{Binding IsDrawFlyoutOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.Background>
                <SolidColorBrush Opacity="0.8" Color="#33000000" />
            </Grid.Background>

            <!--
                MahApps.Metro Flyout核心控件：
                核心作用：弹出式绘制面板，承载ROI绘制的所有UI元素
                属性说明：
                - Width/Height：固定面板尺寸950×650px，保证布局稳定
                - AnimateOpacity：弹出/关闭时带透明度渐变动画，提升交互体验
                - CloseButtonVisibility：隐藏默认关闭按钮，改用自定义“取消”按钮
                - DataContext：绑定静态资源DamageDetectionVM，所有内部控件的绑定基于此VM
                - IsOpen：默认打开（实际由外层Grid的Visibility间接控制）
                - Position：从左侧弹出（结合遮罩视觉上为居中悬浮）
            -->
            <mah:Flyout
                x:Name="DrawRoiFlyout"
                Width="950"
                Height="650"
                AnimateOpacity="True"
                Background="White"
                BorderThickness="0"
                CloseButtonVisibility="Collapsed"
                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Page}}"
                IsOpen="True"
                Position="Left">

                <!--  Flyout内部Grid：分3行布局（标题栏、主体区、按钮栏）  -->
                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  标题栏  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="25,20,25,15"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">

                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="{Binding DrawTitle}" />
                    </StackPanel>

                    <Border
                        Grid.Row="0"
                        Height="1"
                        Margin="25,60,25,0"
                        Background="#E5E7EB" />

                    <Grid Grid.Row="1" Margin="25,10,25,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="3*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Grid.Column="0"
                            Margin="0,0,15,0"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">

                            <Grid>
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="16"
                                        Foreground="#94A3B8"
                                        Text="图片加载中..." />
                                </StackPanel>

                                <!--
                                    InkCanvas核心控件：WPF手绘画布，支持鼠标绘制路径
                                    属性说明：
                                    - Loaded：画布加载完成后触发后台事件，初始化绘制逻辑
                                    - DefaultDrawingAttributes：默认画笔样式（4px宽高、红色、平滑曲线）
                                    - Background：绑定VM的CurrentRoiImageSource，显示待绘制的背景图片
                                -->
                                <InkCanvas
                                    x:Name="NegativeRoiInkCanvas"
                                    Margin="10"
                                    Cursor="Arrow"
                                    Loaded="NegativeRoiInkCanvas_Loaded">

                                    <!--  画笔样式设置：红色（#E74C3C）、4px宽高、平滑曲线  -->
                                    <InkCanvas.DefaultDrawingAttributes>
                                        <DrawingAttributes
                                            Width="4"
                                            Height="4"
                                            FitToCurve="True"
                                            Color="#E74C3C" />

                                        <!--  画布背景：绑定VM的CurrentRoiImageSource，显示待处理图片  -->
                                    </InkCanvas.DefaultDrawingAttributes>
                                    <InkCanvas.Background>
                                        <ImageBrush
                                            ImageSource="{Binding CurrentRoiImageSource}"
                                            Opacity="0.95"
                                            Stretch="Uniform" />
                                    </InkCanvas.Background>
                                </InkCanvas>
                            </Grid>
                        </Border>

                        <!--  绘制说明  -->
                        <Border
                            Grid.Column="1"
                            Padding="20"
                            Background="#F8FAFC"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1"
                            CornerRadius="8">

                            <StackPanel>
                                <StackPanel Margin="0,0,0,15" Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="#2C3E50"
                                        Text="绘制说明" />
                                </StackPanel>

                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel
                                        Margin="0,0,0,12"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#475569"
                                            Text="1.鼠标在左侧图片绘制封闭区域" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,0,0,12"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#475569"
                                            Text="2.区域内负极缺陷将被系统过滤" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,0,0,12"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#475569"
                                            Text="3.绘制错误可点击「删除绘制」重绘" />
                                    </StackPanel>
                                    <StackPanel
                                        Margin="0,0,0,12"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#475569"
                                            Text="4.完成后点击「保存区域」生效" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">

                                        <TextBlock
                                            FontSize="14"
                                            Foreground="#475569"
                                            Text="5.点击「取消」放弃当前绘制" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  删除区域、保存区域、取消，三个按钮  -->
                    <Border
                        Grid.Row="2"
                        Margin="25,0,25,25"
                        Background="#F8FAFC"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel
                            Margin="0,15,0,15"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">

                            <Button
                                Width="130"
                                Height="42"
                                Margin="0,0,15,0"
                                Background="OrangeRed"
                                Command="{Binding DeleteNegativeRoiCommand}"
                                Content="删除绘制"
                                IsEnabled="{Binding IsInAnyDetection}" />

                            <Button
                                Width="130"
                                Height="42"
                                Margin="0,0,15,0"
                                Background="GreenYellow"
                                Command="{Binding SaveNegativeRoiCommand}"
                                Content="保存区域"
                                IsEnabled="{Binding IsInAnyDetection}" />

                            <Button
                                Width="130"
                                Height="42"
                                Background="AliceBlue"
                                Command="{Binding CancelDrawRoiCommand}"
                                Content="取消" />
                        </StackPanel>
                    </Border>
                </Grid>
            </mah:Flyout>
        </Grid>
    </Grid>
</Page>
