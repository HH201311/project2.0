<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBMonitoringPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CCTBMonitoringPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  按钮区  -->
        <Border
            Grid.Row="0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <DockPanel VerticalAlignment="Stretch" LastChildFill="False">
                <RadioButton
                    Command="{Binding SummaryCommand}"
                    Content="总况"
                    IsChecked="True"
                    Style="{StaticResource MenuRadioButtonStyle}" />
                <RadioButton
                    Command="{Binding TBDataCommand}"
                    Content="面密度"
                    Style="{StaticResource MenuRadioButtonStyle}" />
                <RadioButton
                    Command="{Binding CCDDataCommand}"
                    Content="尺寸"
                    Style="{StaticResource MenuRadioButtonStyle}" />
                <StackPanel
                    Margin="0,0,20,0"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding AlarmRecordingsCommand}"
                        Content="报警记录"
                        Style="{StaticResource ClickButtonStyle}" />
                    <Button
                        Command="{Binding ControlRecordingsCommand}"
                        Content="控制记录"
                        Style="{StaticResource ClickButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!--  内容区  -->
        <Grid
            Grid.Row="1"
            Margin="0,20,0,0"
            Background="Transparent">
            <Frame
                BorderThickness="0"
                Content="{Binding NavigationPage}"
                NavigationUIVisibility="Hidden" />
        </Grid>
    </Grid>
</Page>
