<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBRecords.AlarmRecordPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:alarm="clr-namespace:SUNWODA_SEVB.Core.Models.Project.CCTB.AlarmModels;assembly=SUNWODA_SEVB.Core"
    xmlns:behavior="clr-namespace:SUNWODA_SEVB.Core.Behavior;assembly=SUNWODA_SEVB.Core"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBRecords"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    Title="SystemRecordPage"
    d:DesignHeight="940"
    d:DesignWidth="1610"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBDataGridControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:ContentToStringConverter x:Key="ContentToStringConverter" />
            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />

            <Style x:Key="RecordTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Style.Triggers>
                    <Trigger Property="Text" Value="Unknown">
                        <Setter Property="Foreground" Value="#1AFFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style BasedOn="{StaticResource AccountDataGridStyle}" TargetType="DataGrid">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserResizeColumns" Value="False" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Grid.Row="0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <DockPanel
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Label
                        Margin="20,0"
                        Content="报警记录"
                        DockPanel.Dock="Left"
                        Style="{StaticResource ParamTitleLabelStyle}" />

                    <uccc:DateRangePicker
                        Height="30"
                        MinWidth="200"
                        EndDate="{Binding EndDate}"
                        StartDate="{Binding StartDate}"
                        Watermark="全部报警时间" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,20,0"
                        Command="{Binding QueryCommand}"
                        Content="查询"
                        Style="{StaticResource ParamOKButtonStyle}" />

                    <Button
                        Width="100"
                        Margin="0,0,20,0"
                        Command="{Binding ExportCurrentPageCommand}"
                        Content="导出当前页"
                        Style="{StaticResource ParamFunctionButtonStyle}" />

                    <Button
                        Width="100"
                        Margin="0,0,20,0"
                        Command="{Binding ExportCurrentQueryCommand}"
                        Content="导出当前查询"
                        Style="{StaticResource ParamFunctionButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Border
            Grid.Row="1"
            Margin="0,20,0,0"
            Background="#0DFFFFFF"
            BorderThickness="1"
            CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Margin="20"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    BorderBrush="#1AFFFFFF"
                    BorderThickness="0.5,0.5,0,0"
                    CornerRadius="0">
                    <DataGrid
                        behavior:DataGridBehavior.AutoScrollToFirst="True"
                        ItemsSource="{Binding Records}"
                        SelectedItem="{Binding SelectedRecord}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="80" Header="编号">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="0"
                                            Style="{StaticResource RecordTextBlockStyle}"
                                            Text="{Binding ID}"
                                            TextAlignment="Center"
                                            ToolTip="{Binding ID}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="120" Header="极面">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="20,0,5,0"
                                            Style="{StaticResource RecordTextBlockStyle}"
                                            Text="{Binding SideType}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="200" Header="操作时间">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="20,0,5,0"
                                            Style="{StaticResource RecordTextBlockStyle}"
                                            Text="{Binding RecordTime, StringFormat='yyyy-MM-dd HH:mm:ss fff'}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Width="*" Header="报警内容">
                                <DataGridTemplateColumn.HeaderStyle>
                                    <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </DataGridTemplateColumn.HeaderStyle>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock
                                            Margin="20,0,5,0"
                                            Style="{StaticResource RecordTextBlockStyle}"
                                            Text="{Binding AlarmMessage}">
                                            <TextBlock.InputBindings>
                                                <MouseBinding
                                                    Command="{Binding DataContext.ShowMessageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding AlarmMessage}"
                                                    MouseAction="LeftClick" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!--  分页控件  -->
                <Border
                    Grid.Row="1"
                    Height="40"
                    Margin="0,20,0,20">
                    <uccc:PaginationControl
                        CurrentPageNumber="{Binding CurrentPageNumber, Mode=TwoWay}"
                        GotoPageCommand="{Binding GotoPageCommand}"
                        PageCount="{Binding PageCount, Mode=TwoWay}"
                        TotalCount="{Binding TotalCount, Mode=TwoWay}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Page>
