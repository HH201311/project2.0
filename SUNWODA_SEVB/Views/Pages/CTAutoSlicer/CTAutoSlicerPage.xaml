<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CTAutoSlicer.CTAutoSlicerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CTAutoSlicerPage"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- 参数分组标题旁的「?」帮助图标：悬浮显示本组全部参数说明 -->
        <Style x:Key="ParamHelpIconBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#5B8DEF" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Help" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
        </Style>
        <Style x:Key="ParamHelpIconTextStyle" TargetType="TextBlock">
            <Setter Property="Text" Value="?" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ParamHelpToolTipTextStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="18" />
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu
            Grid.Row="0"
            Background="#F0F2F5"
            Padding="4,2">
            <MenuItem Header="{Binding RunModeMenuHeader}" ToolTip="切换生产/调试界面；默认生产模式，隐藏单步测试">
                <MenuItem
                    Command="{Binding SwitchToProductionModeCommand}"
                    Header="生产模式"
                    IsCheckable="True"
                    IsChecked="{Binding IsProductionMode, Mode=OneWay}"
                    ToolTip="生产界面：隐藏单步测试等调试入口，仅保留参数配置与开始流程" />
                <MenuItem
                    Command="{Binding SwitchToDebugModeCommand}"
                    Header="调试模式"
                    IsCheckable="True"
                    IsChecked="{Binding IsDebugMode, Mode=OneWay}"
                    ToolTip="调试界面：显示单步测试按钮，便于标定验证（生产请勿使用）" />
            </MenuItem>
        </Menu>

        <ScrollViewer Grid.Row="1" Margin="5">
            <StackPanel>
                <Expander Margin="5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="应用参数" />
                            <Border Style="{StaticResource ParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource ParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="配置 VGSTUDIO MAX 可执行程序及启动就绪判定，是整条自动化链路的入口。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• VG应用路径：VG 安装目录下的可执行文件。进程名、冷启动与附着单测均由此推导；路径错误则无法启动/附着。" />
                                            <LineBreak />
                                            <Run Text="• VG启动就绪最大等待(ms)：轮询「自动保存恢复」弹窗或「文件(F)」菜单可点的上限。机器慢或首次启动慢时应加大，避免误判启动失败。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource ParamHelpIconTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <Border
                        BorderBrush="LightGray"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,5,5">
                        <StackPanel>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="VG应用路径"
                                    hc:InfoElement.TitlePlacement="Left"
                                    IsReadOnly="True">
                                    <hc:TextBox.Text>
                                        <Binding Path="VGAppPath" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:NoBlankTextRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button Width="40" Command="{Binding OpenVGAppPathCommand}">
                                    <Image Width="18" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleY="-1" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="Black" Geometry="M768 97.92v-97.92h-640v896h384v-256h256v-35.84c24.73-14.631 45.845-32.282 63.738-52.813l0.262 152.653-256 256h-512v-1024h768v97.92zM576 896l192-192h-192v192zM945.92 145.92l-122.88 122.88c-5.725 5.447-12.859 9.465-20.798 11.452 18.665 29.336 29.953 65.126 29.953 103.553 0 106.039-85.961 192-192 192s-192-85.961-192-192c0-106.039 85.961-192 192-192 38.427 0 74.217 11.289 104.235 30.73 1.305-8.716 5.323-15.85 10.789-21.595l122.862-122.86c8.549-7.982 20.063-12.883 32.723-12.883 26.51 0 48 21.49 48 48 0 12.659-4.901 24.174-12.908 32.751zM640 256c-70.692 0-128 57.308-128 128s57.308 128 128 128c70.692 0 128-57.308 128-128s-57.308-128-128-128z" />
                                                    </DrawingGroup>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="VG启动就绪最大等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="VGOpenWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Margin="5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="导入参数" />
                            <Border Style="{StaticResource ParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource ParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="控制批量 .vgl/.vgi 导入节奏、超时与进程池并行度，决定导入阶段是否稳定、吞吐多高。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• CT体素文件夹：待处理体积所在目录（含子级 .vgl/.vgi 或指向它们的 .lnk）。主流程按创建时间排队处理。" />
                                            <LineBreak />
                                            <Run Text="• 快速导入等待(ms)：Ctrl+F+I 后等待「快速导入」对话框出现的超时。界面卡顿时应加大。" />
                                            <LineBreak />
                                            <Run Text="• 新建工程等待(ms)：Ctrl+N 新建后等待工程就绪/保存提示处理完成的时间。" />
                                            <LineBreak />
                                            <Run Text="• 文件选择等待(ms)：填路径点打开后，等待「文件选择/完成」向导出现的超时。" />
                                            <LineBreak />
                                            <Run Text="• 导入超时(分钟)：单文件「正在导入体积」最长等待。超大体积需加大，超时则 Kill 该 VG 并保留文件。" />
                                            <LineBreak />
                                            <Run Text="• 导入后稳定等待(ms)：导入完成后稍作停顿再进后处理，避免 UI 尚未稳定就点渲染/厚板。" />
                                            <LineBreak />
                                            <Run Text="• 最大VG进程数：进程池槽位数（1～8）。导入等待可并行，后处理串行置前；越大越吃内存/显存。" />
                                            <LineBreak />
                                            <Run Text="• 步骤重试次数 / 步骤重试间隔(ms)：UIA 步骤失败时先 Drain 中断弹窗再重试。偶发弹窗/焦点丢失时提高成功率。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource ParamHelpIconTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <Border
                        BorderBrush="LightGray"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,5,5">
                        <StackPanel>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="CT体素文件夹"
                                    hc:InfoElement.TitlePlacement="Left"
                                    IsReadOnly="True">
                                    <hc:TextBox.Text>
                                        <Binding Path="CTFileFolder" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:NoBlankTextRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button Width="40" Command="{Binding OpenCTFileFolderCommand}">
                                    <Image Width="18">
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="Black" Geometry="M245,110.64A16,16,0,0,0,232,104H216V88a16,16,0,0,0-16-16H130.67L102.94,51.2a16.14,16.14,0,0,0-9.6-3.2H40A16,16,0,0,0,24,64V208h0a8,8,0,0,0,8,8H211.1a8,8,0,0,0,7.59-5.47l28.49-85.47A16.05,16.05,0,0,0,245,110.64ZM93.34,64,123.2,86.4A8,8,0,0,0,128,88h72v16H69.77a16,16,0,0,0-15.18,10.94L40,158.7V64Zm112,136H43.1l26.67-80H232Z" />
                                                    </DrawingGroup>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="快速导入等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="QuickImportDialogWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="新建工程等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="NewProjectDialogWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="文件选择等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="FileSelectionDialogWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="导入超时(分钟)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="ImportTimeoutMinutes" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="导入后稳定等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="PostImportWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="最大VG进程数"
                                    hc:InfoElement.TitlePlacement="Left"
                                    hc:InfoElement.Placeholder="1～8，默认4">
                                    <hc:TextBox.Text>
                                        <Binding Path="MaxVgProcesses" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="步骤重试次数"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="StepRetryCount" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="步骤重试间隔(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="StepRetryIntervalMs" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Margin="5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="渲染与厚板参数" />
                            <Border Style="{StaticResource ParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource ParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="导入后应用 LUT 渲染预设，并为前/右/上三象限启用厚板，保证后续截图与切片灰阶、切面一致。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• 渲染预设名称：渲染面板下拉中的预设项名称（须与 VG 中完全一致）。空则跳过预设步骤。" />
                                            <LineBreak />
                                            <Run Text="• 应用预设前等待(ms)：进入后处理后、点开预设下拉前的缓冲，避免面板未就绪。" />
                                            <LineBreak />
                                            <Run Text="• 预设下拉等待(ms)：等待预设 ComboBox 列表项可见/关闭的超时。Qt 下拉偶发慢时加大。" />
                                            <LineBreak />
                                            <Run Text="• 厚板菜单偏移X/Y：相对视口右键点的像素偏移，用于点中右键菜单「厚板」。分辨率/DPI 变化后需重标定。" />
                                            <LineBreak />
                                            <Run Text="• 视口右键Y偏移：相对视口中心的垂直偏移再右键。避开顶栏/标题时可设负值，保证点在内容区。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource ParamHelpIconTextStyle}" />
                            </Border>
                        </StackPanel>
                    </Expander.Header>
                    <Border
                        BorderBrush="LightGray"
                        BorderThickness="1,0,1,1"
                        CornerRadius="0,0,5,5">
                        <StackPanel>
                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="渲染预设名称"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="RenderingPresetName" UpdateSourceTrigger="PropertyChanged" />
                                    </hc:TextBox.Text>
                                </hc:TextBox>

                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="应用预设前等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="PresetApplyWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>

                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Title="预设下拉等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="PresetDropdownWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Title="厚板菜单偏移X"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="相对右键点的像素偏移，真机标定默认 90, 127">
                                    <hc:TextBox.Text>
                                        <Binding Path="ThickPlateMenuOffsetX" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="Int" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <hc:TextBox
                                    Width="245"
                                    hc:InfoElement.Title="厚板菜单偏移Y"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="真机标定默认 127">
                                    <hc:TextBox.Text>
                                        <Binding Path="ThickPlateMenuOffsetY" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="Int" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    hc:InfoElement.Title="视口右键Y偏移"
                                    hc:InfoElement.TitlePlacement="Left"
                                    ToolTip="相对视口中心的垂直偏移，避开顶栏时可设负值">
                                    <hc:TextBox.Text>
                                        <Binding Path="ViewportClickOffsetY" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="Int" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <Expander Margin="5">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="直方图灰度阈值（截图标定）" />
                            <Border Style="{StaticResource ParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource ParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="LUT 预设不保存直方图中间红线位置。通过截图分析峰谷后拖拽红线到目标灰阶（靠右约 2/3），压掉左侧噪点。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• X/Y/W/H：直方图 ROI 屏幕矩形。未标定则主流程跳过本步；须框住直方图主体（含红线可拖区域）。" />
                                            <LineBreak />
                                            <Run Text="• 截图目录：调试图（原图/对比/峰谷）保存根目录；实际写入「目录\yyyy-MM-dd」，超过 7 天自动清理。" />
                                            <LineBreak />
                                            <Run Text="• 掩膜颜色：直方图填充灰的 #RRGGBB，用于把该色换成纯绿再找峰。请取填充区色，勿取红线/蓝 LUT。" />
                                            <LineBreak />
                                            <Run Text="• 容差：掩膜每通道容差 0～64。过小漏检、过大易染绿面板渐变；替换纯绿时建议 0～4。" />
                                        </TextBlock>
