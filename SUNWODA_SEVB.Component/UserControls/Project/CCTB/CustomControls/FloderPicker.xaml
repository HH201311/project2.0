<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls.FloderPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="40"
    d:DesignWidth="400"
    Background="Transparent"
    mc:Ignorable="d">

    <Border
        Background="#0DFFFFFF"
        BorderThickness="0"
        CornerRadius="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                VerticalContentAlignment="Center"
                d:Text="D:\项目工作\涂布闭环\闭环框架及界面"
                Background="Transparent"
                BorderThickness="0"
                CaretBrush="#FFFFFFFF"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
                FontSize="14"
                Foreground="#CCFFFFFF"
                Text="{Binding FloderText, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                TextAlignment="Left" />
            <Button
                Grid.Column="1"
                Padding="10,0"
                d:Content="更改"
                Background="Transparent"
                BorderThickness="0"
                Click="FloderPick_Click"
                Content="{Binding PickerContent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                FontSize="14"
                Foreground="#FF3DCC84" />
        </Grid>
    </Border>
</UserControl>
