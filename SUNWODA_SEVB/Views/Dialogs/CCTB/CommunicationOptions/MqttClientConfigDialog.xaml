<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.CommunicationOptions.MqttClientConfigDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.CoatingOPMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    MinWidth="1000"
    MinHeight="400"
    d:Height="800"
    d:Width="1000"
    Background="Transparent"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  标题样式  -->
            <Style x:Key="ConfigTitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  表头样式  -->
            <Style x:Key="ConfigHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  文本样式  -->
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="{x:Type hc:TextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="400" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="220" />
            </Style>

            <!--  下拉框样式  -->
            <Style BasedOn="{StaticResource HCParamComboBoxStyle}" TargetType="{x:Type hc:ComboBox}">
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="Width" Value="400" />
                <Setter Property="Height" Value="30" />
                <Setter Property="hc:InfoElement.TitleWidth" Value="220" />
            </Style>

            <!--  开关样式  -->
            <Style
                x:Key="YNSimpleToggleButtonStyle"
                BasedOn="{StaticResource ParamValueSimpleToggleButtonStyle}"
                TargetType="{x:Type uccc:SimpleToggleButton}">
                <Setter Property="CheckedText" Value="是" />
                <Setter Property="UnCheckedText" Value="否" />
            </Style>

            <!--  键值对容器样式  -->
            <Style BasedOn="{StaticResource ParamPairContentControlStyle}" TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="Width" Value="400" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="PairKeyWidth" Value="220" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Background="#FF2B2B2B">
        <Grid Margin="20" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource ConfigTitleTextBlockStyle}"
                    Text="通讯及协议配置—客户端Mqtt" />
                <Button
                    Command="{Binding CloseCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconClosedButtonStyle}" />
            </DockPanel>

            <!--  通讯配置  -->
            <Border
                Grid.Row="1"
                Margin="0,20,0,0"
                Padding="20"
                Background="#0DFFFFFF"
                CornerRadius="10">
                <StackPanel Orientation="Vertical">
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource ConfigHeaderTextBlockStyle}" Text="通讯配置" />
                        <Button
                            Width="110"
                            Margin="10,0,0,0"
                            BorderBrush="#FF3DCC84"
                            Command="{Binding ResetOptionCommand}"
                            CommandParameter="{Binding CommunicationOptions}"
                            Content="恢复默认设置"
                            DockPanel.Dock="Right"
                            Foreground="#FF3DCC84"
                            Style="{StaticResource ParamCancleButtonStyle}" />
                    </DockPanel>
                    <Rectangle Margin="0,20,0,0" Style="{StaticResource ParamLineRectangleStyle}" />
                    <UniformGrid Columns="2">
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="客户端ID"
                            Text="{Binding CommunicationOptions.ClientId, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="-1 表示无限等待"
                            hc:InfoElement.Title="连接超时时间（ms）"
                            Text="{Binding CommunicationOptions.ConnectTimeout, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="用户名"
                            Text="{Binding CommunicationOptions.UserName, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="用户密码"
                            Text="{Binding CommunicationOptions.Password, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="保持连接周期（s）"
                            Text="{Binding CommunicationOptions.KeepAlivePeriod, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="发送保持连接消息的间隔（s）"
                            Text="{Binding CommunicationOptions.KeepAliveSendInterval, Mode=TwoWay}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  地址配置  -->
            <Border
                Grid.Row="2"
                Margin="0,20,0,0"
                Padding="20"
                Background="#0DFFFFFF"
                CornerRadius="10">
                <StackPanel Orientation="Vertical">
                    <DockPanel LastChildFill="False">
                        <TextBlock Style="{StaticResource ConfigHeaderTextBlockStyle}" Text="地址信息配置" />
                        <Button
                            Width="110"
                            Margin="10,0,0,0"
                            BorderBrush="#FF3DCC84"
                            Command="{Binding ResetAddressCommand}"
                            CommandParameter="{Binding AddressModel}"
                            Content="恢复默认设置"
                            DockPanel.Dock="Right"
                            Foreground="#FF3DCC84"
                            Style="{StaticResource ParamCancleButtonStyle}" />
                    </DockPanel>
                    <Rectangle Margin="0,20,0,0" Style="{StaticResource ParamLineRectangleStyle}" />
                    <UniformGrid Columns="2">
                        <hc:ComboBox
                            Width="400"
                            d:SelectedIndex="0"
                            hc:InfoElement.Title="通讯协议"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding ProtocolSource}"
                            SelectedValue="{Binding AddressModel.Protocol, Mode=TwoWay}"
                            SelectedValuePath="ItemValue" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="泵1调节地址"
                            Text="{Binding AddressModel.PumpAddress1, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="泵2调节地址"
                            Text="{Binding AddressModel.PumpAddress2, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="泵3调节地址"
                            Text="{Binding AddressModel.PumpAddress3, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="泵4调节地址"
                            Text="{Binding AddressModel.PumpAddress4, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="泵5调节地址"
                            Text="{Binding AddressModel.PumpAddress5, Mode=TwoWay}" />
                        <hc:TextBox
                            Width="400"
                            hc:InfoElement.Placeholder="请输入"
                            hc:InfoElement.Title="泵速调节信号地址"
                            Text="{Binding AddressModel.FlagAddress, Mode=TwoWay}" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!--  功能按钮  -->
            <StackPanel
                Grid.Row="3"
                Margin="0,20,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    Content="确认"
                    Style="{StaticResource ParamOKButtonStyle}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding CancleCommand}"
                    Content="取消"
                    Style="{StaticResource ParamCancleButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Border>

