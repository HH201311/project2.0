<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.ArithmeticSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="190"
    d:DesignWidth="510"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ArithmeticGropBoxStyle" TargetType="GroupBox">
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GroupBox">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <!--  Header  -->
                                    <StackPanel
                                        Grid.Row="0"
                                        Margin="20,20,20,0"
                                        VerticalAlignment="Stretch"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Margin="0,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontFamily="{TemplateBinding FontFamily}"
                                            FontSize="{TemplateBinding FontSize}"
                                            FontWeight="{TemplateBinding FontWeight}"
                                            Foreground="{TemplateBinding Foreground}"
                                            Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                            TextAlignment="Left" />
                                    </StackPanel>

                                    <!--  内容  -->
                                    <ContentPresenter Grid.Row="1" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  算法名称输入框样式  -->
            <Style x:Key="ArithmeticTextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Regular" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <!--  算法开关按钮样式  -->
            <Style x:Key="ArithmeticEnableToggleButtonStyle" TargetType="ToggleButton">
                <Setter Property="Width" Value="80" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Background" Value="#FF3DCC84" />
                <Setter Property="Content" Value="启用" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="5" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="关闭算法" />
                                    <Setter Property="Background" Value="#0DFFFFFF" />
                                    <Setter Property="Foreground" Value="#99FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid
            Width="50"
            Height="50"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            IsEnabled="{Binding IsArithmeticEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <Border Background="#0DFFFFFF" CornerRadius="0,10,0,50" />
            <Path
                Margin="17,11,8,21"
                Data="M25,2.11s-4,1.3-8.666,6.493a50.363,50.363,0,0,0-7,9.254A23.154,23.154,0,0,0,0,9.578L3.5,6.331a18.832,18.832,0,0,1,5.334,6.006A36.406,36.406,0,0,1,25,0Z"
                Fill="#FF3DCC84" />
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>
        <GroupBox
            d:Header="xx算法"
            Header="{Binding Header, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Style="{StaticResource ArithmeticGropBoxStyle}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>
                <Grid
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    ToolTip="单击Esc退出编辑&#x0a;单击Enter完成输入">
                    <Border
                        x:Name="Edit_Bd1"
                        BorderBrush="#FF3DCC84"
                        BorderThickness="0"
                        CornerRadius="5" />
                    <Grid
                        Margin="8,10,8,6"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Border
                                x:Name="Edit_Bd2"
                                Background="#FF3DCC84"
                                Opacity="0.1"
                                Visibility="Hidden" />
                            <TextBox
                                x:Name="ArithmeticName_TB"
                                d:Text="DY-ASDASDASDASDASD"
                                KeyDown="ArithmeticTB_KeyDown"
                                LostFocus="ArithmeticTB_LostFocus"
                                Style="{StaticResource ArithmeticTextBoxStyle}"
                                Text="{Binding ArithmeticName, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}" />
                        </Grid>
                        <Button
                            x:Name="Edit_Btn"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            Click="EditBtn_Click"
                            Style="{StaticResource ParamEditButtonStyle}" />
                    </Grid>
                </Grid>
                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ParamSettingClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                        Style="{StaticResource ParamFunctionButtonStyle}" />
                    <Rectangle Width="20" />
                    <ToggleButton
                        Command="{Binding ArithmeticEnableChangedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}"
                        IsChecked="{Binding IsArithmeticEnabled, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                        Style="{StaticResource ArithmeticEnableToggleButtonStyle}" />
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
