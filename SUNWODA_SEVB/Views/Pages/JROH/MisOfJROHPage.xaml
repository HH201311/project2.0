<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JROH.MisOfJROHPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:jrohuc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JROH;assembly=SUNWODA_SEVB.Component"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JROH"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uc="clr-namespace:SUNWODA_SEVB.Component.UserControls;assembly=SUNWODA_SEVB.Component"
    Title="MisOfJROHPage"
    d:Background="#FFFFFF"
    d:DesignHeight="800"
    d:DesignWidth="1100"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JROH/JROHCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style BasedOn="{StaticResource SimpleGroupBoxStyle}" TargetType="GroupBox" />
            <Style BasedOn="{StaticResource SimpleDataGridStyle}" TargetType="DataGrid" />

            <!--  曲线图统一外观：每个通道一个图  -->
            <Style TargetType="{x:Type jrohuc:MisMatchPlot}">
                <Setter Property="Margin" Value="2" />
                <Setter Property="ShowGrid" Value="True" />
                <Setter Property="ShowLegend" Value="True" />
                <Setter Property="YAxisLabel" Value="极耳错位 (mm)" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="320" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  曲线区：⏸ 模板占位（正极 / 负极各一路），待资料确认后按真实通道扩展  -->
        <UniformGrid Margin="4" Rows="1">
            <jrohuc:MisMatchPlot
                Title="正极极耳错位曲线"
                LineSeries1Collection="{Binding PositiveTabSeries1}"
                LineSeries2Collection="{Binding PositiveTabSeries2}" />
            <jrohuc:MisMatchPlot
                Title="负极极耳错位曲线"
                LineSeries1Collection="{Binding NegativeTabSeries1}"
                LineSeries2Collection="{Binding NegativeTabSeries2}" />
        </UniformGrid>

        <!--  调机日志（与曲线区同为 2 组）  -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="0,0,0,10"
                LastChildFill="False">
                <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="调机日志" />
                <Button
                    Command="{Binding BusinessParamCommand}"
                    Content="参数配置"
                    DockPanel.Dock="Right"
                    Style="{StaticResource SimpleButtonStyle}"
                    Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}" />
            </DockPanel>
            <!--  调机记录  -->
            <TabControl Grid.Row="1">
                <TabItem Header="正极极耳错位">
                    <DataGrid ItemsSource="{Binding PosRecordsView}" />
                </TabItem>
                <TabItem Header="负极极耳错位">
                    <DataGrid ItemsSource="{Binding NegRecordsView}" />
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
