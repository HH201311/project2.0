<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.JROH.BusinessDialogs.MisBusinessParamDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="576"
    Background="#FFFFFFFF"
    BorderBrush="#FFE2E8F0"
    BorderThickness="1"
    CornerRadius="10">
    <Border.Resources>
        <ResourceDictionary>
            <!--  ============ 取色：对齐 JROH 主界面（浅色） ============  -->
            <SolidColorBrush x:Key="StrokeBrush" Color="#FFE2E8F0" />
            <SolidColorBrush x:Key="InputStrokeBrush" Color="#FFCBD5E1" />
            <SolidColorBrush x:Key="SectionBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="InputHiBrush" Color="#FFF1F5F9" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1E293B" />
            <SolidColorBrush x:Key="TextBodyBrush" Color="#FF334155" />
            <SolidColorBrush x:Key="TextSubBrush" Color="#FF94A3B8" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF3DCC84" />
            <SolidColorBrush x:Key="ConfirmBrush" Color="#FF29CC7A" />

            <!--  ============ 标题 ============  -->
            <Style x:Key="DialogTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="19" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="DialogKeyStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="CloseIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FF64748B" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFF1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ============ Tab（浅色；项间距放在模板内部） ============  -->
            <Style x:Key="LightTabItemStyle" TargetType="TabItem">
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="#FF64748B" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2" />
                                </Grid.RowDefinitions>
                                <ContentPresenter
                                    Grid.Row="0"
                                    Margin="10,4,10,6"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Header">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="LineHeight" Value="20" />
                                            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Border
                                    x:Name="ul"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    CornerRadius="1" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ul" Property="Background" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LightTabControlStyle" TargetType="TabControl">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,12,0,0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel
                                    Grid.Row="0"
                                    HorizontalAlignment="Left"
                                    IsItemsHost="True"
                                    Orientation="Horizontal" />
                                <ContentPresenter
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    ContentSource="SelectedContent" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  ============ 分区（区块） ============  -->
            <Style x:Key="SectionBarStyle" TargetType="Border">
                <Setter Property="Width" Value="3" />
                <Setter Property="Height" Value="14" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                <Setter Property="Margin" Value="9,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionHintStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionBodyStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SectionBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,12,16,12" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <!--  ============ 列头与行 ============  -->
            <Style x:Key="ColHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style
                x:Key="ColHeaderLeftStyle"
                BasedOn="{StaticResource ColHeaderStyle}"
                TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="RowLabelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NoteTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="ParamRowStyle" TargetType="Grid">
                <Setter Property="Margin" Value="0,2" />
            </Style>

            <!--  ============ 输入框 ============  -->
            <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="30" />
                <Setter Property="Padding" Value="0,0,10,0" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                <Setter Property="Background" Value="#FFFFFFFF" />
                <Setter Property="BorderBrush" Value="{StaticResource InputStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border
                                x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextSubBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="bd" Property="Background" Value="#FFECFDF5" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
                x:Key="ParamTextBoxCenterStyle"
                BasedOn="{StaticResource ParamTextBoxStyle}"
                TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource InputHiBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource TextSubBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <!--  ============ 二选一开关（保留 Tag 文案机制；做法同 OH 的 CCD 检测面） ============  -->
            <Style x:Key="PillSwitchStyle" TargetType="ToggleButton">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="110" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="#FF64748B" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="bd"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource InputStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="dot"
                                        Width="7"
                                        Height="7"
                                        Margin="0,0,7,0"
                                        Fill="{StaticResource TextSubBrush}" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFECFDF5" />
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    <Setter TargetName="dot" Property="Fill" Value="{StaticResource AccentBrush}" />
                                    <Setter Property="Foreground" Value="#FF047857" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource TextSubBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!--  电芯结构：单极耳 / 双极耳  -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="单双极耳" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="单极耳" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="单双极耳" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="双极耳" />
                    </MultiTrigger>
                    <!--  周长一致性数据：正极 / 负极  -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="正负极" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="正极" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="正负极" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="负极" />
                    </MultiTrigger>
                    <!--  入料调节频次：2n / 3n  -->
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="2n3n" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="2n" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="2n3n" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="3n" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--  ============ 提示条 ============  -->
            <Style x:Key="TipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#FFFFFBEB" />
                <Setter Property="BorderBrush" Value="#FFFDE68A" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>

            <Style x:Key="TipTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="#FF92400E" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  ============ 底栏与按钮 ============  -->
            <Style x:Key="FooterNoteStyle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Regular}" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{StaticResource TextSubBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ConfirmButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="86" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="Content" Value="保存" />
                <Setter Property="Command" Value="{Binding ConfirmCommand}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Background="{StaticResource ConfirmBrush}"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FF22B76D" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CancelButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="86" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Margin" Value="10,0,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}" />
                <Setter Property="Content" Value="取消" />
                <Setter Property="Command" Value="{Binding CancleCommand}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bd"
                                Background="#FFFFFFFF"
                                BorderBrush="{StaticResource InputStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFF1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel Grid.Row="0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <TextBlock Style="{StaticResource DialogTitleStyle}" Text="极耳错位闭环 · 参数配置" />
                <TextBlock Style="{StaticResource DialogKeyStyle}" Text="MisBusinessParam" />
            </StackPanel>
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource CloseIconButtonStyle}" />
        </DockPanel>

        <Border
            Grid.Row="1"
            Height="1"
            Margin="0,14,0,0"
            Background="{StaticResource StrokeBrush}" />

        <!--  内容  -->
        <TabControl Grid.Row="2" Style="{StaticResource LightTabControlStyle}">
            <!--  ============ 组 1：CP控制参数（单列） ============  -->
            <TabItem Header="CP控制参数" Style="{StaticResource LightTabItemStyle}">
                <ScrollViewer
                    Width="538"
                    MaxHeight="360"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="CP 控制参数" />
                            <TextBlock Style="{StaticResource SectionHintStyle}" Text="单列；符号项待现场给定数值" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="极耳错位量" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MisalignmentOfTab, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="d ⏸ 待现场数值" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="电芯结构" />
                                    <ToggleButton
                                        Grid.Column="1"
                                        IsChecked="{Binding ItemSource.IsSingleTab, Mode=TwoWay}"
                                        Style="{StaticResource PillSwitchStyle}"
                                        Tag="单双极耳" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="单极耳 / 双极耳" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="卷针周长" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.NeedleCircumference, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="默认 265" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="正极近边距" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.NearEdgeOfPos, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="默认 24" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="负极近边距" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.NearEdgeOfNeg, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="默认 24" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="电芯隔膜长度" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.DiaphragmLengthOfCell, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="L0标准 ⏸ 待现场数值" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="每卷隔膜总长" />
                                    <TextBox
                                        Grid.Column="1"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.TotalDiaphragmLengthPerRoll, Mode=TwoWay}" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource NoteTextStyle}"
                                        Text="L总 ⏸ 待现场数值" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource TipBorderStyle}">
                            <TextBlock Style="{StaticResource TipTextStyle}" Text="⚠ 表中以符号给出的项（d / L0标准 / L总 / a / b / △S / D中 / D尾）暂无具体数值，默认置 0；现场确认后请更新本界面与 docs/JROH/配置键表.csv。" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!--  ============ 组 2：设备控制参数 ============  -->
            <TabItem Header="设备控制参数" Style="{StaticResource LightTabItemStyle}">
                <ScrollViewer
                    Width="538"
                    MaxHeight="360"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  ===== 缓存与卷针：每行两组，组间距 28 =====  -->
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="缓存与卷针" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="118"
                                            Style="{StaticResource RowLabelStyle}"
                                            Text="正极缓存个数" />
                                        <TextBox
                                            Width="98"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ParamTextBoxCenterStyle}"
                                            Text="{Binding ItemSource.CacheCountOfPos, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="118"
                                            Style="{StaticResource RowLabelStyle}"
                                            Text="负极缓存个数" />
                                        <TextBox
                                            Width="98"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ParamTextBoxCenterStyle}"
                                            Text="{Binding ItemSource.CacheCountOfNeg, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="118"
                                            Style="{StaticResource RowLabelStyle}"
                                            Text="设备卷针个数" />
                                        <TextBox
                                            Width="98"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ParamTextBoxCenterStyle}"
                                            Text="{Binding ItemSource.NeedleCount, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="118"
                                            Style="{StaticResource RowLabelStyle}"
                                            Text="1mm周长变径" />
                                        <TextBox
                                            Width="98"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ParamTextBoxCenterStyle}"
                                            Text="{Binding ItemSource.DiameterChangePerMm, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="118"
                                            Style="{StaticResource RowLabelStyle}"
                                            Text="变径调节频次" />
                                        <TextBox
                                            Width="98"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource ParamTextBoxCenterStyle}"
                                            Text="{Binding ItemSource.DiameterAdjustFrequency, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <TextBlock
                                            Width="118"
                                            Style="{StaticResource RowLabelStyle}"
                                            Text="周长一致性数据" />
                                        <ToggleButton
                                            Width="98"
                                            Margin="8,0,0,0"
                                            IsChecked="{Binding ItemSource.IsPosConsistency, Mode=TwoWay}"
                                            Style="{StaticResource PillSwitchStyle}"
                                            Tag="正负极" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  ===== 换卷收集数：三组，组间距 24 =====  -->
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="换卷收集数" />
                            <TextBlock Style="{StaticResource SectionHintStyle}" Text="隔膜 / 正极 / 负极" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <Grid Style="{StaticResource ParamRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="换隔膜收集数" />
                                    <TextBox
                                        Width="64"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.CollectCountOfDiaphragm, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="换正极收集数" />
                                    <TextBox
                                        Width="64"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.CollectCountOfPos, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="4"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource RowLabelStyle}" Text="换负极收集数" />
                                    <TextBox
                                        Width="64"
                                        Margin="8,0,0,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.CollectCountOfNeg, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  ===== 限幅 =====  -->
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="限幅" />
                            <TextBlock Style="{StaticResource SectionHintStyle}" Text="模切 / 变径 / 入料" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource ColHeaderLeftStyle}"
                                        Text="项目" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource ColHeaderStyle}"
                                        Text="最大限幅" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource ColHeaderStyle}"
                                        Text="最小限幅" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="模切" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MaxLimitOfDieCut, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MinLimitOfDieCut, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="变径" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MaxLimitOfDiameterChange, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MinLimitOfDiameterChange, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="入料" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MaxLimitOfInfeed, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.MinLimitOfInfeed, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  ===== 调节频次 =====  -->
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="调节频次" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <Grid Style="{StaticResource ParamRowStyle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Style="{StaticResource RowLabelStyle}"
                                    Text="入料调节频次" />
                                <ToggleButton
                                    Grid.Column="1"
                                    IsChecked="{Binding ItemSource.Is2nInfeedFrequency, Mode=TwoWay}"
                                    Style="{StaticResource PillSwitchStyle}"
                                    Tag="2n3n" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource NoteTextStyle}"
                                    Text="2n / 3n" />
                            </Grid>
                        </Border>

                        <!--  ===== 前馈错位 =====  -->
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Border Style="{StaticResource SectionBarStyle}" />
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="前馈错位" />
                            <TextBlock Style="{StaticResource SectionHintStyle}" Text="隔膜 / 正极 / 负极" />
                        </StackPanel>

                        <Border Style="{StaticResource SectionBodyStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource ColHeaderLeftStyle}"
                                        Text="项目" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource ColHeaderStyle}"
                                        Text="前馈中间错位（D中）" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Style="{StaticResource ColHeaderStyle}"
                                        Text="前馈首尾错位（D尾）" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="隔膜" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.FeedforwardMiddleMisalignmentOfDiaphragm, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.FeedforwardEndMisalignmentOfDiaphragm, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="正极" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.FeedforwardMiddleMisalignmentOfPos, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.FeedforwardEndMisalignmentOfPos, Mode=TwoWay}" />
                                </Grid>

                                <Grid Style="{StaticResource ParamRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        Style="{StaticResource RowLabelStyle}"
                                        Text="负极" />
                                    <TextBox
                                        Grid.Column="1"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.FeedforwardMiddleMisalignmentOfNeg, Mode=TwoWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        Style="{StaticResource ParamTextBoxCenterStyle}"
                                        Text="{Binding ItemSource.FeedforwardEndMisalignmentOfNeg, Mode=TwoWay}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!--  底栏  -->
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <Border Height="1" Background="{StaticResource StrokeBrush}" />
            <DockPanel Margin="0,10,0,0">
                <StackPanel
                    Margin="18,0,0,0"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button Style="{StaticResource ConfirmButtonStyle}" />
                    <Button Style="{StaticResource CancelButtonStyle}" />
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource FooterNoteStyle}"
                    Text="保存后需二次确认才会写入；取消或关闭不修改。" />
            </DockPanel>
        </StackPanel>
    </Grid>
</Border>
