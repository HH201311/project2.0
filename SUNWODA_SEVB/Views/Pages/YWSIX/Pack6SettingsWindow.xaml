<Window
    x:Class="SUNWODA_SEVB.Views.Pages.YWSIX.Pack6SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="功能设置"
    Width="680"
    Height="560"
    MinWidth="600"
    MinHeight="420"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResizeWithGrip"
    Background="#FFF5F8FC">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="路径 / 其它" />

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="电芯" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,4,12,4"
                        Text="{Binding CellType, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,6" VerticalAlignment="Center" Text="工位产线" />
                    <TextBox
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="0,4,0,4"
                        Text="{Binding ProductionLine, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox
                        Grid.Row="1"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,8"
                        Content="模拟检测（不调 YWX01Pack）"
                        IsChecked="{Binding UseSimulation}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="结果根目录" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,4,0,4"
                        Text="{Binding LocalPathPre, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="SaveImage根" />
                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,4,0,4"
                        Text="{Binding YOkRootPath, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="缺张超时(分)" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,4,12,4"
                        Text="{Binding PackMissingTimeoutMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Margin="0,6" VerticalAlignment="Center" Text="白标签版本号" />
                    <TextBox
                        Grid.Row="4"
                        Grid.Column="3"
                        Margin="0,4,0,4"
                        ToolTip="期望版本，默认 M00；空=不校验"
                        Text="{Binding ExpectedWhiteLabelVersion, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,6" VerticalAlignment="Center" Text="上盖模型路径" />
                    <TextBox
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="0,4,0,4"
                        ToolTip="默认 Dlls\YWSIX\YW_X01_TOP.onnx"
                        Text="{Binding TopCoverModelPath, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox
                        Grid.Row="6"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,4"
                        Content="上盖 YOLO 使用 GPU"
                        IsChecked="{Binding TopCoverUseGpu}" />
                </Grid>

                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="Gray"
                    Text="PIN 等工艺阈值请用右侧「参数设置」（需管理员，运行中可改）。" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Width="100"
                Margin="0,0,8,0"
                Click="OnSaveClick"
                Content="保存"
                FontWeight="SemiBold" />
            <Button
                Width="100"
                Click="OnCloseClick"
                Content="关闭"
                IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
