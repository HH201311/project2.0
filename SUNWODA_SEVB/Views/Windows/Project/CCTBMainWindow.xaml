<hc:Window
    x:Class="SUNWODA_SEVB.Views.Windows.Project.CCTBMainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converter="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:interactivity="clr-namespace:HandyControl.Interactivity;assembly=HandyControl"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Windows.Project"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:uccctb="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    Title="单机数字化平台"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    AllowsTransparency="True"
    Background="#FF121212"
    Foreground="White"
    WindowState="Maximized"
    WindowStyle="None"
    mc:Ignorable="d">
    <!--  添加资源和转换器  -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style BasedOn="{StaticResource IndustrialGrowlStyle}" TargetType="hc:Growl" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!--  顶部标题栏  -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Orientation="Vertical">
            <DockPanel
                Height="20"
                Background="#0DFFFFFF"
                LastChildFill="True">
                <TextBlock
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Left"
                    FontFamily="{Binding FontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontStretch="{Binding FontStretch, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontStyle="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=Window}}"
                    FontWeight="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=Window}}"
                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}"
                    Opacity="0.8"
                    Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                    TextAlignment="Center" />
                <StackPanel
                    Margin="0,0,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        Click="Minimize_Click"
                        Content="&#xe679;"
                        Style="{StaticResource ControlButtonStyle}" />
                    <Button
                        Click="Reduction_Click"
                        Content="&#xe6a2;"
                        Style="{StaticResource ControlButtonStyle}" />
                    <Button
                        Background="DarkRed"
                        Click="Close_Click"
                        Content="&#xe669;"
                        Style="{StaticResource ControlButtonStyle}" />
                </StackPanel>
                <Border
                    Margin="20,0,20,0"
                    Background="Transparent"
                    DockPanel.Dock="Right"
                    MouseLeftButtonDown="TopHeader_MouseLeftButtonDown"
                    MouseLeftButtonUp="TopHeader_MouseDoubleClick" />
            </DockPanel>
            <Rectangle
                Height="1"
                Opacity="0.2"
                Stroke="#CCFFFFFF" />
        </StackPanel>

        <!--  顶部状态栏  -->
        <DockPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Background="#0DFFFFFF"
            LastChildFill="False">
            <Image
                Height="40"
                Margin="20,0,0,0"
                Source="/Assets/images/logo.png"
                Stretch="Uniform" />
            <TextBlock
                Margin="20,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="{StaticResource CCTB.AlimamaShuHeiTi}"
                FontSize="40"
                FontWeight="Bold"
                Foreground="#FFFFFFFF"
                Opacity="0.8"
                Text="涂布控制系统" />
            <UniformGrid Margin="100,0,0,0" Rows="1">
                <ToggleButton
                    Margin="0,0,10,0"
                    Command="{Binding DeviceSwitchoverCommand}"
                    CommandParameter="{Binding}"
                    Content="涂布机"
                    Style="{StaticResource DeviceToggleButtonStyle}" />
                <ToggleButton
                    Margin="0,0,10,0"
                    Command="{Binding DeviceSwitchoverCommand}"
                    CommandParameter="{Binding}"
                    Content="测重仪"
                    Style="{StaticResource DeviceToggleButtonStyle}" />
                <ToggleButton
                    Margin="0,0,10,0"
                    Command="{Binding DeviceSwitchoverCommand}"
                    CommandParameter="{Binding}"
                    Content="模头A"
                    Style="{StaticResource DeviceToggleButtonStyle}" />
                <ToggleButton
                    Margin="0,0,10,0"
                    Command="{Binding DeviceSwitchoverCommand}"
                    CommandParameter="{Binding}"
                    Content="模头B"
                    Style="{StaticResource DeviceToggleButtonStyle}" />
                <ToggleButton
                    Margin="0,0,10,0"
                    Command="{Binding DeviceSwitchoverCommand}"
                    CommandParameter="{Binding}"
                    Content="CCD"
                    Style="{StaticResource DeviceToggleButtonStyle}" />
            </UniformGrid>
            <Rectangle
                Width="1"
                Height="50"
                Margin="10,0,10,0"
                VerticalAlignment="Center"
                Opacity="0.5"
                Stroke="#CCFFFFFF" />
            <UniformGrid Margin="10,10,0,10" Rows="2">
                <uccctb:ClosedLoopToggleButton
                    Margin="0,0,30,0"
                    Command="{Binding ControlSwitchoverCommand}"
                    Text="A面-TD闭环" />
                <uccctb:ClosedLoopToggleButton
                    Margin="0,0,30,0"
                    Command="{Binding ControlSwitchoverCommand}"
                    Text="A面-MD闭环" />
                <uccctb:ClosedLoopToggleButton
                    Margin="0,0,30,0"
                    Command="{Binding ControlSwitchoverCommand}"
                    Text="A面-尺寸闭环" />
                <uccctb:ClosedLoopToggleButton
                    Margin="0,0,30,0"
                    Command="{Binding ControlSwitchoverCommand}"
                    Text="B面-TD闭环" />
                <uccctb:ClosedLoopToggleButton
                    Margin="0,0,30,0"
                    Command="{Binding ControlSwitchoverCommand}"
                    Text="B面-MD闭环" />
                <uccctb:ClosedLoopToggleButton
                    Margin="0,0,30,0"
                    Command="{Binding ControlSwitchoverCommand}"
                    Text="B面-尺寸闭环" />
            </UniformGrid>

            <!--  登录用户信息  -->
            <StackPanel
                Margin="0,0,20,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <Grid>
                    <Ellipse
                        Width="40"
                        Height="40"
                        Fill="#FF29CC7A"
                        Opacity="0.1" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                        FontSize="20"
                        Foreground="#FF29CC7A"
                        Text="小"
                        TextAlignment="Center" />
                </Grid>

                <TextBlock
                    Margin="10,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Bold}"
                    FontSize="20"
                    Foreground="#CCFFFFFF"
                    Text="林小小"
                    TextAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!--  左侧导航栏  -->
        <StackPanel
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Center"
            Background="#0DFFFFFF"
            Orientation="Vertical">
            <RadioButton
                Command="{Binding MonitoringCommand}"
                Content="生产监控"
                IsChecked="True"
                Style="{StaticResource NavigationRadioButtonStyle}"
                Tag="&#xe602;" />
            <RadioButton
                Command="{Binding SettingsCommand}"
                Content="系统设置"
                IsChecked="False"
                Style="{StaticResource NavigationRadioButtonStyle}"
                Tag="&#xe603;" />
            <RadioButton
                Command="{Binding RecordingsCommand}"
                Content="系统记录"
                IsChecked="False"
                Style="{StaticResource NavigationRadioButtonStyle}"
                Tag="&#xe601;" />
        </StackPanel>

        <!--  内容区  -->
        <Grid
            Grid.Row="2"
            Grid.Column="1"
            Margin="20"
            Background="Transparent">
            <Frame x:Name="NavigationFrame" NavigationUIVisibility="Hidden">
                <Frame.Resources>
                    <!--  添加淡入淡出动画  -->
                    <Style TargetType="Frame">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Frame">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter x:Name="PART_FrameCP">
                                            <ContentPresenter.RenderTransform>
                                                <TranslateTransform />
                                            </ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Frame.Resources>
            </Frame>

            <!--  Growl 专用容器  -->
            <ScrollViewer
                Width="Auto"
                Margin="0,0,0,-20"
                HorizontalAlignment="Right"
                VerticalAlignment="Top">
                <StackPanel
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    hc:Growl.Token="ProductionMonitor" />
            </ScrollViewer>
        </Grid>
    </Grid>
</hc:Window>