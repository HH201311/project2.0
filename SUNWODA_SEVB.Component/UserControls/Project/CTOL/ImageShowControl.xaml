<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CTOL.ImageShowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CTOL"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid
        x:Name="rootGrid"
        Background="Transparent"
        ClipToBounds="True"
        Tag="{Binding RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}">
        <Image
            x:Name="imageControl"
            Grid.Row="1"
            MaxWidth="{Binding ActualWidth, ElementName=rootGrid}"
            MaxHeight="{Binding ActualHeight, ElementName=rootGrid}"
            Margin="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5"
            Stretch="Uniform">

            <Image.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="imageScaleTransform" ScaleX="{Binding RealTimeImageScaleX, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" ScaleY="{Binding RealTimeImageScaleY, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" />
                    <TranslateTransform x:Name="imageTranslateTransform" X="{Binding RealTimeImageTranslateX, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" Y="{Binding RealTimeImageTranslateY, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" />
                </TransformGroup>
            </Image.RenderTransform>

            <behaviors:Interaction.Triggers>

                <!--  滚轮缩放命令  -->
                <behaviors:EventTrigger EventName="MouseWheel">
                    <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>

                <!--  鼠标按下（开始拖动）命令  -->
                <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>

                <!--  鼠标移动（拖动中）命令  -->
                <behaviors:EventTrigger EventName="MouseMove">
                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>

                <!--  鼠标松开（结束拖动）命令  -->
                <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>

                <!--  鼠标离开控件（强制结束拖动）  -->
                <behaviors:EventTrigger EventName="MouseLeave">
                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" PassEventArgsToCommand="True" />
                </behaviors:EventTrigger>
            </behaviors:Interaction.Triggers>
            <!--  图片上双击还原  -->
            <Image.InputBindings>
                <MouseBinding Command="{Binding ResetRealTimeImageZoomCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" MouseAction="LeftDoubleClick" />
            </Image.InputBindings>
        </Image>

        <Grid.InputBindings>
            <MouseBinding Command="{Binding ResetRealTimeImageZoomCommand, RelativeSource={RelativeSource AncestorType=local:ImageShowControl}}" MouseAction="LeftDoubleClick" />
        </Grid.InputBindings>
        <Grid.ContextMenu>
            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                <MenuItem Command="{Binding ZoomInRealTimeCommand}" Header="放大" />
                <MenuItem Command="{Binding ZoomOutRealTimeCommand}" Header="缩小" />
                <MenuItem Command="{Binding ResetRealTimeImageZoomCommand}" Header="适应窗口" />
            </ContextMenu>
        </Grid.ContextMenu>
    </Grid>
</UserControl>
