<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.JROH.BusinessDialogs.OHBusinessParamDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.JROH.BusinessDialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="Auto"
    Height="Auto"
    MinWidth="600"
    MinHeight="400"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JROH/JROHCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />

            <!--  标题样式  -->
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  关闭按钮  -->
            <Style x:Key="ClosedButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  参数组容器样式  -->
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="Margin" Value="0,20,20,0" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style BasedOn="{StaticResource HCTabControlStyle}" TargetType="{x:Type hc:TabControl}">
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!--  参数组名样式  -->
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>

            <!--  分割线样式  -->
            <Style TargetType="Rectangle">
                <Setter Property="Margin" Value="0,10,0,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Stroke" Value="#33FFFFFF" />
            </Style>

            <Style x:Key="ColumnHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <Style x:Key="RowHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
            </Style>

            <!--  参数控件值样式  -->
            <Style TargetType="TextBox">
                <Setter Property="Margin" Value="10,10,10,0" />
                <Setter Property="Width" Value="Auto" />
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="ToggleButton">
                <Setter Property="Margin" Value="10,10,10,0" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="DarkSlateGray" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Style.Triggers>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="开关" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="开" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="开关" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="关" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="启用关闭" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="已启用" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="启用关闭" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="已关闭" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="True" />
                            <Condition Property="Tag" Value="正反面" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="正面" />
                    </MultiTrigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsChecked" Value="False" />
                            <Condition Property="Tag" Value="正反面" />
                        </MultiTrigger.Conditions>
                        <Setter Property="Content" Value="反面" />
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!--  功能按钮  -->
            <Style
                x:Key="ConfirmButtonStyle"
                BasedOn="{StaticResource GrowlConfirmButtonStyle}"
                TargetType="Button">
                <Setter Property="Margin" Value="20,0,0,0" />
                <Setter Property="Background" Value="#FF3DCC84" />
                <Setter Property="Content" Value="保存" />
                <Setter Property="Command" Value="{Binding ConfirmCommand}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style
                x:Key="CancleButtonStyle"
                BasedOn="{StaticResource GrowlCancleButtonStyle}"
                TargetType="Button">
                <Setter Property="Margin" Value="20,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Content" Value="取消" />
                <Setter Property="Command" Value="{Binding CancleCommand}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel VerticalAlignment="Center" LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="参数配置窗口" />
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource ClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <hc:TabControl
            Grid.Row="1"
            MinWidth="400"
            MinHeight="500">
            <hc:TabItem Header="CP管控参数" Style="{StaticResource HCTabItemStyle}">
                <Grid Width="500" Margin="10,20,10,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource ColumnHeaderTextBlockStyle}"
                        Text="CP管控项目" />
                    <UniformGrid
                        Grid.Row="0"
                        Grid.Column="1"
                        Columns="3">
                        <TextBlock Style="{StaticResource ColumnHeaderTextBlockStyle}" Text="基准值" />
                        <TextBlock Style="{StaticResource ColumnHeaderTextBlockStyle}" Text="范围下限值" />
                        <TextBlock Style="{StaticResource ColumnHeaderTextBlockStyle}" Text="范围上限值" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="隔膜总宽度" />
                    <UniformGrid
                        Grid.Row="1"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="78.9" Text="{Binding ItemSource.TotalWidthOfMold_Center, Mode=TwoWay}" />
                        <TextBox d:Text="78.5" Text="{Binding ItemSource.TotalWidthOfMold_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="79.3" Text="{Binding ItemSource.TotalWidthOfMold_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="负极极片总宽" />
                    <UniformGrid
                        Grid.Row="2"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="72.7" Text="{Binding ItemSource.PoleWidthOfNeg_Center, Mode=TwoWay}" />
                        <TextBox d:Text="72.2" Text="{Binding ItemSource.PoleWidthOfNeg_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="73.2" Text="{Binding ItemSource.PoleWidthOfNeg_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="正极极片总宽" />
                    <UniformGrid
                        Grid.Row="3"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="72.9" Text="{Binding ItemSource.PoleWidthOfPos_Center, Mode=TwoWay}" />
                        <TextBox d:Text="72.4" Text="{Binding ItemSource.PoleWidthOfPos_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="73.4" Text="{Binding ItemSource.PoleWidthOfPos_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="正极极片涂膜宽度" />
                    <UniformGrid
                        Grid.Row="4"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="70.5" Text="{Binding ItemSource.CoatedWidthOfPos_Center, Mode=TwoWay}" />
                        <TextBox d:Text="70" Text="{Binding ItemSource.CoatedWidthOfPos_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="71" Text="{Binding ItemSource.CoatedWidthOfPos_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="正极CIL基准宽度" />
                    <UniformGrid
                        Grid.Row="5"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="3.1" Text="{Binding ItemSource.CilWidthOfPos_Center, Mode=TwoWay}" />
                        <TextBox d:Text="2.2" Text="{Binding ItemSource.CilWidthOfPos_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="3.7" Text="{Binding ItemSource.CilWidthOfPos_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="负极到正极AC(顶部)" />
                    <UniformGrid
                        Grid.Row="6"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="1.7" Text="{Binding ItemSource.NegToPosACTop_Center, Mode=TwoWay}" />
                        <TextBox d:Text="0.3" Text="{Binding ItemSource.NegToPosACTop_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="3.7" Text="{Binding ItemSource.NegToPosACTop_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="负极到正极AC(底部)" />
                    <UniformGrid
                        Grid.Row="7"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="1.0" Text="{Binding ItemSource.NegToPosACBottom_Center, Mode=TwoWay}" />
                        <TextBox d:Text="0.3" Text="{Binding ItemSource.NegToPosACBottom_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="3.7" Text="{Binding ItemSource.NegToPosACBottom_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="隔膜到负极SA（底部)" />
                    <UniformGrid
                        Grid.Row="8"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="3.3" Text="{Binding ItemSource.MoldToNegSABottom_Center, Mode=TwoWay}" />
                        <TextBox d:Text="0.5" Text="{Binding ItemSource.MoldToNegSABottom_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="5.6" Text="{Binding ItemSource.MoldToNegSABottom_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="隔膜到负极SA（顶部)" />
                    <UniformGrid
                        Grid.Row="9"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="2.5" Text="{Binding ItemSource.MoldToNegSATop_Center, Mode=TwoWay}" />
                        <TextBox d:Text="1" Text="{Binding ItemSource.MoldToNegSATop_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="5.6" Text="{Binding ItemSource.MoldToNegSATop_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="隔膜到 CIL（顶部)" />
                    <UniformGrid
                        Grid.Row="10"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="1.8" Text="{Binding ItemSource.MoldToCILTop_Center, Mode=TwoWay}" />
                        <TextBox d:Text="0.5" Text="{Binding ItemSource.MoldToCILTop_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="5.6" Text="{Binding ItemSource.MoldToCILTop_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="11"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="CIL超负极（顶部)" />
                    <UniformGrid
                        Grid.Row="11"
                        Grid.Column="1"
                        Columns="3">
                        <TextBox d:Text="1.4" Text="{Binding ItemSource.CilOverNegTop_Center, Mode=TwoWay}" />
                        <TextBox d:Text="0.1" Text="{Binding ItemSource.CilOverNegTop_LowerLimit, Mode=TwoWay}" />
                        <TextBox d:Text="3.9" Text="{Binding ItemSource.CilOverNegTop_UpperLimit, Mode=TwoWay}" />
                    </UniformGrid>
                </Grid>
            </hc:TabItem>
            <hc:TabItem Header="调机相关配置" Style="{StaticResource HCTabItemStyle}">
                <Grid Width="500" Margin="10,20,10,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource ColumnHeaderTextBlockStyle}"
                        Text="闭环控制项目" />
                    <UniformGrid
                        Grid.Row="0"
                        Grid.Column="1"
                        Columns="2">
                        <TextBlock Style="{StaticResource ColumnHeaderTextBlockStyle}" Text="正极" />
                        <TextBlock Style="{StaticResource ColumnHeaderTextBlockStyle}" Text="负极" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="方向修正系数" />
                    <UniformGrid
                        Grid.Row="1"
                        Grid.Column="1"
                        Columns="2">
                        <TextBox d:Text="1" Text="{Binding ItemSource.AdjustCorrectionOfPos, Mode=TwoWay}" />
                        <TextBox d:Text="-1" Text="{Binding ItemSource.AdjustCorrectionOfNeg, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="OH数据前分段个数" />
                    <UniformGrid
                        Grid.Row="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">
                        <TextBox d:Text="5" Text="{Binding ItemSource.CountOfFrontEnd, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="3"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="OH数据后分段个数" />
                    <UniformGrid
                        Grid.Row="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">
                        <TextBox d:Text="100" Text="{Binding ItemSource.CountOfBackEnd, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="4"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="正极卷绕CCD检测面" />
                    <UniformGrid
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">
                        <ToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ItemSource.IsFrontOfPosDetextion, Mode=TwoWay}"
                            Tag="正反面" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="5"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="正极双面OH控制开启" />
                    <UniformGrid
                        Grid.Row="5"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">
                        <ToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ItemSource.DoubleSideEnableOfPos, Mode=TwoWay}"
                            Tag="启用关闭" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="6"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="料线向大板移动0.15所需要的纠偏值"
                        TextWrapping="Wrap" />
                    <UniformGrid
                        Grid.Row="6"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">
                        <TextBox d:Text="2" Text="{Binding ItemSource.K, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="7"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="限幅调整最大值" />
                    <UniformGrid
                        Grid.Row="7"
                        Grid.Column="1"
                        Columns="2">
                        <TextBox d:Text="1" Text="{Binding ItemSource.MaxLimitOfPos, Mode=TwoWay}" />
                        <TextBox d:Text="-1" Text="{Binding ItemSource.MaxLimitOfNeg, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="8"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="限幅调整最小值" />
                    <UniformGrid
                        Grid.Row="8"
                        Grid.Column="1"
                        Columns="2">
                        <TextBox d:Text="1" Text="{Binding ItemSource.MinLimitOfPos, Mode=TwoWay}" />
                        <TextBox d:Text="-1" Text="{Binding ItemSource.MinLimitOfNeg, Mode=TwoWay}" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="9"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="闭环功能开启按钮" />
                    <UniformGrid
                        Grid.Row="9"
                        Grid.Column="1"
                        Columns="2">
                        <ToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ItemSource.ClosedLoopEnablePos, Mode=TwoWay}"
                            Tag="启用关闭" />
                        <ToggleButton
                            d:IsChecked="False"
                            IsChecked="{Binding ItemSource.ClosedLoopEnableNeg, Mode=TwoWay}"
                            Tag="启用关闭" />
                    </UniformGrid>
                    <TextBlock
                        Grid.Row="10"
                        Grid.Column="0"
                        Style="{StaticResource RowHeaderTextBlockStyle}"
                        Text="调节频次（S电芯数）" />
                    <UniformGrid
                        Grid.Row="10"
                        Grid.Column="1"
                        Grid.ColumnSpan="2">
                        <TextBox d:Text="2" Text="{Binding ItemSource.AdjustFrequency, Mode=TwoWay}" />
                    </UniformGrid>
                </Grid>
            </hc:TabItem>
        </hc:TabControl>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button Style="{StaticResource ConfirmButtonStyle}" />
            <Button Style="{StaticResource CancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

