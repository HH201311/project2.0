<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.UserOperation.UserChangePasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBHCControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:ConfigToVisibilityMultiValueConverter x:Key="ConfigToVisibilityMultiValueConverter" />

            <!--  标题样式  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20,0,20,0" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel
            Grid.Row="0"
            Margin="0,20,0,20"
            VerticalAlignment="Center"
            LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="修改密码" />

            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource IconClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <StackPanel Grid.Row="1">
            <StackPanel Margin="0,0,0,20">
                <hc:PasswordBox
                    Height="40"
                    hc:InfoElement.Placeholder="请输入原密码"
                    Background="#0DFFFFFF"
                    BorderThickness="0"
                    CaretBrush="#FFFFFFFF"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                    FontSize="12"
                    Foreground="#99FFFFFF"
                    IsSafeEnabled="False"
                    PasswordChar="*"
                    ShowEyeButton="True"
                    Style="{StaticResource HCPasswordBoxStyle}"
                    UnsafePassword="{Binding ReconfirmOldPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    d:Visibility="Collapsed"
                    Style="{StaticResource ErrorMessageTextBlockStyle}"
                    Text="{Binding ReconfirmOldPasswordErrorMessage}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <hc:PasswordBox
                    Height="40"
                    hc:InfoElement.Placeholder="请输入新密码"
                    Background="#0DFFFFFF"
                    BorderThickness="0"
                    CaretBrush="#FFFFFFFF"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                    FontSize="12"
                    Foreground="#99FFFFFF"
                    IsSafeEnabled="False"
                    PasswordChar="*"
                    ShowEyeButton="True"
                    Style="{StaticResource HCPasswordBoxStyle}"
                    UnsafePassword="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="0,0,0,0">
                <hc:PasswordBox
                    Height="40"
                    hc:InfoElement.Placeholder="再次确认新密码"
                    Background="#0DFFFFFF"
                    BorderThickness="0"
                    CaretBrush="#FFFFFFFF"
                    FontFamily="{StaticResource CCTB.SourceHanSansCN-Regular}"
                    FontSize="12"
                    Foreground="#99FFFFFF"
                    IsSafeEnabled="False"
                    PasswordChar="*"
                    ShowEyeButton="True"
                    Style="{StaticResource HCPasswordBoxStyle}"
                    UnsafePassword="{Binding AgainReconfirmNewPassword, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    d:Visibility="Collapsed"
                    Style="{StaticResource ErrorMessageTextBlockStyle}"
                    Text="{Binding AgainReconfirmNewPasswordErrorMessage}" />
            </StackPanel>
        </StackPanel>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FlowDirection="LeftToRight"
            Orientation="Horizontal">
            <Button
                Margin="10,0,0,0"
                Command="{Binding ConfirmCommand}"
                Content="确认"
                Style="{StaticResource ParamOKButtonStyle}" />
            <Button
                Margin="10,0,0,0"
                Command="{Binding CancleCommand}"
                Content="取消"
                Style="{StaticResource ParamCancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

