<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls.DeviceStatusControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB.FormEnums;assembly=SUNWODA_SEVB.Core"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="deviceStatusControl"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />

            <Style x:Key="DeviceBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="Opacity" Value="1" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已连接}">
                        <Setter Property="Background" Value="#FF3DCC84" />
                        <Setter Property="Opacity" Value="0.1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                        <Setter Property="Background" Value="#FF3DCC84" />
                        <Setter Property="Opacity" Value="0.1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未连接}">
                        <Setter Property="Background" Value="#FFCC5252" />
                        <Setter Property="Opacity" Value="0.1" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未开启}">
                        <Setter Property="Background" Value="#FFCC5252" />
                        <Setter Property="Opacity" Value="0.1" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DeviceNameTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已连接}">
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未连接}">
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未开启}">
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="DeviceStatusTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已连接}">
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未连接}">
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未开启}">
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AcceptDeviceCountTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已连接}">
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                        <Setter Property="Foreground" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未连接}">
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未开启}">
                        <Setter Property="Foreground" Value="#FFCC5252" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Fill" Value="#1AFFFFFF" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已连接}">
                        <Setter Property="Fill" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.已开启}">
                        <Setter Property="Fill" Value="#FF3DCC84" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未连接}">
                        <Setter Property="Fill" Value="#FFCC5252" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:EDeviceStatus.未开启}">
                        <Setter Property="Fill" Value="#FFCC5252" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Border CornerRadius="10" Style="{StaticResource DeviceBorderStyle}" />
        <UniformGrid Margin="6" Rows="2">
            <TextBlock
                d:Text="涂布机"
                Style="{StaticResource DeviceNameTextBlockStyle}"
                Text="{Binding DeviceName, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    d:Text="设备状态"
                    Style="{StaticResource DeviceStatusTextBlockStyle}"
                    Text="{Binding DeviceStatus, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsShowAccept, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Rectangle Height="10" Margin="10,0,0,0" />
                    <TextBlock
                        Margin="10,0,0,0"
                        Style="{StaticResource DeviceStatusTextBlockStyle}"
                        Text="连接" />
                    <TextBlock
                        x:Name="AcceptDeviceCountTextBlock"
                        Margin="10,0,0,0"
                        d:Text="9+"
                        Style="{StaticResource AcceptDeviceCountTextBlockStyle}"
                        Text="{Binding AcceptDeviceCount, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </StackPanel>
        </UniformGrid>
    </Grid>
</UserControl>
