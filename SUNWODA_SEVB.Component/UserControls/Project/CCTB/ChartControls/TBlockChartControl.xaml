<UserControl x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls.TBlockChartControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.ChartControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml"/>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBChartControlStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--辅助线样式-->
            <Style x:Key="SubLineStyle" TargetType="Line">
                <Setter Property="Stroke" Value="#FF3DCC84"/>
                <Setter Property="Opacity" Value="0.5"/>
                <Setter Property="StrokeThickness" Value="1"/>
            </Style>

            <!--柱子样式-->
            <Style x:Key="BarGraphPathStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Transparent"/>
                <Setter Property="StrokeThickness" Value="0"/>
                <Setter Property="Fill" Value="#FF3DCC84"/>
                <Setter Property="Opacity" Value="1"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition MinHeight="20" Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="30" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--X轴渲染器-->
        <local:AxisRenderer x:Name="XAxisPainter" AxisType="X" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" Opacity="1"/>
        <!--Y轴渲染器-->
        <local:AxisRenderer x:Name="YAxisPainter" AxisType="Y" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" Opacity="1"/>

        <!--图表区域-->
        <Grid Grid.Row="0" Grid.Column="1">
            <!--XY坐标轴线-->
            <Border BorderBrush="#CCFFFFFF" BorderThickness="1,0,0,1" Opacity="0.5"/>
            <!--绘图区域-->
            <Grid x:Name="ChartGrid" ClipToBounds="True" SizeChanged="ChartGrid_SizeChanged"/>
        </Grid>
    </Grid>
</UserControl>