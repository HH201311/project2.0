<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.FunctionSettingControls.ISFunctionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.FunctionSettingControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    d:DesignHeight="820"
    d:DesignWidth="1330"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="20">
            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="T块位置坐标轴刻度设置" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度上限"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.UpperLimitOfTBlock, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="700"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度下限"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.LowerLimitOfTBlock, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="200"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度间隔"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.IntervalOfTBlock, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度中线"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.CenterValueOfTBlock, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <Rectangle Style="{StaticResource ParamLineRectangleStyle}" />

                    <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="面密度坐标轴刻度及标识线设置-A面" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度上限"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.UpperLimitOfCoatingA, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度下限"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.LowerLimitOfCoatingA, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="面密度目标值"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.TargetValueOfCoatingA, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="面密度预警偏差值"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.WarningOffsetOfCoatingA, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="面密度危险偏差值"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.DangerOffsetOfCoatingA, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />

                    <Rectangle Style="{StaticResource ParamLineRectangleStyle}" />

                    <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="面密度坐标轴刻度及标识线设置-B面" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度上限"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.UpperLimitOfCoatingB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="刻度下限"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.LowerLimitOfCoatingB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="面密度目标值"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.TargetValueOfCoatingB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="面密度预警偏差值"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.WarningOffsetOfCoatingB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <hc:TextBox
                        MinWidth="360"
                        Margin="0,10,0,0"
                        d:Text="-300"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="面密度危险偏差值"
                        hc:InfoElement.TitleWidth="260"
                        Style="{StaticResource HCTitleValueTextBox}"
                        Text="{Binding ItemSource.DangerOffsetOfCoatingB, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  功能按钮  -->
        <Border
            Grid.Row="1"
            BorderBrush="#61FFFFFF"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="保存"
                    Style="{StaticResource ParamOKButtonStyle}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding CancleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="取消"
                    Style="{StaticResource ParamCancleButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
