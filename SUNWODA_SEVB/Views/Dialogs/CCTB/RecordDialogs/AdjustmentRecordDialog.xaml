<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.RecordDialogs.AdjustmentRecordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behavior="clr-namespace:SUNWODA_SEVB.Core.Behavior;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:datagrids="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.DataGridControls;assembly=SUNWODA_SEVB.Component"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.CoatingOPMM"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1410"
    Height="480"
    Background="Transparent"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBDataGridControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  标题样式  -->
            <Style x:Key="ConfigHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Background="#FF2B2B2B">
        <Grid Margin="20" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  内容  -->
            <DockPanel
                Grid.Row="0"
                Margin="0,0,0,20"
                VerticalAlignment="Center"
                LastChildFill="False">
                <TextBlock
                    DockPanel.Dock="Left"
                    Style="{StaticResource ConfigHeaderTextBlockStyle}"
                    Text="控制记录" />
                <Button
                    Command="{Binding CloseCommand}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource IconClosedButtonStyle}" />
            </DockPanel>

            <Border
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="#1AFFFFFF"
                BorderThickness="0.5,0.5,0,0"
                CornerRadius="0">
                <datagrids:AdjustmentRecordDataGridControl ItemsSource="{Binding Records}" />
            </Border>
        </Grid>
    </Grid>
</Border>

