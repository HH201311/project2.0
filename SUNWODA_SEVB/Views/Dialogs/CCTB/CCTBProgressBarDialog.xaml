<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.CCTB.CCTBProgressBarDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB;assembly=SUNWODA_SEVB.Component"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls;assembly=SUNWODA_SEVB.Component"
    MinWidth="400"
    MinHeight="200"
    MaxWidth="500"
    MaxHeight="400"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBGrowlControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <convert:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:ConfigToVisibilityMultiValueConverter x:Key="ConfigToVisibilityMultiValueConverter" />

            <!--  标题样式  -->
            <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  消息样式  -->
            <Style x:Key="MessageTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Medium}" />
                <Setter Property="Foreground" Value="#99FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>

            <!--  百分比文字样式  -->
            <Style x:Key="PercentageTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="#FF3DCC84" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  进度条样式  -->
            <Style x:Key="CustomProgressBarStyle" TargetType="ProgressBar">
                <Setter Property="Height" Value="8" />
                <Setter Property="Background" Value="#40FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#FF3DCC84" />
            </Style>
        </ResourceDictionary>
    </Border.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  1. 标题  -->
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,15"
            d:Text="正在导出数据..."
            FontSize="18"
            Style="{StaticResource TitleTextBlockStyle}"
            Text="{Binding Title}" />

        <!--  2. 当前进度文本  -->
        <Grid Grid.Row="1" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource MessageTextBlockStyle}" Text="当前进度" />
            <TextBlock
                Grid.Column="1"
                d:Text="75%"
                Style="{StaticResource PercentageTextBlockStyle}"
                Text="{Binding ProgressText}" />
        </Grid>

        <!--  3. 进度条  -->
        <ProgressBar
            Grid.Row="2"
            Margin="0,0,0,10"
            IsIndeterminate="{Binding IsIndeterminate}"
            Maximum="100"
            Minimum="0"
            Style="{StaticResource CustomProgressBarStyle}"
            Value="{Binding ProgressValue}" />

        <!--  4. 预计剩余时间  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,0,0,20"
            d:Text="预计剩余时间..."
            Style="{StaticResource MessageTextBlockStyle}"
            Text="{Binding RemainingTimeText}" />

        <!--  5. 按钮  -->
        <Button
            Grid.Row="4"
            Margin="10,0,0,0"
            HorizontalAlignment="Right"
            Command="{Binding CompletedCommand}"
            Content="已完成"
            Style="{StaticResource ParamOKButtonStyle}"
            Visibility="{Binding ShowCompletedButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Button
            Grid.Row="4"
            Margin="10,0,0,0"
            HorizontalAlignment="Right"
            Command="{Binding CancelExportCommand}"
            Content="取消导出"
            Style="{StaticResource ParamCancleButtonStyle}"
            Visibility="{Binding ShowCancelButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </Grid>
</Border>

