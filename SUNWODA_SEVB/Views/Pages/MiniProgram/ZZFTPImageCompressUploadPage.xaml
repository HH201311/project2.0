<Page
    x:Class="SUNWODA_SEVB.Views.Pages.MiniProgram.ZZFTPImageCompressUploadPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.MiniProgram"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ZZFTPImageCompressUploadPage"
    d:DesignHeight="450"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部标题行  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,0"
            Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.png" />
                <!--  项目名称文本  -->
                <TextBlock
                    MinWidth="400"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text=" 图片压缩工具" />
            </StackPanel>
        </Grid>

        <!--  功能区  -->
        <Border
            Grid.Row="1"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!--  左侧：最小200，可拉伸  -->
                    <ColumnDefinition Width="2*" MinWidth="200" />
                    <!--  右侧：主要内容  -->
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <TreeView
                    Margin="20,0,20,0"
                    BorderBrush="#FF9C9CE1"
                    BorderThickness="2"
                    IsEnabled="{Binding IsFtpMode}"
                    ItemsSource="{Binding FtpTree}"
                    SelectedItemChanged="TreeView_SelectedItemChanged"
                    TreeViewItem.Expanded="TreeViewItem_Expanded">

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>

                </TreeView>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  第一行  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  FTP模式  -->
                        <RadioButton
                            Grid.Column="1"
                            Margin="10,0,0,10"
                            Command="{Binding SelectFtpModeCommand}"
                            Content="FTP压缩模式"
                            IsChecked="{Binding IsFtpMode, Mode=OneWay}" />

                        <!--  本地压缩模式  -->
                        <RadioButton
                            Margin="10,0,0,10"
                            Command="{Binding SelectLocalModeCommand}"
                            Content="本地模式"
                            IsChecked="{Binding IsLocalMode, Mode=OneWay}" />
                    </Grid>

                    <!--  第二行  -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  输入框 自适应  -->
                        <TextBox
                            Grid.Column="0"
                            Height="30"
                            MinWidth="300"
                            MaxWidth="600"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding IsFtpMode}"
                            Text="{Binding FtpPath}" />

                        <!--  按钮 固定  -->

                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Background="#FF94C582"
                            Command="{Binding StartCommand}"
                            Content="开始处理"
                            IsEnabled="{Binding IsModeSelected}" />
                    </Grid>

                    <!--  第三行  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            Grid.Column="0"
                            Margin="10,10,0,0"
                            Content="是否删除原图"
                            IsChecked="{Binding IsDeleteImage}" />

                        <CheckBox
                            Grid.Column="1"
                            Margin="10,10,0,0"
                            Content="是否改为压缩tif格式文件"
                            IsChecked="{Binding IsCompressTif}"
                            ToolTip="启用后，将只压缩tif格式文件" />
                    </Grid>

                    <!--  第四行  -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            Grid.Column="0"
                            Margin="10,10,0,0"
                            Content="是否限制文件大小"
                            IsChecked="{Binding IsFileSizeLimit}"
                            IsEnabled="{Binding IsCompressTif}"
                            ToolTip="启用后，只有文件大小超过指定值的文件才会被压缩" />

                        <TextBlock
                            Grid.Column="1"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="文件≥" />

                        <TextBox
                            Grid.Column="2"
                            Height="30"
                            MinWidth="50"
                            MaxWidth="100"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding IsCompressTif}"
                            Text="{Binding FileSizeLimit}"
                            ToolTip="请输入文件大小限制值，单位为M" />

                        <TextBlock
                            Grid.Column="3"
                            Margin="10,10,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="M" />
                    </Grid>

                    <!--  第五行  -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Height="30"
                            MinWidth="300"
                            MaxWidth="600"
                            Margin="10,0,0,0"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding IsLocalMode}"
                            Text="{Binding ExportFolderPath}" />

                        <Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Background="#FF66D1BB"
                            Command="{Binding ExportFolder}"
                            Content="导出文件夹"
                            IsEnabled="{Binding IsLocalMode}"
                            ToolTip="选择已处理的文件目录的新保存路径" />
                    </Grid>

                </Grid>
            </Grid>

        </Border>

        <!--  检测进度条  -->
        <Border
            Grid.Row="2"
            Margin="0,0,0,0"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,15,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="压缩总目录" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="{Binding TotalFiles}" />

                <!--  检测进度条  -->
                <ProgressBar
                    x:Name="PbOfflineProgress"
                    Grid.Column="2"
                    Height="20"
                    Margin="0,0,15,0"
                    Background="#E0E0E0"
                    Foreground="Red"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Progress, FallbackValue=0}" />

                <!--  已完成100%，检测结束！  -->
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold"
                    Foreground="#333"
                    Text="{Binding ProcessedFiles}" />

            </Grid>
        </Border>

        <!--  日志区域：DataGrid表格形式  -->
        <Border
            Grid.Row="3"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
            Margin="0"
            BorderBrush="Black"
            BorderThickness="1">
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Margin="0,0,0,0"
                    FontSize="20"
                    FontWeight="Bold"
                    Text="系统日志" />
                <DataGrid
                    x:Name="LogDataGrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    Background="White"
                    CanUserAddRows="False"
                    HeadersVisibility="None"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    ItemsSource="{Binding LogTable, Mode=OneWay}"
                    RowHeaderWidth="0"
                    RowHeight="24"
                    VerticalScrollBarVisibility="Auto">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="200"
                            Binding="{Binding Item1}"
                            IsReadOnly="True">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <!--  时间居中  -->
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn
                            Width="2000"
                            Binding="{Binding Item2}"
                            IsReadOnly="True">
                            <DataGridTextColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                    <Setter Property="Padding" Value="5,2" />
                                    <Setter Property="ToolTip" Value="{Binding Item2}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <TextBlock
                                                    Padding="{TemplateBinding Padding}"
                                                    FontSize="{TemplateBinding FontSize}"
                                                    Foreground="{TemplateBinding Foreground}"
                                                    Text="{Binding Item2}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.CellStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</Page>
