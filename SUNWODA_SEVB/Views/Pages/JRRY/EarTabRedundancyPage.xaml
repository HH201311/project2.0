<Page
    x:Class="SUNWODA_SEVB.Views.Pages.JRRY.EarTabRedundancyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.JRRY"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:oxy="clr-namespace:OxyPlot.Wpf;assembly=OxyPlot.Wpf"
    Title="EarTabRedundancyPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    FontSize="15"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部标题行  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,0"
            Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.png" />
                <!--  项目名称文本  -->
                <TextBlock
                    MinWidth="400"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="极耳冗余 AI检测系统V1.0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.8*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition MaxHeight="350" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Margin="0,0,5,0"
                        BorderBrush="White"
                        BorderThickness="1">
                        <Grid Margin="5" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="原始图像" />

                            <Viewbox Grid.Row="1" Stretch="Uniform">
                                <Image
                                    x:Name="ImgOriginal"
                                    Margin="5"
                                    RenderTransformOrigin="0.5,0.5"
                                    Source="{Binding CurrentOriginalImage}"
                                    Stretch="None">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding RealTimeImageScaleX}" ScaleY="{Binding RealTimeImageScaleY}" />
                                            <TranslateTransform X="{Binding RealTimeImageTranslateX}" Y="{Binding RealTimeImageTranslateY}" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                    <behaviors:Interaction.Triggers>
                                        <behaviors:EventTrigger EventName="MouseWheel">
                                            <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseMove">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseLeave">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>
                                    </behaviors:Interaction.Triggers>
                                    <Image.InputBindings>
                                        <MouseBinding
                                            Command="{Binding ResetRealTimeImageZoomCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                            MouseAction="LeftDoubleClick" />
                                    </Image.InputBindings>
                                    <Image.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding ZoomInRealTimeCommand}" Header="放大" />
                                            <MenuItem Command="{Binding ZoomOutRealTimeCommand}" Header="缩小" />
                                            <MenuItem Command="{Binding ResetRealTimeImageZoomCommand}" Header="适应窗口" />
                                        </ContextMenu>
                                    </Image.ContextMenu>
                                </Image>

                            </Viewbox>

                        </Grid>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Margin="5,0,0,0"
                        Background="Transparent"
                        BorderBrush="White"
                        BorderThickness="1">
                        <Grid Margin="5" ClipToBounds="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="结果图像" />

                            <Viewbox Grid.Row="1" Stretch="Uniform">
                                <Image
                                    x:Name="ImgResult"
                                    Margin="5"
                                    RenderTransformOrigin="0.5,0.5"
                                    Source="{Binding CurrentResultImage}"
                                    Stretch="None">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="{Binding RealTimeImageScaleX}" ScaleY="{Binding RealTimeImageScaleY}" />
                                            <TranslateTransform X="{Binding RealTimeImageTranslateX}" Y="{Binding RealTimeImageTranslateY}" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                    <behaviors:Interaction.Triggers>
                                        <behaviors:EventTrigger EventName="MouseWheel">
                                            <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseMove">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>

                                        <behaviors:EventTrigger EventName="MouseLeave">
                                            <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand}" PassEventArgsToCommand="True" />
                                        </behaviors:EventTrigger>
                                    </behaviors:Interaction.Triggers>
                                    <Image.InputBindings>
                                        <MouseBinding
                                            Command="{Binding ResetRealTimeImageZoomCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                            MouseAction="LeftDoubleClick" />
                                    </Image.InputBindings>
                                    <Image.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding ZoomInRealTimeCommand}" Header="放大" />
                                            <MenuItem Command="{Binding ZoomOutRealTimeCommand}" Header="缩小" />
                                            <MenuItem Command="{Binding ResetRealTimeImageZoomCommand}" Header="适应窗口" />
                                        </ContextMenu>
                                    </Image.ContextMenu>
                                </Image>
                            </Viewbox>
                        </Grid>
                    </Border>

                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding ZoomInRealTimeCommand}" Header="放大" />
                            <MenuItem Command="{Binding ZoomOutRealTimeCommand}" Header="缩小" />
                            <MenuItem Command="{Binding ResetRealTimeImageZoomCommand}" Header="适应窗口" />
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <Grid.InputBindings>
                        <MouseBinding Command="{Binding ResetRealTimeImageZoomCommand}" MouseAction="LeftDoubleClick" />
                    </Grid.InputBindings>
                </Grid>

                <Border
                    Grid.Row="1"
                    Margin="0"
                    Background="Transparent"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>


                        <TextBlock
                            Margin="0,0,0,0"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="系统日志" />
                        <DataGrid
                            x:Name="LogDataGrid"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            Background="White"
                            CanUserAddRows="False"
                            HeadersVisibility="None"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding LogTable, Mode=OneWay}"
                            RowHeaderWidth="0"
                            RowHeight="24">

                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>

                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding Item1}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                        </Style>

                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Item2}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="FontSize" Value="14" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="5,2" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <ScrollViewer
                                                            Margin="{TemplateBinding Padding}"
                                                            HorizontalScrollBarVisibility="Auto"
                                                            VerticalScrollBarVisibility="Disabled">
                                                            <TextBlock
                                                                FontSize="{TemplateBinding FontSize}"
                                                                Foreground="{TemplateBinding Foreground}"
                                                                Text="{Binding Item2}" />
                                                        </ScrollViewer>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <Border
                Grid.Column="1"
                Margin="0,0,0,0"
                VerticalAlignment="Stretch"
                BorderBrush="Black"
                BorderThickness="1">

                <TabControl Margin="0" VerticalAlignment="Stretch">
                    <TabItem FontSize="25" Header="数据">
                        <Grid Margin="0" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid
                                x:Name="DgDetection"
                                Grid.Row="1"
                                MaxHeight="800"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                AlternationCount="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                FontSize="18"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                ItemsSource="{Binding DetectionDataList}"
                                RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        MinWidth="100"
                                        Binding="{Binding cellCode}"
                                        Header="电芯编码">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="10" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>

                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="1.2*"
                                        MinWidth="100"
                                        Binding="{Binding LeftDistance}"
                                        Header="左侧距离dl">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="1.2*"
                                        MinWidth="80"
                                        Binding="{Binding RightDistance}"
                                        Header="右侧距离dr">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="*"
                                        MinWidth="80"
                                        Binding="{Binding RiskLevel}"
                                        Header="风险等级">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn
                                        Width="1*"
                                        MinWidth="80"
                                        Binding="{Binding DetectionResult}"
                                        Header="检测结果">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="NG">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <!--  查看结果按钮列  -->
                                    <DataGridTemplateColumn
                                        Width="1*"
                                        MinWidth="80"
                                        Header="查看结果">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.ViewResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="查看" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border
                                Grid.Row="2"
                                MaxHeight="400"
                                Margin="0,0,0,0"
                                BorderBrush="LightGray"
                                BorderThickness="1">
                                <StackPanel Height="Auto" Margin="5">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Text="状态信息" />
                                    <Grid Height="Auto" Margin="5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="4*" />
                                            <ColumnDefinition Width="6*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Margin="0,0,5,0"
                                            HorizontalAlignment="Center">
                                            <oxy:PlotView
                                                Width="250"
                                                Height="200"
                                                IsHitTestVisible="False"
                                                Model="{Binding PieModel}" />

                                            <StackPanel
                                                Margin="0,20,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Vertical">
                                                <Grid Margin="2" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Rectangle
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="2"
                                                        VerticalAlignment="Center"
                                                        Fill="#2F80ED" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="2,0"
                                                        VerticalAlignment="Center"
                                                        Text="OK" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="2,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding OKRate}" />
                                                </Grid>

                                                <Grid Margin="2" HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="50" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Rectangle
                                                        Grid.Column="0"
                                                        Width="15"
                                                        Height="15"
                                                        Margin="2"
                                                        VerticalAlignment="Center"
                                                        Fill="#FF9800" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Margin="2,0"
                                                        VerticalAlignment="Center"
                                                        Text="NG" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Margin="2,0"
                                                        VerticalAlignment="Center"
                                                        Text="{Binding NGRate}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!--  右侧状态表格  -->
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <Grid Margin="0,0,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="风险等级" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="数量" />
                                                <TextBlock
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="占比" />
                                            </Grid>
                                            <Separator Margin="0,0,0,5" Background="LightGray" />

                                            <!--  L0-L3数据行  -->
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L0" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count_L0}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Ratio_L0}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L1" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count_L1}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Ratio_L1}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L2" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count_L2}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Ratio_L2}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="L3" />
                                                <TextBlock Grid.Column="1" Text="{Binding Count_L3}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Ratio_L3}" />
                                            </Grid>

                                            <!--  汇总信息  -->
                                            <Separator Margin="0,8,0,5" Background="LightGray" />
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Text="总检测数" />
                                                <TextBlock Grid.Column="1" Text="{Binding TotalDetectionCount}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FF9800"
                                                    Text="NG" />
                                                <TextBlock Grid.Column="1" Text="{Binding NGCount}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Foreground="#2F80ED"
                                                    Text="OK" />
                                                <TextBlock Grid.Column="1" Text="{Binding OKCount}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.5*" />
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Grid.Column="0"
                                                    FontWeight="SemiBold"
                                                    Text="一次优率" />
                                                <TextBlock Grid.Column="1" Text="{Binding OKRate}" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!--  「设置」标签页  -->
                    <TabItem FontSize="25" Header="设置">
                        <StackPanel
                            Height="Auto"
                            Margin="10,0,10,0"
                            VerticalAlignment="Stretch"
                            Orientation="Vertical">
                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Width="Auto"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="监听路径：" />
                                <TextBox
                                    Width="200"
                                    Height="30"
                                    Margin="5,0"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    IsEnabled="{Binding IsInAnyDetection}"
                                    Text="{Binding SelectedMonitorFolderPath, Mode=TwoWay}" />
                                <Button
                                    Width="60"
                                    Height="30"
                                    Margin="5,0"
                                    Background="#5DADE2"
                                    BorderThickness="0"
                                    Command="{Binding SelectMonitorFolderCommand}"
                                    Content="浏览..."
                                    Foreground="White"
                                    IsEnabled="{Binding IsInAnyDetection}" />
                            </StackPanel>
                            <!--  在线检测功能  -->
                            <StackPanel
                                Margin="0,20,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Width="Auto"
                                    FontWeight="Bold"
                                    Text="在线检测：" />
                                <ToggleButton
                                    Height="30"
                                    Margin="0,0,0,0"
                                    FontSize="15"
                                    IsChecked="{Binding IsOnlineDetectionEnabled, Mode=TwoWay}"
                                    IsEnabled="{Binding IsOnlineToggleEnabled}">
                                    <ToggleButton.Style>
                                        <Style BasedOn="{StaticResource ToggleButtonSwitch.Small}" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="已关闭" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Content" Value="已打开" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                                    <Setter Property="Content" Value="已关闭" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>
                            <!--  一键仿真区域  -->
                            <StackPanel Margin="0,20,0,15" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Text="一键仿真:" />
                                <Button
                                    Width="80"
                                    Height="30"
                                    Margin="30,0,10,0"
                                    Background="#5DADE2"
                                    Command="{Binding File_Button}"
                                    Content="文件"
                                    FontSize="15"
                                    IsEnabled="{Binding IsFileSelectEnabled}" />
                                <Button
                                    Width="80"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Background="#5DADE2"
                                    Command="{Binding Folder_Button}"
                                    Content="文件夹"
                                    FontSize="15"
                                    IsEnabled="{Binding IsFolderSelectEnabled}" />
                            </StackPanel>

                            <!--  图像存储区域  -->
                            <Grid Height="Auto" Margin="0,5,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="25"
                                    FontWeight="Bold"
                                    Text="图像存储：" />
                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Text="原图:" />
                                <StackPanel
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Orientation="Vertical">
                                    <CheckBox
                                        Margin="0,2,0,2"
                                        Content="OK"
                                        IsChecked="{Binding IsSaveOriginalOK}"
                                        IsEnabled="{Binding IsInAnyDetection}" />
                                    <CheckBox
                                        Margin="0,2,0,2"
                                        Content="NG"
                                        IsChecked="{Binding IsSaveOriginalNG}"
                                        IsEnabled="{Binding IsInAnyDetection}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Text="结果图：" />
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Orientation="Vertical">
                                    <CheckBox
                                        Margin="0,2,0,2"
                                        Content="OK"
                                        IsChecked="{Binding IsSaveResultOK}"
                                        IsEnabled="{Binding IsInAnyDetection}" />
                                    <CheckBox
                                        Margin="0,2,0,2"
                                        Content="NG"
                                        IsChecked="{Binding IsSaveResultNG}"
                                        IsEnabled="{Binding IsInAnyDetection}" />
                                </StackPanel>
                            </Grid>

                            <Grid
                                Height="Auto"
                                Margin="0,5,0,10"
                                IsEnabled="{Binding IsThresholdSettingEnabled}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock
                                        Margin="0,0,0,8"
                                        FontSize="25"
                                        FontWeight="Bold"
                                        Text="风险等级阈值设置：" />
                                    <StackPanel
                                        Margin="0,5,0,5"
                                        HorizontalAlignment="Stretch"
                                        Orientation="Horizontal">
                                        <Grid Margin="5,0,20,0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Text="L0：" />
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="上限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL0Upper}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="下限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL0Lower}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!--  L1 上下限  -->
                                        <Grid Margin="20,0,5,0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Text="L1：" />
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="上限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL1Upper}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="下限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL1Lower}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Margin="0,5,0,5" Orientation="Horizontal">
                                        <Grid Margin="5,0,20,0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Text="L2：" />
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="上限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL2Upper}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="下限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL2Lower}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Grid Margin="20,0,5,0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Text="L3：" />
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="上限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL3Upper}" />
                                                </StackPanel>
                                                <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                    <TextBlock
                                                        Width="Auto"
                                                        VerticalAlignment="Center"
                                                        FontSize="18"
                                                        Text="下限：" />
                                                    <TextBox
                                                        Width="60"
                                                        Margin="2"
                                                        FontSize="12"
                                                        Text="{Binding TempL3Lower}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    Grid.ColumnSpan="2"
                                    Margin="100,0,0,0"
                                    VerticalAlignment="Center">
                                    <Button
                                        Width="100"
                                        Height="35"
                                        Background="#4CAF50"
                                        Command="{Binding SaveSettingsCommand}"
                                        Content="保存设置"
                                        FontSize="20"
                                        Foreground="White" />
                                    <Button
                                        Width="100"
                                        Height="35"
                                        Margin="0,20,0,0"
                                        Background="#F44336"
                                        Command="{Binding ResetSettingsCommand}"
                                        Content="一键重置"
                                        FontSize="20"
                                        Foreground="White" />
                                </StackPanel>
                            </Grid>
                            <StackPanel
                                Margin="0,40,0,0"
                                HorizontalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    Width="120"
                                    Height="35"
                                    Margin="0,0,40,0"
                                    Background="#F5B0"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding StopDetectionCommand}"
                                    Content="停止检测"
                                    FontSize="16"
                                    Foreground="Black" />
                                <Button
                                    Width="120"
                                    Height="35"
                                    Margin="0,0,20,0"
                                    Background="#F5B041"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ClearListCommand}"
                                    Content="清空列表"
                                    FontSize="16"
                                    Foreground="Black" />
                                <Button
                                    Width="120"
                                    Height="35"
                                    Margin="20,0,0,0"
                                    Background="#F5B041"
                                    BorderBrush="Gray"
                                    BorderThickness="1"
                                    Command="{Binding ClearStatisticsCommand}"
                                    Content="统计清零"
                                    FontSize="16"
                                    Foreground="Black" />

                            </StackPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
        <!--  底部版权栏  -->
        <Grid
            Grid.Row="2"
            Margin="0,0,0,0"
            Background="LightGray">
            <TextBlock
                Margin="5"
                HorizontalAlignment="Right"
                FontSize="15"
                Text="Copyright ©欣旺达动力科技 — 仿真及AI部 — 工程AI部" />

        </Grid>
    </Grid>
</Page>
