<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.FunctionSettingControls.CLFunctionControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.FunctionSettingControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    d:DesignHeight="1020"
    d:DesignWidth="1330"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="闭环入参数据源选择" />
                <UniformGrid Columns="1">
                    <hc:ComboBox
                        MinWidth="440"
                        Margin="0,10,0,0"
                        d:SelectedIndex="0"
                        hc:InfoElement.Title="涂布重量数据来源选择"
                        hc:InfoElement.TitleWidth="260"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding CoatingDataSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedValue="{Binding ItemSource.CoatingDataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedValuePath="ItemValue"
                        Style="{StaticResource HCParamComboBoxStyle}" />
                    <hc:ComboBox
                        MinWidth="440"
                        Margin="0,10,0,0"
                        d:SelectedIndex="0"
                        hc:InfoElement.Title="T块数据来源选择"
                        hc:InfoElement.TitleWidth="260"
                        DisplayMemberPath="DisplayName"
                        ItemsSource="{Binding TBlockDataSource, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedValue="{Binding ItemSource.TBlockDataSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        SelectedValuePath="ItemValue"
                        Style="{StaticResource HCParamComboBoxStyle}" />
                </UniformGrid>
                <Rectangle Style="{StaticResource ParamLineRectangleStyle}" />

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="数据保存" />
                    <Button
                        Margin="10,0,0,10"
                        Command="{Binding PLCGatherConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="PLC"
                        Content="PLC采集配置"
                        Style="{StaticResource TextButtonStyle}" />
                </StackPanel>

                <uccc:PairContentControl PairKeyText="保存路径" Style="{StaticResource PPairContentControlStyle}">
                    <uccc:FloderPicker
                        Width="400"
                        Height="40"
                        d:FloderText="D:\项目工作\涂布闭环\闭环框架及界面"
                        FloderText="{Binding ItemSource.SavePathOfCL, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        PickerContent="更改" />
                </uccc:PairContentControl>

                <Rectangle Style="{StaticResource ParamLineRectangleStyle}" />

                <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="其他" />
                <UniformGrid Columns="1">
                    <uccc:PairContentControl PairKeyText="&quot;涂布机闭环开关旋钮未开启&quot;提醒功能" Style="{StaticResource PPairContentControlStyle}">
                        <uccc:SimpleToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ItemSource.IsUseReminderOfClosedLoopSwitch, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                    </uccc:PairContentControl>
                    <uccc:PairContentControl PairKeyText="&quot;是否开启进退刀判定&quot;功能" Style="{StaticResource PPairContentControlStyle}">
                        <uccc:SimpleToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ItemSource.IsUseJudgeOfKnife, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                    </uccc:PairContentControl>
                    <uccc:PairContentControl PairKeyText="&quot;是否开启FTP上传&quot;功能" Style="{StaticResource PPairContentControlStyle}">
                        <DockPanel MinWidth="400" LastChildFill="False">
                            <uccc:SimpleToggleButton
                                d:IsChecked="True"
                                IsChecked="{Binding ItemSource.IsUseFTPUpload, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                            <Button
                                Margin="10,0,0,0"
                                Command="{Binding FtpConfigCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                Content="FTP配置"
                                Style="{StaticResource TextButtonStyle}" />
                            <!--<uccc:ClickContentControl
                                Margin="20,0,0,0"
                                ClickCommand="{Binding FTPUploadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ClickCommandParameter="{Binding FTPUploadDate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ClickContent="手动上传"
                                Style="{StaticResource ParamClickContentControlStyle}">
                                <DatePicker
                                    HorizontalContentAlignment="Left"
                                    VerticalContentAlignment="Center"
                                    d:SelectedDate="2025/12/28"
                                    d:Text="2025/12/28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FlowDirection="LeftToRight"
                                    FontFamily="Arial"
                                    FontSize="14"
                                    FontWeight="Regular"
                                    Foreground="#CCFFFFFF"
                                    SelectedDate="{Binding FTPUploadDate, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </uccc:ClickContentControl>-->
                        </DockPanel>
                    </uccc:PairContentControl>
                    <uccc:PairContentControl PairKeyText="泵速下发模式" Style="{StaticResource PPairContentControlStyle}">
                        <DockPanel MinWidth="400" LastChildFill="True">
                            <RadioButton
                                d:IsChecked="True"
                                Content="PLC"
                                IsChecked="{Binding ItemSource.ModeOfPumpAdjust, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:EModeOfPumpAdjust.PLC}}"
                                Style="{StaticResource ParamValueRadioButtonStyle}" />
                            <RadioButton
                                Margin="10,0,0,0"
                                Content="Network"
                                IsChecked="{Binding ItemSource.ModeOfPumpAdjust, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:EModeOfPumpAdjust.Network}}"
                                Style="{StaticResource ParamValueRadioButtonStyle}" />
                        </DockPanel>
                    </uccc:PairContentControl>
                    <uccc:PairContentControl PairKeyText="膜卷号读取方式" Style="{StaticResource PPairContentControlStyle}">
                        <DockPanel MinWidth="400" LastChildFill="True">
                            <RadioButton
                                d:IsChecked="True"
                                Content="PLC"
                                IsChecked="{Binding ItemSource.ModeOfRollNumReading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:ERollNumReading.PLC}}"
                                Style="{StaticResource ParamValueRadioButtonStyle}" />
                            <RadioButton
                                Margin="10,0,0,0"
                                d:IsChecked="False"
                                Content="RemoteFile"
                                IsChecked="{Binding ItemSource.ModeOfRollNumReading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter={x:Static enums:ERollNumReading.RemoteFile}}"
                                Style="{StaticResource ParamValueRadioButtonStyle}" />
                            <uccc:ClickContentControl
                                Margin="20,0,0,0"
                                ClickCommand="{Binding RollNumPathVerifyCommand}"
                                ClickCommandParameter="{Binding ItemSource.PathOfRollNumReadingTxt, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                ClickContent="点击验证"
                                IsEnabled="{Binding ItemSource.ModeOfRollNumReading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='RemoteFile'}"
                                Style="{StaticResource ParamClickContentControlStyle}">
                                <TextBox
                                    d:IsReadOnly="True"
                                    d:Text="\\DESKTOP-986B1JE\MESClientData\MESClientData.txt"
                                    Background="Transparent"
                                    IsEnabled="{Binding ItemSource.ModeOfRollNumReading, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='RemoteFile'}"
                                    Style="{StaticResource PValueTextBoxStyle}"
                                    Text="{Binding ItemSource.PathOfRollNumReadingTxt, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </uccc:ClickContentControl>
                        </DockPanel>
                    </uccc:PairContentControl>
                    <uccc:PairContentControl PairKeyText="闭环自动启动" Style="{StaticResource PPairContentControlStyle}">
                        <uccc:SimpleToggleButton
                            d:IsChecked="True"
                            IsChecked="{Binding ItemSource.IsClosedLoopAutoStart, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                    </uccc:PairContentControl>
                </UniformGrid>
            </StackPanel>
        </ScrollViewer>

        <!--  功能按钮  -->
        <Border
            Grid.Row="1"
            BorderBrush="#61FFFFFF"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FlowDirection="LeftToRight"
                Orientation="Horizontal">
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="保存"
                    Style="{StaticResource ParamOKButtonStyle}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding CancleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="取消"
                    Style="{StaticResource ParamCancleButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
