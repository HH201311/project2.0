<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="https://handyorg.github.io/handycontrol">

    <!--  CPK柱状图和折线图的ToolTip样式  -->
    <Style
        x:Key="CPKToolTipStyle"
        BasedOn="{StaticResource ChartToolTipStyle}"
        TargetType="ToolTip" />

    <Style x:Key="ChartToolTipStyle" TargetType="ToolTip">
        <Setter Property="MinWidth" Value="20" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="True" />
        <Setter Property="Placement" Value="Mouse" />
        <Setter Property="Background" Value="#FF121212" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        FontFamily="{StaticResource CCTB.SourceHanSansCN-Medium}"
                        FontSize="14"
                        Foreground="#CCFFFFFF"
                        Opacity="1"
                        Text="{Binding}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid Margin="{TemplateBinding Margin}" Background="Transparent">
                        <!--  边框&背景虚化效果  -->
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Opacity="1">
                            <Border Background="#1AFFFFFF" BorderThickness="0">
                                <Border.Effect>
                                    <BlurEffect
                                        KernelType="Gaussian"
                                        Radius="50"
                                        RenderingBias="Quality" />
                                </Border.Effect>
                            </Border>
                        </Border>
                        <!--  箭头  -->
                        <!--<Grid Width="10" Height="8" Margin="0,0,0,-7" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                            <Path Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" Data="M0,0 L5,8 L10,0">
                                <Path.Effect>
                                    <BlurEffect Radius="5" KernelType="Gaussian" RenderingBias="Quality"/>
                                </Path.Effect>
                            </Path>
                        </Grid>-->
                        <!--  内容  -->
                        <ContentPresenter
                            Margin="10,5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>