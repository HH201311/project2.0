<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CTAutoSlicer.CTAutoSlicerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CTAutoSlicerPage"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CTAutoSlicerPageStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="ParamHelpIconBorderStyle" BasedOn="{StaticResource CasParamHelpIconBorderStyle}" TargetType="Border" />
            <Style x:Key="ParamHelpIconTextStyle" BasedOn="{StaticResource CasParamHelpIconTextStyle}" TargetType="TextBlock" />
            <Style x:Key="ParamHelpToolTipTextStyle" BasedOn="{StaticResource CasParamHelpToolTipTextStyle}" TargetType="TextBlock" />
        </ResourceDictionary>
    </Page.Resources>

    <Border Style="{StaticResource CasPageRootStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CasSidebarStyle}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="0" ToolTip="运行总览">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavOverview}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ViewDashboardOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="运行总览" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="1" ToolTip="应用参数">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavApp}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="CogOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="应用参数" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="2" ToolTip="导入参数">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavImport}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="FolderOpenOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="导入参数" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="3" ToolTip="渲染与厚板">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavRender}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="CubeOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="渲染厚板" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="4" ToolTip="直方图标定">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavHistogram}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ChartBar" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="直方图标定" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="5" ToolTip="视觉对齐">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavVision}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="AxisArrow" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="视觉对齐" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="6" ToolTip="对齐后拖拽">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavPostAlign}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="CursorDefaultClickOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="对齐后拖拽" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="7" ToolTip="切片导出">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavSlice}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="ImageMultipleOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="切片导出" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectNavCommand}" CommandParameter="8" ToolTip="AI图像标注">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavAiAnnotate}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="EyeOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="AI图像标注" />
                            </StackPanel>
                        </Button>
                        <Button
                            Command="{Binding SelectNavCommand}"
                            CommandParameter="9"
                            ToolTip="单步测试（仅调试）"
                            Visibility="{Binding IsDebugMode, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style BasedOn="{StaticResource CasNavButtonStyle}" TargetType="Button">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNavStepTest}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CasCoralBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Width="20" Height="20" Foreground="White" Kind="FlaskOutline" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CasNavLabelStyle}" Text="单步测试" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Alt+P 暂停态醒目横幅 -->
                <Border Grid.Row="0"
                        Margin="0,0,0,10"
                        Padding="16,12"
                        Background="#D32F2F"
                        CornerRadius="6"
                        Visibility="{Binding IsFlowPaused, Converter={StaticResource BoolToVis}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="暂停中 — 再按 Alt+P 继续检查后恢复"/>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,0,0,14" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding CurrentSectionTitle}" Style="{StaticResource CasTitleTextStyle}"/>
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource CasMutedTextStyle}" Text="{Binding MessageShower}"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Style="{StaticResource CasPillBorderStyle}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RunModeDisplayText}" Foreground="{StaticResource CasPrimaryTextBrush}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Border Background="{StaticResource CasWhiteBrush}"
                                    BorderBrush="{StaticResource CasBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="生产"
                                            Command="{Binding SwitchToProductionModeCommand}"
                                            ToolTip="生产界面：隐藏单步测试">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasModeSegmentButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProductionMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CasPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="调试"
                                            Command="{Binding SwitchToDebugModeCommand}"
                                            ToolTip="调试界面：显示单步测试">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource CasModeSegmentButtonStyle}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDebugMode}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource CasPrimaryBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <Grid Grid.Row="2">
                <Grid Visibility="{Binding IsNavOverview, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource CasHeroCardStyle}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="CT 自动化切片" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource CasPrimaryTextBrush}"/>
                            <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding MessageShower}" TextWrapping="Wrap"
                                       Style="{StaticResource CasMutedTextStyle}"/>
                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="VG 路径"/>
                                <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                           Text="{Binding VGAppPath}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="CT 体素文件夹"/>
                                <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                           Text="{Binding CTFileFolder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                <TextBlock Style="{StaticResource CasMutedTextStyle}" Margin="0,0,0,2" Text="切片导出目录"/>
                                <TextBlock Foreground="{StaticResource CasPrimaryTextBrush}" FontSize="15"
                                           Text="{Binding SliceExportFolder}" TextTrimming="CharacterEllipsis" Margin="0,0,0,12"/>
                                <Button Style="{StaticResource CasPrimaryButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Content="{Binding PrimaryActionButtonText}"
                                        Command="{Binding RunSimulationCommand}"
                                        IsEnabled="{Binding IsEnableSimulationBtn}"
                                        ToolTip="生产/批量入口：按 CT 体素文件夹排队执行完整自动化流程"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource CasWhiteCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                                <TextBlock Text="流程日志" Style="{StaticResource CasSectionHeaderStyle}" Margin="0" DockPanel.Dock="Left"/>
                                <Button DockPanel.Dock="Right" Style="{StaticResource CasSecondaryButtonStyle}"
                                        Content="清除日志" Command="{Binding ClearImportLogCommand}"/>
                            </DockPanel>
                            <TextBox
                                x:Name="ImportLogTextBox"
                                Grid.Row="1"
                                MinHeight="180"
                                FontFamily="Consolas"
                                FontSize="14"
                                IsReadOnly="True"
                                Text="{Binding ImportLogText, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto"
                                Background="#FAF8FC"
                                BorderBrush="{StaticResource CasBorderBrush}"
                                BorderThickness="1"
                                Padding="8"
                                AcceptsReturn="True"
                                VerticalContentAlignment="Top" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Visibility="{Binding IsNavApp, Converter={StaticResource BoolToVis}}" Style="{StaticResource CasWhiteCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="应用参数" Style="{StaticResource CasSectionHeaderStyle}" Margin="0"/>
                                <Border Style="{StaticResource CasParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource CasParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="配置 VGSTUDIO MAX 可执行程序及启动就绪判定，是整条自动化链路的入口。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• VG应用路径：VG 安装目录下的可执行文件。进程名、冷启动与附着单测均由此推导；路径错误则无法启动/附着。" />
                                            <LineBreak />
                                            <Run Text="• VG启动就绪最大等待(ms)：轮询「自动保存恢复」弹窗或「文件(F)」菜单可点的上限。机器慢或首次启动慢时应加大，避免误判启动失败。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource CasParamHelpIconTextStyle}" />
                            </Border>
                            </StackPanel>
<StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="VG应用路径"
                                    hc:InfoElement.TitlePlacement="Left"
                                    IsReadOnly="True">
                                    <hc:TextBox.Text>
                                        <Binding Path="VGAppPath" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:NoBlankTextRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button Width="40" Command="{Binding OpenVGAppPathCommand}">
                                    <Image Width="18" RenderTransformOrigin="0.5,0.5">
                                        <Image.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform ScaleY="-1" />
                                            </TransformGroup>
                                        </Image.RenderTransform>
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="Black" Geometry="M768 97.92v-97.92h-640v896h384v-256h256v-35.84c24.73-14.631 45.845-32.282 63.738-52.813l0.262 152.653-256 256h-512v-1024h768v97.92zM576 896l192-192h-192v192zM945.92 145.92l-122.88 122.88c-5.725 5.447-12.859 9.465-20.798 11.452 18.665 29.336 29.953 65.126 29.953 103.553 0 106.039-85.961 192-192 192s-192-85.961-192-192c0-106.039 85.961-192 192-192 38.427 0 74.217 11.289 104.235 30.73 1.305-8.716 5.323-15.85 10.789-21.595l122.862-122.86c8.549-7.982 20.063-12.883 32.723-12.883 26.51 0 48 21.49 48 48 0 12.659-4.901 24.174-12.908 32.751zM640 256c-70.692 0-128 57.308-128 128s57.308 128 128 128c70.692 0 128-57.308 128-128s-57.308-128-128-128z" />
                                                    </DrawingGroup>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="VG启动就绪最大等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="VGOpenWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                            </StackPanel>
                        
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Visibility="{Binding IsNavImport, Converter={StaticResource BoolToVis}}" Style="{StaticResource CasWhiteCardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="导入参数" Style="{StaticResource CasSectionHeaderStyle}" Margin="0"/>
                                <Border Style="{StaticResource CasParamHelpIconBorderStyle}">
                                <Border.ToolTip>
                                    <ToolTip>
                                        <TextBlock Style="{StaticResource CasParamHelpToolTipTextStyle}">
                                            <Run FontWeight="SemiBold" Text="本组作用" />
                                            <LineBreak />
                                            <Run Text="控制批量 .vgl/.vgi 导入节奏、超时与进程池并行度，决定导入阶段是否稳定、吞吐多高。" />
                                            <LineBreak />
                                            <LineBreak />
                                            <Run FontWeight="SemiBold" Text="参数说明" />
                                            <LineBreak />
                                            <Run Text="• CT体素文件夹：待处理体积所在目录（含子级 .vgl/.vgi 或指向它们的 .lnk）。主流程按创建时间排队处理。" />
                                            <LineBreak />
                                            <Run Text="• 快速导入等待(ms)：Ctrl+F+I 后等待「快速导入」对话框出现的超时。界面卡顿时应加大。" />
                                            <LineBreak />
                                            <Run Text="• 新建工程等待(ms)：Ctrl+N 新建后等待工程就绪/保存提示处理完成的时间。" />
                                            <LineBreak />
                                            <Run Text="• 文件选择等待(ms)：填路径点打开后，等待「文件选择/完成」向导出现的超时。" />
                                            <LineBreak />
                                            <Run Text="• 导入超时(分钟)：单文件「正在导入体积」最长等待。超大体积需加大，超时则 Kill 该 VG 并保留文件。" />
                                            <LineBreak />
                                            <Run Text="• 导入后稳定等待(ms)：导入完成后稍作停顿再进后处理，避免 UI 尚未稳定就点渲染/厚板。" />
                                            <LineBreak />
                                            <Run Text="• 最大VG进程数：进程池槽位数（1～8）。导入等待可并行，后处理串行置前；越大越吃内存/显存。" />
                                            <LineBreak />
                                            <Run Text="• 步骤重试次数 / 步骤重试间隔(ms)：UIA 步骤失败时先 Drain 中断弹窗再重试。偶发弹窗/焦点丢失时提高成功率。" />
                                        </TextBlock>
                                    </ToolTip>
                                </Border.ToolTip>
                                <TextBlock Style="{StaticResource CasParamHelpIconTextStyle}" />
                            </Border>
                            </StackPanel>
<StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="500"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="CT体素文件夹"
                                    hc:InfoElement.TitlePlacement="Left"
                                    IsReadOnly="True">
                                    <hc:TextBox.Text>
                                        <Binding Path="CTFileFolder" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:NoBlankTextRule />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
                                </hc:TextBox>
                                <Button Width="40" Command="{Binding OpenCTFileFolderCommand}">
                                    <Image Width="18">
                                        <Image.Source>
                                            <DrawingImage>
                                                <DrawingImage.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="Black" Geometry="M245,110.64A16,16,0,0,0,232,104H216V88a16,16,0,0,0-16-16H130.67L102.94,51.2a16.14,16.14,0,0,0-9.6-3.2H40A16,16,0,0,0,24,64V208h0a8,8,0,0,0,8,8H211.1a8,8,0,0,0,7.59-5.47l28.49-85.47A16.05,16.05,0,0,0,245,110.64ZM93.34,64,123.2,86.4A8,8,0,0,0,128,88h72v16H69.77a16,16,0,0,0-15.18,10.94L40,158.7V64Zm112,136H43.1l26.67-80H232Z" />
                                                    </DrawingGroup>
                                                </DrawingImage.Drawing>
                                            </DrawingImage>
                                        </Image.Source>
                                    </Image>
                                </Button>
                            </StackPanel>

                            <StackPanel Margin="10" Orientation="Horizontal">
                                <hc:TextBox
                                    Width="245"
                                    Margin="0,0,10,0"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Title="快速导入等待(ms)"
                                    hc:InfoElement.TitlePlacement="Left">
                                    <hc:TextBox.Text>
                                        <Binding Path="QuickImportDialogWaitTime" UpdateSourceTrigger="PropertyChanged">
                                            <Binding.ValidationRules>
                                                <hc:RegexRule Type="PInt" />
                                            </Binding.ValidationRules>
                                        </Binding>
                                    </hc:TextBox.Text>
