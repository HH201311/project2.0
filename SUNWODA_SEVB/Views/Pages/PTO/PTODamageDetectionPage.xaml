                                    <!-- A工位相机列表 -->
                                    <StackPanel Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机1：" Width="80" VerticalAlignment="Center" FontSize="20"/>
                                            <Button Content="选择绘制图片"  
                                                    
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="A1"
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="A1"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiA1}"/>
                                        </StackPanel>

                                        <!-- A工位相机2 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机2：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="A2"
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="A2"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiA2}"/>
                                        </StackPanel>

                                        <!-- A工位相机3 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机3：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="A3"
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="A3"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiA3}"/>
                                        </StackPanel>

                                        <!-- A工位相机4 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机4：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="A4"
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="A4"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiA4}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel>
                                    <!-- B工位标题 -->
                                    <TextBlock Text="B工位" FontWeight="Bold" Margin="0,0,0,0" HorizontalAlignment="Left"   FontSize="25"/>

                                    <!-- B工位相机列表 -->
                                    <StackPanel Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机1：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="B1" 
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="B1"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiB1}"/>
                                        </StackPanel>

                                        <!-- B工位相机2 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机2：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="B2"
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="B2"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiB2}"/>
                                        </StackPanel>

                                        <!-- B工位相机3 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机3：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
                        CommandParameter="B3"
                        IsEnabled="{Binding IsInAnyDetection}" 
                        Width="120" Height="26" Margin="20,0,20,0" Foreground="Black" Background="#5DADE2"/>
                                            <Button Content="查看绘制结果" 
                        Command="{Binding ViewNegativeRoiCommand}" 
                        CommandParameter="B3"
                        Width="120" Height="26" Margin="5,0" Foreground="Black" Background="#5DADE2"
                        IsEnabled="{Binding HasNegativeRoiB3}"/>
                                        </StackPanel>

                                        <!-- B工位相机4 -->
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,3">
                                            <TextBlock Text="相机4：" Width="80" VerticalAlignment="Center"  FontSize="20"/>
                                            <Button Content="选择绘制图片" 
                        Command="{Binding SelectNegativeRoiImageCommand}" 
