<Border
    x:Class="SUNWODA_SEVB.Views.Dialogs.JRCW.BusinessDialogs.Business2ParamDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters;assembly=SUNWODA_SEVB.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Dialogs.JRCW"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.JRCW.CustomControls;assembly=SUNWODA_SEVB.Component"
    Width="Auto"
    Height="Auto"
    MinWidth="600"
    MinHeight="400"
    MaxHeight="850"
    Background="#FF2B2B2B"
    BorderBrush="#1AFFFFFF"
    BorderThickness="1"
    CornerRadius="10"
    mc:Ignorable="d">
    <Border.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/JRCW/JRCWCustomControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
            <convert:EnumToBoolConverter x:Key="EnumToBoolConverter" />

            <!--  标题样式  -->
            <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="Foreground" Value="#FFFFFFFF" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!--  关闭按钮  -->
            <Style x:Key="ClosedButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="Opacity" Value="0.8" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.IconFont}" />
                <Setter Property="Content" Value="&#xe669;" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="2" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                        <Setter Property="FontWeight" Value="Bold" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  参数组容器样式  -->
            <Style TargetType="Border">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Background" Value="#0DFFFFFF" />
                <Setter Property="Margin" Value="0,20,20,0" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!--  参数组名样式  -->
            <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="FontFamily" Value="{StaticResource CCTB.SourceHanSansCN-Bold}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Foreground" Value="#CCFFFFFF" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextAlignment" Value="Left" />
            </Style>

            <!--  分割线样式  -->
            <Style TargetType="Rectangle">
                <Setter Property="Margin" Value="0,10,0,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Stroke" Value="#33FFFFFF" />
            </Style>

            <!--  参数控件样式  -->
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="hc:TextBox">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>

            <!--  下拉框样式  -->
            <Style BasedOn="{StaticResource HCParamComboBoxStyle}" TargetType="{x:Type hc:ComboBox}">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>


            <Style BasedOn="{StaticResource HCTabControlStyle}" TargetType="{x:Type hc:TabControl}">
                <Setter Property="Margin" Value="0,20,20,0" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!--  功能按钮  -->
            <Style
                x:Key="ConfirmButtonStyle"
                BasedOn="{StaticResource GrowlConfirmButtonStyle}"
                TargetType="Button">
                <Setter Property="Margin" Value="20,0,0,0" />
                <Setter Property="Background" Value="#FF3DCC84" />
                <Setter Property="Content" Value="保存" />
                <Setter Property="Command" Value="{Binding ConfirmCommand}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style
                x:Key="CancleButtonStyle"
                BasedOn="{StaticResource GrowlCancleButtonStyle}"
                TargetType="Button">
                <Setter Property="Margin" Value="20,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Content" Value="取消" />
                <Setter Property="Command" Value="{Binding CancleCommand}" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#2DFFFFFF" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  定义 DataTemplate  -->
            <DataTemplate x:Key="PerfectBatteryDataTemplate">
                <UniformGrid Margin="0,0,-20,0" Columns="2">
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="完美电芯条码"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding BatteryCode, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="完美错位量-正"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding B120, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="完美错位量-负"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding B121, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="首极耳-正"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding P_θb1, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="尾极耳-正"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding P_θbn, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="首极耳-负"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding P_θa1, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        Margin="0,10,20,0"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="尾极耳-负"
                        IsReadOnly="{Binding DataContext.UserRole, RelativeSource={RelativeSource AncestorType=Border}, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding P_θan, Mode=TwoWay}" />
                </UniformGrid>
            </DataTemplate>
        </ResourceDictionary>
    </Border.Resources>

    <Grid Margin="20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  标题  -->
        <DockPanel VerticalAlignment="Center" LastChildFill="False">
            <TextBlock
                DockPanel.Dock="Left"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="参数配置窗口" />
            <Button
                Command="{Binding CloseCommand}"
                DockPanel.Dock="Right"
                Style="{StaticResource ClosedButtonStyle}" />
        </DockPanel>

        <!--  内容  -->
        <Grid Grid.Row="1" Margin="0,0,-20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0">
                <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                    <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="参数设置" />
                    <Rectangle />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="数采触发极耳层数"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.TabCount, Mode=TwoWay}" />
                    <hc:ComboBox
                        Width="360"
                        Margin="0,10,0,0"
                        d:SelectedIndex="0"
                        hc:InfoElement.Title="卷针类型"
                        DisplayMemberPath="DisplayName"
                        IsEnabled="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='Engineer,Admin,SuperAdmin'}"
                        ItemsSource="{Binding NeedleTypeSource}"
                        SelectedValue="{Binding ItemSource.NeedleType, Mode=TwoWay}"
                        SelectedValuePath="ItemValue" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="闭环阈值t4"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.T4, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="单次调节量上限"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.U_Limit, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="调节系数k值"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.K, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="0" Grid.Column="1">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="极耳层数" />
                    <Rectangle />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="正极层数"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.Nb, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="负极层数"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.Na, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="首极耳正"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.S_Nb1, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="尾极耳正"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.S_Nbn, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="首极耳负"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.S_Na1, Mode=TwoWay}" />
                    <hc:TextBox
                        Width="360"
                        hc:InfoElement.Placeholder="请输入"
                        hc:InfoElement.Title="尾极耳负"
                        IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                        Text="{Binding ItemSource.S_Nan, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <hc:TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}">
                    <!--  1#完美电芯  -->
                    <hc:TabItem Header="1#完美电芯" Style="{StaticResource HCTabItemStyle}">
                        <ContentPresenter Content="{Binding ItemSource.PerfectBattery1}" ContentTemplate="{StaticResource PerfectBatteryDataTemplate}" />
                    </hc:TabItem>
                    <!--  2#完美电芯  -->
                    <hc:TabItem Header="2#完美电芯" Style="{StaticResource HCTabItemStyle}">
                        <ContentPresenter Content="{Binding ItemSource.PerfectBattery2}" ContentTemplate="{StaticResource PerfectBatteryDataTemplate}" />
                    </hc:TabItem>
                    <!--  3#完美电芯（根据针型控制显示）  -->
                    <hc:TabItem
                        Header="3#完美电芯"
                        Style="{StaticResource HCTabItemStyle}"
                        Visibility="{Binding ItemSource.NeedleType, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=三针}">
                        <ContentPresenter Content="{Binding ItemSource.PerfectBattery3}" ContentTemplate="{StaticResource PerfectBatteryDataTemplate}" />
                    </hc:TabItem>
                </hc:TabControl>
                <Border
                    Grid.Row="1"
                    Margin="0,0,20,0"
                    CornerRadius="0">
                    <Rectangle Margin="0" />
                </Border>
                <Border
                    Grid.Row="2"
                    Margin="0,0,20,0"
                    CornerRadius="0">
                    <StackPanel
                        Margin="0,-20,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <hc:TextBox
                            MinWidth="180"
                            Margin="0"
                            hc:InfoElement.Placeholder="请输入电芯条码"
                            hc:InfoElement.TitleWidth="0"
                            IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Engineer,Admin,SuperAdmin'}"
                            Text="{Binding VerifyBatteryCode, Mode=TwoWay}" />
                        <Button
                            Command="{Binding VerifyBatteryCodeCommand}"
                            Content="开始配置"
                            IsEnabled="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='Engineer,Admin,SuperAdmin'}"
                            Style="{StaticResource ConfirmButtonStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <ScrollViewer
                Grid.Row="0"
                Grid.RowSpan="2"
                Grid.Column="2"
                Margin="0,20,0,0"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,-20,0,0" Orientation="Vertical">
                    <Border Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}">
                        <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                            <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="变径参数设置" />
                            <Rectangle />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="闭环阈值t1"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.T1, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="闭环阈值t2"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.T2, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="闭环阈值t3"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.T3, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="变径调节精度"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.J_d, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="完美电芯失效预警阈值"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.CCDErrT, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}">
                        <StackPanel VerticalAlignment="Top" Orientation="Vertical">
                            <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="压花参数设置" />
                            <Rectangle />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="错位稳定阈值"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.PressT, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="压花上限"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.PressUp, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="压花下限"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.PressDown, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="压花调节步长"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.PressStep, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="压花步长对应错位变化量"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.PressK, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="压花连续调节次数"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.PressJT, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <Border Visibility="{Binding UserRole, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter='Admin,SuperAdmin'}">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="极耳圈周长" />
                            <Rectangle />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="稳定首极耳圈周长-正极"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.Cb1, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="稳定尾极耳圈周长-正极"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.Cbn, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="稳定首极耳圈周长-负极"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.Ca1, Mode=TwoWay}" />
                            <hc:TextBox
                                Width="360"
                                hc:InfoElement.Placeholder="请输入"
                                hc:InfoElement.Title="稳定尾极耳圈周长-负极"
                                IsReadOnly="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='!Admin,SuperAdmin'}"
                                Text="{Binding ItemSource.Can, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!--  功能按钮  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button IsEnabled="{Binding UserRole, Converter={StaticResource EnumToBoolConverter}, ConverterParameter='Engineer,Admin,SuperAdmin'}" Style="{StaticResource ConfirmButtonStyle}" />
            <Button Style="{StaticResource CancleButtonStyle}" />
        </StackPanel>
    </Grid>
</Border>

