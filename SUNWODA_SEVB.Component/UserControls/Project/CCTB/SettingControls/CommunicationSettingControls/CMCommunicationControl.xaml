<UserControl
    x:Class="SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.CommunicationSettingControls.CMCommunicationControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.CommunicationSettingControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ucc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB"
    xmlns:uccc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.CustomControls"
    d:DesignHeight="1020"
    d:DesignWidth="1330"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/FunctionParamControlStyle.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  文本样式  -->
            <Style BasedOn="{StaticResource HCTitleValueTextBox}" TargetType="{x:Type hc:TextBox}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Width" Value="360" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <!--  键值对容器样式  -->
            <Style BasedOn="{StaticResource ParamPairContentControlStyle}" TargetType="{x:Type uccc:PairContentControl}">
                <Setter Property="Width" Value="360" />
                <Setter Property="Height" Value="30" />
                <Setter Property="Margin" Value="0,20,0,0" />
                <Setter Property="PairKeyWidth" Value="180" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" Margin="20">
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource ParamHeaderTextBlockStyle}" Text="远端设备配置（PLC）" />
                <uccc:PairContentControl IsEnabled="False" PairKeyText="是否启用PLC">
                    <uccc:SimpleToggleButton IsChecked="{Binding ItemSource.CMIsEnable, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource ParamValueSimpleToggleButtonStyle}" />
                </uccc:PairContentControl>
                <hc:TextBox
                    Width="360"
                    hc:InfoElement.Placeholder="请输入IP"
                    hc:InfoElement.Title="远端IP"
                    Text="{Binding ItemSource.CMPLCIP, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <hc:TextBox
                    Width="360"
                    hc:InfoElement.Placeholder="请输入端口"
                    hc:InfoElement.Title="远端端口"
                    Text="{Binding ItemSource.CMPLCPort, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <hc:TextBox
                    Width="360"
                    hc:InfoElement.Placeholder="请输入品牌规格协议"
                    hc:InfoElement.Title="品牌规格协议"
                    Text="{Binding ItemSource.CMBrandSpecificationProtocal, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <hc:TextBox
                    Width="360"
                    hc:InfoElement.Placeholder="请输入循环读取时间"
                    hc:InfoElement.Title="循环读取时间（ms）"
                    Text="{Binding ItemSource.CMCycleReadTime, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <hc:TextBox
                    Width="360"
                    hc:InfoElement.Placeholder="请输入循环写入时间"
                    hc:InfoElement.Title="循环写入时间（ms）"
                    Text="{Binding ItemSource.CMCycleWriteTime, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>
        </ScrollViewer>

        <!--  功能按钮  -->
        <Border
            Grid.Row="1"
            BorderBrush="#61FFFFFF"
            BorderThickness="0,1,0,0">
            <StackPanel
                Margin="0,0,20,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FlowDirection="LeftToRight"
                Orientation="Horizontal"
                Visibility="Hidden">
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding SaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="保存"
                    Style="{StaticResource ParamOKButtonStyle}" />
                <Button
                    Margin="10,0,0,0"
                    Command="{Binding CancleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    Content="取消"
                    Style="{StaticResource ParamCancleButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
