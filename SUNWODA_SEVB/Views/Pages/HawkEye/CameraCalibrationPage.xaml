<Page
    x:Class="SUNWODA_SEVB.Views.Pages.HawkEye.CameraCalibrationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.HawkEye"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="相机标定配置"
    d:DesignHeight="795.919"
    d:DesignWidth="1075.156"
    mc:Ignorable="d">

    <!--  页面资源配置，设置每个GroupBox的样式，方便后续调用  -->
    <Page.Resources>
        <Style x:Key="GroupBoxStyle1" TargetType="{x:Type GroupBox}">
            <Setter Property="Margin" Value="5,5,5,5" />
            <Setter Property="Padding" Value="5,5,5,5" />
            <Setter Property="BorderBrush" Value="#D5DFE5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupBox}">
                        <Grid SnapsToDevicePixels="true">
                            <!--  每个GroupBox分为4行4列，在 Grid.Row="2"、Grid.Column="1"（第2、3列合并）出显示文本内容  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="6" />
                            </Grid.RowDefinitions>
                            <!--  对每个GroupBox边框的配置  -->
                            <Border
                                Grid.Row="1"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="4"
                                BorderBrush="Black"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                RenderTransformOrigin="0.5,0.5">
                                <Border
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                    <Border
                                        BorderBrush="White"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="2" />
                                </Border>
                            </Border>
                            <!--  对“数据处理配置”等标题头的配置  -->
                            <!--
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"是一个重要的像素对齐属性，
                                用于确保控件渲染的像素级精确性
                                SnapsToDevicePixels：布尔属性，控制是否将元素对齐到设备像素
                                TemplateBinding：将模板内部属性绑定到外部控件的对应属性
                            -->
                            <Border
                                x:Name="Header"
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="2"
                                Padding="2,1,2,1"
                                HorizontalAlignment="Center"
                                Background="White">
                                <ContentPresenter
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            </Border>
                            <!--  用于在控件模板中显示内容  -->
                            <ContentPresenter
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                Margin="{TemplateBinding Padding}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>


    <Grid>
        <!--  1行1列的大框架布局  -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="1"
            Padding="2"
            Background="Transparent"
            BorderBrush="#DDD"
            BorderThickness="1"
            CornerRadius="5">
            <GroupBox Header="相机标定界面设置">
                <!--  滚动条控件：ScrollViewer  -->
                <ScrollViewer
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <Expander
                            FontSize="15"
                            Header="标定板参数"
                            IsExpanded="True"
                            Style="{x:Null}">
                            <StackPanel>
                                <UniformGrid Columns="1" Rows="1">
                                    <GroupBox
                                        Margin="5,5,5,5"
                                        Padding="5,2,5,2"
                                        Header="标定板基本数据"
                                        Style="{StaticResource GroupBoxStyle1}">
                                        <StackPanel Orientation="Horizontal">
                                            <DockPanel Margin="1,1,1,1" VerticalAlignment="Center">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Text="行角点数：" />
                                                <TextBox
                                                    Name="行角点数"
                                                    Width="100"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    BorderBrush="Blue"
                                                    Text="{Binding CalibrationPlateModel.ProceedNumber}"
                                                    ToolTip="行角点数" />
                                            </DockPanel>
                                            <DockPanel Margin="150,1,1,1" VerticalAlignment="Center">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Text="列角点数：" />
                                                <TextBox
                                                    Name="列角点数"
                                                    Width="100"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Center"
                                                    BorderBrush="Blue"
                                                    Text="{Binding CalibrationPlateModel.ListNumber}"
                                                    ToolTip="列角点数" />
                                            </DockPanel>
                                            <DockPanel Margin="150,1,1,1" VerticalAlignment="Center">
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Text="棋盘格单元尺寸：" />
                                                <TextBox
                                                    Name="棋盘格单元尺寸"
                                                    Width="100"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Right"
                                                    BorderBrush="Blue"
                                                    Text="{Binding CalibrationPlateModel.CheckerboardSize}"
                                                    ToolTip="棋盘格单元尺寸" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Text="m" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>

                        <Expander
                            FontSize="15"
                            Header="相机标定"
                            IsExpanded="True"
                            Style="{x:Null}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox
                                        Grid.Column="0"
                                        Height="400"
                                        Margin="5"
                                        VerticalAlignment="Top"
                                        Header="图像"
                                        Style="{StaticResource GroupBoxStyle1}">

                                        <ListBox
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="14"
                                            Foreground="Black"
                                            ItemsSource="{Binding ImagePaths}"
                                            ScrollViewer.CanContentScroll="True"
                                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                                            SelectedItem="{Binding SelectedImage, Mode=TwoWay}" />
                                    </GroupBox>

                                    <GroupBox
                                        Grid.Column="1"
                                        Height="400"
                                        Margin="5"
                                        VerticalAlignment="Top"
                                        Header="图片文件操作"
                                        Style="{StaticResource GroupBoxStyle1}">
                                        <Grid Margin="5">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Button
                                                Grid.Row="0"
                                                Height="40"
                                                MinWidth="90"
                                                VerticalContentAlignment="Center"
                                                Background="#3355FF"
                                                Command="{Binding LoadImageDirectory}"
                                                Content="加载"
                                                FontSize="14"
                                                FontWeight="Black"
                                                Foreground="White"
                                                ToolTip="加载图片文件夹" />
                                            <Button
                                                Grid.Row="1"
                                                Height="40"
                                                MinWidth="90"
                                                Margin="0,0,0,2"
                                                VerticalContentAlignment="Center"
                                                Background="#3355FF"
                                                Command="{Binding RemoveSelectedImage}"
                                                Content="移除"
                                                FontSize="14"
                                                FontWeight="Black"
                                                Foreground="White" />
                                            <Button
                                                Grid.Row="2"
                                                Height="40"
                                                MinWidth="90"
                                                Margin="0,0,0,2"
                                                VerticalContentAlignment="Center"
                                                Background="#3355FF"
                                                Command="{Binding RemoveAllImages}"
                                                Content="移除所有"
                                                FontSize="14"
                                                FontWeight="Black"
                                                Foreground="White" />
                                            <Button
                                                Grid.Row="3"
                                                Height="40"
                                                MinWidth="90"
                                                Margin="0,0,0,2"
                                                VerticalContentAlignment="Center"
                                                Background="#3355FF"
                                                Command="{Binding Calibration}"
                                                Content="标定"
                                                FontSize="14"
                                                FontWeight="Black"
                                                Foreground="White" />
                                        </Grid>
                                    </GroupBox>

                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander
                            FontSize="15"
                            Header="像素精度"
                            IsExpanded="True"
                            Style="{x:Null}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox
                                        Grid.Column="0"
                                        Height="100"
                                        Margin="5,0,5,5"
                                        VerticalAlignment="Bottom"
                                        Header="标定图像"
                                        Style="{StaticResource GroupBoxStyle1}">

                                        <ListBox
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="14"
                                            Foreground="Black"
                                            ItemsSource="{Binding ImagePath}" />
                                    </GroupBox>

                                    <GroupBox
                                        Grid.Column="1"
                                        Margin="5,5,5,5"
                                        Header="像素精度操作"
                                        Style="{StaticResource GroupBoxStyle1}">
                                        <StackPanel>
                                            <DockPanel Margin="1,1,1,1" VerticalAlignment="Center">
                                                <Button
                                                    MinWidth="90"
                                                    Margin="0,0,0,2"
                                                    VerticalContentAlignment="Center"
                                                    Background="#3355FF"
                                                    Command="{Binding LoadImage}"
                                                    Content="加载"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Foreground="White"
                                                    ToolTip="加载一张标定图片" />
                                            </DockPanel>

                                            <DockPanel>
                                                <Button
                                                    MinWidth="90"
                                                    Margin="0,0,0,2"
                                                    VerticalContentAlignment="Center"
                                                    Background="#3355FF"
                                                    Command="{Binding RemoveImage}"
                                                    Content="移除"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Foreground="White" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>

                                </Grid>

                                <Grid>
                                    <GroupBox
                                        Grid.Column="2"
                                        Margin="5,5,5,5"
                                        Header="像素精度计算"
                                        Style="{StaticResource GroupBoxStyle1}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <!--  左侧内容  -->
                                                <ColumnDefinition Width="Auto" />
                                                <!--  右侧按钮  -->
                                            </Grid.ColumnDefinitions>

                                            <!--  左侧像素精度显示  -->
                                            <StackPanel
                                                Grid.Column="0"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal">
                                                <DockPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="Black"
                                                        Text="像素精度：" />
                                                    <TextBox
                                                        Name="像素精度计算结果"
                                                        Width="200"
                                                        Margin="10,5,5,5"
                                                        HorizontalAlignment="Right"
                                                        BorderBrush="Blue"
                                                        IsEnabled="False"
                                                        Text="{Binding CalibrationPlateModel.PixelPrecision}"
                                                        ToolTip="像素精度计算结果" />
                                                    <TextBlock
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="Black"
                                                        Text="mm/pix" />
                                                </DockPanel>
                                            </StackPanel>

                                            <!--  右侧按钮组  -->
                                            <StackPanel
                                                Grid.Column="1"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                                <Button
                                                    MinWidth="90"
                                                    VerticalContentAlignment="Center"
                                                    Background="#3355FF"
                                                    Command="{Binding CalculatePixelAccuracy}"
                                                    Content="开始计算"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Foreground="White" />
                                                <Button
                                                    MinWidth="90"
                                                    Margin="20,0,0,0"
                                                    VerticalContentAlignment="Center"
                                                    Background="#3355FF"
                                                    Command="{Binding LoadCalibrationConfig}"
                                                    Content="加载标定配置文件"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Foreground="White" />
                                                <Button
                                                    MinWidth="90"
                                                    Margin="20,0,0,0"
                                                    VerticalContentAlignment="Center"
                                                    Background="#3355FF"
                                                    Command="{Binding ExportCalibrationConfig}"
                                                    Content="导出标定配置文件"
                                                    FontSize="14"
                                                    FontWeight="Black"
                                                    Foreground="White" />
                                            </StackPanel>
                                        </Grid>
                                    </GroupBox>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Border>
    </Grid>
</Page>
