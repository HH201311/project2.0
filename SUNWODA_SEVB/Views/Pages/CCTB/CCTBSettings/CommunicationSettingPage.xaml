<Page
    x:Class="SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings.CommunicationSettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:convert="clr-namespace:SUNWODA_SEVB.Core.Converters.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:csc="clr-namespace:SUNWODA_SEVB.Component.UserControls.Project.CCTB.SettingControls.CommunicationSettingControls;assembly=SUNWODA_SEVB.Component"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:SUNWODA_SEVB.Core.Enumerations.Project.CCTB;assembly=SUNWODA_SEVB.Core"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.CCTB.CCTBSettings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="CommunicationSettingPage"
    d:DesignHeight="940"
    d:DesignWidth="1610"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBControlStyles.xaml" />
                <ResourceDictionary Source="/SUNWODA_SEVB.Component;component/Themes/Project/CCTB/CCTBParamControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <convert:StringToBooleanConverter x:Key="StringToBooleanConverter" />
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  按钮区  -->
        <Border
            Grid.Row="0"
            Background="#0DFFFFFF"
            CornerRadius="10">
            <DockPanel VerticalAlignment="Stretch" LastChildFill="False">
                <RadioButton
                    x:Name="WeightMeasureRB"
                    d:IsChecked="True"
                    Command="{Binding ControlPageNavigateCommand}"
                    Content="测重仪"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='WMCommunicationControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="CoatingMachineRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    Content="涂布机"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='CMCommunicationControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="DieHeadRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    Content="模头"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='DHCommunicationControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
                <RadioButton
                    x:Name="CCDRB"
                    d:IsChecked="False"
                    Command="{Binding ControlPageNavigateCommand}"
                    Content="CCD"
                    IsChecked="{Binding ControlPageName, Mode=TwoWay, Converter={StaticResource StringToBooleanConverter}, ConverterParameter='CCDCommunicationControl'}"
                    Style="{StaticResource TabNavigationRadioButtonStyle}" />
            </DockPanel>
        </Border>

        <!--  内容区  -->
        <ContentControl
            Grid.Row="1"
            Margin="0,20,0,0"
            Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=WeightMeasureRB}" Value="True">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Border Background="#0DFFFFFF" CornerRadius="10">
                                            <csc:WMCommunicationControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding CommunicationModel, Mode=TwoWay}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </Border>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=CoatingMachineRB}" Value="True">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Border Background="#0DFFFFFF" CornerRadius="10">
                                            <csc:CMCommunicationControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding CommunicationModel, Mode=TwoWay}"
                                                SaveCommand="{Binding ParamPLCSaveCommand}" />
                                        </Border>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=DieHeadRB}" Value="True">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Background="#0DFFFFFF"
                                                CornerRadius="10">
                                                <csc:DHCommunicationControl
                                                    CancleCommand="{Binding ParamCancleCommand}"
                                                    ItemSource="{Binding CommunicationModel, Mode=TwoWay}"
                                                    SaveCommand="{Binding ParamSaveCommand}"
                                                    SideType="{x:Static enums:ESideType.A}" />
                                            </Border>
                                            <Border
                                                Grid.Column="2"
                                                Background="#0DFFFFFF"
                                                CornerRadius="10">
                                                <csc:DHCommunicationControl
                                                    CancleCommand="{Binding ParamCancleCommand}"
                                                    ItemSource="{Binding CommunicationModel, Mode=TwoWay}"
                                                    SaveCommand="{Binding ParamSaveCommand}"
                                                    SideType="{x:Static enums:ESideType.B}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=CCDRB}" Value="True">
                            <Setter Property="ContentTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <Border Background="#0DFFFFFF" CornerRadius="10">
                                            <csc:CCDCommunicationControl
                                                CancleCommand="{Binding ParamCancleCommand}"
                                                ItemSource="{Binding CommunicationModel, Mode=TwoWay}"
                                                SaveCommand="{Binding ParamSaveCommand}" />
                                        </Border>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
    </Grid>
</Page>

