<Page
    x:Class="SUNWODA_SEVB.Views.Pages.PTO.PTODamageDetectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SUNWODA_SEVB.Views.Pages.PTO"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SUNWODA_SEVB.ViewModels.Pages.PTO"
    Title="PTODamageDetectionPage"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    FontSize="15"
    mc:Ignorable="d">
    <!--<Page.Resources>
        <vm:VM_PTODamageDetectionPage x:Key="DamageDetectionVM" />
    </Page.Resources>-->
    <!--  Grid DataContext="{StaticResource DamageDetectionVM}"  -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  顶部标题行  -->
        <Grid
            Grid.Row="0"
            Margin="0,0,0,0"
            Background="LightGray">
            <StackPanel
                Margin="10"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  logo图片  -->
                <Image
                    MaxWidth="80"
                    MaxHeight="90"
                    Source="pack://application:,,,/SUNWODA_SEVB;component/Assets/images/logo.png" />
                <!--  项目名称文本  -->
                <TextBlock
                    MinWidth="400"
                    VerticalAlignment="Center"
                    FontSize="35"
                    FontWeight="Bold"
                    Foreground="Black"
                    Text="PTO叠片 AI检测系统V1.0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="1.9*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="300" />
                </Grid.RowDefinitions>

                <!--  左列：标题区域  -->
                <Border
                    Grid.Column="0"
                    Margin="0,0,0,0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                    <StackPanel Margin="0" Orientation="Vertical">
                        <TextBlock
                            Margin="20,0,0,0"
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="#2C3E50"
                            Text="叠片缺陷AI检测界面" />
                    </StackPanel>
                </Border>

                <!--  实时检测图 + 进度条  -->
                <Border
                    Grid.Row="1"
                    Margin="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                    <Grid Background="Transparent" ClipToBounds="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Margin="10,10,0,10"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#2C3E50"
                            Text="实时检测" />

                        <Image
                            x:Name="ImgRealTimeDetect"
                            Grid.Row="1"
                            MaxWidth="1100"
                            MaxHeight="540"
                            Margin="10"
                            RenderTransformOrigin="0.5,0.5"
                            Source="{Binding CurrentResultImage}"
                            Stretch="Uniform">

                            <!--  为Image控件设置渲染变换（视觉层面的缩放/平移，不影响控件布局位置）  -->
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <!--  缩放变换：控制图片在X/Y轴的缩放比例  -->
                                    <ScaleTransform ScaleX="{Binding RealTimeImageScaleX}" ScaleY="{Binding RealTimeImageScaleY}" />
                                    <!--  平移变换：控制图片在X/Y轴的平移距离（单位为像素）  -->
                                    <TranslateTransform X="{Binding RealTimeImageTranslateX}" Y="{Binding RealTimeImageTranslateY}" />
                                </TransformGroup>
                            </Image.RenderTransform>

                            <!--  交互触发器容器：用于将UI控件的原生事件绑定到ViewModel的命令（MVVM解耦）  -->
                            <!--  behaviors通常对应Microsoft.Xaml.Behaviors.Wpf NuGet包的命名空间  -->
                            <behaviors:Interaction.Triggers>
                                <!--  1. 鼠标滚轮缩放事件触发器：绑定图片缩放命令  -->
                                <behaviors:EventTrigger EventName="MouseWheel">
                                    <!--  将滚轮事件绑定到ViewModel的ZoomRealTimeImageCommand命令  -->
                                    <!--  PassEventArgsToCommand="True"：将MouseWheelEventArgs参数传递给命令处理方法  -->
                                    <behaviors:InvokeCommandAction Command="{Binding ZoomRealTimeImageCommand}" PassEventArgsToCommand="True" />
                                </behaviors:EventTrigger>
                                <!--  2. 鼠标左键按下事件触发器：绑定图片拖拽开始命令  -->
                                <behaviors:EventTrigger EventName="MouseLeftButtonDown">
                                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseDownCommand}" PassEventArgsToCommand="True" />
                                </behaviors:EventTrigger>
                                <!--  3. 鼠标移动事件触发器：绑定图片拖拽移动命令  -->
                                <behaviors:EventTrigger EventName="MouseMove">
                                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseMoveCommand}" PassEventArgsToCommand="True" />
                                </behaviors:EventTrigger>
                                <!--  4. 鼠标左键松开事件触发器：绑定图片拖拽结束命令  -->
                                <behaviors:EventTrigger EventName="MouseLeftButtonUp">
                                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand}" PassEventArgsToCommand="True" />
                                </behaviors:EventTrigger>
                                <!--  5. 鼠标离开控件事件触发器：绑定图片拖拽结束命令（兜底处理）  -->
                                <behaviors:EventTrigger EventName="MouseLeave">
                                    <behaviors:InvokeCommandAction Command="{Binding ImageMouseUpCommand}" PassEventArgsToCommand="True" />
                                </behaviors:EventTrigger>
                            </behaviors:Interaction.Triggers>

                            <!--  图片上双击还原  -->
                            <Image.InputBindings>
                                <MouseBinding Command="{Binding ResetRealTimeImageZoomCommand}" MouseAction="LeftDoubleClick" />
                            </Image.InputBindings>
                            <Image.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ZoomInRealTimeCommand}" Header="放大" />
                                    <MenuItem Command="{Binding ZoomOutRealTimeCommand}" Header="缩小" />
                                    <MenuItem Command="{Binding ResetRealTimeImageZoomCommand}" Header="适应窗口" />
                                </ContextMenu>
                            </Image.ContextMenu>
                        </Image>

                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ZoomInRealTimeCommand}" Header="放大" />
                                <MenuItem Command="{Binding ZoomOutRealTimeCommand}" Header="缩小" />
                                <MenuItem Command="{Binding ResetRealTimeImageZoomCommand}" Header="适应窗口" />
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Grid.InputBindings>
                            <MouseBinding Command="{Binding ResetRealTimeImageZoomCommand}" MouseAction="LeftDoubleClick" />
                        </Grid.InputBindings>
                    </Grid>
                </Border>

                <!--  检测进度条  -->
                <Border
                    Grid.Row="2"
                    Margin="0,0,0,0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Visibility="{Binding IsOfflineProgressVisible}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            Margin="0,0,15,0"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#333"
                            Text="离线进度条" />

                        <!--  检测进度条  -->
                        <ProgressBar
                            x:Name="PbOfflineProgress"
                            Grid.Column="1"
                            Height="20"
                            Margin="0,0,15,0"
                            Background="#E0E0E0"
                            Foreground="Red"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding OfflineProgressValue, FallbackValue=0}" />

                        <!--  已完成100%，检测结束！  -->
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#333"
                            Text="{Binding OfflineProgressTip}" />
                    </Grid>
                </Border>

                <!--  日志区域：DataGrid表格形式  -->
                <Border
                    Grid.Row="3"
                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                    Margin="0"
                    BorderBrush="Black"
                    BorderThickness="1">
                    <Grid Margin="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            Margin="0,0,0,0"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="系统日志" />
                        <DataGrid
                            x:Name="LogDataGrid"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            Background="White"
                            CanUserAddRows="False"
                            HeadersVisibility="None"
                            HorizontalScrollBarVisibility="Auto"
                            IsReadOnly="True"
                            ItemsSource="{Binding LogTable, Mode=OneWay}"
                            RowHeaderWidth="0"
                            RowHeight="24"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding Item1}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <!--  时间居中  -->
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="1000"
                                    Binding="{Binding Item2}"
                                    IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Background" Value="White" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Setter Property="HorizontalAlignment" Value="Left" />
                                            <Setter Property="Padding" Value="5,2" />
                                            <Setter Property="ToolTip" Value="{Binding Item2}" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <TextBlock
                                                            Padding="{TemplateBinding Padding}"
                                                            FontSize="{TemplateBinding FontSize}"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            Text="{Binding Item2}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!--  右侧：数据/设置面板/状态信息面板  -->
            <Border
                Grid.Column="1"
                Margin="0,0,0,0"
                BorderBrush="Black"
                BorderThickness="1">
                <TabControl Height="Auto" Margin="0">
                    <!--  「生产统计」标签页  -->
                    <TabItem FontSize="25" Header="生产统计">
                        <Grid Height="Auto" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="161*" />
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="125*" />
                                <ColumnDefinition Width="414*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="1.3*" />
                            </Grid.RowDefinitions>
                            <!--  图片名、正负极、工位、检测结果等  -->
                            <DataGrid
                                x:Name="DgDetection"
                                Grid.ColumnSpan="5"
                                Height="Auto"
                                AlternationCount="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                ItemsSource="{Binding DetectionDataList}"
                                RowHeaderWidth="0"
                                SelectedItem="{Binding SelectedDetectionData}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="*"
                                        MinWidth="100"
                                        Binding="{Binding ImageName}"
                                        Header="图片名">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                                <Setter Property="FontSize" Value="10" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn
                                        Width="0.9*"
                                        MinWidth="100"
                                        Binding="{Binding Polarity}"
                                        Header="正负极">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn
                                        Width="0.8"
                                        MinWidth="80"
                                        Binding="{Binding Camerainformation}"
                                        Header="工位">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn
                                        Width="1.1*"
                                        MinWidth="125"
                                        Binding="{Binding DetectionResult}"
                                        Header="检测结果">
                                        <!--  结果文字颜色：OK绿色，NG红色  -->
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="Green" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                                <Setter Property="FontSize" Value="15" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DetectionResult}" Value="NG">
                                                        <Setter Property="Foreground" Value="Red" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <!--  查看结果按钮列  -->
                                    <DataGridTemplateColumn
                                        Width="1.1*"
                                        MinWidth="125"
                                        Header="查看结果">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.ViewResultCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="查看" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <!--  跳转存储按钮列  -->
                                    <DataGridTemplateColumn
                                        Width="1.1*"
                                        MinWidth="125"
                                        Header="跳转存储">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.JumpToStorageCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Content="跳转" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid
                                Grid.RowSpan="2"
                                Grid.ColumnSpan="5"
                                Margin="0,570,0,0" />

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="5"
                                MaxHeight="400"
                                Margin="0,5,0,0"
                                BorderBrush="LightGray"
                                BorderThickness="1">
                                <StackPanel Margin="10">
                                    <TextBlock
                                        Margin="0,0,0,15"
                                        HorizontalAlignment="Center"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="DarkBlue"
                                        Text="负极缺陷检测信息" />

                                    <Border
                                        HorizontalAlignment="Stretch"
                                        BorderBrush="Black"
                                        BorderThickness="1">
                                        <Grid>
                                            <Grid.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="Black" />
                                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                                    <Setter Property="Padding" Value="10" />
                                                </Style>
                                            </Grid.Resources>

                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  行1  -->
                                            <Border Grid.Row="0" Grid.Column="0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="总检测数" />
                                            </Border>
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                BorderThickness="0,0,0,1">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="OK数" />
                                            </Border>
                                            <!--  行2  -->
                                            <Border Grid.Row="1" Grid.Column="0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="{Binding TotalNeDetectionCount}" />
                                            </Border>
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                BorderThickness="0,0,0,1">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="{Binding OKCount}" />
                                            </Border>
                                            <!--  行3  -->
                                            <Border Grid.Row="2" Grid.Column="0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="NG数" />
                                            </Border>
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="1"
                                                BorderThickness="0,0,0,1">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    FontWeight="SemiBold"
                                                    Text="一次优率" />
                                            </Border>
                                            <!--  行4  -->
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                BorderThickness="0,0,1,0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="{Binding NGCount}" />
                                            </Border>
                                            <Border
                                                Grid.Row="3"
                                                Grid.Column="1"
                                                BorderThickness="0">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Text="{Binding OKRate, StringFormat={}{0:F2}%}" />
                                            </Border>

                                        </Grid>
                                    </Border>

                                    <StackPanel
                                        Margin="0,40,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Width="120"
                                            Height="35"
                                            Margin="0,0,40,0"
                                            Background="#F5B0"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            Command="{Binding StopDetectionCommand}"
                                            Content="停止检测"
                                            FontSize="16"
                                            Foreground="Black" />

                                        <Button
                                            Width="120"
                                            Height="35"
                                            Margin="0,0,20,0"
                                            Background="#F5B041"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            Command="{Binding ClearListCommand}"
                                            Content="清空列表"
                                            FontSize="16"
                                            Foreground="Black" />

                                        <Button
                                            Width="120"
                                            Height="35"
                                            Margin="20,0,0,0"
                                            Background="#F5B041"
                                            BorderBrush="Gray"
                                            BorderThickness="1"
                                            Command="{Binding ClearStatisticsCommand}"
                                            Content="统计清零"
                                            FontSize="16"
                                            Foreground="Black" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem FontSize="25" Header="参数设定">
                        <StackPanel
                            Height="Auto"
                            Margin="10,0,10,0"
                            VerticalAlignment="Top">

                            <!--  A工位监听路径  -->
                            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Width="Auto"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="正极工位监听路径：" />
                                <TextBox
                                    Width="200"
                                    Height="30"
                                    Margin="5,0"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    FontSize="18"
                                    IsEnabled="{Binding IsInAnyDetectionA}"
                                    Text="{Binding SelectedMonitorFolderPathA, Mode=TwoWay}" />
                                <!--  IsEnabled为True时触发Command，为False时不触发  -->
                                <Button
                                    Width="60"
                                    Height="30"
                                    Margin="5,0"
                                    Background="#5DADE2"
                                    BorderThickness="0"
                                    Command="{Binding SelectMonitorFolderCommandA}"
                                    Content="浏览..."
                                    Foreground="White"
                                    IsEnabled="{Binding IsInAnyDetectionA}" />
                            </StackPanel>

                            <!--  B工位监听路径  -->
                            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                <TextBlock
                                    Width="Auto"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="负极工位监听路径：" />
                                <TextBox
                                    Width="200"
                                    Height="30"
                                    Margin="5,0"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="1"
                                    FontSize="18"
                                    IsEnabled="{Binding IsInAnyDetectionB}"
                                    Text="{Binding SelectedMonitorFolderPathB, Mode=TwoWay}" />
                                <Button
                                    Width="60"
                                    Height="30"
                                    Margin="5,0"
                                    Background="#5DADE2"
                                    BorderThickness="0"
                                    Command="{Binding SelectMonitorFolderCommandB}"
                                    Content="浏览..."
                                    Foreground="White"
                                    IsEnabled="{Binding IsInAnyDetectionB}" />
                            </StackPanel>

                            <!--  在线检测  -->
                            <StackPanel
                                Margin="0,20,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Width="Auto"
                                    Margin="0,0,10,0"
                                    FontWeight="Bold"
                                    Text="在线检测：" />
                                <!--  A工位开关  -->
                                <!--  IsEnabled：控制控件是否可用（能否响应用户交互）；IsChecked：控制控件选中状态（仅适用于可勾选控件：ToggleButton/CheckBox 等）  -->
                                <!--  IsChecked：双向绑定,按钮选中状态 ↔ ViewModel的IsOnlineDetectionEnabledA属性Mode=TwoWay：UI操作（点击按钮）更新ViewModel，ViewModel值变化也更新UI  -->
                                <!--  IsEnabled：单向绑定,按钮是否可用由ViewModel的IsOnlineToggleEnabledA控制True=可用，False=禁用（灰显，无法点击）  -->
                                <ToggleButton
                                    Height="30"
                                    Margin="0,0,20,0"
                                    FontSize="15"
                                    IsChecked="{Binding IsOnlineDetectionEnabledA, Mode=TwoWay}"
                                    IsEnabled="{Binding IsOnlineToggleEnabledA}">
                                    <ToggleButton.Style>
                                        <Style BasedOn="{StaticResource ToggleButtonSwitch.Small}" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="正极工位已关闭" />
                                            <Style.Triggers>
                                                <!--  触发器1：按钮自身IsChecked=True（选中）→ 显示“A工位已打开”  -->
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Content" Value="正极工位已打开" />
                                                </DataTrigger>
                                                <!--  触发器2：按钮自身IsChecked=False（未选中）→ 显示“A工位已关闭”  -->
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                                    <Setter Property="Content" Value="正极工位已关闭" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                                <!--  B工位开关  -->
                                <ToggleButton
                                    Height="30"
                                    Margin="0,0,0,0"
                                    FontSize="15"
                                    IsChecked="{Binding IsOnlineDetectionEnabledB, Mode=TwoWay}"
                                    IsEnabled="{Binding IsOnlineToggleEnabledB}">
                                    <ToggleButton.Style>
                                        <Style BasedOn="{StaticResource ToggleButtonSwitch.Small}" TargetType="ToggleButton">
                                            <Setter Property="Content" Value="负极工位已关闭" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True">
                                                    <Setter Property="Content" Value="负极工位已打开" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False">
                                                    <Setter Property="Content" Value="负极工位已关闭" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </StackPanel>

                            <!--  图像检索、图像存储  -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.6*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontWeight="Bold"
                                        Text="图像检索：" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Margin="0,0,23,0"
                                            VerticalAlignment="Center"
                                            FontSize="25"
                                            Text="工位:" />
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Vertical">
                                            <CheckBox
                                                Content="正极"
                                                IsChecked="{Binding IsPositive, Mode=TwoWay}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                            <CheckBox
                                                Content="负极"
                                                IsChecked="{Binding IsNegative, Mode=TwoWay}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                        </StackPanel>
                                        <!--<TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            FontSize="25"
                                            Text="相机：" />
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Orientation="Vertical">
                                            <CheckBox
                                                Content="相机1"
                                                IsChecked="{Binding IsCamera1, Mode=TwoWay}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                            <CheckBox
                                                Content="相机2"
                                                IsChecked="{Binding IsCamera2, Mode=TwoWay}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Margin="20,0,0,0"
                                            Orientation="Vertical">
                                            <CheckBox
                                                Content="相机3"
                                                IsChecked="{Binding IsCamera3, Mode=TwoWay}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                            <CheckBox
                                                Content="相机4"
                                                IsChecked="{Binding IsCamera4, Mode=TwoWay}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                        </StackPanel>-->
                                    </Grid>
                                </StackPanel>
                                <!--  图像存储  -->
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,10"
                                        FontWeight="Bold"
                                        Text="图像存储：" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="25"
                                            Text="原图:" />
                                        <StackPanel
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,0,0,0"
                                            Orientation="Vertical">
                                            <CheckBox
                                                Content="OK"
                                                IsChecked="{Binding IsSaveOriginalOK}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                            <CheckBox
                                                Content="NG"
                                                IsChecked="{Binding IsSaveOriginalNG}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Margin="0,0,0,0"
                                            VerticalAlignment="Top"
                                            FontSize="25"
                                            Text="结果图：" />
                                        <StackPanel
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Margin="0,0,0,0"
                                            Orientation="Vertical">
                                            <CheckBox
                                                Content="OK"
                                                IsChecked="{Binding IsSaveResultOK}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                            <CheckBox
                                                Content="NG"
                                                IsChecked="{Binding IsSaveResultNG}"
                                                IsEnabled="{Binding IsInAnyDetection}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!--  一键仿真  -->
                            <StackPanel Margin="0,20,0,15" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Text="一键仿真:" />
                                <Button
                                    Width="80"
                                    Height="30"
                                    Margin="10,0,10,0"
                                    Background="#5DADE2"
                                    Command="{Binding File_Button}"
                                    Content="文件"
                                    IsEnabled="{Binding IsFileSelectEnabled}" />
                                <Button
                                    Width="80"
                                    Height="30"
                                    Margin="10,0,0,0"
                                    Background="#5DADE2"
                                    Command="{Binding Folder_Button}"
                                    Content="文件夹"
                                    IsEnabled="{Binding IsFolderSelectEnabled}" />
                            </StackPanel>

                            <!--  参数管控  -->
                            <Grid Margin="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!--  ============== 第一行：参数管控栏 ==============  -->
                                <StackPanel
                                    Grid.Row="0"
                                    Margin="0,20,0,5"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="参数管控:" />
                                </StackPanel>
                                <!--  ============== 第二行：缺陷参数配置区域（直接放DockPanel，去掉Tab容器） ==============  -->
                                <DockPanel
                                    Grid.Row="1"
                                    Margin="0,5,0,0"
                                    Background="#f3e5ff">
                                    <!--  顶部操作按钮栏（行增加/删除/保存）  -->
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        DockPanel.Dock="Top"
                                        Orientation="Horizontal">
                                        <!--  行增加按钮  -->
                                        <Button
                                            Width="76"
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Center"
                                            Background="Bisque"
                                            Command="{Binding AddRow}"
                                            CommandParameter="B"
                                            Content="行增加"
                                            FontSize="14"
                                            IsEnabled="{Binding IsEditAllowed}" />
                                        <!--  行删除按钮  -->
                                        <Button
                                            Width="76"
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Center"
                                            Background="Bisque"
                                            Command="{Binding DeleteRow}"
                                            CommandParameter="{Binding SelectedItem, ElementName=DataGrid}"
                                            Content="行删除"
                                            FontSize="14"
                                            IsEnabled="{Binding IsEditAllowed}" />
                                        <!--  保存按钮  -->
                                        <Button
                                            Width="76"
                                            Margin="5,0,5,0"
                                            HorizontalAlignment="Center"
                                            Background="Bisque"
                                            Command="{Binding SaveData}"
                                            CommandParameter="B"
                                            Content="保存"
                                            FontSize="14"
                                            IsEnabled="{Binding IsEditAllowed}" />
                                    </StackPanel>

                                    <DataGrid
                                        x:Name="DataGrid"
                                        VerticalAlignment="Stretch"
                                        AutoGenerateColumns="False"
                                        Background="GhostWhite"
                                        CanUserAddRows="False"
                                        HeadersVisibility="All"
                                        IsReadOnly="{Binding IsParamGridReadOnly}"
                                        ItemsSource="{Binding DefectDataGrid}"
                                        RowHeaderWidth="0"
                                        RowHeight="40"
                                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                        SelectionMode="Single">
                                        <!--  DataGrid资源区：定义控件内部复用的样式/转换器  -->
                                        <DataGrid.Resources>
                                            <!--  行样式：自定义选中/悬浮效果  -->
                                            <Style TargetType="{x:Type DataGridRow}">
                                                <Style.Triggers>
                                                    <!--  行选中触发：边框设为紫色，上下边框厚度2像素（突出选中行）  -->
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="BorderBrush" Value="Purple" />
                                                        <Setter Property="BorderThickness" Value="0,2,0,2" />
                                                    </Trigger>
                                                    <!--  鼠标悬浮触发：边框设为浅绿，上下边框厚度2像素（提示交互）  -->
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="LightGreen" />
                                                        <Setter Property="BorderThickness" Value="0,2,0,2" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>

                                            <!--  文本块样式（子标题）：复用给所有列的单元格文本，保证样式统一  -->
                                            <Style x:Key="TextBlockSubTitle" TargetType="{x:Type TextBlock}">
                                                <Setter Property="FontSize" Value="14" />
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </Style>

                                        </DataGrid.Resources>

                                        <!--  DataGrid列定义  -->
                                        <DataGrid.Columns>
                                            <!--  1. 缺陷类别列  -->


                                            <DataGridTextColumn
                                                Width="2*"
                                                Binding="{Binding DefectName}"
                                                CanUserResize="False"
                                                CellStyle="{DynamicResource InputElementBaseStyle}"
                                                ElementStyle="{StaticResource TextBlockSubTitle}"
                                                Header="类别">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="{x:Type TextBox}">
                                                        <Setter Property="FontSize" Value="14" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>


                                            <!--  2. 置信度列  -->
                                            <DataGridTextColumn
                                                Width="1.2*"
                                                Binding="{Binding Credibility}"
                                                CanUserResize="False"
                                                CellStyle="{DynamicResource InputElementBaseStyle}"
                                                ElementStyle="{StaticResource TextBlockSubTitle}"
                                                Header="置信度">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="{x:Type TextBox}">
                                                        <Setter Property="FontSize" Value="14" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <!--  3. 宽度列（mm）  -->
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Width}"
                                                CanUserResize="False"
                                                CellStyle="{DynamicResource InputElementBaseStyle}"
                                                ElementStyle="{StaticResource TextBlockSubTitle}"
                                                Header="宽">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="{x:Type TextBox}">
                                                        <Setter Property="FontSize" Value="14" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <!--  4. 高度列（mm）  -->
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Height}"
                                                CanUserResize="False"
                                                CellStyle="{DynamicResource InputElementBaseStyle}"
                                                ElementStyle="{StaticResource TextBlockSubTitle}"
                                                Header="高">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="{x:Type TextBox}">
                                                        <Setter Property="FontSize" Value="14" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <!--  5. 面积列（mm²）  -->
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Area}"
                                                CanUserResize="False"
                                                CellStyle="{DynamicResource InputElementBaseStyle}"
                                                ElementStyle="{StaticResource TextBlockSubTitle}"
                                                Header="面积">
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="{x:Type TextBox}">
                                                        <Setter Property="FontSize" Value="14" />
                                                        <Setter Property="VerticalContentAlignment" Value="Center" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>



                                            <!--  6. 是否启用（开关）  -->
                                            <DataGridTemplateColumn
                                                Width="*"
                                                CanUserResize="False"
                                                CellStyle="{DynamicResource InputElementBaseStyle}"
                                                Header="启用">

                                                <!--  1. 显示模板 (CellTemplate)：对应文本列的 ElementStyle  -->
                                                <!--  负责在非编辑状态下显示数据  -->
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <!--
                                                                IsHitTestVisible="False": 禁止鼠标直接点击勾选（需要进入编辑模式），
                                                                这样行为就和文本列一样（单击选中行，双击编辑）。
                                                                同时保持控件原色（不是灰色），视觉上和黑色文本更协调。
                                                            -->
                                                            <CheckBox
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                Focusable="False"
                                                                IsChecked="{Binding IsEnable, Mode=OneWay}"
                                                                IsHitTestVisible="False" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>

                                                <!--  2. 编辑模板 (CellEditingTemplate)：对应文本列的 EditingElementStyle  -->
                                                <!--  负责在编辑状态下（双击单元格后）修改数据  -->
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <!--  编辑模式下启用交互，绑定模式设为 TwoWay  -->
                                                            <CheckBox
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                IsChecked="{Binding IsEnable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>

                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                </DockPanel>
                            </Grid>
                        </StackPanel>
                    </TabItem>

                    <TabItem
                        Width="120"
                        HorizontalAlignment="Right"
                        FontSize="25"
                        Header="报表设置">
                        <!--  UserID 输入区域  -->
                        <StackPanel Margin="10,0,10,0">
                            <!--  报表内最大电芯数量、生辰报表最大间隔时间  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="报表内最大电芯数量：" />

                                <!--  带上下箭头的输入框  -->
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Height="30"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        IsEnabled="{Binding IsInAnyDetection}"
                                        Text="{Binding MaxImagesPerReport, Mode=TwoWay}"
                                        TextAlignment="Center" />

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        Orientation="Vertical">
                                        <!--  上箭头按钮  -->
                                        <Button
                                            Height="15"
                                            Padding="0,-2,0,0"
                                            Background="LightGray"
                                            BorderThickness="0,1,1,0.5"
                                            Command="{Binding IncrementMaxImagesCommand}"
                                            Content="▲"
                                            FontSize="8"
                                            IsEnabled="{Binding IsInAnyDetection}" />

                                        <!--  下箭头按钮  -->
                                        <Button
                                            Height="15"
                                            Padding="0,-2,0,0"
                                            Background="LightGray"
                                            BorderThickness="0,0.5,1,1"
                                            Command="{Binding DecrementMaxImagesCommand}"
                                            Content="▼"
                                            FontSize="8"
                                            IsEnabled="{Binding IsInAnyDetection}" />
                                    </StackPanel>
                                </Grid>

                                <Button
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Height="30"
                                    Margin="10,5,0,5"
                                    Background="#5DADE2"
                                    Command="{Binding SaveMaxImagesCommand}"
                                    Content="保存"
                                    IsEnabled="{Binding IsInAnyDetection}" />

                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    Text="生成报表最大间隔时间：" />

                                <!--  带上下箭头的输入框  -->
                                <Grid
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>

                                    <TextBox
                                        Grid.Column="0"
                                        Height="30"
                                        Margin="0,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        IsEnabled="{Binding IsInAnyDetection}"
                                        Text="{Binding ReportTimeoutMinutes, Mode=TwoWay}"
                                        TextAlignment="Center" />

                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        Orientation="Vertical">
                                        <!--  上箭头按钮  -->
                                        <Button
                                            Height="15"
                                            Padding="0,-2,0,0"
                                            Background="LightGray"
                                            BorderThickness="0,1,1,0.5"
                                            Command="{Binding IncrementTimeoutCommand}"
                                            Content="▲"
                                            FontSize="8"
                                            IsEnabled="{Binding IsInAnyDetection}" />

                                        <!--  下箭头按钮  -->
                                        <Button
                                            Height="15"
                                            Padding="0,-2,0,0"
                                            Background="LightGray"
                                            BorderThickness="0,0.5,1,1"
                                            Command="{Binding DecrementTimeoutCommand}"
                                            Content="▼"
                                            FontSize="8"
                                            IsEnabled="{Binding IsInAnyDetection}" />
                                    </StackPanel>
                                </Grid>

                                <Button
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    Height="30"
                                    Margin="10,5,0,5"
                                    Background="#5DADE2"
                                    Command="{Binding SaveTimeoutCommand}"
                                    Content="保存"
                                    IsEnabled="{Binding IsInAnyDetection}" />
                            </Grid>

                            <!--  添加推送用户ID  -->
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="添加推送用户 ID" />

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBox
                                    Width="200"
                                    Height="32"
                                    Margin="0,0,10,0"
                                    FontSize="16"
                                    MaxLength="10"
                                    Text="{Binding NewUserId, UpdateSourceTrigger=PropertyChanged}"
                                    ToolTip="仅允许输入10位数字" />

                                <Button
                                    Width="100"
                                    Height="32"
                                    Background="#5DADE2"
                                    BorderThickness="0"
                                    Command="{Binding SaveUserIdCommand}"
                                    Content="保存"
                                    FontSize="16"
                                    Foreground="White"
                                    IsEnabled="{Binding CanSaveUserId}" />
                            </StackPanel>

                            <ItemsControl
                                Width="160"
                                Margin="0,15,0,0"
                                HorizontalAlignment="Left"
                                ItemsSource="{Binding SavedUserIds}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Height="Auto"
                                            Margin="0,0,0,10"
                                            Padding="0"
                                            BorderBrush="#CCCCCC"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="18"
                                                    Text="{Binding}" />

                                                <Button
                                                    Grid.Column="1"
                                                    Width="25"
                                                    Height="25"
                                                    HorizontalAlignment="Center"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteUserIdCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Content="×"
                                                    FontSize="10"
                                                    Foreground="Red"
                                                    ToolTip="删除该用户ID" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </TabItem>
                    <TabItem
                        Width="120"
                        HorizontalAlignment="Right"
                        FontSize="25"
                        Header="区域过滤">
                        <!--  负极误判区域过滤  -->
                        <StackPanel Margin="0,0,0,0" Background="White">
                            <!--  总标题  -->
                            <TextBlock
                                Margin="0,0,0,10"
                                FontWeight="Bold"
                                Text="误判区域过滤：" />
                            <StackPanel Margin="0,0,0,15">
                                <TextBlock
                                    Margin="0"
                                    HorizontalAlignment="Left"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Text="A工位" />

                                <!--  A工位相机列表  -->
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel Margin="0,5,0,3" Orientation="Horizontal">
                                        <TextBlock
                                            Width="80"
